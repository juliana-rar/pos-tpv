@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <NavMenu />

        <span class="spacer"></span>

        <TopbarControls />

        <AuthorizeView>
            <Authorized>
                <div class="topbar__user">
                    <span class="topbar__name">@context.User.Identity?.Name</span>
                </div>
                <form method="post" action="/account/logout">
                    <button class="btn btn--ghost btn--icon" type="submit" title="@Loc.T("Sign out")"><LucideIcon Name="log-out" Size="18" /></button>
                </form>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="shell__content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss"><LucideIcon Name="x" Size="16" /></span>
</div>
