@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="shell">
    <NavMenu />

    <div class="shell__main">
        <header class="topbar">
            <button class="topbar__burger btn btn--icon btn--ghost" @onclick="ToggleSidebar" title="@Loc.T("Menu")">☰</button>
            <span class="spacer"></span>

            <div class="lang" role="group" aria-label="@Loc.T("Language")">
                <button class="lang__opt @(Loc.IsSpanish ? "" : "lang__opt--on")" @onclick='() => SetCulture("en")'>EN</button>
                <button class="lang__opt @(Loc.IsSpanish ? "lang__opt--on" : "")" @onclick='() => SetCulture("es")'>ES</button>
            </div>

            <button class="btn btn--icon btn--ghost" @onclick="ToggleTheme" title="@Loc.T("Toggle theme")">
                @(_theme == "dark" ? "☀️" : "🌙")
            </button>

            <AuthorizeView>
                <Authorized>
                    <div class="topbar__user">
                        <span class="topbar__name">@context.User.Identity?.Name</span>
                        <span class="badge badge--primary">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                    </div>
                    <form method="post" action="/account/logout">
                        <button class="btn btn--ghost btn--icon" type="submit" title="@Loc.T("Sign out")">⏻</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="shell__content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _theme = "light";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("posTheme.get");
            StateHasChanged();
        }
    }

    private async Task ToggleTheme() => _theme = await JS.InvokeAsync<string>("posTheme.toggle");

    private void ToggleSidebar() => JS.InvokeVoidAsync("document.body.classList.toggle", "sidebar-open");

    // Switching culture requires a full reload so the circuit starts under the new culture.
    private void SetCulture(string culture)
    {
        var redirect = Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery);
        Nav.NavigateTo($"/culture/set?culture={culture}&redirect={redirect}", forceLoad: true);
    }
}
