@* Billing metrics + charts (revenue/VAT/invoice count/average ticket, daily revenue bars,
   payment-method donut) — shared by the standalone /billing page and the dashboard's
   "Billing" section so both read from the exact same visual, just fed a different
   date range via Report. *@
@using System.Globalization

<div class="dash__metrics">
    <div class="metric card">
        <span class="metric__icon"><LucideIcon Name="banknote" Size="20" /></span>
        <span class="metric__body"><span class="metric__label">@Loc.T("Revenue")</span><span class="metric__value">@Report.Total.ToString("N2")</span></span>
    </div>
    <div class="metric card">
        <span class="metric__icon"><LucideIcon Name="receipt" Size="20" /></span>
        <span class="metric__body"><span class="metric__label">@Loc.T("VAT collected")</span><span class="metric__value">@Report.VatTotal.ToString("N2")</span></span>
    </div>
    <div class="metric card">
        <span class="metric__icon"><LucideIcon Name="ticket" Size="20" /></span>
        <span class="metric__body"><span class="metric__label">@Loc.T("Invoices")</span><span class="metric__value">@Report.Count</span></span>
    </div>
    <div class="metric card">
        <span class="metric__icon"><LucideIcon Name="bar-chart-3" Size="20" /></span>
        <span class="metric__body"><span class="metric__label">@Loc.T("Average ticket")</span><span class="metric__value">@Report.Average.ToString("N2")</span></span>
    </div>
</div>

<div class="charts">
    <div class="card chart">
        <h2>@Loc.T("Revenue by day")</h2>
        @if (Report.Daily.Count == 0 || Report.Daily.All(d => d.Total == 0))
        {
            <p class="empty">@Loc.T("No revenue in this range.")</p>
        }
        else
        {
            var maxDaily = Report.Daily.Max(d => d.Total);
            <div class="bars">
                @foreach (var d in Report.Daily)
                {
                    var h = maxDaily > 0 ? (double)(d.Total / maxDaily) * 100 : 0;
                    <div class="bars__col" title="@d.Date.ToString("dd/MM/yyyy"): @d.Total.ToString("N2")">
                        <div class="bars__track">
                            <div class="bars__bar" style="height:@h.ToString("0.##", Inv)%"></div>
                        </div>
                        <span class="bars__label">@d.Date.ToString("dd/MM")</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="card chart">
        <h2>@Loc.T("Payment methods")</h2>
        @{ var slices = MethodSlices(); }
        @if (slices.Count == 0)
        {
            <p class="empty">@Loc.T("No payments in this range.")</p>
        }
        else
        {
            <div class="donut-wrap">
                <svg viewBox="0 0 42 42" class="donut" role="img">
                    @if (slices.Count == 1)
                    {
                        <circle cx="21" cy="21" r="21" fill="@slices[0].Color" />
                    }
                    else
                    {
                        double ang = -90;
                        @foreach (var s in slices)
                        {
                            var sweep = s.Pct / 100.0 * 360.0;
                            var (x1, y1) = Pt(ang);
                            var (x2, y2) = Pt(ang + sweep);
                            var large = sweep > 180 ? 1 : 0;
                            <path d="@($"M21,21 L{F(x1)},{F(y1)} A21,21 0 {large} 1 {F(x2)},{F(y2)} Z")" fill="@s.Color" />
                            ang += sweep;
                        }
                    }
                    <circle cx="21" cy="21" r="12" class="donut__hole" />
                </svg>
                <div class="legend2">
                    @foreach (var s in slices)
                    {
                        <div class="legend2__item">
                            <span class="legend2__dot" style="background:@s.Color"></span>
                            <span class="legend2__label">@s.Label</span>
                            <span class="legend2__val">@s.Amount.ToString("N2") · @s.Pct.ToString("0", Inv)%</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public BillingReportDto Report { get; set; } = null!;

    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private record Slice(string Label, decimal Amount, double Pct, string Color);

    private List<Slice> MethodSlices()
    {
        var list = new List<Slice>();
        var total = Report.ByMethod.Sum(m => m.Amount);
        if (total <= 0) return list;
        foreach (var m in Report.ByMethod.OrderByDescending(x => x.Amount))
            list.Add(new Slice(Loc.T(m.Method.ToString()), m.Amount, (double)(m.Amount / total) * 100.0, MethodColor(m.Method)));
        return list;
    }

    private static string MethodColor(PaymentMethod m) => m switch
    {
        PaymentMethod.Cash => "#22c55e",
        PaymentMethod.Card => "#6366f1",
        _ => "#f59e0b"
    };

    // Point on the pie circle (r = 21, centre 21,21) for the given angle in degrees.
    private static (double x, double y) Pt(double deg)
    {
        var r = deg * Math.PI / 180.0;
        return (21 + 21 * Math.Cos(r), 21 + 21 * Math.Sin(r));
    }

    private static string F(double v) => v.ToString("0.###", Inv);
}
