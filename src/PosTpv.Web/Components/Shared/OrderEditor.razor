@* Edit an open comanda from /orders: pick a category → product (with extras), change line
   quantities and remove lines. Reuses the existing order services; every change bubbles up via
   OnChanged so the board card refreshes. Kept out of the POS to leave that screen untouched. *@
@inject IOrderService Orders
@inject IProductService Products
@inject ICategoryService Categories
@inject ITableService Tables
@inject IJSRuntime JS

@if (OrderId is not null)
{
    <div class="order-editor-page @(FullScreen ? "order-editor-page--full" : "")">
        <div class="order-editor-page__body">
        @if (_order is null)
        {
            <p class="muted">@Loc.T("Loading…")</p>
        }
        else
        {
            <div class="editor">
                @if (_error is not null)
                {
                    <div class="editor__error" @onclick="() => _error = null">@_error <LucideIcon Name="x" Size="14" /></div>
                }

                <div class="pos editor__pos" @ref="_editorPosEl">
                    <div class="pos__main">
                        <!-- Left: categories, same vertical rail as /pos — spans both rows so it
                             sits flush against the screen edge for the topbar's full height too,
                             instead of the topbar starting from the screen edge above it. -->
                        <div class="pos__cats">
                            @foreach (var c in _categories)
                            {
                                <button class="cat @(c.Id == _selectedCategoryId ? "cat--active" : "")"
                                        style="--cat:@c.Color" @onclick="() => SelectCategory(c.Id)" type="button">
                                    <span class="cat__icon">
                                        @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                        {
                                            <img src="@c.ImageUrl" alt="" />
                                        }
                                        else
                                        {
                                            @c.Icon
                                        }
                                    </span>
                                    <span class="cat__name">@c.Name</span>
                                </button>
                            }
                        </div>

                        <!-- Centre: product grid, same look as /pos -->
                        <div class="pos__products">
                            <div class="product-grid">
                                @foreach (var p in _products)
                                {
                                    <button class="productCard @(p.IsAvailable ? "" : "productCard--off") @(!string.IsNullOrWhiteSpace(p.ImageUrl) ? "productCard--img" : "") @(_pressedProductId == p.Id || _closingProductId == p.Id ? "productCard--pressed" : "")"
                                            style="--pc:@p.Color; @(!string.IsNullOrWhiteSpace(p.ImageUrl) ? $"background-image:url('{p.ImageUrl}')" : "")"
                                            disabled="@(!p.IsAvailable || _busy)" @onclick="() => OnProductClick(p)" type="button"
                                            @onpointerdown="() => StartProductPress(p)" @onpointerdown:preventDefault="true"
                                            @onpointerup="EndProductPress"
                                            @onpointerleave="EndProductPress" @onpointercancel="EndProductPress"
                                            @oncontextmenu="@(() => { })" @oncontextmenu:preventDefault="true">
                                        @if (_pressedProductId == p.Id)
                                        {
                                            <span class="productCard__extras">
                                                <span class="productCard__extras-inner">
                                                    @if (_pressedExtrasLoading)
                                                    {
                                                        <span class="productCard__extras-empty">@Loc.T("Loading extras…")</span>
                                                    }
                                                    else if (_pressedExtras.Count > 0)
                                                    {
                                                        @foreach (var ex in _pressedExtras)
                                                        {
                                                            <span class="productCard__extra-row @(_pressedSelectedExtraIds.Contains(ex.Id) ? "productCard__extra-row--on" : "")"
                                                                  @onclick="() => TogglePressedExtra(ex)" @onclick:stopPropagation="true"
                                                                  @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true">
                                                                <span class="productCard__extra-check">
                                                                    @if (_pressedSelectedExtraIds.Contains(ex.Id)) { <LucideIcon Name="check" Size="10" /> }
                                                                </span>
                                                                <span class="productCard__extra-name">@ex.Name</span>
                                                                <span class="productCard__extra-price">＋@ex.Price.ToString("N2")</span>
                                                            </span>
                                                        }
                                                    }
                                                    @* Running total (base price + every ticked extra, see GetDisplayPrice) stays
                                                       visible while the preview is open (see .productCard__price, which the
                                                       actions pair takes over up top) — pinned to the bottom-right of this panel
                                                       instead of top-right, in flow with the rest of the content so it
                                                       grows/shrinks with it and never forces a scrollbar. The extras-only sum
                                                       sits just left of it, and how many extras are selected sits at the
                                                       opposite (far left) end of the same row. *@
                                                    <span class="productCard__extras-footer">
                                                        @if (_pressedSelectedExtraIds.Count > 0)
                                                        {
                                                            <span class="productCard__extras-selcount">@_pressedSelectedExtraIds.Count @Loc.T("Extras")</span>
                                                        }
                                                        <span class="productCard__extras-total">
                                                            <span class="productCard__extras-count">＋@_pressedExtras.Where(ex => _pressedSelectedExtraIds.Contains(ex.Id)).Sum(ex => ex.Price).ToString("N2")</span>
                                                            <span class="productCard__extras-price">@GetDisplayPrice(p).ToString("N2")</span>
                                                        </span>
                                                    </span>
                                                </span>
                                            </span>
                                            @* X discards the preview with nothing added; the tick adds the product with
                                               whatever extras are ticked above (none ticked still adds the plain product) —
                                               replaces the old tap-a-row-to-add-immediately flow now that rows are multi-select.
                                               Sibling of .productCard__extras (not nested inside it) so .productCard — not the
                                               extras panel — is its positioned ancestor; see .productCard__extras-actions in
                                               OrderEditor.razor.css. *@
                                            <span class="productCard__extras-actions" @onclick:stopPropagation="true"
                                                  @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true">
                                                <span class="productCard__extras-btn productCard__extras-btn--cancel" role="button" tabindex="0"
                                                      title="@Loc.T("Cancel")" @onclick="ClosePressedPreview">
                                                    <LucideIcon Name="x" Size="13" />
                                                </span>
                                                <span class="productCard__extras-btn productCard__extras-btn--confirm" role="button" tabindex="0"
                                                      title="@Loc.T("Add")" @onclick="() => ConfirmPressedExtras(p)">
                                                    <LucideIcon Name="check" Size="13" />
                                                </span>
                                            </span>
                                        }
                                        else if (_closingProductId == p.Id)
                                        {
                                            @* Another tap (or a new long-press elsewhere) closed this preview — instead of
                                               vanishing instantly, it shrinks back to the card's normal size (see
                                               .productCard__extras--closing in OrderEditor.razor.css), rendering a frozen
                                               snapshot of its extras taken at the moment it closed (see ClosePressedPreview). *@
                                            <span class="productCard__extras productCard__extras--closing">
                                                <span class="productCard__extras-inner">
                                                    @if (_closingExtras.Count > 0)
                                                    {
                                                        @foreach (var ex in _closingExtras)
                                                        {
                                                            <span class="productCard__extra-row">
                                                                <span class="productCard__extra-name">@ex.Name</span>
                                                                <span class="productCard__extra-price">＋@ex.Price.ToString("N2")</span>
                                                            </span>
                                                        }
                                                    }
                                                </span>
                                            </span>
                                        }
                                        @* Title/price stay put at the card's top edge whether the extras preview below is open or
                                           not — never moves down — via order:-1 in CSS, same span either way. *@
                                        <span class="productCard__footer">
                                            <span class="productCard__name"><span class="productCard__name-text">@p.Name</span></span>
                                        </span>
                                        <span class="productCard__price">@GetDisplayPrice(p).ToString("N2")</span>
                                        @if (!p.IsAvailable) { <span class="productCard__off">@Loc.T("Unavailable")</span> }
                                    </button>
                                }
                                @if (_products.Count == 0) { <p class="empty">@Loc.T("No products in this category.")</p> }
                            </div>
                        </div>

                        @* Large-screen only (hidden below the layout's stacking breakpoint, see
                           .editor__topbar in OrderEditor.razor.css): starts right of the category
                           rail and ends exactly where the order panel begins — never under it —
                           so the Serve/Fire actions live down here instead of eating into the
                           order panel's own height. *@
                        <div class="editor__topbar">
                            <div class="editor__topbar-meta">
                                <div class="editor__topbar-meta-row">
                                    <LucideIcon Name="pencil" Size="12" />
                                    <span class="editor__topbar-title">@_order.TableName</span>
                                </div>
                                <div class="editor__topbar-stack">
                                    <span class="editor__topbar-item"><LucideIcon Name="users" Size="10" />@_tableSeats</span>
                                    <span class="editor__topbar-sep">·</span>
                                    <span class="editor__topbar-item"><LucideIcon Name="clock" Size="10" />@_order.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                                </div>
                            </div>
                            @if (_drinks.Count > 0 || _hasSeconds || _showServeFirsts)
                            {
                                <div class="editor__topbar-actions">@ActionsRow</div>
                            }
                            @* Pinned to the topbar's far right (margin-left:auto in CSS) regardless of whether
                               the Serve/Fire actions above render. Same flat card-2 tile look/size as the order
                               panel's own bottom toolbar (.order__toolbar-actions/.order__grand-actions below),
                               not the default circular .btn--icon.btn--ghost, so both icon rows read as one
                               family. Lock/open drawer and the 4th tile are placeholders (no hardware wired up
                               yet, 4th tile's label still TBD); only Move table calls through to OrderService
                               (see StartMoveTable below). *@
                            <div class="editor__topbar-extra">
                                <button class="btn" title="@Loc.T("Move table")" @onclick="StartMoveTable" type="button"><LucideIcon Name="move" Size="16" /><span>@Loc.T("Move table")</span></button>
                                <button class="btn" title="@Loc.T("Lock drawer")" type="button"><LucideIcon Name="lock" Size="16" /><span>@Loc.T("Lock drawer")</span></button>
                                <button class="btn" title="@Loc.T("Open drawer")" type="button"><LucideIcon Name="package-open" Size="16" /><span>@Loc.T("Open drawer")</span></button>
                                <button class="btn btn--pending" title="@Loc.T("Print bill")" type="button"><LucideIcon Name="printer" Size="16" /></button>
                            </div>
                        </div>
                    </div>

                    @* Drag left/right to resize the order panel — clamped in JS between a width
                       where every line's controls still fit on one line, and a generous max. *@
                    <div class="pos__resize-handle" @ref="_resizeHandleEl"></div>

                    <!-- Right: current order, same panel as /pos -->
                    <div class="pos__order card" @ref="_orderPanelEl">
                        <div class="order__head">
                            @* X closes the editor without discarding anything — added lines are already saved.
                               Left/right cells are an equal 1fr each (see .order__head's grid-template-columns),
                               so the title in the middle cell sits at the div's true center regardless of how
                               wide the status+confirm cluster on the right ends up being. *@
                            <button class="btn btn--icon btn--ghost" title="@Loc.T("Close")" @onclick="OnClose" type="button"><LucideIcon Name="x" Size="18" /></button>
                            <span class="badge badge--primary order__head-title">@Loc.T("Table") @_order.TableName · @_order.Number</span>
                            <div class="order__head-right">
                                <span class="badge">@OrderStatusLabel(_order.Status)</span>
                                @* Single confirm tick: sends food to the kitchen (skipped for a drinks-only order) and closes. *@
                                <button class="btn btn--icon btn--ghost"
                                        title="@(HasKitchenItems ? Loc.T("Send to kitchen and close") : Loc.T("Confirm and close"))"
                                        disabled="@_busy" @onclick="ConfirmAndClose" type="button"><LucideIcon Name="check" Size="18" /></button>
                            </div>
                        </div>

                        @* Same Serve/Fire actions as the top bar above (.editor__topbar-actions) — this copy
                           only shows up below the layout's stacking breakpoint, where that bar is hidden and
                           there's no room for a separate row above the columns. *@
                        @if (_drinks.Count > 0 || _hasSeconds || _showServeFirsts)
                        {
                            <div class="order-card__actions order-card__actions--inline">@ActionsRow</div>
                        }

                        <div class="order__items">
                            @foreach (var grp in OrderSections())
                            {
                                @if (grp.Label is not null)
                                {
                                    <div class="order__group" role="button" tabindex="0" @onclick="() => ToggleGroupExpanded(grp.Label)">
                                        <LucideIcon Name="@grp.Icon" Size="14" /> @Loc.T(grp.Label)
                                        @if (grp.Items.Count > 6)
                                        {
                                            <LucideIcon Name="@(_expandedGroups.Contains(grp.Label) ? "chevron-up" : "chevron-down")" Size="12" />
                                        }
                                    </div>
                                }
                                <div class="@GroupLinesClass(grp, _expandedGroups.Contains(grp.Label ?? ""))">
                                    @foreach (var batch in GroupByServeBatch(grp.Items))
                                    {
                                        <div class="order-card__drink-batch" data-served="@(batch.ServedAt is not null ? "true" : "false")">
                                        @foreach (var timeGroup in GroupByOrderTime(batch.Items))
                                        {
                                            <div class="order__time-group">
                                                <span class="order__time-group-time"><span class="order__time-group-time-pin">@timeGroup.Time.ToLocalTime().ToString("HH:mm")</span></span>
                                                <div class="order__time-group-items">
                                                    @foreach (var it in timeGroup.Items)
                                                    {
                                                        <div class="orderLine" id="orderline-@it.Id" @onclick="() => ToggleLineExpanded(it)">
                                                            <div class="orderLine__main">
                                                                @* Select armed: a checkbox at the very start of the line, left of the name —
                                                                   separate from the Invitación checkbox in orderLine__ctrl on the right. First
                                                                   tap selects every unit on the line; a multi-unit line (Quantity > 1) then
                                                                   grows a stepper next to it to dial the selected count down. *@
                                                                @if (_selectMode)
                                                                {
                                                                    <button class="orderLine__select-box @(_selectedQty.ContainsKey(it.Id) ? "orderLine__select-box--on" : "")"
                                                                            title="@Loc.T("Select")" disabled="@_busy"
                                                                            @onclick="() => ToggleItemSelected(it)" @onclick:stopPropagation="true" type="button">
                                                                        @if (_selectedQty.ContainsKey(it.Id)) { <LucideIcon Name="check" Size="12" /> }
                                                                    </button>
                                                                    @if (it.Quantity > 1 && _selectedQty.TryGetValue(it.Id, out var selQty))
                                                                    {
                                                                        <div class="orderLine__select-stepper" @onclick:stopPropagation="true">
                                                                            <button title="@Loc.T("Down")" disabled="@_busy" @onclick="() => SetSelectedQty(it, selQty - 1)" type="button">−</button>
                                                                            <span>@selQty</span>
                                                                            <button title="@Loc.T("Up")" disabled="@_busy" @onclick="() => SetSelectedQty(it, selQty + 1)" type="button">+</button>
                                                                        </div>
                                                                    }
                                                                }
                                                                <div class="orderLine__title">
                                                                    <span class="orderLine__name-group">
                                                                        <span class="orderLine__name">@it.ProductName</span>
                                                                        @if (it.IsInvited)
                                                                        {
                                                                            <span class="orderLine__invited" title="@Loc.T("Invited — not charged")">@Loc.T("Invitation")</span>
                                                                        }
                                                                        @if (it.Extras.Count > 0)
                                                                        {
                                                                            <span class="orderLine__extra">＋ @it.Extras[0].Name</span>
                                                                        }
                                                                    </span>
                                                                    @foreach (var ex in it.Extras.Skip(1))
                                                                    {
                                                                        <span class="orderLine__extra">＋ @ex.Name</span>
                                                                    }
                                                                </div>
                                                                <span class="spacer"></span>
                                                                <div class="orderLine__ctrl" @onclick:stopPropagation="true">
                                                                    @* Invitación armed: a checkbox per line, so already-added items can be marked/unmarked
                                                                       as comped too — not just new taps from the product grid. *@
                                                                    @if (_invitationMode)
                                                                    {
                                                                        <button class="orderLine__invite-box @(it.IsInvited ? "orderLine__invite-box--on" : "")"
                                                                                title="@Loc.T("Toggle invitation")" disabled="@_busy"
                                                                                @onclick="() => ToggleItemInvited(it)" type="button">
                                                                            @if (it.IsInvited) { <LucideIcon Name="check" Size="12" /> }
                                                                        </button>
                                                                    }
                                                                    <button class="btn btn--icon btn--ghost" disabled="@_busy" @onclick="() => ChangeQty(it.Id, -1)">−</button>
                                                                    <span class="orderLine__qty">@it.Quantity</span>
                                                                    <button class="btn btn--icon btn--ghost" disabled="@_busy" @onclick="() => ChangeQty(it.Id, 1)">+</button>
                                                                </div>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(it.Comment))
                                                            {
                                                                <div class="orderLine__comment">“@it.Comment”</div>
                                                            }
                                                            @if (_expandedItemId == it.Id)
                                                            {
                                                                @* Replaces the old pencil → modal flow: expanding the line itself reveals
                                                                   Extra/Comentario toggles, each opening its panel inline right below. *@
                                                                <div class="orderLine__expand-actions" @onclick:stopPropagation="true">
                                                                    <div class="orderLine__expand-btns">
                                                                        <button class="orderLine__expand-btn @(_expandedShowComment ? "orderLine__expand-btn--active" : "")" type="button" title="@Loc.T("Comment")" @onclick="() => ToggleLineComment(it)">
                                                                            <LucideIcon Name="message-square" Size="10" />
                                                                        </button>
                                                                        <button class="orderLine__expand-btn @(_expandedShowExtras ? "orderLine__expand-btn--active" : "")" type="button" title="@Loc.T("Extra")" @onclick="() => ToggleLineExtras(it)">
                                                                            <LucideIcon Name="plus" Size="10" />
                                                                        </button>
                                                                    </div>
                                                                    @if (_expandedShowComment)
                                                                    {
                                                                        <input class="orderLine__comment-inline input" @bind="_lineCommentText" @bind:event="oninput"
                                                                               @onblur="() => SaveLineComment(it)" />
                                                                    }
                                                                </div>
                                                                @if (_expandedShowExtras)
                                                                {
                                                                    <div class="orderLine__extras-panel" @onclick:stopPropagation="true">
                                                                        @if (_lineExtrasLoading)
                                                                        {
                                                                            <span class="muted">@Loc.T("Loading extras…")</span>
                                                                        }
                                                                        else if (_lineExtras.Count == 0)
                                                                        {
                                                                            <span class="muted">@Loc.T("No extras available for this product.")</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            @foreach (var ex in _lineExtras)
                                                                            {
                                                                                <div class="orderLine__extra-opt @(_lineSelectedExtraIds.Contains(ex.Id) ? "orderLine__extra-opt--on" : "")" @onclick="() => ToggleLineExtra(it, ex)">
                                                                                    <span>@ex.Name</span>
                                                                                    <span class="orderLine__extra-opt-price">＋@ex.Price.ToString("N2")</span>
                                                                                </div>
                                                                            }
                                                                        }
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        </div>
                                    }
                                </div>
                            }
                            @if (_order.Items.Count == 0) { <p class="empty">@Loc.T("Tap a product to add it.")</p> }
                        </div>
                        <div class="order__totals">
                            <div class="order__grand">
                                <span>@Loc.T("Total")</span>
                                <span>@_order.Total.ToString("N2")</span>
                            </div>
                            @* Select arms per-line checkboxes below (orderLine__select-box). Up/down will page
                               through the selected lines, ticket will preview the printable receipt — those two
                               have no handlers wired yet, placeholders only. *@
                            <div class="order__toolbar-actions">
                                <button class="btn btn--select @(_selectMode ? "btn--select-active" : "")" title="@Loc.T("Select")" disabled="@_busy" @onclick="ToggleSelectMode" type="button">
                                    <LucideIcon Name="square-dashed" Size="16" />
                                </button>
                                @* With a selection armed, Up/Down move those lines to the previous/next course
                                   (Starter → Main → Dessert) — see MoveItemsCourseAsync. Disabled with nothing
                                   selected, since there's nothing for them to act on. *@
                                <button class="btn btn--nav-up" title="@Loc.T("Move to previous course")" disabled="@(_busy || _selectedQty.Count == 0)" @onclick="() => OnMoveCourse(-1)" type="button">
                                    <LucideIcon Name="chevron-up" Size="16" />
                                </button>
                                <button class="btn btn--nav-down" title="@Loc.T("Move to next course")" disabled="@(_busy || _selectedQty.Count == 0)" @onclick="() => OnMoveCourse(1)" type="button">
                                    <LucideIcon Name="chevron-down" Size="16" />
                                </button>
                                <button class="btn btn--ticket" title="@Loc.T("Ticket")" disabled="@_busy" type="button">
                                    <LucideIcon Name="receipt" Size="16" />
                                </button>
                            </div>
                            <div class="order__grand-actions">
                                @* Delete+Invitación share the same grid column Eliminar/Invitación used to have
                                   on their own — wrapped so the column lines up with Seleccionar above, and
                                   Left/Right below line up with Subir/Bajar instead of drifting off-column. *@
                                <div class="order__del-invite">
                                    @* Requires a selection (Select button, left of Up/Down/Ticket) — deleting
                                       always asks for confirmation instead of arming per-line X buttons. Shows
                                       a ticket (coupon) instead of the trash can while Select isn't armed, since
                                       there's nothing to delete yet — trash only once selection mode is on. *@
                                    <button class="btn btn--delete"
                                            title="@Loc.T("Delete")" disabled="@(_busy || _selectedQty.Count == 0)"
                                            @onclick="OpenDeleteConfirm" type="button">
                                        <LucideIcon Name="@(_selectMode ? "trash-2" : "ticket")" Size="16" />
                                    </button>
                                    @* Arms a single free line: the next product tap is captured at zero price
                                       instead of opening the payment dialog. *@
                                    <button class="btn btn--invite @(_invitationMode ? "btn--invite-active" : "")"
                                            title="@Loc.T("Tap a product to invite it (not charged)")" disabled="@_busy"
                                            @onclick="ToggleInvitation" type="button">
                                        <LucideIcon Name="gift" Size="16" />
                                    </button>
                                </div>
                                @* Jump to the previous/next order in the caller's list — see OnNavigate. *@
                                <button class="btn btn--nav-left" title="@Loc.T("Previous order")" disabled="@_busy" @onclick="() => OnNavigate.InvokeAsync(-1)" type="button">
                                    <LucideIcon Name="chevron-left" Size="16" />
                                </button>
                                <button class="btn btn--nav-right" title="@Loc.T("Next order")" disabled="@_busy" @onclick="() => OnNavigate.InvokeAsync(1)" type="button">
                                    <LucideIcon Name="chevron-right" Size="16" />
                                </button>
                                <button class="btn btn--pay" title="@Loc.T("Charge")" @onclick="OpenPayment" type="button">
                                    <LucideIcon Name="credit-card" Size="16" />
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        </div>
    </div>
}

<PaymentDialog Order="_order" Visible="_showPayment" OnClose="ClosePayment" OnConfirm="ConfirmPayment" />

@* Trash button on a selection asks for confirmation before removing the selected units, instead
   of arming a per-line X on every product. *@
<Modal Visible="_confirmDeleteSelection" Title="@Loc.T("Confirm deletion")" OnClose="CancelDeleteSelection" Narrow="true">
    <ChildContent>
        <p>@Loc.T("Delete") @_selectedQty.Values.Sum() @Loc.T("items")? @Loc.T("This can't be undone.")</p>
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CancelDeleteSelection">@Loc.T("Cancel")</button>
        <button class="btn btn--danger" @onclick="ConfirmDeleteSelection">@Loc.T("Delete")</button>
    </Footer>
</Modal>

@* Move table: same OrderService.MoveOrderToTableAsync call as /tables' reassign-popover. The picker
   is an always-expanded list (not a popup menu) so a big table count is visible at once without the
   list getting clipped by .modal's own overflow:auto — a popup absolutely-positioned past the
   modal's shrink-wrapped height would get cut off there instead of just scrolling. Styled with the
   same tokens as /orders' status/sort/zone filters (.orders-dd in Orders.razor.css) even though the
   shape differs, so it still reads as the same design system; Blazor's CSS isolation scopes that
   file to Orders.razor, so the rules are duplicated here under movetable-list (see
   OrderEditor.razor.css) rather than shared across components.
   Lists every other table, not just free ones — MoveOrderToTableAsync itself already rejects an
   occupied/reserved destination (surfaced as _error below), so filtering here would only hide
   options without adding real protection. *@
<Modal Visible="_showMoveTable" Title="@Loc.T("Move table")" OnClose="CancelMoveTable" Wide="true">
    <ChildContent>
        <div class="movetable-list">
            @foreach (var dest in _tables.Where(t => t.Id != _order!.TableId).OrderBy(t => t.Name))
            {
                <button type="button" class="movetable-list__opt @(_moveTableDestId == dest.Id ? "movetable-list__opt--on" : "")" @onclick="() => SelectMoveTableDest(dest.Id)">@dest.Name</button>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CancelMoveTable">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" disabled="@(_moveTableDestId is null || _busy)" @onclick="ConfirmMoveTable">@Loc.T("Confirm")</button>
    </Footer>
</Modal>

@code {
    /// <summary>Id of the order to edit; the dialog is shown while this is non-null.</summary>
    [Parameter] public int? OrderId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised after any change so the parent can refresh the affected board card.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Left/Right toolbar buttons: -1 for the previous order, +1 for the next one in
    /// whatever list the caller is showing (e.g. /orders' Filtered). The caller owns that list, so
    /// it resolves the delta to an order Id and reassigns OrderId — same pattern as OnEdit.</summary>
    [Parameter] public EventCallback<int> OnNavigate { get; set; }

    /// <summary>
    /// True when the caller's own page already covers the bottom navbar itself (e.g. /tables'
    /// expanded map, which is a full-viewport takeover) — extends the editor all the way to the
    /// bottom instead of leaving its usual gap for that navbar, which would otherwise just reveal
    /// whatever page is behind the editor instead of the (already-hidden) nav.
    /// </summary>
    [Parameter] public bool FullScreen { get; set; }

    private OrderDto? _order;
    private List<CategoryDto> _categories = new();
    private List<ProductDto> _products = new();
    private List<TableDto> _tables = new();
    private int _tableSeats;
    private int _selectedCategoryId;
    private int? _loadedOrderId;
    private bool _busy;
    private string? _error;

    private ElementReference _editorPosEl;
    private ElementReference _resizeHandleEl;
    private ElementReference _orderPanelEl;
    private bool _resizeBound;
    private int? _scrollToItemId;

    // Press-and-hold-to-preview-extras state for the product grid (see StartProductPress /
    // TriggerProductPress / EndProductPress). _pressedProductId identifies which card is
    // currently showing its extras preview, independent of _busy/selection state.
    private int? _pressedProductId;
    private bool _pressedExtrasLoading;
    private List<ExtraDto> _pressedExtras = new();
    // Extras ticked in the preview so far (see TogglePressedExtra) — multiple can be picked before
    // confirming with the tick button (ConfirmPressedExtras). Cleared on every new press and on close.
    private readonly HashSet<int> _pressedSelectedExtraIds = new();
    // Id of the product whose held-past-the-delay press already opened its extras preview — the
    // pointerup/click pair that ends that specific hold shouldn't also add a line (see
    // OnProductClick). Scoped to a product id, not a bare bool: on touch, the release doesn't
    // always land back on the same element as a synthetic click (varies by browser/gesture), so a
    // click may never arrive for THIS product to consume the flag — if it were a bare bool, that
    // leftover "true" would then swallow the very next tap on a completely different product
    // instead of closing its preview and adding that product, as it should.
    private int? _suppressClickForProductId;
    private CancellationTokenSource? _pressCts;

    // Closing-animation state (see ClosePressedPreview) — holds a frozen snapshot of whichever
    // preview was just closed so its shrink-back animation has something to render while it plays,
    // even though _pressedProductId/_pressedExtras have already moved on to the next product.
    private int? _closingProductId;
    private List<ExtraDto> _closingExtras = new();
    private const int ProductPressCloseAnimMs = 220;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Order is not null only once the editor has actually rendered its grid, so bind on the
        // first render where that's true rather than strictly the component's first render.
        if (!_resizeBound && _order is not null)
        {
            _resizeBound = true;
            await JS.InvokeVoidAsync("posOrderResize", _resizeHandleEl, _editorPosEl, 280, 720);
        }
        // Reveal the line just added by OnProductClick, whichever scroll container it landed in —
        // the outer .order__items panel, or a course's own .order__group-lines--scroll once that
        // course alone outgrows 6 lines (see GroupLinesClass). scrollIntoView walks both.
        if (_scrollToItemId is int itemId)
        {
            _scrollToItemId = null;
            await JS.InvokeVoidAsync("posScrollIntoView", $"orderline-{itemId}");
        }
        // Re-run every render, not just once: adding/removing/serving lines changes each
        // time-group's own height, which shifts how its label should be clamped.
        if (_order is not null)
        {
            await JS.InvokeVoidAsync("posStickyTimeLabels", _orderPanelEl);
        }
    }
    private bool _showPayment;
    private bool _invitationMode;
    // Line-selection mode (armed from the toolbar's Select button, left of Up/Down/Ticket). Keyed
    // by item Id -> units selected on that line (not just on/off), since one line can merge several
    // identical units (OrderItemDto.Quantity) and the user may want only some of them — see the
    // per-line stepper in the orderLine markup below. Also what the Delete button acts on, via the
    // confirm dialog below (_confirmDeleteSelection).
    private bool _selectMode;
    private readonly Dictionary<int, int> _selectedQty = new();
    private bool _confirmDeleteSelection;

    // Tap-to-expand per-line editing (Extra/Comment), replacing the old pencil → modal flow — see
    // ToggleLineExpanded/ToggleLineExtras/ToggleLineComment.
    private int? _expandedItemId;
    private bool _expandedShowExtras;
    private bool _expandedShowComment;
    private List<ExtraDto> _lineExtras = new();
    private bool _lineExtrasLoading;
    private readonly HashSet<int> _lineSelectedExtraIds = new();
    private string? _lineCommentText;

    // Move-table modal state, armed from the topbar's Move table action — see StartMoveTable.
    private bool _showMoveTable;
    private int? _moveTableDestId;

    // Same Serve/Fire action-row state as OrderCard.razor (see Repartition below).
    private List<OrderItemDto> _drinks = new();
    private bool _hasPendingDrinks;
    private List<OrderItemDto> _starters = new();
    private bool _firstsPendingToServe;
    private bool _showServeFirsts;
    private List<OrderItemDto> _mains = new();
    private bool _secondsPendingToServe;
    private bool _showServeSeconds;
    private bool _hasSeconds;

    protected override async Task OnParametersSetAsync()
    {
        if (OrderId == _loadedOrderId) return;   // nothing changed
        _loadedOrderId = OrderId;
        _expandedItemId = null;
        _error = null;
        if (OrderId is null) { _order = null; return; }

        _order = await Orders.GetByIdAsync(OrderId.Value);
        Repartition();
        if (_categories.Count == 0)
        {
            _categories = await Categories.GetAllAsync(onlyVisible: true);
            _selectedCategoryId = _categories.FirstOrDefault()?.Id ?? 0;
        }
        if (_tables.Count == 0)
        {
            _tables = await Tables.GetAllAsync();
        }
        _tableSeats = _tables.FirstOrDefault(t => t.Id == _order!.TableId)?.Seats ?? 0;
        await LoadProducts();
    }

    // Same partitioning as OrderCard.razor, so the Serve/Fire action row here matches the
    // board card exactly (drives both the buttons and the Drinks/First/Second/Desserts headers).
    private void Repartition()
    {
        if (_order is null) return;
        var (drinks, starters, mains, _) = OrderPresentation.Partition(_order.Items);

        _drinks = drinks;
        _hasPendingDrinks = drinks.Any(d => d.Status != OrderItemStatus.Delivered);

        _starters = starters;
        _firstsPendingToServe = starters.Any(s => s.Status == OrderItemStatus.Ready);
        // Same rule as OrderCard.razor: hide the standalone button once the order has mains,
        // since "Serve seconds" already serves the firsts alongside them.
        _showServeFirsts = mains.Count == 0 && starters.Any(s => s.Status is OrderItemStatus.Ready or OrderItemStatus.Delivered);

        _mains = mains;
        _secondsPendingToServe = mains.Any(s => s.Status == OrderItemStatus.Ready);
        _showServeSeconds = mains.Any(s => s.Status is OrderItemStatus.Ready or OrderItemStatus.Delivered);
        _hasSeconds = mains.Count > 0;
    }

    private string DrinksLabel() => OrderPresentation.DrinksLabel(_hasPendingDrinks, _order?.DrinksServedAt);

    private string FirstsServeLabel() =>
        OrderPresentation.CourseServeLabel(_firstsPendingToServe, _starters, "Serve firsts", "Firsts served");

    private string SecondsServeLabel() =>
        OrderPresentation.SecondsServeLabel(_secondsPendingToServe, _mains, _order!.SecondsSentAt);

    // Seconds can reach the customer without ever being fired (e.g. auto-served the moment a
    // dessert is ordered) — in that case the "Serve seconds" chip alone already reads "Seconds
    // served · time", so the Fire-seconds bell is hidden rather than showing that same text a
    // second time right next to it.
    private bool ShowFireSeconds => _order!.SecondsSentAt is not null || !(_showServeSeconds && !_secondsPendingToServe);

    // Once the kitchen has fired seconds, SecondsSentAt never clears on its own — so the button
    // locks into "Seconds prepared" instead of flipping back to "Fire seconds" every time the
    // kitchen acknowledges its alert.
    private bool SecondsAlreadyDone => _order!.SecondsSentAt is not null;

    private string SecondsSentLabel() => _order!.SecondsSentAt is not null
        ? $"{Loc.T("Seconds prepared")} · {_order.SecondsSentAt.Value.ToLocalTime():HH:mm}"
        : Loc.T("Fire seconds");

    // Rendered twice — once in the large-screen top bar, once inline in the order panel for
    // small screens — so the buttons and their state live in one place instead of two copies.
    private RenderFragment ActionsRow => @<div class="order-card__actions-row">
        @if (_drinks.Count > 0)
        {
            <button class="btn btn--sm @(_hasPendingDrinks ? "btn--primary" : "btn--ghost")"
                    title="@(_hasPendingDrinks ? null : Loc.T("Click to undo"))" disabled="@_busy"
                    @onclick="OnToggleDrinksClick" type="button">
                <LucideIcon Name="cup-soda" Size="14" />@DrinksLabel()
            </button>
        }
        @if (_hasSeconds)
        {
            @if (_showServeSeconds)
            {
                <button class="btn btn--sm @(_secondsPendingToServe ? "btn--primary" : "btn--ghost")"
                        title="@(_secondsPendingToServe ? null : Loc.T("Click to undo"))" disabled="@_busy"
                        @onclick="OnToggleServeSecondsClick" type="button">
                    <LucideIcon Name="utensils" Size="14" />@SecondsServeLabel()
                </button>
            }
            else if (ShowFireSeconds)
            {
                <button class="btn btn--sm @(SecondsAlreadyDone ? "btn--ghost" : "btn--primary")"
                        title="@(SecondsAlreadyDone ? null : Loc.T("Tell the kitchen to start the second courses"))"
                        disabled="@(_busy || SecondsAlreadyDone)"
                        @onclick="OnToggleSecondsClick" type="button">
                    <LucideIcon Name="bell" Size="14" />@SecondsSentLabel()
                </button>
            }
        }
        @if (_showServeFirsts)
        {
            <button class="btn btn--sm @(_firstsPendingToServe ? "btn--primary" : "btn--ghost")"
                    title="@(_firstsPendingToServe ? null : Loc.T("Click to undo"))" disabled="@_busy"
                    @onclick="OnToggleServeFirstsClick" type="button">
                <LucideIcon Name="salad" Size="14" />@FirstsServeLabel()
            </button>
        }
    </div>;

    private Task OnToggleDrinksClick() => Mutate(async () =>
    {
        if (_hasPendingDrinks) await Orders.ServeDrinksAsync(_order!.Id);
        else await Orders.UnserveDrinksAsync(_order!.Id);
        return await Orders.GetByIdAsync(_order!.Id);
    });

    private Task OnToggleServeFirstsClick() => Mutate(async () =>
    {
        if (_firstsPendingToServe) await Orders.ServeFirstCoursesAsync(_order!.Id);
        else await Orders.UnserveFirstCoursesAsync(_order!.Id);
        return await Orders.GetByIdAsync(_order!.Id);
    });

    private Task OnToggleServeSecondsClick() => Mutate(async () =>
    {
        if (_secondsPendingToServe) await Orders.ServeSecondCoursesAsync(_order!.Id);
        else await Orders.UnserveSecondCoursesAsync(_order!.Id);
        return await Orders.GetByIdAsync(_order!.Id);
    });

    // Button is disabled once seconds are already fired or served, so this only ever fires
    // (never undoes) — undoing is left to the kitchen's own "Seconds prepared" toggle in /kitchen.
    private Task OnToggleSecondsClick() => Mutate(async () =>
    {
        if (!SecondsAlreadyDone) await Orders.FireSecondCoursesAsync(_order!.Id);
        return await Orders.GetByIdAsync(_order!.Id);
    });

    private async Task SelectCategory(int id)
    {
        _selectedCategoryId = id;
        await LoadProducts();
    }

    private async Task LoadProducts() =>
        _products = _selectedCategoryId == 0 ? new() : await Products.GetByCategoryAsync(_selectedCategoryId, onlyAvailable: false);

    // Wraps a server round-trip: single in-flight guard, surfaces failures as a dismissible notice,
    // refreshes the local order and notifies the parent so the board card updates.
    private async Task Mutate(Func<Task<OrderDto?>> op)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var updated = await op();
            if (updated is not null) _order = updated;
            Repartition();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // Tapping a product adds it straight away, as its own line (no dialog in the way).
    // Extras/comment can be set afterwards from the line itself. While invitation mode is
    // armed, every tap is captured at zero price — it stays armed until the Invitación
    // button is pressed again, so several products can be invited in a row.
    private async Task OnProductClick(ProductDto p)
    {
        // A held-past-the-delay press already showed the extras preview instead of adding the
        // product — the pointerup/click pair that ends it shouldn't also add a line. Only
        // suppresses a click on the SAME product that was just pressed — a click on any other
        // product still goes through below, closing this one's preview and adding the one tapped.
        if (_suppressClickForProductId == p.Id) { _suppressClickForProductId = null; return; }
        // The extras preview stays pinned open after a press (see EndProductPress) until any
        // product is tapped — same one or a different one — which both adds the tapped line and
        // closes whichever preview was open (see ClosePressedPreview for the shrink animation).
        ClosePressedPreview();
        if (_order is null) return;
        var orderId = _order.Id;
        var invited = _invitationMode;
        await Mutate(async () => await Orders.AddItemAsync(new AddItemRequest(orderId, p.Id, Merge: false, Invited: invited)));
        // Newest row for this product — Merge:false above guarantees the add always creates one,
        // so the last match by Id is unambiguously the line that was just added.
        _scrollToItemId = _order?.Items.Where(i => i.ProductId == p.Id).OrderByDescending(i => i.Id).FirstOrDefault()?.Id;
    }

    // Tapping an extra row in the press-and-hold preview just arms/disarms it — several can be
    // ticked before the tick button below actually adds the product (see ConfirmPressedExtras).
    private void TogglePressedExtra(ExtraDto ex)
    {
        if (!_pressedSelectedExtraIds.Add(ex.Id)) _pressedSelectedExtraIds.Remove(ex.Id);
    }

    // Bottom-right corner price on the card: while its extras preview is open, reflects the base
    // price plus whichever extras are currently ticked, so it tracks ConfirmPressedExtras' total
    // instead of staying frozen at the plain product price.
    private decimal GetDisplayPrice(ProductDto p)
        => p.Id == _pressedProductId
            ? p.Price + _pressedExtras.Where(ex => _pressedSelectedExtraIds.Contains(ex.Id)).Sum(ex => ex.Price)
            : p.Price;

    // Tick button: adds the product with every extra currently ticked (none ticked still adds the
    // plain product), then closes the preview like a cancel would.
    private async Task ConfirmPressedExtras(ProductDto p)
    {
        if (_order is null) return;
        var orderId = _order.Id;
        var invited = _invitationMode;
        var extraIds = _pressedSelectedExtraIds.ToList();
        int? newItemId = null;
        await Mutate(async () =>
        {
            var afterAdd = await Orders.AddItemAsync(new AddItemRequest(orderId, p.Id, Merge: false, Invited: invited));
            newItemId = afterAdd.Items.Where(i => i.ProductId == p.Id).OrderByDescending(i => i.Id).FirstOrDefault()?.Id;
            return newItemId is null || extraIds.Count == 0 ? afterAdd : await Orders.SetItemExtrasAsync(newItemId.Value, extraIds);
        });
        ClosePressedPreview();
        _scrollToItemId = newItemId;
    }

    // Closes whichever product's extras preview is currently pinned open, handing it off to the
    // closing-animation state (_closingProductId/_closingExtras) instead of just nulling
    // _pressedProductId outright — an @if removing the panel's DOM node in the same render gives
    // CSS no chance to transition, so a frozen snapshot keeps rendering (with a
    // .productCard__extras--closing class — see OrderEditor.razor.css) until the shrink animation
    // finishes, then ClearClosingPreview drops it for good.
    private void ClosePressedPreview()
    {
        if (_pressedProductId is not { } closingId) return;
        _closingProductId = closingId;
        _closingExtras = _pressedExtras;
        _pressedProductId = null;
        _pressedExtras = new();
        _pressedExtrasLoading = false;
        _pressedSelectedExtraIds.Clear();
        _ = ClearClosingPreview(closingId);
    }

    private async Task ClearClosingPreview(int productId)
    {
        await Task.Delay(ProductPressCloseAnimMs);
        if (_closingProductId != productId) return;
        _closingProductId = null;
        StateHasChanged();
    }

    private const int ProductPressDelayMs = 450;

    private void StartProductPress(ProductDto p)
    {
        _pressCts?.Cancel();
        if (p.Extras.Count == 0) return;
        var cts = new CancellationTokenSource();
        _pressCts = cts;
        _ = TriggerProductPress(p, cts.Token);
    }

    private async Task TriggerProductPress(ProductDto p, CancellationToken ct)
    {
        try { await Task.Delay(ProductPressDelayMs, ct); }
        catch (TaskCanceledException) { return; }
        if (ct.IsCancellationRequested) return;

        // Long-pressing straight into a different product while another's preview is still
        // open swaps it out — the old one plays its shrink-back animation instead of just
        // disappearing under the new one.
        if (_pressedProductId is not null && _pressedProductId != p.Id) ClosePressedPreview();

        _pressedProductId = p.Id;
        _suppressClickForProductId = p.Id;
        _pressedExtrasLoading = true;
        _pressedExtras = new();
        _pressedSelectedExtraIds.Clear();
        StateHasChanged();

        try { _pressedExtras = await Products.GetExtrasAsync(p.Id); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _pressedExtrasLoading = false; }
        StateHasChanged();
    }

    // Ends the hold gesture: a quick tap (released before the delay elapses) cancels the pending
    // preview so OnProductClick's normal add-on-click still fires. Once the preview is already
    // showing, releasing the pointer leaves it open — see OnProductClick for how it closes.
    private void EndProductPress() => _pressCts?.Cancel();

    private void ToggleInvitation() => _invitationMode = !_invitationMode;

    // Flips an already-added line between invited (comped, zero price) and its normal catalog
    // price — the per-line checkbox shown while Invitación is armed (see the orderLine markup).
    private Task ToggleItemInvited(OrderItemDto item) =>
        Mutate(() => Orders.SetItemInvitedAsync(item.Id, !item.IsInvited));

    private void OpenDeleteConfirm() => _confirmDeleteSelection = true;
    private void CancelDeleteSelection() => _confirmDeleteSelection = false;

    // Removes every unit currently selected (full lines drop out entirely — see ChangeQuantityAsync),
    // then disarms Select the same way leaving it normally does.
    private Task ConfirmDeleteSelection() => Mutate(async () =>
    {
        OrderDto? updated = null;
        foreach (var (id, qty) in _selectedQty)
            updated = await Orders.ChangeQuantityAsync(id, -qty);
        _confirmDeleteSelection = false;
        _selectMode = false;
        _selectedQty.Clear();
        return updated;
    });

    private void StartMoveTable() { _showMoveTable = true; _moveTableDestId = null; }
    private void CancelMoveTable() { _showMoveTable = false; _moveTableDestId = null; }
    private void SelectMoveTableDest(int id) => _moveTableDestId = id;

    // Same call /tables' reassign-popover makes (OrderService.MoveOrderToTableAsync); refreshes both
    // the order (new TableId/TableName) and the table list (old table freed up, new one occupied) so
    // a second move in the same session offers the right destinations again.
    private async Task ConfirmMoveTable()
    {
        if (_moveTableDestId is null || _busy) return;
        _busy = true;
        _error = null;
        try
        {
            _order = await Orders.MoveOrderToTableAsync(_order!.Id, _moveTableDestId.Value);
            _tables = await Tables.GetAllAsync();
            _tableSeats = _tables.FirstOrDefault(t => t.Id == _order!.TableId)?.Seats ?? 0;
            _showMoveTable = false;
            _moveTableDestId = null;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // Select armed/disarmed from the toolbar; leaving it clears whatever was checked so a stale
    // selection can't linger into the next time it's armed.
    private void ToggleSelectMode()
    {
        _selectMode = !_selectMode;
        if (!_selectMode) _selectedQty.Clear();
    }

    // First tap on a line's select box grabs every unit on it; a second tap clears it. Dialing a
    // multi-unit line's count down to zero via the stepper (SetSelectedQty) has the same effect.
    private void ToggleItemSelected(OrderItemDto item)
    {
        if (!_selectedQty.Remove(item.Id)) _selectedQty[item.Id] = item.Quantity;
    }

    private void SetSelectedQty(OrderItemDto item, int qty)
    {
        qty = Math.Clamp(qty, 0, item.Quantity);
        if (qty <= 0) _selectedQty.Remove(item.Id);
        else _selectedQty[item.Id] = qty;
    }

    // Up/Down toolbar buttons while a selection is armed — steps every selected line one place
    // along Drinks/Starter/Main/Dessert (see MoveItemsCourseAsync; a food line pushed past Starter
    // becomes a real drink everywhere, not just visually). Selection stays armed afterwards so the
    // same lines can be nudged again without re-picking them.
    private async Task OnMoveCourse(int delta)
    {
        if (_order is null || _selectedQty.Count == 0) return;
        var ids = _selectedQty.Keys.ToList();
        await Mutate(async () => await Orders.MoveItemsCourseAsync(_order.Id, ids, delta));
        // MoveItemsCourseAsync sorts moved lines to the bottom of their new section — scroll to
        // one of them so the move is visible immediately instead of the panel staying where it was.
        _scrollToItemId = ids[0];
    }

    // Tapping the product div itself arms/disarms its inline expand panel — a second tap on the
    // same line (or switching to another) collapses it. Seeds the local extras/comment state from
    // the line's current values so the panels open already showing what's saved.
    private void ToggleLineExpanded(OrderItemDto item)
    {
        if (_expandedItemId == item.Id) { _expandedItemId = null; return; }
        _expandedItemId = item.Id;
        _expandedShowExtras = false;
        _expandedShowComment = false;
        _lineExtras = new();
        _lineCommentText = item.Comment;
        _lineSelectedExtraIds.Clear();
        foreach (var e in item.Extras.Where(e => e.ExtraId.HasValue))
            _lineSelectedExtraIds.Add(e.ExtraId!.Value);
    }

    private async Task ToggleLineExtras(OrderItemDto item)
    {
        _expandedShowExtras = !_expandedShowExtras;
        _expandedShowComment = false;
        if (!_expandedShowExtras || _lineExtras.Count > 0) return;

        _lineExtrasLoading = true;
        StateHasChanged();
        try { _lineExtras = await Products.GetExtrasAsync(item.ProductId); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _lineExtrasLoading = false; }
    }

    private void ToggleLineComment(OrderItemDto item)
    {
        _expandedShowComment = !_expandedShowComment;
        _expandedShowExtras = false;
    }

    // Applies immediately, no separate Save step — consistent with every other line action in
    // this editor (qty, invitation, course move). Toggling an extra here updates the line right away.
    private Task ToggleLineExtra(OrderItemDto item, ExtraDto ex)
    {
        if (!_lineSelectedExtraIds.Add(ex.Id)) _lineSelectedExtraIds.Remove(ex.Id);
        var extraIds = _lineSelectedExtraIds.ToList();
        return Mutate(() => Orders.SetItemExtrasAsync(item.Id, extraIds));
    }

    private Task SaveLineComment(OrderItemDto item)
    {
        if (_order is null) return Task.CompletedTask;
        var comment = _lineCommentText;
        var orderId = _order.Id;
        return Mutate(async () =>
        {
            await Orders.SetItemCommentAsync(item.Id, comment);
            return await Orders.GetByIdAsync(orderId);
        });
    }

    private Task ChangeQty(int itemId, int delta) =>
        Mutate(async () => await Orders.ChangeQuantityAsync(itemId, delta));

    /// <summary>True when the order has at least one non-drink line, i.e. something the kitchen must cook.</summary>
    private bool HasKitchenItems => _order?.Items.Any(i => !i.IsDrink) ?? false;

    // The single confirm tick: send food to the kitchen only if there is any (a drinks-only order goes
    // straight to the bar, never to the kitchen), then close the editor.
    private async Task ConfirmAndClose()
    {
        if (HasKitchenItems) await SendToKitchen();
        await OnClose.InvokeAsync();
    }

    private void OpenPayment() => _showPayment = true;
    private void ClosePayment() => _showPayment = false;

    private async Task ConfirmPayment(IReadOnlyList<PaymentInput> payments)
    {
        if (_order is null) return;
        var orderId = _order.Id;
        await Orders.CheckoutAsync(orderId, payments);
        _showPayment = false;
        await OnChanged.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    private Task SendToKitchen()
    {
        if (_order is null) return Task.CompletedTask;
        var orderId = _order.Id;
        return Mutate(async () =>
        {
            await Orders.SendToKitchenAsync(orderId);
            return await Orders.GetByIdAsync(orderId);
        });
    }

    private static string OrderStatusLabel(OrderStatus s) => Loc.T(s switch
    {
        OrderStatus.Open => "Open",
        OrderStatus.Sent => "Sent",
        OrderStatus.InPreparation => "Cooking",
        OrderStatus.Ready => "Ready",
        OrderStatus.Delivered => "Delivered",
        _ => s.ToString()
    });

    // Same Drinks/First/Second/Desserts grouping as /pos (OrderPresentation.Sections), so
    // editing an order reads the same way instead of one undifferentiated column — but always
    // labelled here (even under 5 lines), since a single drink still needs a "Drinks" header.
    private List<OrderPresentation.OrderSection> OrderSections() =>
        _order is null ? new() : OrderPresentation.Sections(_order.Items, alwaysLabel: true);

    private static string GroupLinesClass(OrderPresentation.OrderSection section, bool expanded) => OrderPresentation.GroupLinesClass(section, expanded);

    // Course sections capped to 6 lines (see GroupLinesClass) can be expanded to full height by
    // clicking their header, and collapsed back the same way — tracked per label so Drinks/First/
    // Second/Desserts expand independently of each other.
    private readonly HashSet<string> _expandedGroups = new();

    private void ToggleGroupExpanded(string label)
    {
        if (!_expandedGroups.Remove(label)) _expandedGroups.Add(label);
    }

    // Same "served together" batching as OrderCard.razor, so a batch already marked served
    // gets the same green shaded frame here while editing.
    private static List<OrderPresentation.ServeBatch> GroupByServeBatch(List<OrderItemDto> items) =>
        OrderPresentation.GroupByServeBatch(items);

    // Same "ordered in the same minute" grouping as OrderCard.razor, so a long ticket edited
    // here reads the same way (shared timestamp + connecting bracket instead of repeating it per line).
    private static List<OrderPresentation.TimeGroup> GroupByOrderTime(List<OrderItemDto> items) =>
        OrderPresentation.GroupByOrderTime(items);
}
