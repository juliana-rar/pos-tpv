@* A large launcher tile used on the home hub. *@
<a class="hub-card" href="@Href" style="--accent:@Accent">
    <span class="hub-card__icon">@Icon</span>
    <span class="hub-card__body">
        <span class="hub-card__title">@Title</span>
        <span class="hub-card__desc">@Description</span>
    </span>
    <span class="hub-card__go">@Loc.T("Enter") →</span>
</a>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Accent { get; set; } = "var(--primary)";
}
