@* One order (comanda) on the /orders screen, grouped into Drinks / First / Second / Desserts.
   Kept as its own component so a single-order refresh re-renders only the affected card:
   ShouldRender short-circuits unless the Order reference actually changed, and the block
   partition is computed once per change (in OnParametersSet) rather than on every render. *@

<div class="card order-card">
    <div class="order-card__head">
        <div class="order-card__title">
            <LucideIcon Name="armchair" Size="16" />
            <strong>@Order.TableName</strong>
            <span class="muted order-card__number"> · @Order.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
        </div>
        <div class="order-card__head-right">
            <span class="badge @StatusClass(Order.Status)">@Loc.T(Order.Status.ToString())</span>
            <button class="btn btn--icon btn--ghost" title="@Loc.T("Edit")" @onclick="OnEditClick"><LucideIcon Name="pencil" Size="15" /></button>
        </div>
    </div>

    @* All fire/serve actions grouped together, right under the meta line.
       None of them disappear once done — they switch to a muted, disabled state that keeps
       showing what happened and at what time, instead of vanishing from the card. *@
    @if (_drinks.Count > 0 || _hasSeconds || _showServeFirsts || _showServeDesserts)
    {
        <div class="order-card__actions">
            @if (_drinks.Count > 0)
            {
                <button class="btn btn--sm @(_hasPendingDrinks ? "btn--primary" : "btn--ghost")"
                        title="@(_hasPendingDrinks ? null : Loc.T("Click to undo"))"
                        @onclick="OnToggleDrinksClick">
                    <LucideIcon Name="cup-soda" Size="14" />@DrinksLabel()
                </button>
            }
            @if (_showServeFirsts)
            {
                <button class="btn btn--sm @(_firstsPendingToServe ? "btn--primary" : "btn--ghost")"
                        title="@(_firstsPendingToServe ? null : Loc.T("Click to undo"))"
                        @onclick="OnToggleServeFirstsClick">
                    <LucideIcon Name="salad" Size="14" />@FirstsServeLabel()
                </button>
            }
            @* Once seconds are ready to serve (or served), that state takes over this same slot
               instead of stacking a separate "Serve seconds" button next to "Fire seconds". *@
            @if (_showServeSeconds)
            {
                <button class="btn btn--sm @(_secondsPendingToServe ? "btn--primary" : "btn--ghost")"
                        title="@(_secondsPendingToServe ? null : Loc.T("Click to undo"))"
                        @onclick="OnToggleServeSecondsClick">
                    <LucideIcon Name="utensils" Size="14" />@SecondsServeLabel()
                </button>
            }
            else if (_hasSeconds)
            {
                <button class="btn btn--sm @(Order.SecondsFiredAt is null ? "btn--primary" : "btn--ghost")"
                        title="@(Order.SecondsFiredAt is null ? Loc.T("Tell the kitchen to start the second courses") : Loc.T("Click to undo"))"
                        @onclick="OnToggleSecondsClick">
                    <LucideIcon Name="bell" Size="14" />@CourseLabel("Fire seconds", "Seconds fired", Order.SecondsFiredAt)
                </button>
            }
            @if (_showServeDesserts)
            {
                <button class="btn btn--sm @(_dessertsPendingToServe ? "btn--primary" : "btn--ghost")"
                        title="@(_dessertsPendingToServe ? null : Loc.T("Click to undo"))"
                        @onclick="OnToggleServeDessertsClick">
                    <LucideIcon Name="cake-slice" Size="14" />@DessertsServeLabel()
                </button>
            }
        </div>
    }

    <div class="order-card__body">
    @* ---- Drinks ---- *@
    @if (_drinks.Count > 0)
    {
        <div class="order-card__group"><LucideIcon Name="cup-soda" Size="16" /> @Loc.T("Drinks")</div>
        <div class="order-card__lines @(_drinks.Count > 7 ? "order-card__lines--scroll" : "")">
            @foreach (var group in _drinkGroups)
            {
                <div class="order-card__drink-batch" data-served="@(group.ServedAt is not null ? "true" : "false")">
                    @foreach (var timeGroup in GroupByOrderTime(group.Items))
                    {
                        <div class="order-card__time-group">
                            <span class="order-card__time-group-time">@timeGroup.Time.ToLocalTime().ToString("HH:mm")</span>
                            <div class="order-card__time-group-items">
                                @foreach (var it in timeGroup.Items)
                                {
                                    <div class="order-card__line"><span>@it.Quantity× @it.ProductName</span></div>
                                }
                            </div>
                        </div>
                    }
                    @if (group.ServedAt is { } at)
                    {
                        <button class="badge badge--success badge--btn" title="@Loc.T("Mark as not served")" @onclick="() => OnUnserveBatchClick(group)">
                            <LucideIcon Name="rotate-ccw" Size="11" />@Loc.T("Served") · @at.ToLocalTime().ToString("HH:mm")
                        </button>
                    }
                </div>
            }
        </div>
    }

    @* ---- First course: same served-batch/green-badge pattern as drinks ---- *@
    @if (_starters.Count > 0)
    {
        <div class="order-card__group"><LucideIcon Name="salad" Size="16" /> @Loc.T("First course")</div>
        <div class="order-card__lines">
            @foreach (var group in _starterGroups)
            {
                <div class="order-card__drink-batch" data-served="@(group.ServedAt is not null ? "true" : "false")">
                    @foreach (var timeGroup in GroupByOrderTime(group.Items))
                    {
                        <div class="order-card__time-group">
                            <span class="order-card__time-group-time">@timeGroup.Time.ToLocalTime().ToString("HH:mm")</span>
                            <div class="order-card__time-group-items">
                                @foreach (var it in timeGroup.Items)
                                {
                                    <div class="order-card__line">
                                        <span>@it.Quantity× @it.ProductName</span>
                                        <span>@it.LineTotal.ToString("N2")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (group.ServedAt is { } at)
                    {
                        <button class="badge badge--success badge--btn" title="@Loc.T("Mark as not served")" @onclick="() => OnUnserveFirstBatchClick(group)">
                            <LucideIcon Name="rotate-ccw" Size="11" />@Loc.T("Served") · @at.ToLocalTime().ToString("HH:mm")
                        </button>
                    }
                </div>
            }
        </div>
    }

    @* ---- Second course: same served-batch/green-badge pattern as first course ---- *@
    @if (_mains.Count > 0)
    {
        <div class="order-card__group"><LucideIcon Name="utensils" Size="16" /> @Loc.T("Second course")</div>
        <div class="order-card__lines">
            @foreach (var group in _mainGroups)
            {
                <div class="order-card__drink-batch" data-served="@(group.ServedAt is not null ? "true" : "false")">
                    @foreach (var timeGroup in GroupByOrderTime(group.Items))
                    {
                        <div class="order-card__time-group">
                            <span class="order-card__time-group-time">@timeGroup.Time.ToLocalTime().ToString("HH:mm")</span>
                            <div class="order-card__time-group-items">
                                @foreach (var it in timeGroup.Items)
                                {
                                    <div class="order-card__line">
                                        <span>@it.Quantity× @it.ProductName</span>
                                        <span>@it.LineTotal.ToString("N2")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (group.ServedAt is { } at)
                    {
                        <button class="badge badge--success badge--btn" title="@Loc.T("Mark as not served")" @onclick="() => OnUnserveSecondBatchClick(group)">
                            <LucideIcon Name="rotate-ccw" Size="11" />@Loc.T("Served") · @at.ToLocalTime().ToString("HH:mm")
                        </button>
                    }
                </div>
            }
        </div>
    }

    @* ---- Desserts: same served-batch/green-badge pattern as first course ---- *@
    @if (_desserts.Count > 0)
    {
        <div class="order-card__group"><LucideIcon Name="cake-slice" Size="16" /> @Loc.T("Desserts")</div>
        <div class="order-card__lines">
            @foreach (var group in _dessertGroups)
            {
                <div class="order-card__drink-batch" data-served="@(group.ServedAt is not null ? "true" : "false")">
                    @foreach (var timeGroup in GroupByOrderTime(group.Items))
                    {
                        <div class="order-card__time-group">
                            <span class="order-card__time-group-time">@timeGroup.Time.ToLocalTime().ToString("HH:mm")</span>
                            <div class="order-card__time-group-items">
                                @foreach (var it in timeGroup.Items)
                                {
                                    <div class="order-card__line">
                                        <span>@it.Quantity× @it.ProductName</span>
                                        <span>@it.LineTotal.ToString("N2")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (group.ServedAt is { } at)
                    {
                        <button class="badge badge--success badge--btn" title="@Loc.T("Mark as not served")" @onclick="() => OnUnserveDessertBatchClick(group)">
                            <LucideIcon Name="rotate-ccw" Size="11" />@Loc.T("Served") · @at.ToLocalTime().ToString("HH:mm")
                        </button>
                    }
                </div>
            }
        </div>
    }
    </div>

    <div class="order-card__foot">
        <strong>@Order.Total.ToString("N2")</strong>
        <span class="spacer"></span>
        <button class="btn btn--success" @onclick="OnPayClick"><LucideIcon Name="credit-card" Size="16" />@Loc.T("Charge")</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public OrderDto Order { get; set; } = default!;

    /// <summary>Serve every pending drink of this order (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnServeDrinks { get; set; }
    /// <summary>Undo serving every drink of this order at once (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnUnserveDrinks { get; set; }
    /// <summary>Undo serving a single drink line (carries the order item id).</summary>
    [Parameter] public EventCallback<int> OnUnserveDrink { get; set; }
    /// <summary>Serve every ready first-course line of this order (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnServeFirsts { get; set; }
    /// <summary>Undo serving every first-course line of this order at once (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnUnserveFirsts { get; set; }
    /// <summary>Undo serving a single first-course line (carries the order item id).</summary>
    [Parameter] public EventCallback<int> OnUnserveFirstItem { get; set; }
    /// <summary>Serve every ready second-course line of this order (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnServeSeconds { get; set; }
    /// <summary>Undo serving every second-course line of this order at once (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnUnserveSeconds { get; set; }
    /// <summary>Undo serving a single second-course line (carries the order item id).</summary>
    [Parameter] public EventCallback<int> OnUnserveSecondItem { get; set; }
    /// <summary>Fire the second courses for this order (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnFireSeconds { get; set; }
    /// <summary>Undo firing the second courses (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnUnfireSeconds { get; set; }
    /// <summary>Serve every ready dessert line of this order (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnServeDesserts { get; set; }
    /// <summary>Undo serving every dessert line of this order at once (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnUnserveDesserts { get; set; }
    /// <summary>Undo serving a single dessert line (carries the order item id).</summary>
    [Parameter] public EventCallback<int> OnUnserveDessertItem { get; set; }
    /// <summary>Open the editor for this order (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnEdit { get; set; }
    /// <summary>Open the payment dialog for this order (carries the order id).</summary>
    [Parameter] public EventCallback<int> OnPay { get; set; }

    private OrderDto? _rendered;                       // last Order reference we partitioned/rendered
    private List<OrderItemDto> _drinks = new();
    private List<OrderPresentation.ServeBatch> _drinkGroups = new();
    private bool _hasPendingDrinks;
    private List<OrderItemDto> _starters = new();
    private List<OrderPresentation.ServeBatch> _starterGroups = new();
    private bool _firstsPendingToServe;                 // has ready-but-not-served first courses
    private bool _showServeFirsts;                      // something ready or already served, so the button is relevant
    private List<OrderItemDto> _mains = new();
    private List<OrderPresentation.ServeBatch> _mainGroups = new();
    private bool _secondsPendingToServe;                // has ready-but-not-served second courses
    private bool _showServeSeconds;                     // something ready or already served, so the button is relevant
    private bool _hasSeconds;                           // has second courses (drives the "Fire seconds" button)
    private List<OrderItemDto> _desserts = new();
    private List<OrderPresentation.ServeBatch> _dessertGroups = new();
    private bool _dessertsPendingToServe;               // has ready-but-not-served desserts
    private bool _showServeDesserts;                    // something ready or already served, so the button is relevant

    protected override void OnParametersSet()
    {
        // Repartition only when the order instance actually changed, not on every parent render.
        if (!ReferenceEquals(_rendered, Order)) Repartition();
    }

    protected override bool ShouldRender()
    {
        if (ReferenceEquals(_rendered, Order)) return false;
        _rendered = Order;
        return true;
    }

    private void Repartition()
    {
        var (drinks, starters, mains, desserts) = OrderPresentation.Partition(Order.Items);

        _drinks = drinks;
        _drinkGroups = OrderPresentation.GroupByServeBatch(drinks);
        _hasPendingDrinks = drinks.Any(d => d.Status != OrderItemStatus.Delivered);

        _starters = starters;
        _starterGroups = OrderPresentation.GroupByServeBatch(starters);
        _firstsPendingToServe = starters.Any(s => s.Status == OrderItemStatus.Ready);
        // No standalone "Serve firsts" button once the order also has mains: "Serve seconds"
        // already serves the firsts alongside them, so a separate button would be redundant.
        // Starter-only orders (no mains) still need it as their only way to mark firsts served.
        _showServeFirsts = mains.Count == 0 && starters.Any(s => s.Status is OrderItemStatus.Ready or OrderItemStatus.Delivered);

        _mains = mains;
        _mainGroups = OrderPresentation.GroupByServeBatch(mains);
        _secondsPendingToServe = mains.Any(s => s.Status == OrderItemStatus.Ready);
        _showServeSeconds = mains.Any(s => s.Status is OrderItemStatus.Ready or OrderItemStatus.Delivered);
        _hasSeconds = mains.Count > 0;

        _desserts = desserts;
        _dessertGroups = OrderPresentation.GroupByServeBatch(desserts);
        _dessertsPendingToServe = desserts.Any(s => s.Status == OrderItemStatus.Ready);
        _showServeDesserts = desserts.Any(s => s.Status is OrderItemStatus.Ready or OrderItemStatus.Delivered);
    }

    private static List<OrderPresentation.TimeGroup> GroupByOrderTime(List<OrderItemDto> items) =>
        OrderPresentation.GroupByOrderTime(items);

    // Label + timestamp for a fired course, e.g. "Firsts fired · 14:32"; the plain active label
    // (e.g. "Fire firsts") while it hasn't been fired yet.
    private string CourseLabel(string activeKey, string firedKey, DateTime? firedAt) =>
        firedAt is null ? Loc.T(activeKey) : $"{Loc.T(firedKey)} · {firedAt.Value.ToLocalTime():HH:mm}";

    private string DrinksLabel() => OrderPresentation.DrinksLabel(_hasPendingDrinks, Order.DrinksServedAt);

    private string FirstsServeLabel() =>
        OrderPresentation.CourseServeLabel(_firstsPendingToServe, _starters, "Serve firsts", "Firsts served");

    private string SecondsServeLabel() =>
        OrderPresentation.SecondsServeLabel(_secondsPendingToServe, _mains, Order.SecondsSentAt);

    private string DessertsServeLabel() =>
        OrderPresentation.CourseServeLabel(_dessertsPendingToServe, _desserts, "Serve desserts", "Desserts served");

    // Clicking the grouped drinks button toggles: serve every pending drink, or — once they're
    // all served — undo and put them all back to pending.
    private Task OnToggleDrinksClick() => _hasPendingDrinks
        ? OnServeDrinks.InvokeAsync(Order.Id)
        : OnUnserveDrinks.InvokeAsync(Order.Id);
    private Task OnUnserveDrinkClick(int itemId) => OnUnserveDrink.InvokeAsync(itemId);

    // The badge now represents a whole serve batch, not a single line: undo puts every
    // drink in that batch back to pending, same as clicking each one's undo used to.
    private async Task OnUnserveBatchClick(OrderPresentation.ServeBatch group)
    {
        foreach (var it in group.Items) await OnUnserveDrink.InvokeAsync(it.Id);
    }

    // Same toggle/badge pattern as drinks: serve every ready first course, or — once they're
    // all served — undo and put them all back to ready.
    private Task OnToggleServeFirstsClick() => _firstsPendingToServe
        ? OnServeFirsts.InvokeAsync(Order.Id)
        : OnUnserveFirsts.InvokeAsync(Order.Id);
    private async Task OnUnserveFirstBatchClick(OrderPresentation.ServeBatch group)
    {
        foreach (var it in group.Items) await OnUnserveFirstItem.InvokeAsync(it.Id);
    }

    // Same toggle/badge pattern as firsts: serve every ready second course, or — once they're
    // all served — undo and put them all back to ready.
    private Task OnToggleServeSecondsClick() => _secondsPendingToServe
        ? OnServeSeconds.InvokeAsync(Order.Id)
        : OnUnserveSeconds.InvokeAsync(Order.Id);
    private async Task OnUnserveSecondBatchClick(OrderPresentation.ServeBatch group)
    {
        foreach (var it in group.Items) await OnUnserveSecondItem.InvokeAsync(it.Id);
    }

    // Same toggle/badge pattern as firsts: serve every ready dessert, or — once they're
    // all served — undo and put them all back to ready.
    private Task OnToggleServeDessertsClick() => _dessertsPendingToServe
        ? OnServeDesserts.InvokeAsync(Order.Id)
        : OnUnserveDesserts.InvokeAsync(Order.Id);
    private async Task OnUnserveDessertBatchClick(OrderPresentation.ServeBatch group)
    {
        foreach (var it in group.Items) await OnUnserveDessertItem.InvokeAsync(it.Id);
    }
    // Same toggle pattern as the drinks button: click to fire, click again to undo.
    private Task OnToggleSecondsClick() => Order.SecondsFiredAt is null
        ? OnFireSeconds.InvokeAsync(Order.Id)
        : OnUnfireSeconds.InvokeAsync(Order.Id);
    private Task OnEditClick() => OnEdit.InvokeAsync(Order.Id);
    private Task OnPayClick() => OnPay.InvokeAsync(Order.Id);

    private static string StatusClass(OrderStatus s) => s switch
    {
        OrderStatus.Ready => "badge--success",
        OrderStatus.InPreparation => "badge--warning",
        OrderStatus.Sent => "badge--primary",
        _ => ""
    };
}
