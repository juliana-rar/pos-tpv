@page "/products"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using FluentValidation
@inject IProductService Service
@inject ICategoryService CategoryService
@inject IAllergenService AllergenService
@inject IExtraService ExtraService
@inject IValidator<ProductFormDto> Validator
@inject IValidator<CategoryFormDto> CategoryValidator
@inject IValidator<AllergenFormDto> AllergenValidator
@inject IValidator<ExtraFormDto> ExtraValidator
@inject AppSettingsCache Branding

<PageTitle>Products · @Branding.Current.Title</PageTitle>

<PageHero Title="@Loc.T("Products")">
    <LeftContent>
        <button type="button" class="btn btn--icon @(_reorderMode ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Drag to reorder")" @onclick="ToggleReorderMode"><LucideIcon Name="hand" Size="10" /></button>
    </LeftContent>
</PageHero>

<div class="catalog" @onclick="ClearExpandedCatRows">
    @* ---- Left column: section switcher + categories -------------------------- *@
    <div class="catalog__col">
    <nav class="catalog__sections" role="tablist" @onclick:stopPropagation="true">
        <button class="catalog__section @(_viewingAllergens ? "catalog__section--on" : "")" @onclick="SelectAllergensView"><LucideIcon Name="triangle-alert" Size="14" /> @Loc.T("Allergens")</button>
        <button class="catalog__section @(_viewingExtras ? "catalog__section--on" : "")" @onclick="SelectExtrasView"><LucideIcon Name="tag" Size="14" /> @Loc.T("Extras")</button>
    </nav>
    <section class="catalog__cats surface" @onclick:stopPropagation="true">
        <div class="catalog__cats-head">
            <h2 class="catalog__eyebrow">@Loc.T("Categories")</h2>
            <button class="btn btn--icon btn--neutral btn--sm" title="@Loc.T("New category")" @onclick="() => OpenCategoryForm(null)"><LucideIcon Name="plus" Size="14" /></button>
        </div>

        @if (_notice is not null)
        {
            <div class="catalog__notice" @onclick="() => _notice = null">@_notice <LucideIcon Name="x" Size="14" /></div>
        }

        <div class="catalog__cats-list">
            @foreach (var (c, i) in _categories.Select((c, i) => (c, i)))
            {
                <div class="catRow" data-active="@(c.Id == _selectedId ? "true" : null)"
                     data-reorder="@(_reorderMode ? "true" : null)" data-dragging="@(_draggedCategoryId == c.Id ? "true" : null)"
                     @onclick="() => ClickCategory(c.Id)">
                    <div class="catRow__thumb">
                        @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                        {
                            <img src="@c.ImageUrl" alt="" />
                        }
                        else
                        {
                            <span>@c.Icon</span>
                        }
                    </div>
                    <div class="catRow__main">
                        <span class="catRow__name">@c.Name</span>
                    </div>
                    <div class="catRow__actions" @onclick:stopPropagation="true">
                        @if (_expandedCatRows.Contains(c.Id))
                        {
                            <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Move up")"
                                    disabled="@(i == 0)" @onclick="() => MoveCategory(c.Id, -1)"><LucideIcon Name="chevron-up" Size="16" /></button>
                            <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Move down")"
                                    disabled="@(i == _categories.Count - 1)" @onclick="() => MoveCategory(c.Id, 1)"><LucideIcon Name="chevron-down" Size="16" /></button>
                            <button class="btn btn--icon btn--ghost btn--sm" title="@(c.IsVisible ? Loc.T("Hide") : Loc.T("Show"))"
                                    @onclick="() => ToggleCategoryVisibility(c)"><LucideIcon Name="@(c.IsVisible ? "eye-off" : "eye")" Size="16" /></button>
                            <button class="btn btn--icon btn--danger btn--sm" title="@Loc.T("Delete")"
                                    @onclick="() => DeleteCategory(c)"><LucideIcon Name="trash-2" Size="16" /></button>
                        }
                        <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Edit")"
                                @onclick="() => ToggleCatRow(c.Id)"><LucideIcon Name="pencil" Size="16" /></button>
                    </div>
                </div>
            }
            @if (_categories.Count == 0) { <p class="empty">@Loc.T("No categories yet.")</p> }
        </div>
    </section>
    </div>

    @* ---- Right panel: products of the selected category ---------------------- *@
    <section class="catalog__products">
        @if (_viewingAllergens || _viewingExtras || _selected is not null)
        {
            <div class="catalog__toolbar">
                @if (_viewingAllergens)
                {
                    <div class="toolbar__filters">
                        <button type="button" class="btn btn--icon @(_toolbarFiltersOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Filters")" @onclick="() => _toolbarFiltersOpen = !_toolbarFiltersOpen"><LucideIcon Name="sliders-horizontal" Size="13" /></button>
                        @if (_toolbarFiltersOpen)
                        {
                            <div class="toolbar__filters-backdrop" @onclick="() => _toolbarFiltersOpen = false"></div>
                            <div class="toolbar__filters-menu" @onclick:stopPropagation="true">
                                <button type="button" class="extra-dd__opt @(_toolbarSort == ToolbarSort.Manual ? "extra-dd__opt--on" : "")" @onclick="() => SetToolbarSort(ToolbarSort.Manual)">
                                    <span class="extra-dd__check">@(_toolbarSort == ToolbarSort.Manual ? "✓" : "")</span>
                                    <span class="extra-dd__name">@Loc.T("Manual order")</span>
                                </button>
                                <button type="button" class="extra-dd__opt @(_toolbarSort == ToolbarSort.NameAsc ? "extra-dd__opt--on" : "")" @onclick="() => SetToolbarSort(ToolbarSort.NameAsc)">
                                    <span class="extra-dd__check">@(_toolbarSort == ToolbarSort.NameAsc ? "✓" : "")</span>
                                    <span class="extra-dd__name">@Loc.T("Alphabetical (A–Z)")</span>
                                </button>
                                <button type="button" class="extra-dd__opt @(_toolbarSort == ToolbarSort.CreatedDesc ? "extra-dd__opt--on" : "")" @onclick="() => SetToolbarSort(ToolbarSort.CreatedDesc)">
                                    <span class="extra-dd__check">@(_toolbarSort == ToolbarSort.CreatedDesc ? "✓" : "")</span>
                                    <span class="extra-dd__name">@Loc.T("Newest first")</span>
                                </button>
                            </div>
                        }
                    </div>
                    <div class="toolbar__search">
                        <LucideIcon Name="search" Size="13" />
                        <input class="input search" placeholder="@Loc.T("Search…")" @bind="_allergenSearch" @bind:event="oninput" />
                    </div>
                    <button class="btn btn--icon btn--primary btn--sm" title="@Loc.T("New allergen")" @onclick="() => OpenAllergenForm(null)"><LucideIcon Name="plus" Size="14" /></button>
                }
                else if (_viewingExtras)
                {
                    <div class="toolbar__filters">
                        <button type="button" class="btn btn--icon @(_toolbarFiltersOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Filters")" @onclick="() => _toolbarFiltersOpen = !_toolbarFiltersOpen"><LucideIcon Name="sliders-horizontal" Size="13" /></button>
                        @if (_toolbarFiltersOpen)
                        {
                            <div class="toolbar__filters-backdrop" @onclick="() => _toolbarFiltersOpen = false"></div>
                            <div class="toolbar__filters-menu" @onclick:stopPropagation="true">
                                <button type="button" class="extra-dd__opt @(_toolbarSort == ToolbarSort.Manual ? "extra-dd__opt--on" : "")" @onclick="() => SetToolbarSort(ToolbarSort.Manual)">
                                    <span class="extra-dd__check">@(_toolbarSort == ToolbarSort.Manual ? "✓" : "")</span>
                                    <span class="extra-dd__name">@Loc.T("Manual order")</span>
                                </button>
                                <button type="button" class="extra-dd__opt @(_toolbarSort == ToolbarSort.NameAsc ? "extra-dd__opt--on" : "")" @onclick="() => SetToolbarSort(ToolbarSort.NameAsc)">
                                    <span class="extra-dd__check">@(_toolbarSort == ToolbarSort.NameAsc ? "✓" : "")</span>
                                    <span class="extra-dd__name">@Loc.T("Alphabetical (A–Z)")</span>
                                </button>
                                <button type="button" class="extra-dd__opt @(_toolbarSort == ToolbarSort.CreatedDesc ? "extra-dd__opt--on" : "")" @onclick="() => SetToolbarSort(ToolbarSort.CreatedDesc)">
                                    <span class="extra-dd__check">@(_toolbarSort == ToolbarSort.CreatedDesc ? "✓" : "")</span>
                                    <span class="extra-dd__name">@Loc.T("Newest first")</span>
                                </button>
                            </div>
                        }
                    </div>
                    <div class="toolbar__search">
                        <LucideIcon Name="search" Size="13" />
                        <input class="input search" placeholder="@Loc.T("Search…")" @bind="_extraSearch" @bind:event="oninput" />
                    </div>
                    <button class="btn btn--icon btn--neutral btn--sm" title="@Loc.T("New extra")" @onclick="() => OpenExtraForm(null)"><LucideIcon Name="plus" Size="14" /></button>
                }
                else if (_selected is not null)
                {
                    <div class="toolbar__filters">
                        <button type="button" class="btn btn--icon @(_toolbarFiltersOpen || HasActiveProductFilters ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Filters")" @onclick="ToggleToolbarFilters"><LucideIcon Name="sliders-horizontal" Size="13" /></button>
                        @if (_toolbarFiltersOpen)
                        {
                            <div class="toolbar__filters-backdrop" @onclick="CloseToolbarFilters"></div>
                            <div class="toolbar__filters-menu" @onclick:stopPropagation="true">
                                <button type="button" class="extra-dd__opt @(_toolbarSort == ToolbarSort.Manual ? "extra-dd__opt--on" : "")" @onclick="() => SetToolbarSort(ToolbarSort.Manual)">
                                    <span class="extra-dd__check">@(_toolbarSort == ToolbarSort.Manual ? "✓" : "")</span>
                                    <span class="extra-dd__name">@Loc.T("Manual order")</span>
                                </button>
                                <button type="button" class="extra-dd__opt @(_toolbarSort == ToolbarSort.NameAsc ? "extra-dd__opt--on" : "")" @onclick="() => SetToolbarSort(ToolbarSort.NameAsc)">
                                    <span class="extra-dd__check">@(_toolbarSort == ToolbarSort.NameAsc ? "✓" : "")</span>
                                    <span class="extra-dd__name">@Loc.T("Alphabetical (A–Z)")</span>
                                </button>
                                <button type="button" class="extra-dd__opt @(_toolbarSort == ToolbarSort.CreatedDesc ? "extra-dd__opt--on" : "")" @onclick="() => SetToolbarSort(ToolbarSort.CreatedDesc)">
                                    <span class="extra-dd__check">@(_toolbarSort == ToolbarSort.CreatedDesc ? "✓" : "")</span>
                                    <span class="extra-dd__name">@Loc.T("Newest first")</span>
                                </button>
                                @if (_allergens.Count > 0)
                                {
                                    <div class="toolbar__filters-divider"></div>
                                    <span class="toolbar__filters-label">@Loc.T("Allergens")</span>
                                    <div class="extra-dd toolbar__filters-dd">
                                        <button type="button" class="input extra-dd__trigger" @onclick="() => _filterAllergenDropdownOpen = !_filterAllergenDropdownOpen">
                                            <span class="extra-dd__summary">@FilterAllergenSummary()</span>
                                            <LucideIcon Name="chevron-down" Size="14" />
                                        </button>
                                        @if (_filterAllergenDropdownOpen)
                                        {
                                            <div class="extra-dd__backdrop" @onclick="() => _filterAllergenDropdownOpen = false"></div>
                                            <div class="extra-dd__menu" @onclick:stopPropagation="true">
                                                @foreach (var a in _allergens)
                                                {
                                                    <button type="button" class="extra-dd__opt @(_filterAllergenIds.Contains(a.Id) ? "extra-dd__opt--on" : "")" @onclick="() => ToggleFilterAllergen(a.Id)">
                                                        <span class="extra-dd__check">@(_filterAllergenIds.Contains(a.Id) ? "✓" : "")</span>
                                                        <span class="extra-dd__name">@a.Name</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (_extras.Count > 0)
                                {
                                    <div class="toolbar__filters-divider"></div>
                                    <span class="toolbar__filters-label">@Loc.T("Extras")</span>
                                    <div class="extra-dd toolbar__filters-dd">
                                        <button type="button" class="input extra-dd__trigger" @onclick="() => _filterExtraDropdownOpen = !_filterExtraDropdownOpen">
                                            <span class="extra-dd__summary">@FilterExtraSummary()</span>
                                            <LucideIcon Name="chevron-down" Size="14" />
                                        </button>
                                        @if (_filterExtraDropdownOpen)
                                        {
                                            <div class="extra-dd__backdrop" @onclick="() => _filterExtraDropdownOpen = false"></div>
                                            <div class="extra-dd__menu" @onclick:stopPropagation="true">
                                                @foreach (var e in _extras)
                                                {
                                                    <button type="button" class="extra-dd__opt @(_filterExtraIds.Contains(e.Id) ? "extra-dd__opt--on" : "")" @onclick="() => ToggleFilterExtra(e.Id)">
                                                        <span class="extra-dd__check">@(_filterExtraIds.Contains(e.Id) ? "✓" : "")</span>
                                                        <span class="extra-dd__name">@e.Name</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (HasActiveProductFilters)
                                {
                                    <div class="toolbar__filters-divider"></div>
                                    <button type="button" class="extra-dd__opt toolbar__filters-clear" @onclick="ClearProductFilters">
                                        <LucideIcon Name="x" Size="12" /> <span class="extra-dd__name">@Loc.T("Clear filters")</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="toolbar__search">
                        <LucideIcon Name="search" Size="13" />
                        <input class="input search" placeholder="@Loc.T("Search…")" @bind="_search" @bind:event="oninput" />
                    </div>
                    <button class="btn btn--icon btn--neutral btn--sm" title="@Loc.T("New product")" @onclick="() => OpenProductForm(null)"><LucideIcon Name="plus" Size="14" /></button>
                }
            </div>
        }
        @if (_viewingAllergens)
        {
            <div class="allergenManager">
                <div class="allergenManager__list">
                    @foreach (var a in FilteredAllergens)
                    {
                        <div class="allergenRow">
                            <div class="allergenRow__thumb">
                                @if (!string.IsNullOrWhiteSpace(a.ImageUrl))
                                {
                                    <img src="@a.ImageUrl" alt="" />
                                }
                                else
                                {
                                    <LucideIcon Name="triangle-alert" Size="18" />
                                }
                            </div>
                            <div class="allergenRow__main">
                                <span class="allergenRow__name">@a.Name</span>
                                @if (!string.IsNullOrWhiteSpace(a.Description))
                                {
                                    <span class="allergenRow__desc muted">@a.Description</span>
                                }
                            </div>
                            <div class="allergenRow__actions">
                                <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Edit")" @onclick="() => OpenAllergenForm(a.Id)"><LucideIcon Name="pencil" Size="16" /></button>
                                <button class="btn btn--icon btn--danger btn--sm" title="@Loc.T("Delete")" @onclick="() => DeleteAllergen(a.Id)"><LucideIcon Name="trash-2" Size="16" /></button>
                            </div>
                        </div>
                    }
                    @if (_allergens.Count == 0) { <p class="empty">@Loc.T("No allergens yet.")</p> }
                    else if (FilteredAllergens.Count == 0) { <p class="empty">@Loc.T("No allergens found.")</p> }
                </div>
            </div>
        }
        else if (_viewingExtras)
        {
            <div class="extraManager">
                <div class="extraManager__list">
                    @foreach (var e in FilteredExtras)
                    {
                        <div class="extraRow">
                            <div class="extraRow__thumb">
                                @if (!string.IsNullOrWhiteSpace(e.ImageUrl))
                                {
                                    <img src="@e.ImageUrl" alt="" />
                                }
                                else
                                {
                                    <LucideIcon Name="tag" Size="14" />
                                }
                            </div>
                            <span class="extraRow__name">@e.Name</span>
                            <span class="extraRow__leader"></span>
                            <span class="extraRow__price">+@e.Price.ToString("N2")</span>
                            <div class="extraRow__actions">
                                <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Edit")" @onclick="() => OpenExtraForm(e.Id)"><LucideIcon Name="pencil" Size="14" /></button>
                                <button class="btn btn--icon btn--danger btn--sm" title="@Loc.T("Delete")" @onclick="() => DeleteExtra(e.Id)"><LucideIcon Name="trash-2" Size="14" /></button>
                            </div>
                        </div>
                    }
                    @if (FilteredExtras.Count == 0) { <p class="empty">@Loc.T("No extras yet.")</p> }
                </div>
            </div>
        }
        else if (_selected is null)
        {
            <p class="empty">@Loc.T("Select a category to manage its products.")</p>
        }
        else
        {
            <div class="grid-cards">
                @foreach (var p in Filtered)
                {
                    <div class="card mgmt-card" data-off="@(!p.IsAvailable ? "true" : null)"
                         data-reorder="@(_reorderMode && CanDragProducts ? "true" : null)" data-dragging="@(_draggedProductId == p.Id ? "true" : null)"
                         style="--prod:@p.Color" @onclick="() => ClickProduct(p.Id)">
                        <div class="mgmt-card__head">
                            @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                            {
                                <div class="mgmt-card__thumb"><img src="@p.ImageUrl" alt="" /></div>
                            }
                            else
                            {
                                <div class="mgmt-card__thumb mgmt-card__thumb--empty"><span></span></div>
                            }
                            <strong>@p.Name</strong>
                            @if (!p.IsVisible) { <span class="badge badge--danger">@Loc.T("hidden")</span> }
                            <span class="spacer"></span>
                            <span class="mgmt-card__price">@p.Price.ToString("N2")</span>
                        </div>
                        @* Always rendered (even with zero allergens) so every card reserves the same
                           slot for this row instead of shrinking by one row's height whenever a
                           product happens to have no allergens — that's what kept cards uneven. *@
                        <div class="mgmt-card__allergens">
                            @foreach (var a in p.Allergens)
                            {
                                <span class="allergen-tag" title="@a.Name">
                                    @if (!string.IsNullOrWhiteSpace(a.ImageUrl))
                                    {
                                        <img src="@a.ImageUrl" alt="" />
                                    }
                                    else
                                    {
                                        <LucideIcon Name="triangle-alert" Size="10" />
                                    }
                                    @a.Name
                                </span>
                            }
                        </div>
                        @if (p.Extras.Count > 0)
                        {
                            <div class="mgmt-card__extras">
                                @foreach (var e in p.Extras)
                                {
                                    <span class="extra-tag" title="@e.Name">@e.Name</span>
                                }
                            </div>
                        }
                    </div>
                }
                @if (Filtered.Count == 0) { <p class="empty">@Loc.T("No products found.")</p> }
            </div>
        }
    </section>
</div>

@* ---- Product form modal -------------------------------------------------- *@
<Modal Visible="_product is not null"
       OnClose="CloseProduct" Wide="true" CloseLeft="true">
    <HeaderActions>
        <button class="btn btn--icon btn--primary" title="@Loc.T("Save")" @onclick="SaveProduct" type="button"><LucideIcon Name="check" Size="18" /></button>
    </HeaderActions>
    <ChildContent>
        @if (_product is not null)
        {
            <div class="product-form" style="--prod:@_product.Color">
                <div class="pform-toolbar">
                    <span class="pform-toolbar__eyebrow">@(_product.Id > 0 ? Loc.T("Edit product") : Loc.T("New product"))</span>
                    @if (_product.Id > 0)
                    {
                        var idx = Filtered.FindIndex(x => x.Id == _product.Id);
                        var forMove = Filtered.FirstOrDefault(x => x.Id == _product.Id);
                        <div class="pform-toolbar__actions">
                            <button class="btn btn--icon btn--ghost" title="@Loc.T("Move up")" type="button"
                                    disabled="@(!string.IsNullOrWhiteSpace(_search) || _toolbarSort != ToolbarSort.Manual || idx <= 0)" @onclick="() => MoveProduct(_product.Id, -1)"><LucideIcon Name="chevron-up" Size="14" /></button>
                            <button class="btn btn--icon btn--ghost" title="@Loc.T("Move down")" type="button"
                                    disabled="@(!string.IsNullOrWhiteSpace(_search) || _toolbarSort != ToolbarSort.Manual || idx < 0 || idx == Filtered.Count - 1)" @onclick="() => MoveProduct(_product.Id, 1)"><LucideIcon Name="chevron-down" Size="14" /></button>
                            <button class="btn btn--icon btn--ghost" title="@Loc.T("Duplicate")" type="button" @onclick="() => Duplicate(_product.Id)"><LucideIcon Name="copy" Size="14" /></button>
                            @if (forMove is not null)
                            {
                                <button class="btn btn--icon btn--ghost" title="@Loc.T("Move to category")" type="button" @onclick="() => OpenMove(forMove)"><LucideIcon Name="arrow-right-left" Size="14" /></button>
                            }
                        </div>
                    }
                    <div class="pform-toolbar__switches">
                        <label class="switch" title="@Loc.T("Visible")"><input type="checkbox" @bind="_product.IsVisible" /><span>@Loc.T("Visible")</span></label>
                        <label class="switch" title="@Loc.T("Available")"><input type="checkbox" @bind="_product.IsAvailable" /><span>@Loc.T("Available")</span></label>
                    </div>
                </div>
                <div class="pform-hero">
                    <div class="pform-hero__media">
                        <ImageUpload Value="@_product.ImageUrl" ValueChanged="v => _product.ImageUrl = v" Folder="products" />
                    </div>
                    <div class="pform-hero__fields">
                        <input class="pform-hero__name" placeholder="@Loc.T("Name")" @bind="_product.Name" />
                        <div class="pform-hero__row">
                            <select class="select" @bind="_product.CategoryId">
                                <option value="0">@Loc.T("— select —")</option>
                                @foreach (var c in _categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            <label class="pform-hero__swatch" title="@Loc.T("Colour")">
                                <input type="color" @bind="_product.Color" />
                            </label>
                        </div>
                    </div>
                    <div class="pform-hero__price">
                        <span class="pform-hero__price-label">@Loc.T("Price")</span>
                        <div class="pform-hero__price-input">
                            <input type="number" step="0.01" @bind="_product.Price" />
                        </div>
                    </div>
                </div>

                <div class="pform-stats">
                    <div class="pform-stat"><label>@Loc.T("VAT %")</label><input type="number" step="0.5" class="input" @bind="_product.VatRate" /></div>
                    <div class="pform-stat"><label>@Loc.T("Prep. minutes")</label><input type="number" class="input" @bind="_product.PreparationMinutes" /></div>
                    <div class="pform-stat"><label>@Loc.T("Display order")</label><input type="number" class="input" @bind="_product.DisplayOrder" /></div>
                </div>

                <div class="pform-section">
                    <label>@Loc.T("Description")</label>
                    <textarea class="input" rows="2" @bind="_product.Description"></textarea>
                </div>

                <div class="pform-section-row">
                <div class="pform-section">
                    <label>@Loc.T("Allergens")</label>
                    @if (_allergens.Count > 0)
                    {
                        <div class="extra-dd">
                            <button type="button" class="input extra-dd__trigger" @onclick="() => _allergenDropdownOpen = !_allergenDropdownOpen">
                                <span class="extra-dd__summary">@AllergenSummary()</span>
                                <LucideIcon Name="chevron-down" Size="14" />
                            </button>
                            @if (_allergenDropdownOpen)
                            {
                                <div class="extra-dd__backdrop" @onclick="() => _allergenDropdownOpen = false"></div>
                                <div class="extra-dd__menu" @onclick:stopPropagation="true">
                                    @foreach (var a in _allergens)
                                    {
                                        <button type="button" class="extra-dd__opt @(_product.AllergenIds.Contains(a.Id) ? "extra-dd__opt--on" : "")"
                                                @onclick="() => ToggleProductAllergen(a.Id)">
                                            <span class="extra-dd__check">@(_product.AllergenIds.Contains(a.Id) ? "✓" : "")</span>
                                            <span class="extra-dd__name">@a.Name</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="muted">@Loc.T("No allergens defined yet.") <button type="button" class="btn btn--ghost btn--sm" @onclick="GoToAllergens">@Loc.T("Add one")</button></p>
                    }
                </div>

                <div class="pform-section">
                    <label>@Loc.T("Extras")</label>
                    @if (_extras.Count > 0)
                    {
                        <div class="extra-dd">
                            <button type="button" class="input extra-dd__trigger" @onclick="() => _extraDropdownOpen = !_extraDropdownOpen">
                                <span class="extra-dd__summary">@ExtraSummary()</span>
                                <LucideIcon Name="chevron-down" Size="14" />
                            </button>
                            @if (_extraDropdownOpen)
                            {
                                <div class="extra-dd__backdrop" @onclick="() => _extraDropdownOpen = false"></div>
                                <div class="extra-dd__menu" @onclick:stopPropagation="true">
                                    @foreach (var e in _extras)
                                    {
                                        <button type="button" class="extra-dd__opt @(_product.ExtraIds.Contains(e.Id) ? "extra-dd__opt--on" : "")"
                                                @onclick="() => ToggleProductExtra(e.Id)">
                                            <span class="extra-dd__check">@(_product.ExtraIds.Contains(e.Id) ? "✓" : "")</span>
                                            <span class="extra-dd__name">@e.Name</span>
                                            <span class="extra-dd__price">+@e.Price.ToString("N2")</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="muted">@Loc.T("No extras defined yet.") <button type="button" class="btn btn--ghost btn--sm" @onclick="GoToExtras">@Loc.T("Add one")</button></p>
                    }
                </div>
                </div>

                @if (_productError is not null) { <div class="field-error">@_productError</div> }
            </div>
        }
    </ChildContent>
</Modal>

@* ---- Category form modal (same .product-form chrome/layout as the product modal above) --- *@
<Modal Visible="_category is not null"
       OnClose="CloseCategory" Wide="true" CloseLeft="true">
    <HeaderActions>
        <button class="btn btn--icon btn--primary" title="@Loc.T("Save")" @onclick="SaveCategory" type="button"><LucideIcon Name="check" Size="18" /></button>
    </HeaderActions>
    <ChildContent>
        @if (_category is not null)
        {
            <div class="product-form" style="--prod:@_category.Color">
                <div class="pform-toolbar">
                    <span class="pform-toolbar__eyebrow">@(_category.Id > 0 ? Loc.T("Edit category") : Loc.T("New category"))</span>
                    <div class="pform-toolbar__switches">
                        <label class="switch" title="@Loc.T("Visible")"><input type="checkbox" @bind="_category.IsVisible" /><span>@Loc.T("Visible")</span></label>
                    </div>
                </div>
                <div class="pform-hero">
                    <div class="pform-hero__media">
                        <ImageUpload Value="@_category.ImageUrl" ValueChanged="v => _category.ImageUrl = v" Folder="categories" />
                    </div>
                    <div class="pform-hero__fields">
                        <input class="pform-hero__name" placeholder="@Loc.T("Name")" @bind="_category.Name" />
                        <div class="pform-hero__row">
                            <select class="select" @bind="_category.Kind">
                                <option value="@CategoryKind.Food">@Loc.T("Food")</option>
                                <option value="@CategoryKind.Drink">@Loc.T("Drinks")</option>
                            </select>
                            <label class="pform-hero__swatch" title="@Loc.T("Colour")">
                                <input type="color" @bind="_category.Color" />
                            </label>
                        </div>
                    </div>
                </div>

                <div class="pform-stats">
                    <div class="pform-stat"><label>@Loc.T("Icon (emoji)")</label><input class="input" @bind="_category.Icon" /></div>
                    @if (_category.Kind == CategoryKind.Food)
                    {
                        <div class="pform-stat">
                            <label>@Loc.T("Course")</label>
                            <select class="input" @bind="_category.Course">
                                @foreach (var course in Enum.GetValues<CourseType>())
                                {
                                    <option value="@course">@Loc.T(CourseLabel(course))</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="pform-stat"><label>@Loc.T("Display order")</label><input type="number" class="input" @bind="_category.DisplayOrder" /></div>
                </div>

                @if (_categoryError is not null) { <div class="field-error">@_categoryError</div> }
            </div>
        }
    </ChildContent>
</Modal>

@* ---- Change-category modal ----------------------------------------------- *@
<Modal Visible="_moving is not null" Title="@Loc.T("Move to category")" OnClose="() => _moving = null">
    <ChildContent>
        @if (_moving is not null)
        {
            <div class="field">
                <label>@Loc.T("Category")</label>
