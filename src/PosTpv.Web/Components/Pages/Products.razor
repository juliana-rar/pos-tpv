@* ---- Allergen create/edit form (nested over the inline Allergens section) --------- *@
<Modal Visible="_allergen is not null" Title="@(_allergen?.Id > 0 ? Loc.T("Edit allergen") : Loc.T("New allergen"))" OnClose="CloseAllergenForm">
    <ChildContent>
        @if (_allergen is not null)
        {
