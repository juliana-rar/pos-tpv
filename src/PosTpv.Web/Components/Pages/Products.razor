@* ---- Extra create/edit form (same .product-form chrome/layout as the product/category modals) --------- *@
<Modal Visible="_extra is not null"
       OnClose="CloseExtraForm" Wide="true" CloseLeft="true">
    <HeaderActions>
        <button class="btn btn--icon btn--primary" title="@Loc.T("Save")" @onclick="SaveExtra" type="button"><LucideIcon Name="check" Size="18" /></button>
    </HeaderActions>
    <ChildContent>
        @if (_extra is not null)
        {
            <div class="product-form">
                <div class="pform-toolbar">
                    <span class="pform-toolbar__eyebrow">@(_extra.Id > 0 ? Loc.T("Edit extra") : Loc.T("New extra"))</span>
                </div>
                <div class="pform-hero">
                    <div class="pform-hero__media">
                        <ImageUpload Value="@_extra.ImageUrl" ValueChanged="v => _extra.ImageUrl = v" Folder="extras" />
                    </div>
                    <div class="pform-hero__fields">
                        <input class="pform-hero__name" placeholder="@Loc.T("Name")" @bind="_extra.Name" />
                    </div>
                    <div class="pform-hero__price">
                        <span class="pform-hero__price-label">@Loc.T("Price")</span>
                        <div class="pform-hero__price-input">
                            <input type="number" step="0.01" @bind="_extra.Price" />
                        </div>
                    </div>
                </div>

                <div class="pform-section">
                    <label>@Loc.T("Categories")</label>
                    @if (_categories.Count > 0)
                    {
                        <div class="allergen-pick">
                            @foreach (var c in _categories)
                            {
                                <button type="button" class="allergen-chip @(_extra.CategoryIds.Contains(c.Id) ? "allergen-chip--on" : "")"
                                        @onclick="() => ToggleExtraCategory(c.Id)">
                                    @c.Name
                                </button>
                            }
                        </div>
                        <p class="muted">@Loc.T("Applies to every product in the selected categories — add exceptions below to opt specific products out.")</p>
                    }
                    else
                    {
                        <p class="muted">@Loc.T("No categories yet.")</p>
                    }
                </div>
                @if (_extra.CategoryIds.Count > 0)
                {
                    <div class="pform-section">
                        <label>@Loc.T("Exceptions")</label>
                        <input class="input" placeholder="@Loc.T("Search…")" @bind="_extraExceptionSearch" @bind:event="oninput" />
                        <div class="product-pick">
                            @foreach (var grp in FilteredExtraExceptionProducts.GroupBy(p => p.CategoryName))
                            {
                                <div class="product-pick__group">
                                    <span class="product-pick__group-label">@grp.Key</span>
                                    <div class="product-pick__chips">
                                        @foreach (var p in grp)
                                        {
                                            <button type="button" class="product-chip product-chip--exception @(_extra.ExcludedProductIds.Contains(p.Id) ? "product-chip--on" : "")"
                                                    @onclick="() => ToggleExtraException(p.Id)">
                                                @p.Name
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            @if (FilteredExtraExceptionProducts.Count == 0)
                            {
                                <p class="empty">@Loc.T("No products found.")</p>
                            }
                        </div>
                        <p class="muted">@Loc.T("Checked products do NOT get this extra, even though their category is selected above.")</p>
                    </div>
                }
                <div class="pform-section">
                    <label>@Loc.T("Individual products")</label>
                    @if (_allProducts.Count > 0)
                    {
                        <input class="input" placeholder="@Loc.T("Search…")" @bind="_extraProductSearch" @bind:event="oninput" />
                        <div class="product-pick">
                            @foreach (var grp in FilteredExtraProducts.GroupBy(p => p.CategoryName))
                            {
                                <div class="product-pick__group">
                                    <span class="product-pick__group-label">@grp.Key</span>
                                    <div class="product-pick__chips">
                                        @foreach (var p in grp)
                                        {
                                            <button type="button" class="product-chip @(_extra.ProductIds.Contains(p.Id) ? "product-chip--on" : "")"
                                                    @onclick="() => ToggleExtraProduct(p.Id)">
                                                @p.Name
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            @if (FilteredExtraProducts.Count == 0)
                            {
                                <p class="empty">@Loc.T("No products found.")</p>
                            }
                        </div>
                        <p class="muted">@Loc.T("Ad-hoc products, on top of any category assignment above.")</p>
                    }
                    else
                    {
                        <p class="muted">@Loc.T("No products yet.")</p>
                    }
                </div>

                @if (_extraError is not null) { <div class="field-error">@_extraError</div> }
            </div>
        }
    </ChildContent>
</Modal>

@code {
    private List<CategoryDto> _categories = new();
    private List<ProductDto> _products = new();
    private int? _selectedId;
    private string _search = "";
    private bool _toolbarFiltersOpen;
    private ToolbarSort _toolbarSort = ToolbarSort.Manual;
    private readonly HashSet<int> _filterAllergenIds = new();
    private readonly HashSet<int> _filterExtraIds = new();
    private bool _filterAllergenDropdownOpen;
    private bool _filterExtraDropdownOpen;

    private enum ToolbarSort { Manual, NameAsc, CreatedDesc }

    private bool _reorderMode;
    private int? _draggedCategoryId;
    private int? _draggedProductId;

    /// <summary>Also clears any pending pick — otherwise turning reorder mode off mid-pick and
    /// back on later would leave a stale "armed" item that silently jumps to wherever the next
    /// tap lands.</summary>
    private void ToggleReorderMode()
    {
        _reorderMode = !_reorderMode;
        _draggedCategoryId = null;
        _draggedProductId = null;
    }

    /// <summary>Reordering swaps neighbours step by step against the service's own DisplayOrder,
    /// so it only makes sense against the unsorted, unfiltered list — same constraint as the
    /// existing move-up/down buttons.</summary>
    private bool CanDragProducts => _toolbarSort == ToolbarSort.Manual && string.IsNullOrWhiteSpace(_search);

    /// <summary>Reorder mode repurposes a plain click into a tap-to-pick-up / tap-to-drop pair
    /// (first tap on a category marks it, a second tap on another one moves it there) instead of
    /// a press-and-drag gesture — simpler to hit reliably on the tablets this page also runs on,
    /// and it doesn't depend on the browser's native HTML5 drag session at all.</summary>
    private async Task ClickCategory(int id)
    {
        if (!_reorderMode) { await Select(id); return; }
        if (_draggedCategoryId == id) { _draggedCategoryId = null; return; }
        if (_draggedCategoryId is null) { _draggedCategoryId = id; return; }
        await DropCategory(id);
    }

    private async Task ClickProduct(int id)
    {
        if (!_reorderMode || !CanDragProducts) { OpenProductForm(id); return; }
        if (_draggedProductId == id) { _draggedProductId = null; return; }
        if (_draggedProductId is null) { _draggedProductId = id; return; }
        await DropProduct(id);
    }

    private async Task DropCategory(int targetId)
    {
        var dragId = _draggedCategoryId;
        _draggedCategoryId = null;
        if (dragId is null || dragId == targetId) return;

        var from = _categories.FindIndex(c => c.Id == dragId);
        var to = _categories.FindIndex(c => c.Id == targetId);
        if (from < 0 || to < 0) return;

        var direction = to > from ? 1 : -1;
        for (var i = 0; i < Math.Abs(to - from); i++)
            await CategoryService.MoveAsync(dragId.Value, direction);
        await LoadCategories();
    }

    private async Task DropProduct(int targetId)
    {
        var dragId = _draggedProductId;
        _draggedProductId = null;
        if (dragId is null || dragId == targetId || !CanDragProducts) return;

        var from = _products.FindIndex(p => p.Id == dragId);
        var to = _products.FindIndex(p => p.Id == targetId);
        if (from < 0 || to < 0) return;

        var direction = to > from ? 1 : -1;
        for (var i = 0; i < Math.Abs(to - from); i++)
            await Service.MoveAsync(dragId.Value, direction);
        await LoadProducts();
    }

    private void SetToolbarSort(ToolbarSort sort)
    {
        _toolbarSort = sort;
        CloseToolbarFilters();
    }

    private void ToggleToolbarFilters()
    {
        if (_toolbarFiltersOpen) CloseToolbarFilters();
        else _toolbarFiltersOpen = true;
    }

    /// <summary>Also collapses the nested allergen/extra dropdowns — otherwise closing and
    /// reopening the filters menu could leave one stuck open from a previous visit.</summary>
    private void CloseToolbarFilters()
    {
        _toolbarFiltersOpen = false;
        _filterAllergenDropdownOpen = false;
        _filterExtraDropdownOpen = false;
    }

    /// <summary>Manual keeps the caller's own order (category/display-order from the service);
    /// the other modes re-sort on top of whatever search filter was already applied.</summary>
    private List<T> ApplyToolbarSort<T>(IEnumerable<T> items, Func<T, string> byName, Func<T, DateTime> byCreated) => _toolbarSort switch
    {
        ToolbarSort.NameAsc => items.OrderBy(byName, StringComparer.OrdinalIgnoreCase).ToList(),
        ToolbarSort.CreatedDesc => items.OrderByDescending(byCreated).ToList(),
        _ => items.ToList(),
    };

    private ProductFormDto? _product;
    private string? _productError;
    private bool _extraDropdownOpen;
    private bool _allergenDropdownOpen;

    private CategoryFormDto? _category;
    private string? _categoryError;

    private ProductDto? _moving;
    private int _moveTargetId;

    private string? _notice;

    private List<AllergenDto> _allergens = new();
    private bool _viewingAllergens;
    private AllergenFormDto? _allergen;
    private string? _allergenError;
    private string _allergenSearch = "";

    private List<ExtraDto> _extras = new();
    private bool _viewingExtras;
    private ExtraFormDto? _extra;
    private string? _extraError;
    private string _extraSearch = "";
    private List<ProductDto> _allProducts = new();
    private string _extraProductSearch = "";
    private string _extraExceptionSearch = "";

    private CategoryDto? _selected => _categories.FirstOrDefault(c => c.Id == _selectedId);

    private List<AllergenDto> FilteredAllergens => ApplyToolbarSort(string.IsNullOrWhiteSpace(_allergenSearch)
        ? _allergens
        : _allergens.Where(a => a.Name.Contains(_allergenSearch, StringComparison.OrdinalIgnoreCase)),
        a => a.Name, a => a.CreatedAt);

    private List<ExtraDto> FilteredExtras => ApplyToolbarSort(string.IsNullOrWhiteSpace(_extraSearch)
        ? _extras
        : _extras.Where(e => e.Name.Contains(_extraSearch, StringComparison.OrdinalIgnoreCase)),
        e => e.Name, e => e.CreatedAt);

    private List<ProductDto> FilteredExtraProducts =>
        _allProducts
            .Where(p => string.IsNullOrWhiteSpace(_extraProductSearch) || p.Name.Contains(_extraProductSearch, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<ProductDto> FilteredExtraExceptionProducts =>
        _extra is null
            ? new List<ProductDto>()
            : _allProducts
                .Where(p => _extra.CategoryIds.Contains(p.CategoryId))
                .Where(p => string.IsNullOrWhiteSpace(_extraExceptionSearch) || p.Name.Contains(_extraExceptionSearch, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private bool HasActiveProductFilters => _filterAllergenIds.Count > 0 || _filterExtraIds.Count > 0;

    private void ToggleFilterAllergen(int allergenId)
    {
        if (!_filterAllergenIds.Remove(allergenId)) _filterAllergenIds.Add(allergenId);
    }

    private void ToggleFilterExtra(int extraId)
    {
        if (!_filterExtraIds.Remove(extraId)) _filterExtraIds.Add(extraId);
    }

    private void ClearProductFilters()
    {
        _filterAllergenIds.Clear();
        _filterExtraIds.Clear();
    }

    private string FilterAllergenSummary()
    {
        if (_filterAllergenIds.Count == 0) return Loc.T("All");
        var names = _allergens.Where(a => _filterAllergenIds.Contains(a.Id)).Select(a => a.Name).ToList();
        return names.Count <= 2 ? string.Join(", ", names) : $"{names.Count} {Loc.T("selected")}";
    }

    private string FilterExtraSummary()
    {
        if (_filterExtraIds.Count == 0) return Loc.T("All");
        var names = _extras.Where(e => _filterExtraIds.Contains(e.Id)).Select(e => e.Name).ToList();
        return names.Count <= 2 ? string.Join(", ", names) : $"{names.Count} {Loc.T("selected")}";
    }

    private List<ProductDto> Filtered => ApplyToolbarSort(_products
        .Where(p => string.IsNullOrWhiteSpace(_search) || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(p => _filterAllergenIds.Count == 0 || p.Allergens.Any(a => _filterAllergenIds.Contains(a.Id)))
        .Where(p => _filterExtraIds.Count == 0 || p.Extras.Any(e => _filterExtraIds.Contains(e.Id))),
        p => p.Name, p => p.CreatedAt);

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        _selectedId = _categories.FirstOrDefault()?.Id;
        await LoadProducts();
        await LoadAllergens();
        await LoadExtras();
    }

    private async Task LoadCategories() => _categories = await CategoryService.GetAllAsync();
    private async Task LoadAllergens() => _allergens = await AllergenService.GetAllAsync();
    private async Task LoadExtras() => _extras = await ExtraService.GetAllAsync();

    private async Task LoadProducts() =>
        _products = _selectedId is int id
            ? await Service.GetByCategoryAsync(id, includeHidden: true)
            : new();

    private async Task Select(int id)
    {
        _viewingAllergens = false;
        _viewingExtras = false;
        if (_selectedId == id) return;
        _selectedId = id;
        _search = "";
        _notice = null;
        await LoadProducts();
    }

    // ---- Categories -------------------------------------------------------
    private readonly HashSet<int> _expandedCatRows = new();

    private void ClearExpandedCatRows() => _expandedCatRows.Clear();

    private void ToggleCatRow(int id)
    {
        if (_expandedCatRows.Contains(id))
        {
            _expandedCatRows.Remove(id);
            OpenCategoryForm(id);
        }
        else
        {
            _expandedCatRows.Add(id);
        }
    }

    private void OpenCategoryForm(int? id) => _ = OpenCategoryFormAsync(id);

    private async Task OpenCategoryFormAsync(int? id)
    {
        _categoryError = null;
        _notice = null;
        _category = id is null
            ? new CategoryFormDto { DisplayOrder = _categories.Count }
            : await CategoryService.GetForEditAsync(id.Value) ?? new CategoryFormDto();
    }

    private void CloseCategory() => _category = null;

    // Localisation key for a course, shared with the /orders block headers.
    private static string CourseLabel(CourseType course) => course switch
    {
        CourseType.Starter => "First course",
        CourseType.Dessert => "Desserts",
        _ => "Second course"
    };

    private async Task SaveCategory()
    {
        if (_category is null) return;
        var result = await CategoryValidator.ValidateAsync(_category);
        if (!result.IsValid) { _categoryError = result.Errors[0].ErrorMessage; return; }

        int savedId;
        if (_category.Id > 0) { await CategoryService.UpdateAsync(_category); savedId = _category.Id; }
        else savedId = await CategoryService.CreateAsync(_category);

        _category = null;
        await LoadCategories();
        _selectedId ??= savedId;
        await LoadProducts();
    }

    private async Task ToggleCategoryVisibility(CategoryDto c)
    {
        await CategoryService.SetVisibilityAsync(c.Id, !c.IsVisible);
        await LoadCategories();
    }

    private async Task MoveCategory(int id, int direction)
    {
        await CategoryService.MoveAsync(id, direction);
        await LoadCategories();
    }

    private async Task DeleteCategory(CategoryDto c)
    {
        try
        {
            await CategoryService.DeleteAsync(c.Id);
        }
        catch (InvalidOperationException)
        {
            _notice = Loc.T("Cannot delete a category that still has products.");
            return;
        }

        if (_selectedId == c.Id) _selectedId = null;
        await LoadCategories();
        _selectedId ??= _categories.FirstOrDefault()?.Id;
        await LoadProducts();
    }

    // ---- Products ---------------------------------------------------------
    private void OpenProductForm(int? id) => _ = OpenProductFormAsync(id);

    private async Task OpenProductFormAsync(int? id)
    {
        _productError = null;
        _extraDropdownOpen = false;
        _allergenDropdownOpen = false;
        _product = id is null
            ? new ProductFormDto { CategoryId = _selectedId ?? 0 }
            : await Service.GetForEditAsync(id.Value) ?? new ProductFormDto();
    }

    private void CloseProduct() => _product = null;

    private string ExtraSummary()
    {
        if (_product is null || _product.ExtraIds.Count == 0) return Loc.T("— select —");
        var names = _extras.Where(e => _product.ExtraIds.Contains(e.Id)).Select(e => e.Name).ToList();
        return names.Count <= 2 ? string.Join(", ", names) : $"{names.Count} {Loc.T("selected")}";
    }

    private string AllergenSummary()
    {
        if (_product is null || _product.AllergenIds.Count == 0) return Loc.T("— select —");
        var names = _allergens.Where(a => _product.AllergenIds.Contains(a.Id)).Select(a => a.Name).ToList();
        return names.Count <= 2 ? string.Join(", ", names) : $"{names.Count} {Loc.T("selected")}";
    }

    private async Task SaveProduct()
    {
        if (_product is null) return;
        var result = await Validator.ValidateAsync(_product);
        if (!result.IsValid) { _productError = result.Errors[0].ErrorMessage; return; }

        if (_product.Id > 0) await Service.UpdateAsync(_product);
        else await Service.CreateAsync(_product);

        _product = null;
        await LoadCategories(); // product counts may have changed
        await LoadProducts();
    }

    private async Task ToggleAvailable(ProductDto p, bool value)
    {
        await Service.SetAvailabilityAsync(p.Id, value);
        await LoadProducts();
    }

    private async Task MoveProduct(int id, int direction)
    {
        await Service.MoveAsync(id, direction);
        await LoadProducts();
    }

    private async Task Duplicate(int id)
    {
        await Service.DuplicateAsync(id);
        await LoadCategories();
        await LoadProducts();
    }

    private void OpenMove(ProductDto p)
    {
        _moving = p;
        _moveTargetId = p.CategoryId;
    }

    private async Task ConfirmMove()
    {
        if (_moving is null) return;
        await Service.SetCategoryAsync(_moving.Id, _moveTargetId);
        _moving = null;
        await LoadCategories();
        await LoadProducts();
    }

    private async Task DeleteProduct(int id)
    {
        await Service.DeleteAsync(id);
        await LoadCategories();
        await LoadProducts();
    }

    // ---- Allergens ----------------------------------------------------------
    private void SelectAllergensView() { _viewingAllergens = true; _viewingExtras = false; _selectedId = null; _allergenSearch = ""; }

    /// <summary>Same as <see cref="SelectAllergensView"/>, but also closes the product form —
    /// for the "Add one" link inside it, which needs to leave that modal to reach the section.</summary>
    private void GoToAllergens()
    {
        _product = null;
        SelectAllergensView();
    }

    private void ToggleProductAllergen(int allergenId)
    {
        if (_product is null) return;
        if (!_product.AllergenIds.Remove(allergenId)) _product.AllergenIds.Add(allergenId);
    }

    private void OpenAllergenForm(int? id) => _ = OpenAllergenFormAsync(id);

    private async Task OpenAllergenFormAsync(int? id)
    {
        _allergenError = null;
        _allergen = id is null
            ? new AllergenFormDto()
            : await AllergenService.GetForEditAsync(id.Value) ?? new AllergenFormDto();
    }

    private void CloseAllergenForm() => _allergen = null;

    private async Task SaveAllergen()
    {
        if (_allergen is null) return;
        var result = await AllergenValidator.ValidateAsync(_allergen);
        if (!result.IsValid) { _allergenError = result.Errors[0].ErrorMessage; return; }

        if (_allergen.Id > 0) await AllergenService.UpdateAsync(_allergen);
        else await AllergenService.CreateAsync(_allergen);

        _allergen = null;
        await LoadAllergens();
        await LoadProducts(); // product cards show allergen tags, keep them in sync
    }

    private async Task DeleteAllergen(int id)
    {
        await AllergenService.DeleteAsync(id);
        await LoadAllergens();
        await LoadProducts();
    }

    // ---- Extras ---------------------------------------------------------------
    private void SelectExtrasView() { _viewingExtras = true; _viewingAllergens = false; _selectedId = null; _extraSearch = ""; }

    /// <summary>Same as <see cref="SelectExtrasView"/>, but also closes the product form —
    /// for the "Add one" link inside it, which needs to leave that modal to reach the section.</summary>
    private void GoToExtras()
    {
        _product = null;
        SelectExtrasView();
    }

    private void ToggleProductExtra(int extraId)
    {
        if (_product is null) return;
        if (!_product.ExtraIds.Remove(extraId)) _product.ExtraIds.Add(extraId);
    }

    private void ToggleExtraProduct(int productId)
    {
        if (_extra is null) return;
        if (!_extra.ProductIds.Remove(productId)) _extra.ProductIds.Add(productId);
    }

    private void ToggleExtraCategory(int categoryId)
    {
        if (_extra is null) return;
        if (!_extra.CategoryIds.Remove(categoryId)) _extra.CategoryIds.Add(categoryId);
    }

    private void ToggleExtraException(int productId)
    {
        if (_extra is null) return;
        if (!_extra.ExcludedProductIds.Remove(productId)) _extra.ExcludedProductIds.Add(productId);
    }

    private void OpenExtraForm(int? id) => _ = OpenExtraFormAsync(id);

    private async Task OpenExtraFormAsync(int? id)
    {
        _extraError = null;
        _extraProductSearch = "";
        _extraExceptionSearch = "";
        _allProducts = await Service.GetAllAsync();
        _extra = id is null
            ? new ExtraFormDto()
            : await ExtraService.GetForEditAsync(id.Value) ?? new ExtraFormDto();
    }

    private void CloseExtraForm() => _extra = null;

    private async Task SaveExtra()
    {
        if (_extra is null) return;
        var result = await ExtraValidator.ValidateAsync(_extra);
        if (!result.IsValid) { _extraError = result.Errors[0].ErrorMessage; return; }

        if (_extra.Id > 0) await ExtraService.UpdateAsync(_extra);
        else await ExtraService.CreateAsync(_extra);

        _extra = null;
        await LoadExtras();
        await LoadProducts(); // product cards show extra tags, keep them in sync
    }

    private async Task DeleteExtra(int id)
    {
        await ExtraService.DeleteAsync(id);
        await LoadExtras();
        await LoadProducts();
    }
}
