@page "/suppliers"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@implements IAsyncDisposable
@using FluentValidation
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.SignalR.Client
@using PosTpv.Domain.Enums
@using PosTpv.Web.Hubs
@using PosTpv.Web.Services
@inject ISupplierService SupplierService
@inject IPurchaseService PurchaseService
@inject IStockService StockService
@inject IProductService ProductService
@inject IAlbaranScanService AlbaranScanService
@inject AlbaranScanBackgroundRunner ScanRunner
@inject IValidator<SupplierFormDto> SupplierValidator
@inject IValidator<PurchaseFormDto> PurchaseValidator
@inject IValidator<StockAdjustFormDto> StockValidator
@inject IValidator<AlbaranScanEditDto> AlbaranScanValidator
@inject IWebHostEnvironment Env
@inject NavigationManager Nav
@inject AppSettingsCache Branding

<PageTitle>@Loc.T("Suppliers") · @Branding.Current.Title</PageTitle>

<PageHero Icon="truck" Title="@Loc.T("Suppliers")">
    <div class="page-hero__row">
        <span></span>
        <div class="tabs" role="tablist">
            <button class="tabs__opt @(_tab == "suppliers" ? "tabs__opt--on" : "")" @onclick='() => _tab = "suppliers"'><LucideIcon Name="truck" Size="16" /> @Loc.T("Suppliers")</button>
            <button class="tabs__opt @(_tab == "purchases" ? "tabs__opt--on" : "")" @onclick='SelectPurchases'><LucideIcon Name="receipt" Size="16" /> @Loc.T("Purchases")</button>
            <button class="tabs__opt @(_tab == "stock" ? "tabs__opt--on" : "")" @onclick='SelectStock'><LucideIcon Name="clipboard-list" Size="16" /> @Loc.T("Stock")</button>
            <button class="tabs__opt @(_tab == "estadisticas" ? "tabs__opt--on" : "")" @onclick='SelectEstadisticas'><LucideIcon Name="bar-chart-3" Size="16" /> @Loc.T("Statistics")</button>
        </div>
        <div class="page-hero__actions">
            @if (_tab == "suppliers")
            {
                <button class="btn btn--icon btn--neutral btn--sm" title="@Loc.T("New supplier")" @onclick="() => OpenSupplierForm(null)"><LucideIcon Name="plus" Size="14" /></button>
            }
            else if (_tab == "purchases")
            {
                <div class="toolbar__search toolbar__search--sm">
                    <LucideIcon Name="search" Size="13" />
                    <input class="input search" placeholder="@Loc.T("Search…")" @bind="_purchasesSearch" @bind:event="oninput" />
                </div>
                <div class="albaran-scan-menu">
                    <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Scan delivery note")" @onclick="ToggleAlbaranUploadMenu"><LucideIcon Name="camera" Size="14" /></button>
                    @if (_albaranUploadMenuOpen)
                    {
                        <div class="albaran-scan-menu__backdrop" @onclick="CloseAlbaranUploadMenu"></div>
                        <div class="albaran-scan-menu__panel" @onclick:stopPropagation="true">
                            <label class="albaran-scan-menu__item docpick">
                                <LucideIcon Name="camera" Size="16" /> @Loc.T("Take photo")
                                <InputFile OnChange="OnAlbaranPhotoSelected" class="docpick__input" accept="image/*" capture="environment" />
                            </label>
                            <label class="albaran-scan-menu__item docpick">
                                <LucideIcon Name="upload" Size="16" /> @Loc.T("Choose file")
                                <InputFile OnChange="OnAlbaranPhotoSelected" class="docpick__input" accept="image/*" />
                            </label>
                            <p class="muted albaran-scan-menu__hint">@Loc.T("On mobile, \"Choose file\" also lets you pick from Google Drive, Photos or other apps installed on the device.")</p>
                            @if (_albaranUploadError is not null) { <div class="field-error">@_albaranUploadError</div> }
                        </div>
                    }
                </div>
                <button class="btn btn--icon btn--neutral btn--sm" title="@Loc.T("New purchase")" @onclick="OpenPurchaseForm" disabled="@(_suppliers.Count == 0)"><LucideIcon Name="plus" Size="14" /></button>
            }
            else if (_tab == "stock")
            {
                <div class="toolbar__search toolbar__search--sm">
                    <LucideIcon Name="search" Size="13" />
                    <input class="input search" placeholder="@Loc.T("Search…")" @bind="_stockSearch" @bind:event="oninput" />
                </div>
                <div class="sup-dd">
                    <button type="button" class="btn btn--icon btn--neutral btn--sm" title="@Loc.T("Export")" @onclick="() => _stockExportDropdownOpen = !_stockExportDropdownOpen">
                        <LucideIcon Name="download" Size="14" />
                    </button>
                    @if (_stockExportDropdownOpen)
                    {
                        <div class="sup-dd__backdrop" @onclick="() => _stockExportDropdownOpen = false"></div>
                        <div class="sup-dd__menu sup-dd__menu--r">
                            <a class="sup-dd__opt" href="/export/stock?format=csv" target="_blank" rel="noopener" @onclick="() => _stockExportDropdownOpen = false">CSV</a>
                            <a class="sup-dd__opt" href="/export/stock?format=xlsx" target="_blank" rel="noopener" @onclick="() => _stockExportDropdownOpen = false">Excel</a>
                            <a class="sup-dd__opt" href="/export/stock?format=pdf" target="_blank" rel="noopener" @onclick="() => _stockExportDropdownOpen = false">PDF</a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</PageHero>

@if (_tab == "suppliers")
{
    @if (_listError is not null) { <div class="field-error">@_listError</div> }
    <div class="grid-cards">
        @foreach (var s in _suppliers)
        {
            <div class="card mgmt-card sup-card" data-status="@(s.IsActive ? "active" : "inactive")">
                <div class="sup-card__head">
                    <div class="sup-card__avatar">@Initials(s.Name)</div>
                    <div class="sup-card__title">
                        <strong title="@s.Name">@s.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(s.ContactName)) { <span class="muted">@s.ContactName</span> }
                    </div>
                    <span class="sup-card__dot" title="@(s.IsActive ? Loc.T("Active") : Loc.T("Inactive"))"></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(s.Phone) || !string.IsNullOrWhiteSpace(s.Email))
                {
                    <div class="sup-card__contact">
                        @if (!string.IsNullOrWhiteSpace(s.Phone)) { <span><LucideIcon Name="phone" Size="12" /> @s.Phone</span> }
                        @if (!string.IsNullOrWhiteSpace(s.Email)) { <span><LucideIcon Name="mail" Size="12" /> @s.Email</span> }
                    </div>
                }
                <div class="sup-card__stats">
                    <div><strong>@s.DocumentCount</strong><span>@Loc.T("documents")</span></div>
                    <div><strong>@s.PurchaseCount</strong><span>@Loc.T("purchases")</span></div>
                </div>
                <div class="mgmt-card__actions">
                    <span class="spacer"></span>
                    <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Edit")" @onclick="() => OpenSupplierForm(s.Id)"><LucideIcon Name="pencil" Size="13" /></button>
                    <button class="btn btn--icon btn--danger btn--sm" title="@Loc.T("Delete")" @onclick="() => DeleteSupplier(s.Id)"><LucideIcon Name="trash-2" Size="13" /></button>
                </div>
            </div>
        }
        @if (_suppliers.Count == 0) { <p class="empty">@Loc.T("No suppliers yet.")</p> }
    </div>
}
else if (_tab == "purchases")
{
    <div class="toolbar">
      <div class="filter-bar">
        <label class="muted">@Loc.T("From")</label>
        <div class="date-filter">
            <button type="button" class="input date-filter__btn" style="max-width:150px" @onclick="() => _purchaseFromPickerOpen = !_purchaseFromPickerOpen">@(_purchaseDateFrom?.ToString("dd/MM/yyyy") ?? Loc.T("Any"))</button>
            @if (_purchaseFromPickerOpen)
            {
                <div class="resv-date__backdrop" @onclick="() => _purchaseFromPickerOpen = false"></div>
                <div class="resv-date__menu" @onclick:stopPropagation="true">
                    <Calendar Value="_purchaseDateFrom ?? DateTime.Today" ValueChanged="PickPurchaseFrom" />
                </div>
            }
        </div>
        <label class="muted">@Loc.T("To")</label>
        <div class="date-filter">
            <button type="button" class="input date-filter__btn" style="max-width:150px" @onclick="() => _purchaseToPickerOpen = !_purchaseToPickerOpen">@(_purchaseDateTo?.ToString("dd/MM/yyyy") ?? Loc.T("Any"))</button>
            @if (_purchaseToPickerOpen)
            {
                <div class="resv-date__backdrop" @onclick="() => _purchaseToPickerOpen = false"></div>
                <div class="resv-date__menu" @onclick:stopPropagation="true">
                    <Calendar Value="_purchaseDateTo ?? DateTime.Today" ValueChanged="PickPurchaseTo" />
                </div>
            }
        </div>
        @if (_purchaseDateFrom is not null || _purchaseDateTo is not null)
        {
            <button class="btn btn--ghost btn--sm" @onclick="ClearPurchaseDates"><LucideIcon Name="x" Size="13" /> @Loc.T("Clear filters")</button>
        }
        <span class="spacer"></span>
      </div>
    </div>

    @if (_albaranDetail is not null && _albaranEditForm is not null)
    {
        <div class="card albaran-editor">
            <div class="row-2 sup-albaran-detail">
                <div class="sup-albaran-image">
                    <img src="@_albaranDetail.ImageUrl" alt="@Loc.T("Delivery note")" />
                    @if (_albaranDetail.Status == AlbaranScanStatus.Processing)
                    {
                        <p class="muted"><LucideIcon Name="clock" Size="14" /> @Loc.T("Processing… this can take a few minutes.")</p>
                    }
                    @if (_albaranDetail.Status == AlbaranScanStatus.Failed)
                    {
                        <div class="field-error">@_albaranDetail.ErrorMessage</div>
                    }
                </div>
                <div>
                    <div class="albaran-editor__head">
                        <h2>@Loc.T("Delivery note")</h2>
                        <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Close")" @onclick="CloseAlbaranDetail"><LucideIcon Name="x" Size="16" /></button>
                    </div>
                    <div class="row-2">
                        <div class="field">
                            <label>@Loc.T("Supplier")</label>
                            <select class="select" @bind="_albaranEditForm.SupplierId">
                                <option value="0">@Loc.T("Select…")</option>
                                @foreach (var s in _suppliers)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label>@Loc.T("Date")</label>
                            <input type="date" class="input" value="@(_albaranEditForm.AlbaranDate?.ToString("yyyy-MM-dd"))" @onchange="OnAlbaranDateChanged" />
                        </div>
                    </div>
                    <div class="field"><label>@Loc.T("Number")</label><input class="input" @bind="_albaranEditForm.AlbaranNumber" /></div>

                    <div class="modal-section">@Loc.T("Lines")</div>
                    @foreach (var (line, i) in _albaranEditForm.Lines.Select((l, i) => (l, i)))
                    {
                        <div class="row-2 sup-albaran-line">
                            <div class="field"><label>@Loc.T("Description")</label><input class="input" @bind="line.Description" /></div>
                            <div class="field"><label>@Loc.T("Qty")</label><input type="number" min="0" step="0.01" class="input" @bind="line.Quantity" /></div>
                            <div class="field"><label>@Loc.T("Unit price")</label><input type="number" min="0" step="0.01" class="input" @bind="line.UnitPrice" /></div>
                            <div class="field">
                                <label>@Loc.T("Product")</label>
                                <select class="select" @bind="line.ProductId">
                                    <option value="0">@Loc.T("Select…")</option>
                                    @foreach (var p in _products)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                            </div>
                            <button class="btn btn--icon btn--danger btn--sm" title="@Loc.T("Remove")" @onclick="() => _albaranEditForm.Lines.RemoveAt(i)"><LucideIcon Name="trash-2" Size="15" /></button>
                        </div>
                    }
                    <button class="btn btn--ghost btn--sm" @onclick="() => _albaranEditForm.Lines.Add(new AlbaranScanLineEditDto())"><LucideIcon Name="plus" Size="14" /> @Loc.T("Add line")</button>

                    <p class="ta-r" style="margin-top:.8rem"><strong>@Loc.T("Total"): @_albaranEditForm.Lines.Sum(l => l.Quantity * l.UnitPrice).ToString("N2")</strong></p>
                    @if (_albaranDetailError is not null) { <div class="field-error">@_albaranDetailError</div> }

                    <div class="albaran-editor__actions">
                        @if (_albaranDetail.Status == AlbaranScanStatus.Failed)
                        {
                            <button class="btn btn--ghost" @onclick="RetryAlbaran"><LucideIcon Name="rotate-cw" Size="14" /> @Loc.T("Retry")</button>
                        }
                        @if (_albaranDetail.Status is AlbaranScanStatus.NeedsReview or AlbaranScanStatus.Failed)
                        {
                            <button class="btn btn--ghost" @onclick="SaveAlbaranDraft">@Loc.T("Save draft")</button>
                            <button class="btn btn--primary" @onclick="ValidateAlbaran"
                                    disabled="@(!CanValidateAlbaran)" title="@(CanValidateAlbaran ? "" : Loc.T("Select a supplier and a product for every line."))">
                                @Loc.T("Validate and create purchase")
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (PendingAlbaranScans.Count > 0)
    {
        <div class="modal-section">@Loc.T("Pending delivery notes")</div>
        <div class="grid-cards sup-pending-scans">
            @foreach (var scan in PendingAlbaranScans)
            {
                <div class="card mgmt-card albaran-card" data-status="@StatusAttr(scan.Status)">
                    <div class="albaran-card__thumb">
                        <img src="@scan.ImageUrl" alt="" loading="lazy" />
                        <span class="badge @StatusBadgeClass(scan.Status) albaran-card__badge"><LucideIcon Name="@StatusIcon(scan.Status)" Size="12" /> @StatusLabel(scan.Status)</span>
                    </div>
                    <strong class="albaran-card__supplier">@(scan.SupplierName ?? scan.SupplierNameRaw ?? Loc.T("Unknown"))</strong>
                    <span class="muted albaran-card__meta">
                        @(scan.AlbaranDate?.ToString("dd MMM yyyy") ?? scan.CreatedAt.ToString("dd MMM yyyy"))
                        @if (!string.IsNullOrWhiteSpace(scan.AlbaranNumber)) { <text> · @scan.AlbaranNumber</text> }
                    </span>
                    <div class="mgmt-card__actions">
                        <strong class="albaran-card__total">@(scan.TotalAmount?.ToString("N2") ?? "—")</strong>
                        <span class="spacer"></span>
                        <button class="btn btn--ghost btn--sm" @onclick="() => OpenAlbaranDetail(scan.Id)"><LucideIcon Name="eye" Size="13" /> @Loc.T("View")</button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="card" style="padding:1rem 1.2rem">
        @if (FilteredPurchases.Count == 0)
        {
            <p class="empty">@Loc.T("No purchases recorded yet.")</p>
        }
        else
        {
            <table class="table sup-purchases">
                <thead>
                    <tr><th>@Loc.T("Date")</th><th>@Loc.T("Supplier")</th><th>@Loc.T("Reference")</th><th>@Loc.T("Delivery note")</th><th class="ta-r">@Loc.T("Lines")</th><th class="ta-r">@Loc.T("Total")</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in FilteredPurchases)
                    {
                        <tr>
                            <td>@p.Date.ToString("dd MMM yyyy")</td>
                            <td>@p.SupplierName</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(p.Reference)) { <span class="muted">—</span> }
                                else { <span class="badge">@p.Reference</span> }
                            </td>
                            <td>
                                @if (p.AlbaranImageUrl is not null)
                                {
                                    <a class="sup-purchases__scan-thumb" href="@p.AlbaranImageUrl" target="_blank" rel="noopener"
                                       title="@(p.AlbaranDate?.ToString("dd MMM yyyy") ?? "")">
                                        <img src="@p.AlbaranImageUrl" alt="" loading="lazy" />
                                    </a>
                                }
                                else { <span class="muted">—</span> }
                            </td>
                            <td class="ta-r">@p.Lines.Count</td>
                            <td class="ta-r"><strong>@p.Total.ToString("N2")</strong></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="ta-r">@Loc.T("Total")</td>
                        <td class="ta-r"><strong>@FilteredPurchases.Sum(p => p.Total).ToString("N2")</strong></td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
}
else if (_tab == "stock")
{
    <div class="toolbar">
      <div class="filter-bar">
        <div class="sup-dd">
            <button type="button" class="sup-dd__trigger" @onclick="() => _stockCategoryDropdownOpen = !_stockCategoryDropdownOpen">
                <span>@(_stockCategoryFilter == 0 ? Loc.T("All categories") : StockCategories.First(c => c.Id == _stockCategoryFilter).Name)</span>
                <LucideIcon Name="chevron-down" Size="13" />
            </button>
            @if (_stockCategoryDropdownOpen)
            {
                <div class="sup-dd__backdrop" @onclick="() => _stockCategoryDropdownOpen = false"></div>
                <div class="sup-dd__menu">
                    <button type="button" class="sup-dd__opt @(_stockCategoryFilter == 0 ? "sup-dd__opt--on" : "")" @onclick="() => SelectStockCategory(0)">@Loc.T("All categories")</button>
                    @foreach (var c in StockCategories)
                    {
                        <button type="button" class="sup-dd__opt @(_stockCategoryFilter == c.Id ? "sup-dd__opt--on" : "")" @onclick="() => SelectStockCategory(c.Id)">@c.Name</button>
                    }
                </div>
            }
        </div>
        <label class="muted">@Loc.T("From")</label>
        <div class="date-filter">
            <button type="button" class="input date-filter__btn" style="max-width:150px" @onclick="() => _stockFromPickerOpen = !_stockFromPickerOpen">@(_stockDateFrom?.ToString("dd/MM/yyyy") ?? Loc.T("Any"))</button>
            @if (_stockFromPickerOpen)
            {
                <div class="resv-date__backdrop" @onclick="() => _stockFromPickerOpen = false"></div>
                <div class="resv-date__menu" @onclick:stopPropagation="true">
                    <Calendar Value="_stockDateFrom ?? DateTime.Today" ValueChanged="PickStockFrom" />
                </div>
            }
        </div>
        <label class="muted">@Loc.T("To")</label>
        <div class="date-filter">
            <button type="button" class="input date-filter__btn" style="max-width:150px" @onclick="() => _stockToPickerOpen = !_stockToPickerOpen">@(_stockDateTo?.ToString("dd/MM/yyyy") ?? Loc.T("Any"))</button>
            @if (_stockToPickerOpen)
            {
                <div class="resv-date__backdrop" @onclick="() => _stockToPickerOpen = false"></div>
                <div class="resv-date__menu" @onclick:stopPropagation="true">
                    <Calendar Value="_stockDateTo ?? DateTime.Today" ValueChanged="PickStockTo" />
                </div>
            }
        </div>
        @if (_stockDateFrom is not null || _stockDateTo is not null)
        {
            <button class="btn btn--ghost btn--sm" @onclick="ClearStockDates"><LucideIcon Name="x" Size="13" /> @Loc.T("Clear filters")</button>
        }
        <span class="spacer"></span>
      </div>
    </div>
    <div class="card" style="padding:1rem 1.2rem">
        @if (FilteredStock.Count == 0)
        {
            <p class="empty">@Loc.T("No products found.")</p>
        }
        else
        {
            <table class="table sup-stock">
                <thead>
                    <tr>
                        <th><button type="button" class="sup-stock__sort" @onclick='() => SortStockBy("product")'>@Loc.T("Product") @StockSortIconMarkup("product")</button></th>
                        <th><button type="button" class="sup-stock__sort" @onclick='() => SortStockBy("category")'>@Loc.T("Category") @StockSortIconMarkup("category")</button></th>
                        <th class="ta-r"><button type="button" class="sup-stock__sort sup-stock__sort--r" @onclick='() => SortStockBy("stock")'>@Loc.T("Stock") @StockSortIconMarkup("stock")</button></th>
                        <th class="ta-r"><button type="button" class="sup-stock__sort sup-stock__sort--r" @onclick='() => SortStockBy("value")'>@Loc.T("Value") @StockSortIconMarkup("value")</button></th>
                        <th><button type="button" class="sup-stock__sort" @onclick='() => SortStockBy("updated")'>@Loc.T("Last updated") @StockSortIconMarkup("updated")</button></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in FilteredStock)
                    {
                        @if (_stockForm is not null && _stockForm.ProductId == item.ProductId)
                        {
                            <tr class="sup-stock__row--edit" data-status="@(item.StockQuantity <= 0 ? "out" : "ok")">
                                <td><strong>@item.ProductName</strong></td>
                                <td><span class="badge">@item.CategoryName</span></td>
                                <td class="ta-r">
                                    <input type="number" min="0" step="0.01" class="input sup-stock__edit-input sup-stock__edit-input--r"
                                           @bind="_stockForm.NewQuantity" @bind:event="oninput" />
                                </td>
                                <td class="ta-r muted">@((_stockForm.NewQuantity * item.UnitPrice).ToString("N2"))</td>
                                <td>
                                    <input class="input sup-stock__edit-input" @bind="_stockForm.Note" placeholder="@Loc.T("e.g. inventory count")" />
                                </td>
                                <td class="ta-r sup-stock__edit-actions">
                                    <button class="btn btn--ghost btn--sm" @onclick="CloseStockForm" title="@Loc.T("Cancel")"><LucideIcon Name="x" Size="14" /></button>
                                    <button class="btn btn--primary btn--sm" @onclick="SaveStockAdjust" title="@Loc.T("Save")"><LucideIcon Name="check" Size="14" /></button>
                                </td>
                            </tr>
                            @if (_stockError is not null)
                            {
                                <tr class="sup-stock__row--error"><td colspan="6"><div class="field-error">@_stockError</div></td></tr>
                            }
                        }
                        else
                        {
                            <tr data-status="@(item.StockQuantity <= 0 ? "out" : "ok")">
                                <td><button type="button" class="sup-stock__product-link" title="@Loc.T("View movement history")" @onclick="() => FilterStockMovesByProduct(item.ProductId)">@item.ProductName</button></td>
                                <td><span class="badge">@item.CategoryName</span></td>
                                <td class="ta-r">
                                    <div class="sup-stock__qty">
                                        <span class="sup-stock__bar" style="--pct:@(StockPct(item))%"></span>
                                        <strong>@item.StockQuantity.ToString("N2")</strong>
                                        @if (item.StockQuantity <= 0) { <span class="badge badge--danger">@Loc.T("Out of stock")</span> }
                                    </div>
                                </td>
                                <td class="ta-r muted">@StockValue(item).ToString("N2")</td>
                                <td class="muted">@(item.LastUpdatedAt is null ? Loc.T("Never") : item.LastUpdatedAt.Value.ToString("dd MMM yyyy HH:mm"))</td>
                                <td class="ta-r"><button class="btn btn--ghost btn--sm" @onclick="() => OpenStockAdjust(item)"><LucideIcon Name="pencil" Size="13" /> @Loc.T("Adjust")</button></td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="ta-r">@Loc.T("Total")</td>
                        <td class="ta-r"><strong>@FilteredStock.Sum(StockValue).ToString("N2")</strong></td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>

    <div class="toolbar sup-stock-moves__head">
        <h2 class="sup-stock-moves__title"><LucideIcon Name="history" Size="17" /> @Loc.T("Movement history")</h2>
        @if (_stockMoveProductFilter is not null)
        {
            <button type="button" class="badge badge--primary sup-stock-moves__chip" @onclick="() => _stockMoveProductFilter = null">
                @_stockMoveProductName <LucideIcon Name="x" Size="12" />
            </button>
        }
        <span class="spacer"></span>
        <label class="muted">@Loc.T("From")</label>
        <div class="date-filter">
            <button type="button" class="input date-filter__btn" style="max-width:150px" @onclick="() => _stockMoveFromPickerOpen = !_stockMoveFromPickerOpen">@(_stockMoveDateFrom?.ToString("dd/MM/yyyy") ?? Loc.T("Any"))</button>
            @if (_stockMoveFromPickerOpen)
            {
                <div class="resv-date__backdrop" @onclick="() => _stockMoveFromPickerOpen = false"></div>
                <div class="resv-date__menu" @onclick:stopPropagation="true">
                    <Calendar Value="_stockMoveDateFrom ?? DateTime.Today" ValueChanged="PickStockMoveFrom" />
                </div>
            }
        </div>
        <label class="muted">@Loc.T("To")</label>
        <div class="date-filter">
            <button type="button" class="input date-filter__btn" style="max-width:150px" @onclick="() => _stockMoveToPickerOpen = !_stockMoveToPickerOpen">@(_stockMoveDateTo?.ToString("dd/MM/yyyy") ?? Loc.T("Any"))</button>
            @if (_stockMoveToPickerOpen)
            {
                <div class="resv-date__backdrop" @onclick="() => _stockMoveToPickerOpen = false"></div>
                <div class="resv-date__menu" @onclick:stopPropagation="true">
                    <Calendar Value="_stockMoveDateTo ?? DateTime.Today" ValueChanged="PickStockMoveTo" />
                </div>
            }
        </div>
        @if (_stockMoveDateFrom is not null || _stockMoveDateTo is not null || _stockMoveProductFilter is not null)
        {
            <button class="btn btn--ghost btn--sm" @onclick="ClearStockMoveDates"><LucideIcon Name="x" Size="13" /> @Loc.T("Clear filters")</button>
        }
    </div>
    <div class="card" style="padding:1rem 1.2rem">
        @if (FilteredStockMovements.Count == 0)
        {
            <p class="empty">@Loc.T("No stock movements found.")</p>
        }
        else
        {
            <table class="table sup-stock-moves">
                <thead>
                    <tr><th>@Loc.T("Date")</th><th>@Loc.T("Product")</th><th>@Loc.T("Category")</th><th>@Loc.T("Reason")</th><th class="ta-r">@Loc.T("Change")</th><th>@Loc.T("Note")</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in FilteredStockMovements)
                    {
                        <tr>
                            <td>@m.Date.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@m.ProductName</td>
                            <td><span class="badge">@m.CategoryName</span></td>
                            <td><span class="sup-stock-moves__reason" data-reason="@m.Reason.ToString().ToLowerInvariant()">@MovementReasonLabel(m.Reason)</span></td>
                            <td class="ta-r sup-stock-moves__qty" data-sign="@(m.QuantityChange >= 0 ? "pos" : "neg")">@(m.QuantityChange >= 0 ? "+" : "")@m.QuantityChange.ToString("N2")</td>
                            <td class="muted">@(string.IsNullOrWhiteSpace(m.Note) ? "—" : m.Note)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
else if (_tab == "estadisticas")
{
    <div class="dash__metrics sup-metrics">
        <div class="metric card"><span class="metric__label">@Loc.T("Products tracked")</span><span class="metric__value">@_stock.Count</span></div>
        <div class="metric card"><span class="metric__label">@Loc.T("Units in stock")</span><span class="metric__value">@_stock.Sum(s => s.StockQuantity).ToString("N0")</span></div>
        <div class="metric card" data-status="@(OutOfStockCount > 0 ? "alert" : "ok")"><span class="metric__label">@Loc.T("Out of stock")</span><span class="metric__value">@OutOfStockCount</span></div>
        <div class="metric card"><span class="metric__label">@Loc.T("Categories")</span><span class="metric__value">@StockCategories.Count</span></div>
        <div class="metric card"><span class="metric__label">@Loc.T("Inventory value")</span><span class="metric__value">@TotalStockValue.ToString("N2")</span></div>
    </div>

    @if (StockValueByCategory.Count > 1)
    {
        <div class="card sup-stock-cats">
            <h2 class="sup-stock-cats__title"><LucideIcon Name="bar-chart-3" Size="16" /> @Loc.T("Stock by category")</h2>
            <div class="sup-stock-cats__list">
                @foreach (var c in StockValueByCategory)
                {
                    <div class="sup-stock-cats__row">
                        <span class="sup-stock-cats__name">@c.Name</span>
                        <span class="sup-stock-cats__bar"><span style="--pct:@(c.Pct)%"></span></span>
                        <span class="sup-stock-cats__units">@c.Units.ToString("N0") @Loc.T("units")</span>
                        <span class="sup-stock-cats__value">@c.Value.ToString("N2")</span>
                        <span class="sup-stock-cats__pct">@c.Pct%</span>
                    </div>
                }
            </div>
        </div>
    }
}
@* ---- Supplier form + documents ------------------------------------------- *@
<Modal Visible="_supplierForm is not null" Title="@(_supplierForm?.Id > 0 ? Loc.T("Edit supplier") : Loc.T("New supplier"))" OnClose="CloseSupplierForm">
    <ChildContent>
        @if (_supplierForm is not null)
        {
            <div class="field"><label>@Loc.T("Name")</label><input class="input" @bind="_supplierForm.Name" /></div>
            <div class="row-2">
                <div class="field"><label>@Loc.T("Contact person")</label><input class="input" @bind="_supplierForm.ContactName" /></div>
                <div class="field"><label>@Loc.T("Phone")</label><input class="input" @bind="_supplierForm.Phone" /></div>
            </div>
            <div class="row-2">
                <div class="field"><label>@Loc.T("Email")</label><input class="input" @bind="_supplierForm.Email" /></div>
                <div class="field"><label>@Loc.T("Tax ID")</label><input class="input" @bind="_supplierForm.TaxId" /></div>
            </div>
            <div class="field"><label>@Loc.T("Address")</label><input class="input" @bind="_supplierForm.Address" /></div>
            <div class="field"><label>@Loc.T("Notes")</label><textarea class="input" rows="2" @bind="_supplierForm.Notes"></textarea></div>
            <label class="switch"><input type="checkbox" @bind="_supplierForm.IsActive" /> @Loc.T("Active")</label>
            @if (_supplierError is not null) { <div class="field-error">@_supplierError</div> }

            @if (_supplierForm.Id > 0)
            {
                <div class="modal-section">@Loc.T("Documents")</div>
                @foreach (var doc in _supplierDocs)
                {
                    <div class="sup-doc-row">
                        <a href="@doc.FileUrl" target="_blank"><LucideIcon Name="file-text" Size="15" /> @doc.FileName</a>
                        <button class="btn btn--icon btn--danger btn--sm" title="@Loc.T("Delete")" @onclick="() => DeleteDocument(doc.Id)"><LucideIcon Name="trash-2" Size="15" /></button>
                    </div>
                }
                @if (_supplierDocs.Count == 0) { <p class="muted">@Loc.T("No documents attached.")</p> }
                <label class="btn btn--ghost btn--sm docpick" style="margin-top:.5rem">
                    @Loc.T("Attach document")
                    <InputFile OnChange="OnDocumentSelected" class="docpick__input" accept=".pdf,.doc,.docx,.xls,.xlsx,image/png,image/jpeg,image/webp" />
                </label>
                @if (_docError is not null) { <div class="field-error">@_docError</div> }
            }
        }
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CloseSupplierForm">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" @onclick="SaveSupplier">@Loc.T("Save")</button>
    </Footer>
</Modal>

@* ---- Purchase form --------------------------------------------------------- *@
<Modal Visible="_purchaseForm is not null" Title="@Loc.T("New purchase")" OnClose="ClosePurchaseForm" Wide="true">
    <ChildContent>
        @if (_purchaseForm is not null)
        {
            <div class="row-2">
                <div class="field">
                    <label>@Loc.T("Supplier")</label>
                    <select class="select" @bind="_purchaseForm.SupplierId">
                        <option value="0">@Loc.T("Select…")</option>
                        @foreach (var s in _suppliers)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="field"><label>@Loc.T("Date")</label><input type="date" class="input" value="@_purchaseForm.Date.ToString("yyyy-MM-dd")" @onchange="OnPurchaseDateChanged" /></div>
            </div>
            <div class="row-2">
                <div class="field"><label>@Loc.T("Reference")</label><input class="input" @bind="_purchaseForm.Reference" /></div>
                <div class="field"><label>@Loc.T("Notes")</label><input class="input" @bind="_purchaseForm.Notes" /></div>
            </div>

            <div class="modal-section">@Loc.T("Lines")</div>
            @foreach (var (line, i) in _purchaseForm.Lines.Select((l, i) => (l, i)))
            {
                <div class="row-2" style="grid-template-columns: 2fr 1fr 1fr auto; align-items:end; gap:.5rem">
                    <div class="field">
                        <label>@Loc.T("Product")</label>
                        <select class="select" @bind="line.ProductId">
                            <option value="0">@Loc.T("Select…")</option>
                            @foreach (var p in _products)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field"><label>@Loc.T("Qty")</label><input type="number" min="0" step="0.01" class="input" @bind="line.Quantity" /></div>
                    <div class="field"><label>@Loc.T("Unit cost")</label><input type="number" min="0" step="0.01" class="input" @bind="line.UnitCost" /></div>
                    <button class="btn btn--icon btn--danger btn--sm" title="@Loc.T("Remove")" @onclick="() => _purchaseForm.Lines.RemoveAt(i)"><LucideIcon Name="trash-2" Size="15" /></button>
                </div>
            }
            <button class="btn btn--ghost btn--sm" @onclick="() => _purchaseForm.Lines.Add(new PurchaseLineFormDto())"><LucideIcon Name="plus" Size="14" /> @Loc.T("Add line")</button>

            <p class="ta-r" style="margin-top:.8rem"><strong>@Loc.T("Total"): @_purchaseForm.Lines.Sum(l => l.Quantity * l.UnitCost).ToString("N2")</strong></p>
            @if (_purchaseError is not null) { <div class="field-error">@_purchaseError</div> }
        }
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="ClosePurchaseForm">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" @onclick="SavePurchase">@Loc.T("Save")</button>
    </Footer>
</Modal>

@code {
    private const long MaxDocBytes = 10 * 1024 * 1024;

    private string _tab = "suppliers";

    private List<SupplierDto> _suppliers = new();
    private List<PurchaseDto> _purchases = new();
    private List<StockItemDto> _stock = new();
    private List<StockMovementDto> _stockMovements = new();
    private List<ProductDto> _products = new();
    private string _stockSearch = "";
    private int _stockCategoryFilter;
    private bool _stockCategoryDropdownOpen;
    private void SelectStockCategory(int id) { _stockCategoryFilter = id; _stockCategoryDropdownOpen = false; }
    private DateTime? _stockDateFrom;
    private DateTime? _stockDateTo;
    private bool _stockFromPickerOpen;
    private bool _stockToPickerOpen;
    private bool _stockExportDropdownOpen;

    private void PickStockFrom(DateTime date)
    {
        _stockDateFrom = date;
        _stockFromPickerOpen = false;
    }

    private void PickStockTo(DateTime date)
    {
        _stockDateTo = date;
        _stockToPickerOpen = false;
    }

    private void ClearStockDates()
    {
        _stockDateFrom = null;
        _stockDateTo = null;
    }
    private string _purchasesSearch = "";
    private DateTime? _purchaseDateFrom;
    private DateTime? _purchaseDateTo;
    private bool _purchaseFromPickerOpen;
    private bool _purchaseToPickerOpen;

    private void PickPurchaseFrom(DateTime date)
    {
        _purchaseDateFrom = date;
        _purchaseFromPickerOpen = false;
    }

    private void PickPurchaseTo(DateTime date)
    {
        _purchaseDateTo = date;
        _purchaseToPickerOpen = false;
    }

    private void ClearPurchaseDates()
    {
        _purchaseDateFrom = null;
        _purchaseDateTo = null;
    }
    private DateTime? _stockMoveDateFrom;
    private DateTime? _stockMoveDateTo;
    private bool _stockMoveFromPickerOpen;
    private bool _stockMoveToPickerOpen;
    private int? _stockMoveProductFilter;
    private string _stockMoveProductName = "";

    private void PickStockMoveFrom(DateTime date)
    {
        _stockMoveDateFrom = date;
        _stockMoveFromPickerOpen = false;
    }

    private void PickStockMoveTo(DateTime date)
    {
        _stockMoveDateTo = date;
        _stockMoveToPickerOpen = false;
    }

    private void FilterStockMovesByProduct(int productId)
    {
        _stockMoveProductFilter = productId;
        _stockMoveProductName = _stock.FirstOrDefault(s => s.ProductId == productId)?.ProductName ?? "";
    }

    private SupplierFormDto? _supplierForm;
    private List<SupplierDocumentDto> _supplierDocs = new();
    private string? _supplierError;
    private string? _docError;
    private string? _listError;

    private PurchaseFormDto? _purchaseForm;
    private string? _purchaseError;

    private StockAdjustFormDto? _stockForm;
    private string? _stockError;

    private const long MaxAlbaranBytes = 10 * 1024 * 1024;
    private List<AlbaranScanSummaryDto> _albaranScans = new();
    private bool _albaranUploadMenuOpen;
    private string? _albaranUploadError;
    private AlbaranScanDetailDto? _albaranDetail;
    private AlbaranScanEditDto? _albaranEditForm;
    private string? _albaranDetailError;
    private HubConnection? _suppliersHub;

    private List<AlbaranScanSummaryDto> PendingAlbaranScans =>
        _albaranScans.Where(s => s.Status != AlbaranScanStatus.Validated).ToList();

    private bool CanValidateAlbaran =>
        _albaranEditForm is { SupplierId: > 0 } form && form.Lines.Count > 0 && form.Lines.All(l => l.ProductId > 0);

    private static string StatusAttr(AlbaranScanStatus status) => status switch
    {
        AlbaranScanStatus.Processing => "processing",
        AlbaranScanStatus.NeedsReview => "needs-review",
        AlbaranScanStatus.Validated => "validated",
        AlbaranScanStatus.Failed => "failed",
        _ => "processing"
    };

    private string StatusLabel(AlbaranScanStatus status) => status switch
    {
        AlbaranScanStatus.Processing => Loc.T("Processing"),
        AlbaranScanStatus.NeedsReview => Loc.T("Needs review"),
        AlbaranScanStatus.Validated => Loc.T("Validated"),
        AlbaranScanStatus.Failed => Loc.T("Failed"),
        _ => ""
    };

    private static string StatusIcon(AlbaranScanStatus status) => status switch
    {
        AlbaranScanStatus.Processing => "clock",
        AlbaranScanStatus.NeedsReview => "eye",
        AlbaranScanStatus.Validated => "check",
        AlbaranScanStatus.Failed => "triangle-alert",
        _ => "clock"
    };

    private static string StatusBadgeClass(AlbaranScanStatus status) => status switch
    {
        AlbaranScanStatus.NeedsReview => "badge--warning",
        AlbaranScanStatus.Validated => "badge--success",
        AlbaranScanStatus.Failed => "badge--danger",
        _ => ""
    };

    private List<PurchaseDto> FilteredPurchases =>
        _purchases.Where(p =>
            (string.IsNullOrWhiteSpace(_purchasesSearch) ||
             p.SupplierName.Contains(_purchasesSearch, StringComparison.OrdinalIgnoreCase) ||
             (p.Reference?.Contains(_purchasesSearch, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (_purchaseDateFrom is null || p.Date.Date >= _purchaseDateFrom.Value.Date) &&
            (_purchaseDateTo is null || p.Date.Date <= _purchaseDateTo.Value.Date))
        .ToList();

    private List<StockItemDto> FilteredStock
    {
        get
        {
            var q = _stock.Where(s =>
                (string.IsNullOrWhiteSpace(_stockSearch) || s.ProductName.Contains(_stockSearch, StringComparison.OrdinalIgnoreCase)) &&
                (_stockCategoryFilter == 0 || s.CategoryId == _stockCategoryFilter) &&
                (_stockDateFrom is null || (s.LastUpdatedAt is not null && s.LastUpdatedAt.Value.Date >= _stockDateFrom.Value.Date)) &&
                (_stockDateTo is null || (s.LastUpdatedAt is not null && s.LastUpdatedAt.Value.Date <= _stockDateTo.Value.Date)));

            IEnumerable<StockItemDto> sorted = _stockSortField switch
            {
                "category" => q.OrderBy(s => s.CategoryName).ThenBy(s => s.ProductName),
                "stock" => q.OrderBy(s => s.StockQuantity),
                "value" => q.OrderBy(s => StockValue(s)),
                "updated" => q.OrderBy(s => s.LastUpdatedAt),
                _ => q.OrderBy(s => s.ProductName),
            };
            return (_stockSortDesc ? sorted.Reverse() : sorted).ToList();
        }
    }

    private string _stockSortField = "product";
    private bool _stockSortDesc;

    private void SortStockBy(string field)
    {
        if (_stockSortField == field) { _stockSortDesc = !_stockSortDesc; }
        else { _stockSortField = field; _stockSortDesc = false; }
    }

    private RenderFragment StockSortIconMarkup(string field) => builder =>
    {
        if (field != _stockSortField) return;
        builder.OpenComponent<LucideIcon>(0);
        builder.AddAttribute(1, "Name", _stockSortDesc ? "chevron-down" : "chevron-up");
        builder.AddAttribute(2, "Size", 12);
        builder.CloseComponent();
    };

    private List<(int Id, string Name)> StockCategories =>
        _products.Select(p => (Id: p.CategoryId, Name: p.CategoryName)).Distinct().OrderBy(c => c.Name).ToList();

    private int OutOfStockCount => _stock.Count(s => s.StockQuantity <= 0);

    private decimal StockValue(StockItemDto item) => item.StockQuantity * item.UnitPrice;
    private decimal TotalStockValue => _stock.Sum(StockValue);

    private List<(string Name, decimal Units, decimal Value, int Pct)> StockValueByCategory
    {
        get
        {
            var total = TotalStockValue;
            return _stock
                .GroupBy(s => s.CategoryName)
                .Select(g => (Name: g.Key, Units: g.Sum(s => s.StockQuantity), Value: g.Sum(StockValue)))
                .OrderByDescending(x => x.Value)
                .Select(x => (x.Name, x.Units, x.Value, Pct: total <= 0 ? 0 : (int)Math.Round((double)(x.Value / total) * 100)))
                .ToList();
        }
    }

    private List<StockMovementDto> FilteredStockMovements =>
        _stockMovements.Where(m =>
            (_stockCategoryFilter == 0 || m.CategoryId == _stockCategoryFilter) &&
            (_stockMoveProductFilter is null || m.ProductId == _stockMoveProductFilter) &&
            (_stockMoveDateFrom is null || m.Date.Date >= _stockMoveDateFrom.Value.Date) &&
            (_stockMoveDateTo is null || m.Date.Date <= _stockMoveDateTo.Value.Date))
        .ToList();

    private void ClearStockMoveDates()
    {
        _stockMoveDateFrom = null;
        _stockMoveDateTo = null;
        _stockMoveProductFilter = null;
    }

    private string MovementReasonLabel(StockMovementReason reason) => reason switch
    {
        StockMovementReason.Purchase => Loc.T("Purchase"),
        StockMovementReason.Sale => Loc.T("Sale"),
        StockMovementReason.Adjustment => Loc.T("Adjustment"),
        _ => reason.ToString()
    };

    private decimal MaxStock => _stock.Count == 0 ? 0 : _stock.Max(s => s.StockQuantity);

    private int StockPct(StockItemDto item) => MaxStock <= 0 ? 0 : (int)Math.Round((double)(item.StockQuantity / MaxStock) * 100);

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }

    protected override async Task OnInitializedAsync()
    {
        _suppliers = await SupplierService.GetAllAsync();
        _products = await ProductService.GetAllAsync();

        // Only open the real-time channel during the interactive render (not prerender).
        if (!RendererInfo.IsInteractive) return;

        _suppliersHub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri(SuppliersHub.Path))
            .WithAutomaticReconnect()
            .Build();

        // The vision-model call can take minutes, so the user may have left this tab (or the
        // page) by the time it finishes — refresh the list/open detail without a reload.
        _suppliersHub.On<int, string>(SuppliersHub.AlbaranScanUpdated, async (scanId, _) =>
        {
            _albaranScans = await AlbaranScanService.GetAllAsync();
            if (_albaranDetail?.Id == scanId) await OpenAlbaranDetail(scanId);
            await InvokeAsync(StateHasChanged);
        });

        await _suppliersHub.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_suppliersHub is not null) await _suppliersHub.DisposeAsync();
    }

    private async Task SelectPurchases()
    {
        _tab = "purchases";
        _purchases = await PurchaseService.GetAllAsync();
        _albaranScans = await AlbaranScanService.GetAllAsync();
    }

    private async Task SelectStock()
    {
        _tab = "stock";
        _stock = await StockService.GetAllAsync();
        _stockMovements = await StockService.GetAllMovementsAsync();
    }

    private async Task SelectEstadisticas()
    {
        _tab = "estadisticas";
        _stock = await StockService.GetAllAsync();
    }

    // ---- Suppliers ----------------------------------------------------------

    private void OpenSupplierForm(int? id) => _ = OpenSupplierFormAsync(id);

    private async Task OpenSupplierFormAsync(int? id)
    {
        _supplierError = null;
        _docError = null;
        _supplierForm = id is null ? new SupplierFormDto() : await SupplierService.GetForEditAsync(id.Value) ?? new SupplierFormDto();
        _supplierDocs = _supplierForm.Id > 0 ? await SupplierService.GetDocumentsAsync(_supplierForm.Id) : new();
    }

    private void CloseSupplierForm() => _supplierForm = null;

    private async Task SaveSupplier()
    {
        if (_supplierForm is null) return;
        var result = await SupplierValidator.ValidateAsync(_supplierForm);
        if (!result.IsValid) { _supplierError = result.Errors[0].ErrorMessage; return; }

        if (_supplierForm.Id > 0) await SupplierService.UpdateAsync(_supplierForm);
        else await SupplierService.CreateAsync(_supplierForm);

        _supplierForm = null;
        _suppliers = await SupplierService.GetAllAsync();
    }

    private async Task DeleteSupplier(int id)
    {
        _listError = null;
        try { await SupplierService.DeleteAsync(id); }
        catch (InvalidOperationException ex) { _listError = ex.Message; return; }
        _suppliers = await SupplierService.GetAllAsync();
    }

    private async Task OnDocumentSelected(InputFileChangeEventArgs e)
    {
        if (_supplierForm is null) return;
        _docError = null;
        var file = e.File;

        if (file.Size > MaxDocBytes) { _docError = Loc.T("File is too large (max 10 MB)."); return; }

        var ext = Path.GetExtension(file.Name);
        var dir = Path.Combine(Env.WebRootPath, "uploads", "suppliers", _supplierForm.Id.ToString());
        Directory.CreateDirectory(dir);
        var storedName = $"{Guid.NewGuid():N}{ext.ToLowerInvariant()}";

        await using (var output = File.Create(Path.Combine(dir, storedName)))
        await using (var input = file.OpenReadStream(MaxDocBytes))
        {
            await input.CopyToAsync(output);
        }

        var url = $"/uploads/suppliers/{_supplierForm.Id}/{storedName}";
        await SupplierService.AddDocumentAsync(_supplierForm.Id, file.Name, url, file.ContentType, file.Size);
        _supplierDocs = await SupplierService.GetDocumentsAsync(_supplierForm.Id);
        _suppliers = await SupplierService.GetAllAsync();
    }

    private async Task DeleteDocument(int documentId)
    {
        if (_supplierForm is null) return;
        await SupplierService.DeleteDocumentAsync(documentId);
        _supplierDocs = await SupplierService.GetDocumentsAsync(_supplierForm.Id);
        _suppliers = await SupplierService.GetAllAsync();
    }

    // ---- Purchases ------------------------------------------------------------

    private void OpenPurchaseForm()
    {
        _purchaseError = null;
        _purchaseForm = new PurchaseFormDto();
        _purchaseForm.Lines.Add(new PurchaseLineFormDto());
    }

    private void ClosePurchaseForm() => _purchaseForm = null;

    private void OnPurchaseDateChanged(ChangeEventArgs e)
    {
        if (_purchaseForm is null) return;
        if (DateTime.TryParse(e.Value?.ToString(), out var date)) _purchaseForm.Date = date;
    }

    private async Task SavePurchase()
    {
        if (_purchaseForm is null) return;
        var result = await PurchaseValidator.ValidateAsync(_purchaseForm);
        if (!result.IsValid) { _purchaseError = result.Errors[0].ErrorMessage; return; }

        await PurchaseService.CreateAsync(_purchaseForm);
        _purchaseForm = null;
        _purchases = await PurchaseService.GetAllAsync();
    }

    // ---- Stock ------------------------------------------------------------

    private void OpenStockAdjust(StockItemDto item)
    {
        _stockError = null;
        _stockForm = new StockAdjustFormDto { ProductId = item.ProductId, NewQuantity = item.StockQuantity };
    }

    private void CloseStockForm()
    {
        _stockForm = null;
        _stockError = null;
    }

    private async Task SaveStockAdjust()
    {
        if (_stockForm is null) return;
        var result = await StockValidator.ValidateAsync(_stockForm);
        if (!result.IsValid) { _stockError = result.Errors[0].ErrorMessage; return; }

        await StockService.AdjustAsync(_stockForm);
        _stockForm = null;
        _stock = await StockService.GetAllAsync();
        _stockMovements = await StockService.GetAllMovementsAsync();
    }

    // ---- Albarán scans ------------------------------------------------------

    private void ToggleAlbaranUploadMenu()
    {
        _albaranUploadError = null;
        _albaranUploadMenuOpen = !_albaranUploadMenuOpen;
    }

    private void CloseAlbaranUploadMenu() => _albaranUploadMenuOpen = false;

    private async Task OnAlbaranPhotoSelected(InputFileChangeEventArgs e)
    {
        _albaranUploadError = null;
        var file = e.File;

        if (file.Size > MaxAlbaranBytes) { _albaranUploadError = Loc.T("File is too large (max 10 MB)."); return; }
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) { _albaranUploadError = Loc.T("Please choose an image file."); return; }

        var ext = Path.GetExtension(file.Name);
        if (string.IsNullOrWhiteSpace(ext)) ext = ".jpg";
        var dir = Path.Combine(Env.WebRootPath, "uploads", "albaranes");
        Directory.CreateDirectory(dir);
        var storedName = $"{Guid.NewGuid():N}{ext.ToLowerInvariant()}";
        var absolutePath = Path.Combine(dir, storedName);

        await using (var output = File.Create(absolutePath))
        await using (var input = file.OpenReadStream(MaxAlbaranBytes))
        {
            await input.CopyToAsync(output);
        }

        var url = $"/uploads/albaranes/{storedName}";
        var scanId = await AlbaranScanService.CreateAsync(url, null);
        ScanRunner.QueueScan(scanId, absolutePath);

        _albaranUploadMenuOpen = false;
        _albaranScans = await AlbaranScanService.GetAllAsync();
        await OpenAlbaranDetail(scanId);
    }

    private async Task OpenAlbaranDetail(int id)
    {
        _albaranDetailError = null;
        _albaranDetail = await AlbaranScanService.GetByIdAsync(id);
        if (_albaranDetail is null) return;

        _albaranEditForm = new AlbaranScanEditDto
        {
            SupplierId = _albaranDetail.SupplierId ?? 0,
            AlbaranNumber = _albaranDetail.AlbaranNumber,
            AlbaranDate = _albaranDetail.AlbaranDate,
            Lines = _albaranDetail.Lines.Select(l => new AlbaranScanLineEditDto
            {
                Id = l.Id,
                Description = l.Description,
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice,
                ProductId = l.ProductId ?? 0
            }).ToList()
        };
    }

    private void CloseAlbaranDetail()
    {
        _albaranDetail = null;
        _albaranEditForm = null;
    }

    private void OnAlbaranDateChanged(ChangeEventArgs e)
    {
        if (_albaranEditForm is null) return;
        _albaranEditForm.AlbaranDate = DateTime.TryParse(e.Value?.ToString(), out var date) ? date : null;
    }

    private async Task SaveAlbaranDraft()
    {
        if (_albaranDetail is null || _albaranEditForm is null) return;
        _albaranDetailError = null;
        var result = await AlbaranScanValidator.ValidateAsync(_albaranEditForm);
        if (!result.IsValid) { _albaranDetailError = result.Errors[0].ErrorMessage; return; }

        await AlbaranScanService.SaveDraftAsync(_albaranDetail.Id, _albaranEditForm);
        await OpenAlbaranDetail(_albaranDetail.Id);
        _albaranScans = await AlbaranScanService.GetAllAsync();
    }

    private async Task ValidateAlbaran()
    {
        if (_albaranDetail is null || _albaranEditForm is null) return;
        _albaranDetailError = null;
        var result = await AlbaranScanValidator.ValidateAsync(_albaranEditForm);
        if (!result.IsValid) { _albaranDetailError = result.Errors[0].ErrorMessage; return; }

        try
        {
            await AlbaranScanService.ValidateAndCreatePurchaseAsync(_albaranDetail.Id, _albaranEditForm);
        }
        catch (InvalidOperationException ex)
        {
            _albaranDetailError = ex.Message;
            return;
        }

        CloseAlbaranDetail();
        _albaranScans = await AlbaranScanService.GetAllAsync();
        _purchases = await PurchaseService.GetAllAsync();
        _stock = await StockService.GetAllAsync();
    }

    private async Task RetryAlbaran()
    {
        if (_albaranDetail is null) return;
        var absolutePath = Path.Combine(Env.WebRootPath, _albaranDetail.ImageUrl.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));

        await AlbaranScanService.RetryAsync(_albaranDetail.Id);
        ScanRunner.QueueScan(_albaranDetail.Id, absolutePath);
        await OpenAlbaranDetail(_albaranDetail.Id);
        _albaranScans = await AlbaranScanService.GetAllAsync();
    }
}
