@page "/orders"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Waiter,Cashier")]
@using Microsoft.AspNetCore.SignalR.Client
@using PosTpv.Web.Hubs
@implements IAsyncDisposable
@inject IOrderService OrderSvc
@inject NavigationManager Nav
@inject AppSettingsCache Branding

<PageTitle>Orders · @Branding.Current.Title</PageTitle>

<div class="orders-quicknav">
    <div class="orders-quicknav__row">
        <div class="orders-quicknav__chips @(_chipsExpanded ? "orders-quicknav__chips--expanded" : "")">
            @foreach (var o in Filtered)
            {
                <button class="orders-quicknav__chip" data-status="@o.Status.ToString().ToLower()"
                        title="@o.TableName · @o.Number · @Loc.T(o.Status.ToString())" @onclick="() => OpenEditor(o.Id)">
                    <span class="orders-quicknav__chip-name">@o.TableName</span>
                </button>
            }
        </div>
        <div class="toolbar">
            <button class="btn btn--icon @(_showFilters ? "btn--primary" : "btn--ghost")" title="@Loc.T("Filters")" @onclick="() => _showFilters = !_showFilters">
                <LucideIcon Name="settings" Size="16" />
            </button>
            <button class="btn btn--icon btn--ghost" title="@Loc.T("Refresh")" @onclick="Reload"><LucideIcon Name="rotate-cw" Size="16" /></button>
            <button class="btn btn--icon @(_chipsExpanded ? "btn--primary" : "btn--ghost")"
                    title="@(_chipsExpanded ? Loc.T("Show fewer tables") : Loc.T("Show all tables"))"
                    @onclick="() => _chipsExpanded = !_chipsExpanded">
                <LucideIcon Name="@(_chipsExpanded ? "chevron-up" : "chevron-down")" Size="16" />
            </button>
        </div>
    </div>
    @if (_showFilters)
    {
        <div class="orders-quicknav__filters">
            <div class="orders-dd">
                <button type="button" class="orders-dd__trigger" @onclick='() => ToggleDropdown("status")'>
                    <span>@(_statusFilterValue is null ? Loc.T("All statuses") : Loc.T(_statusFilterValue.ToString()!))</span>
                    <LucideIcon Name="chevron-down" Size="13" />
                </button>
                @if (_openDropdown == "status")
                {
                    <div class="orders-dd__backdrop" @onclick="CloseDropdown"></div>
                    <div class="orders-dd__menu">
                        <button type="button" class="orders-dd__opt @(_statusFilterValue is null ? "orders-dd__opt--on" : "")" @onclick='() => SelectStatus("")'>@Loc.T("All statuses")</button>
                        @foreach (var s in new[] { OrderStatus.Open, OrderStatus.Sent, OrderStatus.InPreparation, OrderStatus.Ready, OrderStatus.Delivered })
                        {
                            <button type="button" class="orders-dd__opt @(_statusFilterValue == s ? "orders-dd__opt--on" : "")" @onclick="() => SelectStatus(s.ToString())">@Loc.T(s.ToString())</button>
                        }
                    </div>
                }
            </div>
            <div class="orders-dd">
                <button type="button" class="orders-dd__trigger" @onclick='() => ToggleDropdown("sort")'>
                    <span>@SortLabel()</span>
                    <LucideIcon Name="chevron-down" Size="13" />
                </button>
                @if (_openDropdown == "sort")
                {
                    <div class="orders-dd__backdrop" @onclick="CloseDropdown"></div>
                    <div class="orders-dd__menu">
                        <button type="button" class="orders-dd__opt @(_sortOrder == "oldest" ? "orders-dd__opt--on" : "")" @onclick='() => SelectSort("oldest")'>@Loc.T("Oldest first")</button>
                        <button type="button" class="orders-dd__opt @(_sortOrder == "newest" ? "orders-dd__opt--on" : "")" @onclick='() => SelectSort("newest")'>@Loc.T("Newest first")</button>
                        <button type="button" class="orders-dd__opt @(_sortOrder == "number" ? "orders-dd__opt--on" : "")" @onclick='() => SelectSort("number")'>@Loc.T("Order number")</button>
                    </div>
                }
            </div>
            @if (Zones.Count > 0)
            {
                <div class="orders-dd">
                    <button type="button" class="orders-dd__trigger" @onclick='() => ToggleDropdown("zone")'>
                        <span>@(string.IsNullOrEmpty(_zoneFilter) ? Loc.T("All zones") : _zoneFilter)</span>
                        <LucideIcon Name="chevron-down" Size="13" />
                    </button>
                    @if (_openDropdown == "zone")
                    {
                        <div class="orders-dd__backdrop" @onclick="CloseDropdown"></div>
                        <div class="orders-dd__menu">
                            <button type="button" class="orders-dd__opt @(string.IsNullOrEmpty(_zoneFilter) ? "orders-dd__opt--on" : "")" @onclick='() => SelectZone("")'>@Loc.T("All zones")</button>
                            @foreach (var z in Zones)
                            {
                                <button type="button" class="orders-dd__opt @(_zoneFilter == z ? "orders-dd__opt--on" : "")" @onclick="() => SelectZone(z)">@z</button>
                            }
                        </div>
                    }
                </div>
            }
            <div class="orders-dd">
                <button type="button" class="orders-dd__trigger" @onclick='() => ToggleDropdown("cols")'>
                    <span>@_cardsPerRow @Loc.T("per row")</span>
                    <LucideIcon Name="chevron-down" Size="13" />
                </button>
                @if (_openDropdown == "cols")
                {
                    <div class="orders-dd__backdrop" @onclick="CloseDropdown"></div>
                    <div class="orders-dd__menu">
                        @foreach (var n in new[] { 2, 3, 4, 5 })
                        {
                            <button type="button" class="orders-dd__opt @(_cardsPerRow == n ? "orders-dd__opt--on" : "")" @onclick="() => SelectColumns(n)">@n @Loc.T("per row")</button>
                        }
                    </div>
                }
            </div>
            <input class="input orders-filters__search" placeholder="@Loc.T("Search table…")" @bind="_tableSearch" @bind:event="oninput" />
        </div>
    }
</div>

<div class="orders" style="--orders-cols: @_cardsPerRow">
    @foreach (var o in Filtered)
    {
        <OrderCard @key="o.Id"
                   Order="o"
                   OnServeDrinks="ServeDrinks"
                   OnUnserveDrinks="UnserveDrinks"
                   OnUnserveDrink="UnserveDrink"
                   OnServeFirsts="ServeFirsts"
                   OnUnserveFirsts="UnserveFirsts"
                   OnUnserveFirstItem="UnserveFirstItem"
                   OnServeSeconds="ServeSeconds"
                   OnUnserveSeconds="UnserveSeconds"
                   OnUnserveSecondItem="UnserveSecondItem"
                   OnFireSeconds="FireSeconds"
                   OnUnfireSeconds="UnfireSeconds"
                   OnServeDesserts="ServeDesserts"
                   OnUnserveDesserts="UnserveDesserts"
                   OnUnserveDessertItem="UnserveDessertItem"
                   OnEdit="OpenEditor"
                   OnPay="OpenPayment" />
    }
    @if (Filtered.Count == 0) { <p class="empty">@Loc.T("No open orders.")</p> }
</div>

<OrderEditor OrderId="_editorOrderId" OnClose="CloseEditor" OnChanged="EditorChanged" OnNavigate="NavigateOrder" />

<PaymentDialog Order="_payingOrder" Visible="_payingOrder is not null" OnClose="ClosePayment" OnConfirm="ConfirmPayment" />

@code {
    private List<OrderDto> _orders = new();
    private OrderStatus? _statusFilterValue;
    private HubConnection? _hub;

    private int? _editorOrderId;
    private OrderDto? _payingOrder;
    private bool _showFilters;
    private bool _chipsExpanded;

    private string _sortOrder = "newest"; // "newest" | "oldest" | "number"

    private string _tableSearch = "";
    private string _zoneFilter = "";
    private int _cardsPerRow = 4;
    private List<string> Zones => _orders
        .Select(o => o.Zone)
        .Where(z => !string.IsNullOrWhiteSpace(z))
        .Distinct()
        .OrderBy(z => z)
        .ToList()!;

    // Custom dropdowns (status/sort/zone) instead of native <select> — only one open at a time,
    // and picking an option closes it, same pattern as .resv-status__menu in Tables.razor.
    private string? _openDropdown;
    private void ToggleDropdown(string key) => _openDropdown = _openDropdown == key ? null : key;
    private void CloseDropdown() => _openDropdown = null;

    private void SelectStatus(string value)
    {
        _statusFilterValue = Enum.TryParse<OrderStatus>(value, out var s) ? s : null;
        _openDropdown = null;
    }
    private void SelectSort(string value) { _sortOrder = value; _openDropdown = null; }
    private void SelectZone(string value) { _zoneFilter = value; _openDropdown = null; }
    private void SelectColumns(int value) { _cardsPerRow = value; _openDropdown = null; }

    private string SortLabel() => _sortOrder switch
    {
        "oldest" => Loc.T("Oldest first"),
        "number" => Loc.T("Order number"),
        _ => Loc.T("Newest first")
    };

    private List<OrderDto> Filtered
    {
        get
        {
            var list = _statusFilterValue is null ? _orders : _orders.Where(o => o.Status == _statusFilterValue);
            if (!string.IsNullOrEmpty(_zoneFilter)) list = list.Where(o => o.Zone == _zoneFilter);
            if (!string.IsNullOrWhiteSpace(_tableSearch)) list = list.Where(o => o.TableName.Contains(_tableSearch, StringComparison.OrdinalIgnoreCase));
            return (_sortOrder switch
            {
                "oldest" => list.OrderBy(o => o.CreatedAt),
                "number" => list.OrderBy(o => o.Number),
                _ => list.OrderByDescending(o => o.CreatedAt)
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();
        if (!RendererInfo.IsInteractive) return;
        _hub = new HubConnectionBuilder().WithUrl(Nav.ToAbsoluteUri(KitchenHub.Path)).WithAutomaticReconnect().Build();
        // Every event carries the affected order id, so we refresh just that one card (see RefreshOrder)
        // instead of reloading and re-rendering the whole board.
        _hub.On<int, int>(KitchenHub.ItemStatusChanged, (orderId, _) => RefreshOrder(orderId));
        _hub.On<int>(KitchenHub.OrderReady, RefreshOrder);
        _hub.On<int>(KitchenHub.OrderSent, RefreshOrder);
        _hub.On<int>(KitchenHub.SecondsFired, RefreshOrder);
        _hub.On<int>(KitchenHub.DrinksServed, RefreshOrder);
        _hub.On<int>(KitchenHub.FirstCoursesServed, RefreshOrder);
        _hub.On<int>(KitchenHub.SecondCoursesServed, RefreshOrder);
        _hub.On<int>(KitchenHub.DessertCoursesServed, RefreshOrder);
        await _hub.StartAsync();
    }

    private async Task Load() => _orders = await OrderSvc.GetOpenOrdersAsync();
    private async Task Reload() { await Load(); await InvokeAsync(StateHasChanged); }

    // Refresh a single order in place: one DB read for that order, and — because only its OrderDto
    // instance changes — only its OrderCard re-renders (the others short-circuit in ShouldRender).
    private async Task RefreshOrder(int orderId)
    {
        var fresh = await OrderSvc.GetByIdAsync(orderId);
        var idx = _orders.FindIndex(o => o.Id == orderId);

        if (fresh is null || fresh.Status is OrderStatus.Paid or OrderStatus.Cancelled)
        {
            if (idx >= 0) _orders.RemoveAt(idx);            // left the board (charged/cancelled)
        }
        else if (idx >= 0)
        {
            _orders[idx] = fresh;                           // replace just this order's snapshot
        }
        else
        {
            _orders.Add(fresh);                             // newly opened/sent order appeared
            _orders.Sort((a, b) => a.CreatedAt.CompareTo(b.CreatedAt));
        }

        // Keep an open payment dialog in sync with the refreshed total.
        if (_payingOrder?.Id == orderId) _payingOrder = fresh;

        await InvokeAsync(StateHasChanged);
    }

    // ---- Editing ----
    private void OpenEditor(int orderId) => _editorOrderId = orderId;
    private void CloseEditor() => _editorOrderId = null;
    private Task EditorChanged() => _editorOrderId is int id ? RefreshOrder(id) : Task.CompletedTask;

    // Left/Right in the editor's toolbar (OrderEditor.OnNavigate): step to the previous/next
    // order within the same Filtered list the board itself shows, so it matches whatever
    // filter/sort is currently active. No-ops at either end instead of wrapping around.
    private void NavigateOrder(int delta)
    {
        if (_editorOrderId is not int currentId) return;
        var list = Filtered;
        var idx = list.FindIndex(o => o.Id == currentId);
        if (idx < 0) return;
        var newIdx = idx + delta;
        if (newIdx < 0 || newIdx >= list.Count) return;
        _editorOrderId = list[newIdx].Id;
    }

    // ---- Payment (single button → dialog with cash / card / split) ----
    private void OpenPayment(int orderId) => _payingOrder = _orders.FirstOrDefault(o => o.Id == orderId);
    private void ClosePayment() => _payingOrder = null;

    private async Task ConfirmPayment(IReadOnlyList<PaymentInput> payments)
    {
        if (_payingOrder is null) return;
        var orderId = _payingOrder.Id;
        await OrderSvc.CheckoutAsync(orderId, payments);
        _payingOrder = null;
        await RefreshOrder(orderId);   // checkout has no broadcast, so drop it locally
    }

    // Drinks come from the bar: one button serves the whole block. The single DrinksServed
    // broadcast refreshes this card (and every other waiter's) — no per-line events or full reload.
    private Task ServeDrinks(int orderId) => OrderSvc.ServeDrinksAsync(orderId);
    private Task UnserveDrinks(int orderId) => OrderSvc.UnserveDrinksAsync(orderId);

    // Undo path "just in case" a drink was marked served by mistake: back to Pending so it
    // reappears under "Serve drinks". The ItemStatusChanged broadcast refreshes the card.
    private Task UnserveDrink(int itemId) => OrderSvc.SetItemStatusAsync(itemId, OrderItemStatus.Pending);

    // Same green-badge serve/undo pattern as drinks, but for ready first-course lines: serving
    // needs the kitchen to have marked them Ready first, and undo puts them back to Ready (not
    // Pending) so they don't reappear as unstarted on the kitchen display.
    private Task ServeFirsts(int orderId) => OrderSvc.ServeFirstCoursesAsync(orderId);
    private Task UnserveFirsts(int orderId) => OrderSvc.UnserveFirstCoursesAsync(orderId);
    private Task UnserveFirstItem(int itemId) => OrderSvc.SetItemStatusAsync(itemId, OrderItemStatus.Ready);

    // Same green-badge serve/undo pattern, for second courses and desserts.
    private Task ServeSeconds(int orderId) => OrderSvc.ServeSecondCoursesAsync(orderId);
    private Task UnserveSeconds(int orderId) => OrderSvc.UnserveSecondCoursesAsync(orderId);
    private Task UnserveSecondItem(int itemId) => OrderSvc.SetItemStatusAsync(itemId, OrderItemStatus.Ready);
    private Task ServeDesserts(int orderId) => OrderSvc.ServeDessertCoursesAsync(orderId);
    private Task UnserveDesserts(int orderId) => OrderSvc.UnserveDessertCoursesAsync(orderId);
    private Task UnserveDessertItem(int itemId) => OrderSvc.SetItemStatusAsync(itemId, OrderItemStatus.Ready);

    // "Marchar segundos": alert the kitchen in real time; the echo refreshes the card.
    private Task FireSeconds(int orderId) => OrderSvc.FireSecondCoursesAsync(orderId);

    // Undo path: same "acknowledge" the kitchen uses to clear its alert, reused here so a
    // mis-fired course goes back to unfired instead of staying stuck on both screens.
    private Task UnfireSeconds(int orderId) => OrderSvc.AcknowledgeSecondCoursesAsync(orderId);

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}
