@page "/dashboard"
@rendermode InteractiveServer
@inject IDashboardService Dashboard
@inject IBillingService BillingSvc
@inject AppSettingsCache Branding

<PageTitle>@Loc.T("Dashboard") · @Branding.Current.Title</PageTitle>

<h1>@Loc.T("Dashboard")</h1>

@if (_data is null)
{
    <div class="page-loading">@Loc.T("Loading…")</div>
}
else
{
    <div class="dash">
        <div class="dash__metrics">
            <div class="metric card">
                <span class="metric__label">@Loc.T("Sales today")</span>
                <span class="metric__value">@_data.SalesToday.ToString("N2")</span>
            </div>
            <div class="metric card">
                <span class="metric__label">@Loc.T("Sales this month")</span>
                <span class="metric__value">@_data.SalesMonth.ToString("N2")</span>
            </div>
            <div class="metric card">
                <span class="metric__label">@Loc.T("Orders today")</span>
                <span class="metric__value">@_data.OrdersToday</span>
            </div>
            <div class="metric card">
                <span class="metric__label">@Loc.T("Open orders")</span>
                <span class="metric__value">@_data.OpenOrders</span>
            </div>
            <div class="metric card">
                <span class="metric__label">@Loc.T("Occupied tables")</span>
                <span class="metric__value">@_data.OccupiedTables / @_data.TotalTables</span>
            </div>
            <div class="metric card">
                <span class="metric__label">@Loc.T("Reservations today")</span>
                <span class="metric__value">@_data.ReservationsToday</span>
            </div>
            <div class="metric card">
                <span class="metric__label">@Loc.T("Current service")</span>
                <span class="metric__value">@CurrentPeriodLabel()</span>
            </div>
        </div>

        <AuthorizeView Roles="Admin,Cashier" Context="auth">
            <div class="dash__section">
                <div class="dash__section-head">
                    <h2>@Loc.T("Billing")</h2>
                    <a class="btn btn--ghost btn--sm" href="/billing">@Loc.T("View report") <LucideIcon Name="arrow-right" Size="14" /></a>
                </div>
                @if (_billing is null)
                {
                    <p class="empty">@Loc.T("Loading…")</p>
                }
                else
                {
                    <BillingStatsPanel Report="_billing" />
                }
            </div>
        </AuthorizeView>

        <div class="dash__panel card">
            <h2>@Loc.T("Top products")</h2>
            @if (_data.TopProducts.Count == 0)
            {
                <p class="empty">@Loc.T("No sales recorded yet.")</p>
            }
            else
            {
                <table class="dash__table">
                    <thead>
                        <tr><th>@Loc.T("Product")</th><th>@Loc.T("Qty")</th><th>@Loc.T("Revenue")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _data.TopProducts)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td>@p.Quantity</td>
                                <td>@p.Revenue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private DashboardDto? _data;
    private BillingReportDto? _billing;

    protected override async Task OnInitializedAsync()
    {
        _data = await Dashboard.GetAsync();

        var auth = AuthState is null ? null : await AuthState;
        if (auth is not null && (auth.User.IsInRole("Admin") || auth.User.IsInRole("Cashier")))
        {
            var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            _billing = await BillingSvc.GetReportAsync(monthStart, DateTime.Today);
        }
    }

    private string CurrentPeriodLabel()
    {
        var period = Branding.Current.GetPeriod(TimeOnly.FromDateTime(DateTime.Now));
        return period switch
        {
            ServicePeriod.Lunch => Loc.T("Lunch"),
            ServicePeriod.Dinner => Loc.T("Dinner"),
            _ => Loc.T("Closed")
        };
    }
}
