@page "/billing"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Cashier")]
@inject IBillingService BillingSvc
@inject AppSettingsCache Branding
@inject IJSRuntime JS

<PageTitle>Billing · @Branding.Current.Title</PageTitle>

<PageHero Icon="receipt" Title="@Loc.T("Billing")" />

<div class="toolbar">
    <div class="filter-bar">
        <label class="muted">@Loc.T("From")</label>
        <div class="date-filter">
            <button type="button" class="input date-filter__btn" @onclick="() => _fromPickerOpen = !_fromPickerOpen">@_from.ToString("dd/MM/yyyy")</button>
            @if (_fromPickerOpen)
            {
                <div class="resv-date__backdrop" @onclick="() => _fromPickerOpen = false"></div>
                <div class="resv-date__menu" @onclick:stopPropagation="true">
                    <Calendar Value="_from" ValueChanged="PickFrom" />
                </div>
            }
        </div>
        <label class="muted">@Loc.T("To")</label>
        <div class="date-filter">
            <button type="button" class="input date-filter__btn" @onclick="() => _toPickerOpen = !_toPickerOpen">@_to.ToString("dd/MM/yyyy")</button>
            @if (_toPickerOpen)
            {
                <div class="resv-date__backdrop" @onclick="() => _toPickerOpen = false"></div>
                <div class="resv-date__menu" @onclick:stopPropagation="true">
                    <Calendar Value="_to" ValueChanged="PickTo" />
                </div>
            }
        </div>
        <span class="spacer"></span>
        <div class="bill-dd">
            <button type="button" class="btn btn--primary" @onclick="() => _exportDropdownOpen = !_exportDropdownOpen">
                <LucideIcon Name="download" Size="16" />@Loc.T("Download")
                <LucideIcon Name="chevron-down" Size="13" />
            </button>
            @if (_exportDropdownOpen)
            {
                <div class="bill-dd__backdrop" @onclick="() => _exportDropdownOpen = false"></div>
                <div class="bill-dd__menu">
                    <a class="bill-dd__opt" href="@ExportUrl("csv")" target="_blank" rel="noopener" @onclick="() => _exportDropdownOpen = false">CSV</a>
                    <a class="bill-dd__opt" href="@ExportUrl("xlsx")" target="_blank" rel="noopener" @onclick="() => _exportDropdownOpen = false">Excel</a>
                    <a class="bill-dd__opt" href="@ExportUrl("pdf")" target="_blank" rel="noopener" @onclick="() => _exportDropdownOpen = false">PDF</a>
                </div>
            }
        </div>
    </div>
</div>

@if (_report is null)
{
    <div class="page-loading">@Loc.T("Loading…")</div>
}
else
{
    <div class="card" style="padding:1rem 1.2rem">
        @if (_report.Invoices.Count == 0)
        {
            <p class="empty">@Loc.T("No invoices in this range.")</p>
        }
        else
        {
            <table class="table table--clickable">
                <thead>
                    <tr><th>@Loc.T("Invoice")</th><th>@Loc.T("Order")</th><th>@Loc.T("Table")</th><th>@Loc.T("Method")</th><th>@Loc.T("Date")</th><th class="ta-r">@Loc.T("Total")</th></tr>
                </thead>
                <tbody>
                    @foreach (var inv in _report.Invoices)
                    {
                        <tr @onclick="() => OpenDetail(inv.Id)">
                            <td>@inv.Number</td>
                            <td>@inv.OrderNumber</td>
                            <td>@inv.TableName</td>
                            <td><span class="badge">@Loc.T(inv.PaymentMethod.ToString())</span></td>
                            <td>@inv.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            <td class="ta-r"><strong>@inv.Total.ToString("N2")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

<!-- Invoice detail: full itemised breakdown of a single sale, laid out like a real receipt. -->
<Modal Visible="_detail is not null || _detailLoading" Title="@(_detail is not null ? $"{Loc.T("Invoice")} {_detail.Number}" : Loc.T("Invoice"))" OnClose="CloseDetail" Wide="true">
    <ChildContent>
        @if (_detailLoading)
        {
            <p class="muted">@Loc.T("Loading…")</p>
        }
        else if (_detail is not null)
        {
            <div class="invoice">
                <div class="invoice__head">
                    <div class="invoice__brand-row">
                        <span class="invoice__icon"><LucideIcon Name="receipt" Size="18" /></span>
                        <div>
                            <strong class="invoice__brand">@Branding.Current.Title</strong>
                            <div class="muted">@_detail.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                    <div class="invoice__meta">
                        <span class="invoice__chip" title="@Loc.T("Order")"><LucideIcon Name="clipboard-list" Size="13" /> @_detail.OrderNumber</span>
                        <span class="invoice__chip" title="@Loc.T("Table")"><LucideIcon Name="armchair" Size="13" /> @_detail.TableName</span>
                        <span class="invoice__chip" title="@Loc.T("Waiter")"><LucideIcon Name="user" Size="13" /> @_detail.WaiterName</span>
                    </div>
                </div>

                <table class="table invoice__lines">
                    <thead>
                        <tr>
                            <th>@Loc.T("Product")</th>
                            <th class="ta-r">@Loc.T("Qty")</th>
                            <th class="ta-r">@Loc.T("Unit price")</th>
                            <th class="ta-r">@Loc.T("Line total")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _detail.Lines)
                        {
                            <tr>
                                <td>
                                    @line.ProductName
                                    @if (line.Extras.Count > 0)
                                    {
                                        <div class="invoice__linenote">@string.Join(", ", line.Extras.Select(e => "＋ " + e))</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(line.Comment))
                                    {
                                        <div class="invoice__linenote invoice__linenote--comment">“@line.Comment”</div>
                                    }
                                </td>
                                <td class="ta-r">@line.Quantity</td>
                                <td class="ta-r">@line.UnitPrice.ToString("N2")</td>
                                <td class="ta-r"><strong>@line.LineTotal.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="invoice__totals">
                    <div><span>@Loc.T("Subtotal")</span><span>@_detail.Subtotal.ToString("N2")</span></div>
                    <div><span>@Loc.T("VAT")</span><span>@_detail.VatTotal.ToString("N2")</span></div>
                    <div class="invoice__grand"><span>@Loc.T("Total")</span><span>@_detail.Total.ToString("N2")</span></div>
                </div>

                <div class="invoice__payments">
                    <span class="muted">@Loc.T("Paid with")</span>
                    @if (_detail.Payments.Count > 0)
                    {
                        @foreach (var p in _detail.Payments)
                        {
                            <span class="badge badge--primary">@Loc.T(p.Method.ToString()) · @p.Amount.ToString("N2")</span>
                        }
                    }
                    else
                    {
                        <span class="badge badge--primary">@Loc.T(_detail.PaymentMethod.ToString())</span>
                    }
                </div>
            </div>

            @* Rendered off-screen; only shown by the @media print rule in app.css when Print is
               clicked, so the reprint matches exactly what was handed to the customer at checkout. *@
            <div class="print-only">
                <SalesReceipt Invoice="_detail" BrandTitle="Branding.Current.Title" LegalName="Branding.Current.ReceiptLegalName"
                              TaxId="Branding.Current.ReceiptTaxId" Address="Branding.Current.ReceiptAddress" Footer="Branding.Current.ReceiptFooter"
                              ShowTaxBreakdown="Branding.Current.ReceiptShowTaxBreakdown" PaperWidth="Branding.Current.ReceiptPaperWidth" />
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CloseDetail">@Loc.T("Close")</button>
        @if (_detail is not null)
        {
            <button class="btn btn--primary" @onclick='() => JS.InvokeVoidAsync("print")'><LucideIcon Name="printer" Size="16" /> @Loc.T("Print")</button>
        }
    </Footer>
</Modal>

@code {
    private BillingReportDto? _report;
    private InvoiceDetailDto? _detail;
    private bool _detailLoading;
    private DateTime _from = DateTime.Today.AddDays(-7);
    private DateTime _to = DateTime.Today;
    private bool _exportDropdownOpen;
    private bool _fromPickerOpen;
    private bool _toPickerOpen;

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() => _report = await BillingSvc.GetReportAsync(_from, _to);

    private async Task PickFrom(DateTime date)
    {
        _from = date;
        _fromPickerOpen = false;
        await Load();
    }

    private async Task PickTo(DateTime date)
    {
        _to = date;
        _toPickerOpen = false;
        await Load();
    }

    private async Task OpenDetail(int invoiceId)
    {
        _detail = null;
        _detailLoading = true;
        StateHasChanged();
        _detail = await BillingSvc.GetInvoiceDetailAsync(invoiceId);
        _detailLoading = false;
    }

    private void CloseDetail() => _detail = null;

    private string ExportUrl(string format) =>
        $"/export/billing?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&format={format}";
}
