@page "/pos"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Waiter,Cashier")]
@using System.Security.Claims
@using Microsoft.AspNetCore.SignalR.Client
@using PosTpv.Web.Hubs
@implements IAsyncDisposable
@inject ICategoryService Categories
@inject IProductService Products
@inject ITableService Tables
@inject IOrderService Orders
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AppSettingsCache Branding

<PageTitle>POS · @Branding.Current.Title</PageTitle>

@if (_error is not null)
{
    <div class="pos-toast" role="alert">
        <span><LucideIcon Name="triangle-alert" Size="16" /> @_error</span>
        <button class="btn btn--icon btn--ghost" @onclick="() => _error = null" type="button"><LucideIcon Name="x" Size="18" /></button>
    </div>
}

<div class="pos">
    <div class="pos__left">
        <!-- Table strip: pick or switch tables without opening a modal -->
        <div class="pos__tablebar">
            @foreach (var t in _tables)
            {
                <button type="button"
                        class="tableChip @(_order?.TableId == t.Id ? "tableChip--active" : "")"
                        data-status="@t.Status.ToString().ToLower()"
                        disabled="@_busy"
                        @onclick="() => OpenTable(t.Id)">
                    <span class="tableChip__name">@t.Name</span>
                </button>
            }
            @if (_tables.Count == 0) { <p class="empty">@Loc.T("No tables yet.")</p> }
        </div>

        <div class="pos__main">
            <!-- Left: categories -->
            <div class="pos__cats">
                @foreach (var c in _categories)
                {
                    <button class="cat @(c.Id == _selectedCategoryId ? "cat--active" : "")"
                            style="--cat:@c.Color" @onclick="() => SelectCategory(c.Id)">
                        <span class="cat__icon">
                            @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                            {
                                <img src="@c.ImageUrl" alt="" />
                            }
                            else
                            {
                                @c.Icon
                            }
                        </span>
                        <span class="cat__name">@c.Name</span>
                    </button>
                }
            </div>

            <!-- Centre: product grid -->
            <div class="pos__products">
                <div class="product-grid">
                    @foreach (var p in _products)
                    {
                        <button class="productCard @(p.IsAvailable ? "" : "productCard--off") @(!string.IsNullOrWhiteSpace(p.ImageUrl) ? "productCard--img" : "")"
                                style="--pc:@p.Color; @(!string.IsNullOrWhiteSpace(p.ImageUrl) ? $"background-image:url('{p.ImageUrl}')" : "")"
                                disabled="@(!p.IsAvailable || _busy)"
                                @onclick="() => OnProductClick(p)">
                            <span class="productCard__price">@p.Price.ToString("N2")</span>
                            <span class="productCard__name"><span class="productCard__dot"></span>@p.Name</span>
                            @if (!p.IsAvailable)
                            {
                                <span class="productCard__off">@Loc.T("Unavailable")</span>
                            }
                        </button>
                    }
                    @if (_products.Count == 0)
                    {
                        <p class="empty">@Loc.T("No products in this category.")</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right: current order -->
    <div class="pos__order card">
        @if (_order is not null)
        {
            <div class="order__head">
                <span class="badge badge--primary">@Loc.T("Table") @_order.TableName · @_order.Number</span>
                <span class="badge">@OrderStatusLabel(_order.Status)</span>
            </div>
        }

        @if (_order is null)
        {
            <div class="order__empty">
                <p class="muted">@Loc.T("No open table.")</p>
                <button class="btn btn--primary" @onclick="() => _showTables = true">@Loc.T("Select a table")</button>
            </div>
        }
        else
        {
            <div class="order__items" @ref="_orderItemsEl">
                @foreach (var it in _order.Items)
                {
                    <div class="orderLine">
                        <div class="orderLine__main">
                            <span class="orderLine__name">@it.ProductName</span>
                            <span class="orderLine__price">@it.LineTotal.ToString("N2")</span>
                        </div>
                        <div class="orderLine__ctrl">
                            <button class="btn btn--icon btn--ghost" @onclick="() => ChangeQty(it.Id, -1)">−</button>
                            <span class="orderLine__qty">@it.Quantity</span>
                            <button class="btn btn--icon btn--ghost" @onclick="() => ChangeQty(it.Id, 1)">+</button>
                            @if (it.Status != OrderItemStatus.Pending)
                            {
                                <span class="badge @ItemStatusClass(it.Status)">@Loc.T(it.Status.ToString())</span>
                            }
                            <span class="spacer"></span>
                            <button class="btn btn--icon btn--ghost" title="@Loc.T("Extras")" @onclick="() => OpenEditExtras(it)"><LucideIcon Name="list-plus" Size="16" /></button>
                            <button class="btn btn--icon btn--ghost" title="@Loc.T("Comment")" @onclick="() => OpenComment(it)"><LucideIcon Name="pencil" Size="16" /></button>
                            <button class="btn btn--icon btn--ghost" title="@Loc.T("Remove")" @onclick="() => RemoveItem(it.Id)"><LucideIcon Name="trash-2" Size="16" /></button>
                        </div>
                        @if (it.Extras.Count > 0)
                        {
                            <div class="orderLine__extras">@string.Join(", ", it.Extras.Select(e => "＋ " + e.Name))</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(it.Comment))
                        {
                            <div class="orderLine__comment">“@it.Comment”</div>
                        }
                    </div>
                }
                @if (_order.Items.Count == 0)
                {
                    <p class="empty">@Loc.T("Tap a product to add it.")</p>
                }
            </div>

            <div class="order__totals">
                <div class="order__grand"><span>@Loc.T("Total")</span><span>@_order.Total.ToString("N2")</span></div>
            </div>

            <div class="order__actions">
                <button class="btn btn--ghost btn--block" disabled="@(_order.Items.Count == 0 || _busy)" @onclick="SendToKitchen">
                    @Loc.T("Send to kitchen")
                </button>
                <div class="order__pay">
                    <button class="btn btn--success btn--block" disabled="@(_order.Items.Count == 0 || _busy)" @onclick="TogglePayMenu">
                        <LucideIcon Name="credit-card" Size="16" />@Loc.T("Pay")
                    </button>
                    @if (_payMenuOpen)
                    {
                        <div class="pay-menu">
                            <button class="pay-menu__opt" @onclick="() => QuickCheckout(PaymentMethod.Cash)"><LucideIcon Name="banknote" Size="16" />@Loc.T("Cash")</button>
                            <button class="pay-menu__opt" @onclick="() => QuickCheckout(PaymentMethod.Card)"><LucideIcon Name="credit-card" Size="16" />@Loc.T("Card")</button>
                            <button class="pay-menu__opt" @onclick="OpenSplitFromMenu"><LucideIcon Name="split" Size="16" />@Loc.T("Split")</button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Table selector -->
<Modal Visible="_showTables" Title="@Loc.T("Open a table")" OnClose="() => _showTables = false">
    <div class="table-picker">
        @foreach (var t in _tables)
        {
            <button class="tablePick tablePick--@t.Status.ToString().ToLower()"
                    @onclick="() => OpenTable(t.Id)">
                <span class="tablePick__name">@t.Name</span>
                <span class="tablePick__seats">@t.Seats @Loc.T("seats")</span>
            </button>
        }
    </div>
</Modal>

<!-- Edit extras on an existing order line -->
<Modal Visible="_editingItem is not null" Title="@(_editingItem?.ProductName ?? string.Empty)" OnClose="() => _editingItem = null">
    <ChildContent>
        @if (_editingItem is not null)
        {
            <div class="customize">
                @if (_extrasLoading)
                {
                    <div class="customize__extras">
                        <label>@Loc.T("Extras")</label>
                        <span class="muted">@Loc.T("Loading extras…")</span>
                    </div>
                }
                else if (_customizeExtras.Count > 0)
                {
                    <div class="customize__extras">
                        <label>@Loc.T("Extras")</label>
                        <div class="extra-chips">
                            @foreach (var ex in _customizeExtras)
                            {
                                <button class="extra-chip @(_selectedExtraIds.Contains(ex.Id) ? "extra-chip--on" : "")"
                                        @onclick="() => ToggleExtra(ex.Id)" type="button">
                                    <span>@ex.Name</span>
                                    <span class="extra-chip__price">＋@ex.Price.ToString("N2")</span>
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="muted">@Loc.T("No extras available for this product.")</p>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="() => _editingItem = null">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" disabled="@(_busy || _extrasLoading)" @onclick="SaveExtras">@Loc.T("Save")</button>
    </Footer>
</Modal>

<!-- Split payment -->
<Modal Visible="_paying" Title="@Loc.T("Payment")" OnClose="() => _paying = false">
    <ChildContent>
        @if (_order is not null)
        {
            <div class="pay">
                <div class="pay__total">
                    <span class="muted">@Loc.T("Total due")</span>
                    <span class="pay__due">@_order.Total.ToString("N2")</span>
                </div>

                <div class="pay__split">
                    <span>@Loc.T("Split equally")</span>
                    <div class="qty-stepper">
                        <button class="btn btn--icon btn--ghost" @onclick="() => _splitCount = Math.Max(2, _splitCount - 1)">−</button>
                        <span class="qty-stepper__val">@_splitCount</span>
                        <button class="btn btn--icon btn--ghost" @onclick="() => _splitCount++">+</button>
                    </div>
                    <button class="btn btn--ghost" @onclick="SplitEqually">@Loc.T("Apply")</button>
                </div>

                @if (_payments.Count > 0)
                {
                    <div class="pay__list">
                        @foreach (var p in _payments)
                        {
                            <div class="pay__row">
                                <span class="pay__method"><LucideIcon Name="@MethodIcon(p.Method)" Size="15" /> @Loc.T(p.Method.ToString())</span>
                                <span class="pay__amount">@p.Amount.ToString("N2")</span>
                                <button class="btn btn--icon btn--ghost" title="@Loc.T("Remove")" @onclick="() => RemovePayment(p)"><LucideIcon Name="trash-2" Size="16" /></button>
                            </div>
                        }
                    </div>
                }

                <div class="pay__add">
                    <input type="number" step="0.01" min="0" class="input" @bind="_payAmount" />
                    <select class="select" @bind="_payMethod">
                        @foreach (var m in Enum.GetValues<PaymentMethod>())
                        {
                            <option value="@m">@Loc.T(m.ToString())</option>
                        }
                    </select>
                    <button class="btn btn--ghost" @onclick="AddPayment">@Loc.T("Add")</button>
                </div>

                <div class="pay__quick">
                    <button class="btn btn--ghost" @onclick="() => RestIn(PaymentMethod.Cash)"><LucideIcon Name="banknote" Size="16" />@Loc.T("Rest in cash")</button>
                    <button class="btn btn--ghost" @onclick="() => RestIn(PaymentMethod.Card)"><LucideIcon Name="credit-card" Size="16" />@Loc.T("Rest in card")</button>
                </div>

                <div class="pay__balance @(Remaining > 0 ? "pay__balance--due" : "pay__balance--ok")">
                    @if (Remaining > 0)
                    {
                        <span>@Loc.T("Remaining")</span><span>@Remaining.ToString("N2")</span>
                    }
                    else if (Remaining < 0)
                    {
                        <span>@Loc.T("Change")</span><span>@((-Remaining).ToString("N2"))</span>
                    }
                    else
                    {
                        <span>@Loc.T("Fully paid")</span><span><LucideIcon Name="check" Size="16" /></span>
                    }
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <span class="muted">@Loc.T("Tendered") @PaidSoFar.ToString("N2")</span>
        <span class="spacer"></span>
        <button class="btn btn--ghost" @onclick="() => _paying = false">@Loc.T("Cancel")</button>
        <button class="btn btn--success" disabled="@(Remaining > 0)" @onclick="FinalizePayment">@Loc.T("Finalize")</button>
    </Footer>
</Modal>

<!-- Comment editor -->
<Modal Visible="_commentItem is not null" Title="@Loc.T("Line comment")" OnClose="() => _commentItem = null">
    <ChildContent>
        <div class="field">
            <label>@Loc.T("Note for the kitchen")</label>
            <textarea class="input" rows="3" @bind="_commentText" placeholder="@Loc.T("No onion, well done, extra sauce…")"></textarea>
        </div>
        <div class="comment-presets">
            @foreach (var preset in _commentPresets)
            {
                <button class="btn btn--ghost" @onclick="() => _commentText = preset.Text">@preset.Text</button>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="() => _commentItem = null">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" @onclick="SaveComment">@Loc.T("Save")</button>
    </Footer>
</Modal>

@code {
    private List<CategoryCommentDto> _commentPresets = new();

    private List<CategoryDto> _categories = new();
    private List<ProductDto> _products = new();
    private List<TableDto> _tables = new();
    private OrderDto? _order;
    private int _selectedCategoryId;
    private int _userId;

    private bool _showTables;
    private OrderItemDto? _commentItem;
    private string? _commentText;

    private OrderItemDto? _editingItem;
    private List<ExtraDto> _customizeExtras = new();
    private readonly HashSet<int> _selectedExtraIds = new();
    private bool _extrasLoading;

    // Guards every server round-trip: prevents stacked clicks and keeps a failed
    // DB call from tearing down the circuit (which would freeze the whole screen).
    private bool _busy;
    private string? _error;

    private bool _paying;
    private bool _payMenuOpen;
    private readonly List<PaymentInput> _payments = new();
    private decimal _payAmount;
    private PaymentMethod _payMethod = PaymentMethod.Cash;
    private int _splitCount = 2;

    private decimal PaidSoFar => _payments.Sum(p => p.Amount);
    private decimal Remaining => Math.Round((_order?.Total ?? 0m) - PaidSoFar, 2);

    private HubConnection? _hub;

    private IJSObjectReference? _shortcuts;
    private DotNetObjectReference<Pos>? _selfRef;

    private ElementReference _orderItemsEl;
    private bool _scrollPending;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState!;
        _userId = int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;

        _categories = await Categories.GetAllAsync(onlyVisible: true);
        _selectedCategoryId = _categories.FirstOrDefault()?.Id ?? 0;
        await LoadProducts();
        await LoadTables();

        // Only open the real-time channel during the interactive render (not prerender).
        if (!RendererInfo.IsInteractive) return;

        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri(KitchenHub.Path))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<int, int>(KitchenHub.ItemStatusChanged, async (orderId, _) =>
        {
            if (_order?.Id == orderId) { _order = await Orders.GetByIdAsync(orderId); await InvokeAsync(StateHasChanged); }
        });
        _hub.On<int>(KitchenHub.OrderReady, async orderId =>
        {
            if (_order?.Id == orderId)
            {
                _order = await Orders.GetByIdAsync(orderId);
                await JS.InvokeVoidAsync("posBeep");
                await InvokeAsync(StateHasChanged);
            }
        });

        await _hub.StartAsync();

        // Keyboard shortcuts (see the ? overlay).
        _selfRef = DotNetObjectReference.Create(this);
        _shortcuts = await JS.InvokeAsync<IJSObjectReference>("import", "./js/shortcuts.js");
        await _shortcuts.InvokeVoidAsync("register", _selfRef);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollPending) return;
        _scrollPending = false;
        await JS.InvokeVoidAsync("posScrollBottom", _orderItemsEl);
    }

    [JSInvokable]
    public async Task OnKey(string key)
    {
        if (key == "Escape")
        {
            if (_paying) _paying = false;
            else if (_payMenuOpen) _payMenuOpen = false;
            else if (_editingItem is not null) _editingItem = null;
            else if (_commentItem is not null) _commentItem = null;
            else if (_showTables) _showTables = false;
            StateHasChanged();
            return;
        }

        // While the payment dialog is open, Enter finalises a fully-covered bill.
        if (_paying)
        {
            if (key == "Enter" && Remaining <= 0) await FinalizePayment();
            return;
        }

        // Ignore action keys while another modal is open.
        if (_editingItem is not null || _commentItem is not null || _showTables) return;

        switch (key.ToLowerInvariant())
        {
            case "k" when _order?.Items.Count > 0: await SendToKitchen(); break;
            case "p" when _order?.Items.Count > 0: OpenPayment(); break;
            case "c" when _order?.Items.Count > 0: await Checkout(PaymentMethod.Cash); break;
            case "t": _showTables = true; break;
            case "+" or "=": await ChangeLastQty(1); break;
            case "-": await ChangeLastQty(-1); break;
            case "backspace" or "delete": await RemoveLastLine(); break;
            default:
                if (key.Length == 1 && key[0] is >= '1' and <= '9')
                {
                    var idx = key[0] - '1';
                    if (idx < _categories.Count) await SelectCategory(_categories[idx].Id);
                }
                break;
        }
        StateHasChanged();
    }

    // Runs a server operation with a single in-flight guard. Stacked clicks are
    // ignored (returns immediately) and any failure surfaces as a dismissible toast
    // instead of crashing the SignalR circuit and freezing the page.
    private async Task RunAsync(Func<Task> op)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            await op();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ChangeLastQty(int delta)
    {
        var last = _order?.Items.LastOrDefault();
        return last is null ? Task.CompletedTask : ChangeQty(last.Id, delta);
    }

    private Task RemoveLastLine()
    {
        var last = _order?.Items.LastOrDefault();
        return last is null ? Task.CompletedTask : RemoveItem(last.Id);
    }

    private async Task SelectCategory(int id)
    {
        _selectedCategoryId = id;
        await LoadProducts();
    }

    private async Task LoadProducts() =>
        _products = _selectedCategoryId == 0 ? new() : await Products.GetByCategoryAsync(_selectedCategoryId, onlyAvailable: false);

    private async Task LoadTables() => _tables = await Tables.GetAllAsync();

    private Task OnProductClick(ProductDto p)
    {
        if (_order is null) { _showTables = true; return Task.CompletedTask; }
        var orderId = _order.Id;
        return RunAsync(async () =>
        {
            _order = await Orders.AddItemAsync(new AddItemRequest(orderId, p.Id, Merge: false));
            _scrollPending = true;
        });
    }

    private async Task OpenEditExtras(OrderItemDto item)
    {
        // Show the dialog immediately, then fetch the extras. Awaiting the DB call
        // before rendering made the button feel frozen on slow round-trips.
        _editingItem = item;
        _customizeExtras = new();
        _selectedExtraIds.Clear();
        foreach (var e in item.Extras.Where(e => e.ExtraId.HasValue))
            _selectedExtraIds.Add(e.ExtraId!.Value);
        _extrasLoading = true;
        StateHasChanged();

        try { _customizeExtras = await Products.GetExtrasAsync(item.ProductId); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _extrasLoading = false; }
    }

    private void ToggleExtra(int id)
    {
        if (!_selectedExtraIds.Add(id)) _selectedExtraIds.Remove(id);
    }

    private Task SaveExtras()
    {
        if (_editingItem is null) return Task.CompletedTask;
        var itemId = _editingItem.Id;
        var extraIds = _selectedExtraIds.ToList();

        return RunAsync(async () =>
        {
            _order = await Orders.SetItemExtrasAsync(itemId, extraIds) ?? _order;
            _editingItem = null;
        });
    }

    private Task OpenTable(int tableId) => RunAsync(async () =>
    {
        _order = await Orders.OpenOrderAsync(tableId, _userId);
        _showTables = false;
        await LoadTables();
    });

    private Task ChangeQty(int itemId, int delta) =>
        RunAsync(async () => _order = await Orders.ChangeQuantityAsync(itemId, delta));

    private Task RemoveItem(int itemId) =>
        RunAsync(async () => _order = await Orders.RemoveItemAsync(itemId));

    private async Task OpenComment(OrderItemDto item)
    {
        _commentItem = item;
        _commentText = item.Comment;
        _commentPresets = await Categories.GetCommentsAsync(item.CategoryId);
    }

    private Task SaveComment() => RunAsync(async () =>
    {
        if (_commentItem is not null)
        {
            await Orders.SetItemCommentAsync(_commentItem.Id, _commentText);
            _order = await Orders.GetByIdAsync(_order!.Id);
        }
        _commentItem = null;
    });

    private Task SendToKitchen()
    {
        if (_order is null) return Task.CompletedTask;
        var orderId = _order.Id;
        return RunAsync(async () =>
        {
            await Orders.SendToKitchenAsync(orderId);
            _order = await Orders.GetByIdAsync(orderId);
        });
    }

    private Task Checkout(PaymentMethod method)
    {
        if (_order is null) return Task.CompletedTask;
        var orderId = _order.Id;
        return RunAsync(async () =>
        {
            await Orders.CheckoutAsync(orderId, method);
            _order = null;
            await LoadTables();
        });
    }

    // ---- Single "Pay" button: a small menu for Cash / Card / Split, instead of three buttons ----
    private void TogglePayMenu() => _payMenuOpen = !_payMenuOpen;

    private Task QuickCheckout(PaymentMethod method)
    {
        _payMenuOpen = false;
        return Checkout(method);
    }

    private void OpenSplitFromMenu()
    {
        _payMenuOpen = false;
        OpenPayment();
    }

    // ---- Split payment ----
    private void OpenPayment()
    {
        if (_order is null) return;
        _payments.Clear();
        _payMethod = PaymentMethod.Cash;
        _payAmount = _order.Total;
        _splitCount = 2;
        _paying = true;
    }

    private void AddPayment()
    {
        if (_payAmount <= 0) return;
        _payments.Add(new PaymentInput(_payAmount, _payMethod));
        _payAmount = Math.Max(0, Remaining);
    }

    private void RemovePayment(PaymentInput p)
    {
        _payments.Remove(p);
        _payAmount = Math.Max(0, Remaining);
    }

    private void RestIn(PaymentMethod method)
    {
        if (Remaining > 0) { _payments.Add(new PaymentInput(Remaining, method)); _payAmount = 0; }
    }

    private void SplitEqually()
    {
        if (_order is null || _splitCount < 2) return;
        _payments.Clear();
        var each = Math.Round(_order.Total / _splitCount, 2);
        for (var i = 0; i < _splitCount; i++)
        {
            var amount = i == _splitCount - 1 ? _order.Total - each * (_splitCount - 1) : each;
            _payments.Add(new PaymentInput(amount, PaymentMethod.Cash));
        }
        _payAmount = 0;
    }

    private Task FinalizePayment()
    {
        if (_order is null) return Task.CompletedTask;
        var orderId = _order.Id;
        var payments = _payments.ToList();
        return RunAsync(async () =>
        {
            await Orders.CheckoutAsync(orderId, payments);
            _paying = false;
            _order = null;
            await LoadTables();
        });
    }

    // Lucide icon name per payment method (rendered via <LucideIcon>).
    private static string MethodIcon(PaymentMethod m) => m switch
    {
        PaymentMethod.Cash => "banknote",
        PaymentMethod.Card => "credit-card",
        _ => "receipt"
    };

    private static string OrderStatusLabel(OrderStatus s) => Loc.T(s switch
    {
        OrderStatus.Open => "Open",
        OrderStatus.Sent => "Sent",
        OrderStatus.InPreparation => "Cooking",
        OrderStatus.Ready => "Ready",
        OrderStatus.Delivered => "Delivered",
        _ => s.ToString()
    });

    private static string ItemStatusClass(OrderItemStatus s) => s switch
    {
        OrderItemStatus.Preparing => "badge--warning",
        OrderItemStatus.Ready => "badge--success",
        OrderItemStatus.Delivered => "badge--primary",
        _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        if (_shortcuts is not null)
        {
            try { await _shortcuts.InvokeVoidAsync("unregister"); await _shortcuts.DisposeAsync(); }
            catch { /* circuit already gone */ }
        }
        _selfRef?.Dispose();
        if (_hub is not null) await _hub.DisposeAsync();
    }
}
