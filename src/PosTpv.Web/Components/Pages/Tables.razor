    private void CancelSelect() { _selecting = false; _selection.Clear(); }

    // ---- Reassign an open order to another table ----
    private void StartReassign() { CancelAssign(); StopPaintMode(); _reassigning = true; _reassignSource = null; _reassignDestId = null; _notice = null; }
    private void CancelReassign() { _reassigning = false; _reassignSource = null; _reassignDestId = null; }

    private async Task ConfirmReassign()
    {
        if (_reassignSource?.ActiveOrderId is null || _reassignDestId is null) return;
        await OrderSvc.MoveOrderToTableAsync(_reassignSource.ActiveOrderId.Value, _reassignDestId.Value);
        CancelReassign();
        await Load();
    }

    // Joining asks for a name first (defaulting to "T1 + T2") so the group reads as one table
    // everywhere, instead of leaving each member's own name showing.
    private bool _showJoinNamePrompt;
    private string _joinNameInput = "";

    private void OpenJoinNamePrompt()
    {
        _joinNameInput = string.Join(" + ", _tables.Where(t => _selection.Contains(t.Id)).OrderBy(t => t.Name).Select(t => t.Name));
        _showJoinNamePrompt = true;
    }

