@page "/tables"
@* No prerender: with ~85 tables (and ~300 chairs) the prerendered map was built, painted, then
   thrown away and rebuilt from scratch once the circuit connected (Blazor doesn't reuse
   prerendered DOM). Rendering it only once, interactively, gets the usable map on screen in about
   half the time. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin,Waiter,Cashier")]
@using System.Globalization
@using System.Security.Claims
@using FluentValidation
@using static PosTpv.Web.Components.Shared.FloorPlanHelpers
@implements IAsyncDisposable
@inject ITableService Service
@inject IFloorDecorService DecorService
@inject IFloorZoneService ZoneService
@inject IReservationService ReservationService
@inject IOrderService OrderSvc
@inject IValidator<TableFormDto> Validator
@inject IValidator<ReservationFormDto> ResValidator
@inject IJSRuntime JS
@inject AppSettingsCache Branding
@inject ISettingsService Settings
@inject NavigationManager Nav

<PageTitle>Tables · @Branding.Current.Title</PageTitle>

<div class="floor-layout floor-layout--split floor-layout--map-expanded">
    <div class="floor-panel card">
        @if (_notice is not null)
        {
            <p class="floor-notice">@_notice</p>
        }
        @if (_selecting)
        {
            <p class="floor-hint muted">@Loc.T("Tap two or more free tables to join them into one group that shares a single bill.")</p>
        }

    <div class="floor-wrap">
    @* Mirrors .floor-settings on the opposite corner: floats over the map's top-left corner
       instead of taking its own row, so it stays reachable no matter which toolbar row
       (Edit/Select/Reassign/default) is showing on the right. *@
    <div class="floor-tex-widget floor-resv-corner">
    <button class="btn btn--icon @(_resSidebarOpen ? "btn--primary" : "btn--ghost") btn--sm" type="button"
            title="@(_resSidebarOpen ? Loc.T("Hide reservations") : Loc.T("Show reservations"))" @onclick="ToggleResSidebar">
        <LucideIcon Name="calendar" Size="16" />
    </button>
    @if (_resSidebarOpen)
    {
        <div class="resv-col @(_resSidebarClosing ? "resv-col--closing" : "")" @ref="_resvPanelEl">
        <aside class="resv card">
        <div class="tables-datebar" @ref="_resvHeaderEl">
            <div class="resv__day-nav">
                <div class="resv__day-nav-side">
                    <div class="resv-policy">
                        @* Replaces the old gear-icon trigger: the dot itself already shows the current
                           policy at a glance (colour-coded, see PolicyDotColor), still opens the same
                           picker menu on click. Stays visible even while a reservation is being
                           created/edited, since it's the "are we taking reservations" indicator, not
                           part of the form. *@
                        <button type="button" class="resv-policy-dot" style="--dot:@PolicyDotColor(Branding.Current.ReservationPolicy)" title="@Loc.T(PolicyLabel(Branding.Current.ReservationPolicy))" @onclick="TogglePolicyMenu"></button>
                        @if (_policyMenuOpen)
                        {
                            <div class="resv-policy__backdrop" @onclick="ClosePolicyMenu"></div>
                            <div class="resv-policy__menu" @onclick:stopPropagation="true">
                                <div class="resv-policy__title">@Loc.T("Taking reservations")</div>
                                @foreach (var opt in ReservationPolicies)
                                {
                                    <button type="button" class="resv-policy__opt @(Branding.Current.ReservationPolicy == opt.Value ? "resv-policy__opt--on" : "")"
                                            disabled="@opt.ComingSoon" @onclick="() => SetReservationPolicy(opt.Value)">
                                        <span>@Loc.T(opt.Label)</span>
                                        @if (opt.ComingSoon)
                                        {
                                            <span class="badge">@Loc.T("Coming soon")</span>
                                        }
                                        else if (Branding.Current.ReservationPolicy == opt.Value)
                                        {
                                            <LucideIcon Name="check" Size="14" />
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <h2>@Loc.T("Reservations")</h2>
                </div>
                <div class="resv__day-nav-center">
                    <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Previous day")" @onclick="() => ShiftDay(-1)"><LucideIcon Name="arrow-left" Size="11" /></button>
                    <div class="resv__head-date-wrap">
                        <div class="tabs resv__head-periods">
                            <button class="tabs__opt @(_periodFilter == ServicePeriod.Lunch ? "tabs__opt--on" : "")" title="@Loc.T("Lunch")"
                                    @onclick="() => _periodFilter = _periodFilter == ServicePeriod.Lunch ? null : ServicePeriod.Lunch">
                                <LucideIcon Name="sun" Size="10" />
                            </button>
                            <button class="tabs__opt @(_periodFilter == ServicePeriod.Dinner ? "tabs__opt--on" : "")" title="@Loc.T("Dinner")"
                                    @onclick="() => _periodFilter = _periodFilter == ServicePeriod.Dinner ? null : ServicePeriod.Dinner">
                                <LucideIcon Name="moon" Size="10" />
                            </button>
                        </div>
                        <button type="button" class="resv__head-date" @onclick="() => _showDatePicker = !_showDatePicker">@_reserveDate.ToString("dd/MM/yyyy")</button>
                        <button type="button" class="resv__head-date-icon" title="@Loc.T("Pick a date")" @onclick="() => _showDatePicker = !_showDatePicker"><LucideIcon Name="calendar" Size="14" /></button>
                        @if (_showDatePicker)
                        {
                            <div class="resv-date__backdrop" @onclick="() => _showDatePicker = false"></div>
                            <div class="resv-date__menu" @onclick:stopPropagation="true">
                                <Calendar Value="_reserveDate" ValueChanged="PickReserveDate" />
                            </div>
                        }
                    </div>
                    <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Next day")" @onclick="() => ShiftDay(1)"><LucideIcon Name="arrow-right" Size="11" /></button>
                </div>
                <div class="resv__day-nav-side resv__day-nav-side--end">
                    @if (_resForm is null)
                    {
                        <button class="btn btn--primary btn--icon resv__new-btn" title="@Loc.T("New reservation")" @onclick="() => OpenResForm(null)"><LucideIcon Name="plus" Size="13" /></button>
                    }
                    else
                    {
                        @if (_resForm.Id > 0)
                        {
                            <button class="btn btn--icon btn--ghost" title="@Loc.T("Delete")" @onclick="() => DeleteRes(_resForm.Id)" type="button"><LucideIcon Name="trash-2" Size="13" /></button>
                        }
                        <button class="btn btn--icon btn--ghost" title="@Loc.T("Close")" @onclick="CloseResForm" type="button"><LucideIcon Name="x" Size="13" /></button>
                        <button class="btn btn--icon btn--primary" title="@Loc.T("Save")" disabled="@_savingRes" @onclick="SaveRes" type="button"><LucideIcon Name="check" Size="13" /></button>
                    }
                </div>
            </div>
        </div>
        @if (_resForm is not null)
        {
            @if (_resForm.Id > 0)
            {
                <div class="resv__head">
                    <h2>@Loc.T("Edit reservation")</h2>
                </div>
            }
            <div class="resv-wizard">
                @if (_saveSuccess)
                {
                    <div class="resv-success">
                        <div class="resv-success__circle"><LucideIcon Name="check" Size="26" /></div>
                        <p class="resv-success__text">@(_wasNewReservation ? Loc.T("Reservation created") : Loc.T("Changes saved"))</p>
                    </div>
                }
                else
                {
                <div class="resv-form">
                    <div class="resv-steps">
                        <div class="resv-steps__track"></div>
                        <div class="resv-steps__progress" style="width:@(N(StepProgressWidthPercent))%"></div>
                        @foreach (var s in ResSteps)
                        {
                            <button type="button"
                                    class="resv-step @(s.Step == _resStep ? "resv-step--on" : "") @(s.Step < _resMaxStep && s.Step != _resStep ? "resv-step--done" : "")"
                                    disabled="@(s.Step > _resMaxStep)" @onclick="() => GoToStep(s.Step)">
                                <span class="resv-step__num">@(s.Step < _resMaxStep ? "✓" : s.Step.ToString())</span>
                                <span class="resv-step__label">@Loc.T(s.Label)</span>
                            </button>
                        }
                    </div>

                    <div class="resv-step-panel">
                        @if (_resStep == 1)
                        {
                            <div class="resv-row">
                                <div class="field"><label>@Loc.T("Customer name")</label><input class="input" @bind="_resForm.CustomerName" /></div>
                                <div class="field">
                                    <label>@Loc.T("Phone")</label>
                                    <div class="phone-field">
                                        <button type="button" class="phone-prefix" @onclick="TogglePrefixMenu">
                                            @_phonePrefix<LucideIcon Name="chevron-down" Size="11" />
                                        </button>
                                        <input class="input" @bind="_phoneLocal" @bind:event="oninput" @bind:after="SyncPhone" />
                                        @if (_prefixMenuOpen)
                                        {
                                            <div class="phone-prefix__backdrop" @onclick="ClosePrefixMenu"></div>
                                            <div class="phone-prefix__menu" @onclick:stopPropagation="true">
                                                <input class="input phone-prefix__search" placeholder="@Loc.T("Search country or code…")"
                                                       @bind="_prefixSearch" @bind:event="oninput" autofocus />
                                                <div class="phone-prefix__list">
                                                    @foreach (var p in FilteredPrefixes)
                                                    {
                                                        <button type="button" class="phone-prefix__opt @(p.Code == _phonePrefix ? "phone-prefix__opt--on" : "")" @onclick="() => PickPrefix(p.Code)">
                                                            <span>@p.Name</span>
                                                            <span class="muted">@p.Code</span>
                                                        </button>
                                                    }
                                                    @if (!FilteredPrefixes.Any()) { <p class="empty">@Loc.T("No matches.")</p> }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="resv-row resv-row--guest">
                                <div class="field"><label>@Loc.T("Party size")</label><input type="number" min="0" class="input" @bind="_resForm.PartySize" /></div>
                                <div class="field"><label><LucideIcon Name="baby" Size="12" /> @Loc.T("Children")</label><input type="number" min="0" class="input" @bind="_resForm.ChildrenCount" /></div>
                                <div class="field"><label><LucideIcon Name="armchair" Size="12" /> @Loc.T("High chairs")</label><input type="number" min="0" class="input" @bind="_resForm.HighChairCount" /></div>
                            </div>
                            <div class="field"><label>@Loc.T("Total")</label><div class="field-static">@FormTotalGuests @Loc.T("people")</div></div>
                        }
                        else if (_resStep == 2)
                        {
                            <Calendar Value="_resForm.Date" ValueChanged="PickDate" />
                        }
                        else if (_resStep == 3)
                        {
                            <div class="period-picker">
                                <button type="button" class="period-opt @(Branding.Current.GetPeriod(_resForm.Time) == ServicePeriod.Lunch ? "period-opt--on" : "")"
                                        @onclick="() => PickPeriod(Branding.Current.LunchStart)">
                                    <LucideIcon Name="sun" Size="16" />
                                    <span class="period-opt__label">@Loc.T("Lunch")</span>
                                    <span class="period-opt__time">@Branding.Current.LunchStart.ToString("HH:mm")–@Branding.Current.LunchEnd.ToString("HH:mm")</span>
                                </button>
                                <button type="button" class="period-opt @(Branding.Current.GetPeriod(_resForm.Time) == ServicePeriod.Dinner ? "period-opt--on" : "")"
                                        @onclick="() => PickPeriod(Branding.Current.DinnerStart)">
                                    <LucideIcon Name="moon" Size="16" />
                                    <span class="period-opt__label">@Loc.T("Dinner")</span>
                                    <span class="period-opt__time">@Branding.Current.DinnerStart.ToString("HH:mm")–@Branding.Current.DinnerEnd.ToString("HH:mm")</span>
                                </button>
                            </div>
                            var slots = CurrentPeriodSlots;
                            @if (slots.Count > 0)
                            {
                                <div class="slot-grid">
                                    @foreach (var slot in slots)
                                    {
                                        <button type="button" class="slot-chip @(slot == _resForm.Time ? "slot-chip--on" : "")" @onclick="() => PickSlot(slot)">@slot.ToString("HH:mm")</button>
                                    }
                                </div>
                            }
                        }
                        else if (_resStep == 4)
                        {
                            <div class="resv-summary__title">@(_resForm.Id > 0 ? Loc.T("Edit reservation") : Loc.T("New reservation"))</div>
                            <div class="resv-summary">
                                <div class="resv-summary__row"><LucideIcon Name="user" Size="14" /> @(string.IsNullOrWhiteSpace(_resForm.CustomerName) ? Loc.T("Customer name") : _resForm.CustomerName) @if (!string.IsNullOrWhiteSpace(_resForm.Phone)) { <span class="muted"> · @_resForm.Phone</span> }</div>
                                <div class="resv-summary__row"><LucideIcon Name="users" Size="14" /> @FormTotalGuests @Loc.T("people")
                                    @if (_resForm.ChildrenCount > 0) { <span class="muted"> · <LucideIcon Name="baby" Size="13" /> @_resForm.ChildrenCount</span> }
                                    @if (_resForm.HighChairCount > 0) { <span class="muted"> · <LucideIcon Name="armchair" Size="13" /> @_resForm.HighChairCount</span> }
                                </div>
                                <div class="resv-summary__row"><LucideIcon Name="calendar" Size="14" /> @_resForm.Date.ToString("dd MMM yyyy")</div>
                                <div class="resv-summary__row"><LucideIcon Name="@(Branding.Current.GetPeriod(_resForm.Time) == ServicePeriod.Lunch ? "sun" : "moon")" Size="14" /> @Loc.T(Branding.Current.GetPeriod(_resForm.Time) == ServicePeriod.Lunch ? "Lunch" : "Dinner") · @_resForm.Time.ToString("HH:mm")</div>
                            </div>
                            <div class="field"><label>@Loc.T("Comments")</label><textarea class="input" rows="2" @bind="_resForm.Comments"></textarea></div>
                        }

                        @if (_resError is not null) { <div class="field-error">@_resError</div> }
                    </div>

                    <div class="resv-nav @(_resStep == ResSteps.Length ? "resv-nav--joined" : "")">
                        @if (_resStep > 1)
                        {
                            <button type="button" class="btn btn--ghost resv-nav__back--full" @onclick="GoBack"><LucideIcon Name="arrow-left" Size="16" />@Loc.T("Back")</button>
                        }
                        @if (_resStep == 1 && _resStep < ResSteps.Length)
                        {
                            <button type="button" class="btn btn--primary resv-nav__next"
                                    @onclick="GoNext">@Loc.T("Next")<LucideIcon Name="arrow-right" Size="16" /></button>
                        }
                        else if (_resStep == ResSteps.Length)
                        {
                            <button type="button" class="btn btn--primary resv-nav__next" disabled="@_savingRes" @onclick="SaveRes">
                                @(_resForm.Id > 0 ? Loc.T("Save changes") : Loc.T("Create reservation"))
                            </button>
                        }
                    </div>
                </div>
                }
            </div>
        }
        else
        {
            <div class="resv__list">
                @foreach (var r in FilteredReservations)
                {
                    <div class="resv-card @(_assignReservationId == r.Id ? "resv-card--active" : "")" data-status="@r.Status.ToString().ToLowerInvariant()">
                        <div class="resv-card__time">
                            <strong>@r.Time.ToString("HH:mm")</strong>
                            <span class="resv-card__period" title="@Loc.T(PeriodLabel(r.Time))"><LucideIcon Name="@PeriodIcon(r.Time)" Size="13" /></span>
                        </div>
                        <div class="resv-card__top">
                            <span class="resv-card__name">@r.CustomerName</span>
                            <span class="spacer"></span>
                            <div class="resv-status">
                                <button type="button" class="badge resv-card__status @StatusClass(r.Status)" title="@Loc.T("Status")" @onclick="() => ToggleStatusMenu(r.Id)">
                                    @Loc.T(r.Status.ToString())
                                </button>
                                @if (_statusMenuOpenId == r.Id)
                                {
                                    <div class="resv-status__menu">
                                        @foreach (var s in Enum.GetValues<ReservationStatus>())
                                        {
                                            <button type="button" class="resv-status__opt @(s == r.Status ? "resv-status__opt--on" : "")" @onclick="() => ChooseStatus(r.Id, s)">
                                                <span class="badge @StatusClass(s)">@Loc.T(s.ToString())</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Edit")" @onclick="() => OpenResForm(r.Id)"><LucideIcon Name="pencil" Size="14" /></button>
                        </div>
                        <div class="resv-card__meta">
                            <span class="resv-card__stat" title="@Loc.T("Guests")"><LucideIcon Name="users" Size="13" /> @(r.PartySize + r.ChildrenCount)</span>
                            @if (r.ChildrenCount > 0)
                            {
                                <span class="resv-card__stat"><LucideIcon Name="baby" Size="13" /> @r.ChildrenCount</span>
                            }
                            @if (r.HighChairCount > 0)
                            {
                                <span class="resv-card__stat"><LucideIcon Name="armchair" Size="13" /> @r.HighChairCount</span>
                            }
                            @if (r.TableNames.Count > 0)
                            {
                                <span class="resv-card__tables">
                                    @* First click on an assigned chip only reveals its own quick-remove X
                                       (shares _selectedAssignedTableId with the floor map's identical X) instead
                                       of jumping straight into the "change table" picker — a second click on that
                                       same chip falls through to ToggleAssign as before. *@
                                    @foreach (var (tableId, name) in r.TableIds.Zip(r.TableNames))
                                    {
                                        <span class="tbl-chip-wrap">
                                            <button type="button" class="tbl-chip tbl-chip--sm" title="@Loc.T("Click to change table")" @onclick="() => OnAssignedChipClick(r, tableId)"><LucideIcon Name="armchair" Size="12" /> @name</button>
                                            @if (_selectedAssignedTableId == tableId)
                                            {
                                                <button type="button" class="tbl-chip__unassign" title="@Loc.T("Remove from reservation")" @onclick="() => RemoveTableFromReservation(r.Id, tableId)" @onclick:stopPropagation="true"><LucideIcon Name="x" Size="7" /></button>
                                            }
                                        </span>
                                    }
                                    @if (_assignReservationId == r.Id)
                                    {
                                        <button type="button" class="btn btn--icon btn--primary btn--sm resv-card__confirm-assign" title="@Loc.T("Done")" @onclick="CancelAssign"><LucideIcon Name="check" Size="13" /></button>
                                        <button type="button" class="btn btn--icon btn--ghost btn--sm resv-card__confirm-assign" title="@Loc.T("Cancel")" @onclick="CancelAssign"><LucideIcon Name="x" Size="13" /></button>
                                    }
                                    else if (_selectedAssignedTableId is not null && r.TableIds.Contains(_selectedAssignedTableId.Value))
                                    {
                                        @* Shown alongside a chip's revealed X (see above) so the row-level check/cross
                                           are reachable right away too — check opens the same "change table" picker as
                                           tapping the chip a second time, cross just closes the reveal. *@
                                        <button type="button" class="btn btn--icon btn--primary btn--sm resv-card__confirm-assign" title="@Loc.T("Change table")" @onclick="() => ToggleAssign(r)"><LucideIcon Name="check" Size="13" /></button>
                                        <button type="button" class="btn btn--icon btn--ghost btn--sm resv-card__confirm-assign" title="@Loc.T("Close")" @onclick="() => _selectedAssignedTableId = null"><LucideIcon Name="x" Size="13" /></button>
                                    }
                                </span>
                            }
                            else
                            {
                                @* Direct shortcut into assign mode — same as the "Assign" button tucked behind
                                   the gear icon below, but reachable in one tap instead of two. Tick + cross both
                                   sit right next to it as soon as assign mode opens (not only once a table's
                                   been picked), so there's always a visible way to finish/cancel right here
                                   instead of the floating "Done" hints this replaces. *@
                                <button type="button" class="tbl-chip tbl-chip--sm tbl-chip--unassigned" @onclick="() => ToggleAssign(r)">@Loc.T("Unassigned")</button>
                                @if (_assignReservationId == r.Id)
                                {
                                    <button type="button" class="btn btn--icon btn--primary btn--sm resv-card__confirm-assign" title="@Loc.T("Done")" @onclick="CancelAssign"><LucideIcon Name="check" Size="13" /></button>
                                    <button type="button" class="btn btn--icon btn--ghost btn--sm resv-card__confirm-assign" title="@Loc.T("Cancel")" @onclick="CancelAssign"><LucideIcon Name="x" Size="13" /></button>
                                }
                            }
                            <span class="spacer"></span>
                            @if (r.Status is ReservationStatus.Pending or ReservationStatus.Confirmed)
                            {
                                <button class="btn btn--primary btn--sm" disabled="@(r.TableIds.Count == 0)"
                                        title="@(r.TableIds.Count == 0 ? Loc.T("Assign a table before seating this reservation.") : null)"
                                        @onclick="() => SetResStatus(r.Id, ReservationStatus.Seated)"><LucideIcon Name="check" Size="15" />@Loc.T("Seat")</button>
                            }
                            else if (r.Status == ReservationStatus.Seated)
                            {
                                <button class="btn btn--primary btn--sm" @onclick="() => SetResStatus(r.Id, ReservationStatus.Finished)"><LucideIcon Name="log-out" Size="15" />@Loc.T("Mark as left")</button>
                            }
                        </div>
                    </div>
                }
                @if (_reservations.Count == 0) { <p class="empty">@Loc.T("No reservations for this day.")</p> }
                else if (FilteredReservations.Count == 0) { <p class="empty">@Loc.T("No reservations for this service.")</p> }
            </div>
        }
        </aside>
        <div class="resv__resize-handle" @ref="_resvResizeEl" title="@Loc.T("Resize")"></div>
        </div>
    }
    </div>
    @* Floats over the map's top-right corner instead of taking its own row, so the map
       fills the whole panel height. *@
    <div class="toolbar toolbar--tables @(_editing || _selecting || _reassigning || _paintMode || _showFilters ? "toolbar--tables-row" : "") @(_showFilters ? "toolbar--tables-menu-open" : "")">
        <span class="spacer"></span>
        @* Rendered unconditionally (outside the Edit/Select/Reassign/default branches below) and
           absolutely positioned (.floor-settings) so it always sits in the map's top-right corner —
           it used to live inside the "default" toolbar-actions row only, so it vanished entirely
           whenever _editing/_selecting/_reassigning replaced that row with their own controls. *@
        <div class="floor-tex-widget floor-settings">
            <button class="btn btn--icon @(_showFilters ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Filters")" @onclick="() => _showFilters = !_showFilters"><LucideIcon Name="settings" Size="16" /></button>
            @if (_showFilters)
            {
                <div class="floor-tools-menu">
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_zoneMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Zones")" @onclick="ToggleZoneMenu"><LucideIcon Name="square-dashed" Size="16" /></button>
                        @if (_zoneMenuOpen || _zoneMenuClosing)
                        {
                            <div class="floor-tex-menu zone-pick @(_zoneMenuClosing ? "floor-tex-menu--closing" : "")">
                                @foreach (var z in _zones)
                                {
                                    <button type="button" class="zone-chip" style="@(z.Color is not null && !IsImageColor(z.Color) ? $"--zc:{z.Color}" : "")" @onclick="() => { OnZoneClick(z); _zoneMenuOpen = false; _zoneEditActive = true; StartEdit(); }">@z.Name</button>
                                }
                                <button type="button" class="floor-tex-opt" title="@Loc.T("Add zone")" @onclick="AddZone">
                                    <span class="zone-swatch"><LucideIcon Name="plus" Size="14" /></span>
                                    <span class="floor-tex-opt__label">@Loc.T("Add zone")</span>
                                </button>
                            </div>
                        }
                    </div>
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_floorMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Floor style")" @onclick="ToggleFloorMenu"><LucideIcon Name="image" Size="16" /></button>
                        @if (_floorMenuOpen || _floorMenuClosing)
                        {
                            <div class="floor-tex-menu tex-pick @(_floorMenuClosing ? "floor-tex-menu--closing" : "")">
                                @foreach (var tex in FloorTextures)
                                {
                                    <button type="button" class="floor-tex-opt @(Branding.Current.FloorTexture == tex ? "floor-tex-opt--on" : "")" title="@Loc.T(TextureLabel(tex))" @onclick="() => ChooseFloorTexture(tex)">
                                        <span class="floor-tex-swatch floor-tex-swatch--@tex"></span>
                                        <span class="floor-tex-opt__label">@Loc.T(TextureLabel(tex))</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_paintMode || _paintMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Paint table colours")" @onclick="TogglePaintMenu"><LucideIcon Name="palette" Size="16" /></button>
                    </div>
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_plantMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Plants")" @onclick="TogglePlantMenu"><LucideIcon Name="leaf" Size="16" /></button>
                        @if (_plantMenuOpen || _plantMenuClosing)
                        {
                            <div class="floor-tex-menu plant-pick @(_plantMenuClosing ? "floor-tex-menu--closing" : "")">
                                @foreach (var type in PlantTypes)
                                {
                                    <button type="button" class="floor-tex-opt" title="@Loc.T(DecorLabel(type))" @onclick="() => AddDecor(type)">
                                        <span class="decor-swatch decor-swatch--@DecorSlug(type)"></span>
                                        <span class="floor-tex-opt__label">@Loc.T(DecorLabel(type))</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_designMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Design elements")" @onclick="ToggleDesignMenu"><LucideIcon Name="layout-template" Size="16" /></button>
                        @if (_designMenuOpen || _designMenuClosing)
                        {
                            <div class="floor-tex-menu design-pick @(_designMenuClosing ? "floor-tex-menu--closing" : "")">
                                @foreach (var type in InteriorTypes)
                                {
                                    <button type="button" class="floor-tex-opt" title="@Loc.T(DecorLabel(type))" @onclick="() => AddDecor(type)">
                                        <span class="decor-swatch decor-swatch--@DecorSlug(type)"></span>
                                        <span class="floor-tex-opt__label">@Loc.T(DecorLabel(type))</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_furnitureMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Furniture")" @onclick="ToggleFurnitureMenu"><LucideIcon Name="sofa" Size="16" /></button>
                        @if (_furnitureMenuOpen || _furnitureMenuClosing)
                        {
                            <div class="floor-tex-menu design-pick @(_furnitureMenuClosing ? "floor-tex-menu--closing" : "")">
                                @foreach (var type in FurnitureTypes)
                                {
                                    <button type="button" class="floor-tex-opt" title="@Loc.T(DecorLabel(type))" @onclick="() => AddDecor(type)">
                                        <span class="decor-swatch decor-swatch--@DecorSlug(type)"></span>
                                        <span class="floor-tex-opt__label">@Loc.T(DecorLabel(type))</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_leisureMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Leisure")" @onclick="ToggleLeisureMenu"><LucideIcon Name="gamepad-2" Size="16" /></button>
                        @if (_leisureMenuOpen || _leisureMenuClosing)
                        {
                            <div class="floor-tex-menu design-pick @(_leisureMenuClosing ? "floor-tex-menu--closing" : "")">
                                @foreach (var type in LeisureTypes)
                                {
                                    <button type="button" class="floor-tex-opt" title="@Loc.T(DecorLabel(type))" @onclick="() => AddDecor(type)">
                                        <span class="decor-swatch decor-swatch--@DecorSlug(type)"></span>
                                        <span class="floor-tex-opt__label">@Loc.T(DecorLabel(type))</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        @if (_editing)
        {
            <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Cancel")" @onclick="CancelEdit"><LucideIcon Name="x" Size="16" /></button>
            <button class="btn btn--icon btn--primary btn--sm" title="@Loc.T("Save layout")" @onclick="SaveLayout"><LucideIcon Name="save" Size="14" /></button>
        }
        else if (_selecting)
        {
            <span class="badge badge--primary">@_selection.Count @Loc.T("selected")</span>
            <button class="btn btn--ghost btn--sm" @onclick="CancelSelect">@Loc.T("Cancel")</button>
            @if (SelectedGroupId is not null)
            {
                <button class="btn btn--danger btn--sm" @onclick="SeparateSelectedGroup"><LucideIcon Name="split" Size="14" />@Loc.T("Separate")</button>
            }
            else
            {
                <button class="btn btn--primary btn--sm" disabled="@(_selection.Count < 2)" @onclick="OpenJoinNamePrompt"><LucideIcon Name="link" Size="14" />@Loc.T("Join")</button>
            }
        }
        else if (_reassigning)
        {
            <button class="btn btn--ghost btn--sm" @onclick="CancelReassign">@Loc.T("Cancel")</button>
        }
        else if (_paintMode)
        {
            @* Each tap on a table already applies (and persists) the selected colour immediately —
               there's no staged change to discard — but the icon-only Cancel/Done pair still mirrors
               the Edit-layout toolbar (see _editing above) so every "mode" in this toolbar exits the
               same way instead of paint mode alone keeping the old floating text hint + button. *@
            <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Cancel")" @onclick="StopPaintMode"><LucideIcon Name="x" Size="16" /></button>
            <button class="btn btn--icon btn--primary btn--sm" title="@Loc.T("Done")" @onclick="StopPaintMode"><LucideIcon Name="save" Size="14" /></button>
        }
        else if (_showFilters)
        {
            <div class="toolbar-actions">
                <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("New table")" @onclick="() => OpenForm(null)"><LucideIcon Name="plus" Size="16" /></button>
                <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Join tables")" @onclick="StartSelect"><LucideIcon Name="link" Size="16" /></button>
                <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Assign tables")" @onclick="StartReassign"><LucideIcon Name="arrow-right-left" Size="16" /></button>
                <button class="btn btn--icon btn--primary btn--sm" title="@Loc.T("Edit layout")" @onclick="StartEdit"><LucideIcon Name="move" Size="16" /></button>
            </div>
        }
    </div>
    @* Stacked bottom-center of the map: zoom always renders here (even in Edit/Select mode, when
       the zone-filter pill below it is hidden), with the zone tabs docked directly under it. *@
    <div class="floor-zoom-dock">
        <span class="zoom-group zoom-group--sm">
            <button class="btn btn--icon btn--ghost btn--sm" type="button" disabled="@(_zoom <= ZoomMin)" title="@Loc.T("Zoom out")" @onclick="ZoomOut"><LucideIcon Name="zoom-out" Size="12" /></button>
            <button class="zoom-group__level" type="button" title="@Loc.T("Reset zoom")" @onclick="ZoomReset">@((_zoom * 100).ToString("0"))%</button>
            <button class="btn btn--icon btn--ghost btn--sm" type="button" disabled="@(_zoom >= ZoomMax)" title="@Loc.T("Zoom in")" @onclick="ZoomIn"><LucideIcon Name="zoom-in" Size="12" /></button>
        </span>
        @if (!_editing && !_selecting && _assignReservationId is null && Zones.Count > 0)
        {
            <div class="tabs zone-filter">
                <button class="tabs__opt @(_zoneFilter is null ? "tabs__opt--on" : "")" @onclick="() => _zoneFilter = null">@Loc.T("All zones")</button>
                @foreach (var z in Zones)
                {
                    <button class="tabs__opt @(_zoneFilter == z ? "tabs__opt--on" : "")" style="@ZoneDotStyle(z)" @onclick="() => _zoneFilter = z">@z</button>
                }
            </div>
        }
    </div>
    @if (_reassigning && _reassignSource is null)
    {
        <div class="floor-hint floor-hint--assign floor-hint--floating">
            <LucideIcon Name="arrow-right-left" Size="16" /> @Loc.T("Click the occupied table whose order you want to move.")
        </div>
    }
    @if (_reassignSource is not null)
    {
        <div class="reassign-popover">
            <div class="reassign-popover__title"><LucideIcon Name="arrow-right-left" Size="15" /> @Loc.T("Reassign") @(_reassignSource.GroupId is not null ? (_reassignSource.GroupName ?? _reassignSource.Name) : _reassignSource.Name)?</div>
            <select class="select" @bind="_reassignDestId">
                <option value="">@Loc.T("Choose a table")</option>
                @foreach (var dest in VisibleTables.Where(x => x.Id != _reassignSource.Id && x.ActiveOrderId is null && x.GroupId is null))
                {
                    <option value="@dest.Id">@dest.Name</option>
                }
            </select>
            <div class="reassign-popover__actions">
                <button class="btn btn--ghost btn--sm" @onclick="CancelReassign">@Loc.T("Cancel")</button>
                <button class="btn btn--primary btn--sm" disabled="@(_reassignDestId is null)" @onclick="ConfirmReassign">@Loc.T("Confirm")</button>
            </div>
        </div>
    }
    <div class="floor floor--tex-@Branding.Current.FloorTexture @(_editing ? "floor--edit" : "") @(_selecting ? "floor--select" : "") @(_assignReservationId is not null ? "floor--assign" : "") @(_reassigning ? "floor--assign" : "") @(_paintMode ? "floor--assign" : "")" @ref="_floorEl">
        @{
            // Computed once per render instead of once per table/foreach: VisibleTables filters the
            // whole floor and ResByTable groups every reservation, so re-evaluating either property
            // on each access below was doing that work again for every table and every group badge.
            var visible = VisibleTables;
            var resByTable = ResByTable;
        }
    <div class="floor-canvas" style="transform:scale(@N(_zoom)); transform-origin:0 0; --zoom:@N(_zoom);">
        <FloorMap AllTables="_tables" Tables="visible" Zones="VisibleZones" Decor="VisibleDecor" ResByTable="resByTable"
                  Editing="_editing" ZoneEditActive="_zoneEditActive" ZoneMenuOpen="_zoneMenuOpen" ZoneFilter="@_zoneFilter"
                  Selecting="_selecting" Selection="_selection" SelectedAssignedTableId="_selectedAssignedTableId" LayoutEpoch="_layoutEpoch"
                  Loading="!_loaded" RenderKey="FloorKey"
                  OnTableClick="OnTableClick"
                  OnRemoveTableFromReservation="RemoveTableFromReservation"
                  OnEditTableInLayout="EditTableDuringLayoutEdit"
                  OnDeleteTable="RequestDeleteTable"
                  OnEditZoneInLayout="EditZoneDuringLayoutEdit"
                  OnDeleteZoneInLayout="RequestDeleteZone"
                  OnRenameZone="StartRenameZone"
                  OnRemoveZone="RemoveZone"
                  OnDeleteDecor="RequestDeleteDecor" />
    </div>
    </div>
    </div>
    </div>

</div>

<Modal Visible="_form is not null" Title="@(_form?.Id > 0 ? Loc.T("Edit table") : Loc.T("New table"))" OnClose="Close" FullScreen="true">
    <ChildContent>
        @if (_form is not null)
        {
            <div class="field"><label>@Loc.T("Name")</label><input class="input" @bind="_form.Name" /></div>
            <div class="row-2">
                <div class="field"><label>@Loc.T("Seats")</label><input type="number" class="input" @bind="_form.Seats" /></div>
                <div class="field"><label>@Loc.T("Shape")</label>
                    <select class="select" @bind="_form.Shape">
                        @foreach (var s in Enum.GetValues<TableShape>())
                        {
                            <option value="@s">@Loc.T(s.ToString())</option>
                        }
                    </select>
                </div>
            </div>
            <div class="field">
                <label>@Loc.T("Zone")</label>
                <input class="input" list="zone-options" placeholder="@Loc.T("e.g. Main hall, Bar")" @bind="_form.Zone" />
                <datalist id="zone-options">
                    @foreach (var z in Zones)
                    {
                        <option value="@z"></option>
                    }
                </datalist>
            </div>
            <div class="field">
                <label>@Loc.T("Accent colour")</label>
                <ColorPickerPanel Current="@_form.Color" OnPick="c => _form.Color = c" ImageFolder="tables" />
            </div>
            @if (_groupMembers.Count > 0)
            {
                <div class="field"><label>@Loc.T("Group name")</label><input class="input" @bind="_groupNameEdit" /></div>
                <div class="join-info">
                    <span class="badge badge--primary"><LucideIcon Name="link" Size="14" /> @Loc.T("Joined")</span>
                    @Loc.T("Shares a bill with:") <strong>@string.Join(", ", _groupMembers)</strong>
                </div>
            }
            @if (_error is not null) { <div class="field-error">@_error</div> }
        }
    </ChildContent>
    <Footer>
        @if (_form?.Id > 0)
        {
            <button class="btn btn--danger" @onclick="() => Delete(_form!.Id)">@Loc.T("Delete")</button>
        }
        @if (_groupMembers.Count > 0)
        {
            <button class="btn btn--ghost" @onclick="() => SeparateGroup(_form!.Id)"><LucideIcon Name="link" Size="16" />@Loc.T("Separate")</button>
        }
        <span class="spacer"></span>
        <button class="btn btn--ghost" @onclick="Close">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" @onclick="Save">@Loc.T("Save")</button>
    </Footer>
</Modal>

<Modal Visible="_paintMenuOpen" Title="@Loc.T("Paint table colours")" OnClose="TogglePaintMenu" Narrow="true">
    <ChildContent>
        <ColorPickerPanel Current="@_paintColor" OnPick="ChoosePaintColor" ImageFolder="tables" />
    </ChildContent>
</Modal>

<Modal Visible="_showJoinNamePrompt" Title="@Loc.T("Name this table")" OnClose="CancelJoinNamePrompt">
    <ChildContent>
        <div class="field"><label>@Loc.T("Group name")</label><input class="input" @bind="_joinNameInput" /></div>
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CancelJoinNamePrompt">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" @onclick="ConfirmJoin"><LucideIcon Name="link" Size="16" />@Loc.T("Join")</button>
    </Footer>
</Modal>

<Modal Visible="_renamingTableId is not null" Title="@(RenamingTable?.GroupId is not null ? Loc.T("Group name") : Loc.T("Edit table"))" OnClose="CancelRenameTable" Narrow="true">
    <ChildContent>
        @if (RenamingTable?.GroupId is not null)
        {
            <div class="field"><label>@Loc.T("Group name")</label><input class="input" placeholder="@GroupDisplayName(_tables, RenamingTable.GroupId.Value)" @bind="_groupNameQuickInput" /></div>
        }
        else
        {
            <div class="field"><label>@Loc.T("Name")</label><input class="input" @bind="_tableNameInput" /></div>
        }
        @* Seats/shape/colour belong to this specific table, not the group as a whole — still
           editable here even when joined (same as the full "Edit table" modal already allows),
           on top of the shared group name above. *@
        <div class="row-2">
            <div class="field"><label>@Loc.T("Seats")</label><input type="number" min="1" class="input" @bind="_tableSeatsInput" /></div>
            <div class="field"><label>@Loc.T("Shape")</label>
                <select class="select" @bind="_tableShapeInput">
                    @foreach (var s in Enum.GetValues<TableShape>())
                    {
                        <option value="@s">@Loc.T(s.ToString())</option>
                    }
                </select>
            </div>
        </div>
        <div class="field">
            <label>@Loc.T("Accent colour")</label>
            <ColorPickerPanel Current="@_tableColorInput" OnPick="c => _tableColorInput = c" ImageFolder="tables" />
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CancelRenameTable">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" @onclick="ConfirmRenameTable">@Loc.T("Save")</button>
    </Footer>
</Modal>

<Modal Visible="_renamingZoneId is not null" Title="@Loc.T("Name this zone")" OnClose="CancelRenameZone" Narrow="true">
    <ChildContent>
        <div class="field"><label>@Loc.T("Zone name")</label><input class="input" @bind="_zoneNameInput" /></div>
        <div class="field">
            <label>@Loc.T("Accent colour")</label>
            <ColorPickerPanel Current="@_zoneColorInput" OnPick="c => _zoneColorInput = c" ImageFolder="zones" />
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CancelRenameZone">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" @onclick="ConfirmRenameZone">@Loc.T("Save")</button>
    </Footer>
</Modal>

<Modal Visible="_confirmDelete is not null" Title="@Loc.T("Confirm deletion")" OnClose="CancelConfirmDelete" Narrow="true">
    <ChildContent>
        <p>@Loc.T("Delete") "@_confirmDelete?.Name"? @Loc.T("This can't be undone.")</p>
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CancelConfirmDelete">@Loc.T("Cancel")</button>
        <button class="btn btn--danger" @onclick="ConfirmDelete">@Loc.T("Delete")</button>
    </Footer>
</Modal>

@* Big-map mode and small screens (see OnTableClick): a single tap on a table opens its comanda
   straight away instead of the table-properties form, so the expanded map (and mobile) works as
   a fast waiter screen — there's no press-and-hold fallback to the properties form here, tapping
   a table only ever opens its comanda; use "Edit layout" for table properties instead. *@
<OrderEditor OrderId="_editorOrderId" OnClose="CloseOrderEditor" OnChanged="OnOrderEditorChanged" FullScreen="true" />

@code {
    // Replaced, never mutated in place: FloorMap decides whether to re-render by comparing list
    // references (see FloorRenderKey) — the same goes for _decor, _zones and _reservations.
    private List<TableDto> _tables = new();
    private TableFormDto? _form;
    private List<string> _groupMembers = new();
    private int? _groupId;
    private string _groupNameEdit = "";
    private string? _error;
    private string? _notice;

    private bool _editing;
    private bool _selecting;
    private bool _showFilters;
    private readonly HashSet<int> _selection = new();

    // ---- Reassign order to another table ----
    private bool _reassigning;
    private TableDto? _reassignSource;   // set once the occupied table to move is clicked
    private int? _reassignDestId;

    // ---- Floor style (background texture) ----
    private static readonly string[] FloorTextures = { "grid", "wood", "tile", "concrete", "marble", "terracotta" };
    private bool _floorMenuOpen;
    private bool _floorMenuClosing;
    private async Task ToggleFloorMenu()
    {
        if (_floorMenuOpen)
        {
            _floorMenuClosing = true;
            StateHasChanged();
            await Task.Delay(200);
            _floorMenuOpen = false;
            _floorMenuClosing = false;
        }
        else
        {
            _floorMenuOpen = true;
            _paintMenuOpen = false; _plantMenuOpen = false; _designMenuOpen = false; _furnitureMenuOpen = false; _leisureMenuOpen = false; _zoneMenuOpen = false;
        }
    }
    private static string TextureLabel(string tex) => tex switch
    {
        "wood" => "Wood",
        "tile" => "Tile",
        "concrete" => "Concrete",
        "marble" => "Marble",
        "terracotta" => "Terracotta",
        _ => "Grid",
    };
    private async Task ChooseFloorTexture(string texture)
    {
        _floorMenuOpen = false;
        if (Branding.Current.FloorTexture == texture) return;
        var form = await Settings.GetForEditAsync();
        form.FloorTexture = texture;
        await Settings.UpdateAsync(form);
    }

    // ---- Paint mode: pick a colour once (via the ColorPickerPanel modal below), then tap tables
    // on the map to apply it directly, instead of opening each table's full properties form just
    // to change its accent colour. ----
    private bool _paintMenuOpen;
    private bool _paintMode;
    private string? _paintColor;

    private Task TogglePaintMenu()
    {
        if (_paintMenuOpen)
        {
            _paintMenuOpen = false;
            _paintMode = false;
        }
        else
        {
            _paintMenuOpen = true;
            _floorMenuOpen = false; _plantMenuOpen = false; _designMenuOpen = false; _furnitureMenuOpen = false; _leisureMenuOpen = false; _zoneMenuOpen = false;
        }
        return Task.CompletedTask;
    }

    private void ChoosePaintColor(string? color)
    {
        _paintColor = color;
        _paintMode = true;
        _paintMenuOpen = false;
    }

    private void StopPaintMode()
    {
        _paintMode = false;
        _paintMenuOpen = false;
    }

    private async Task PaintTable(TableDto t)
    {
        await Service.SetColorAsync(t.Id, _paintColor);
        await Load();
    }

    // ---- Floor decor: decorative plants and interior-design elements (walls, doors, bar
    // counter, columns, windows) placed alongside tables so the plan can read as a real floor
    // plan instead of a bare grid. Share the drag/resize/rotate/lock editor with tables (see
    // floorplan.js) but persist through IFloorDecorService instead of ITableService. ----
    private List<FloorDecorDto> _decor = new();
    private static readonly FloorDecorType[] PlantTypes =
    {
        FloorDecorType.PottedPlant, FloorDecorType.SmallPlant, FloorDecorType.HangingPlant,
        FloorDecorType.Bush, FloorDecorType.SmallTree, FloorDecorType.Fern
    };
    // Building shell and circulation (the "Design elements" picker) vs. loose furniture and
    // fittings (the "Furniture" picker), split so neither swatch strip grows too long.
    private static readonly FloorDecorType[] InteriorTypes =
    {
        FloorDecorType.Wall, FloorDecorType.Window, FloorDecorType.GlassWall, FloorDecorType.Column,
        FloorDecorType.Door, FloorDecorType.DoubleDoor, FloorDecorType.SlidingDoor, FloorDecorType.Corridor,
        FloorDecorType.Stairs, FloorDecorType.SpiralStairs, FloorDecorType.Kitchen, FloorDecorType.Restrooms,
    };
    private static readonly FloorDecorType[] FurnitureTypes =
    {
        FloorDecorType.BarCounter, FloorDecorType.WineRack, FloorDecorType.Banquette, FloorDecorType.Sofa,
        FloorDecorType.Armchair, FloorDecorType.Rug, FloorDecorType.Fireplace, FloorDecorType.Piano,
        FloorDecorType.WaiterStation, FloorDecorType.Buffet, FloorDecorType.HostStand, FloorDecorType.CoatRack,
        FloorDecorType.FloorLamp, FloorDecorType.Planter, FloorDecorType.Parasol,
    };
    private static readonly FloorDecorType[] LeisureTypes =
    {
        FloorDecorType.PoolTable, FloorDecorType.Foosball, FloorDecorType.AirHockey, FloorDecorType.PingPong,
        FloorDecorType.ArcadeMachine, FloorDecorType.Dartboard, FloorDecorType.Jukebox, FloorDecorType.BeanBag,
        FloorDecorType.CueRack, FloorDecorType.Carpet,
    };

    private bool _plantMenuOpen;
    private bool _plantMenuClosing;
    private bool _designMenuOpen;

    // Blazor removes a popover from the DOM the instant its "open" flag flips false, which gives
    // it no chance to play an exit animation (unlike the CSS-only entrance). So closing via the
    // toggle button itself goes through a short "closing" state first — the panel stays rendered
    // with the floor-tex-menu--closing class (see Tables.razor.css) for the exit animation's own
    // duration, then is actually removed once it's finished. Same pattern on every picker in this
    // dropdown (see ToggleZoneMenu/ToggleFloorMenu/TogglePaintMenu/ToggleDesignMenu below).
    private async Task TogglePlantMenu()
    {
        if (_plantMenuOpen)
        {
            _plantMenuClosing = true;
            StateHasChanged();
            await Task.Delay(200);
            _plantMenuOpen = false;
            _plantMenuClosing = false;
        }
        else
        {
            _plantMenuOpen = true;
            _floorMenuOpen = false; _paintMenuOpen = false; _designMenuOpen = false; _furnitureMenuOpen = false; _leisureMenuOpen = false; _zoneMenuOpen = false;
        }
    }

    private bool _designMenuClosing;
    private async Task ToggleDesignMenu()
    {
        if (_designMenuOpen)
        {
            _designMenuClosing = true;
            StateHasChanged();
            await Task.Delay(200);
            _designMenuOpen = false;
            _designMenuClosing = false;
        }
        else
        {
            _designMenuOpen = true;
            _floorMenuOpen = false; _paintMenuOpen = false; _plantMenuOpen = false; _furnitureMenuOpen = false; _leisureMenuOpen = false; _zoneMenuOpen = false;
        }
    }

    private bool _furnitureMenuOpen;
    private bool _furnitureMenuClosing;
    private async Task ToggleFurnitureMenu()
    {
        if (_furnitureMenuOpen)
        {
            _furnitureMenuClosing = true;
            StateHasChanged();
            await Task.Delay(200);
            _furnitureMenuOpen = false; _leisureMenuOpen = false;
            _furnitureMenuClosing = false;
        }
        else
        {
            _furnitureMenuOpen = true;
            _floorMenuOpen = false; _paintMenuOpen = false; _plantMenuOpen = false; _designMenuOpen = false; _leisureMenuOpen = false; _zoneMenuOpen = false;
        }
    }

    private bool _leisureMenuOpen;
    private bool _leisureMenuClosing;
    private async Task ToggleLeisureMenu()
    {
        if (_leisureMenuOpen)
        {
            _leisureMenuClosing = true;
            StateHasChanged();
            await Task.Delay(200);
            _leisureMenuOpen = false;
            _leisureMenuClosing = false;
        }
        else
        {
            _leisureMenuOpen = true;
            _floorMenuOpen = false; _paintMenuOpen = false; _plantMenuOpen = false; _designMenuOpen = false; _furnitureMenuOpen = false; _zoneMenuOpen = false;
        }
    }

    // ---- Zone edit mode: toggled from the "Zones" button, gating the rename/delete controls
    // that render on each zone box (see the floor-zone markup above) — without this flag they
    // used to always be visible, so any click near a zone's edge could modify it. The zone body
    // on the map itself is inert (no onclick) — filtering only happens via the "Zones" dropdown
    // chips or the zone-filter tabs below the map (both call OnZoneClick).
    private bool _zoneMenuOpen;
    private bool _zoneMenuClosing;
    private async Task ToggleZoneMenu()
    {
        if (_zoneMenuOpen)
        {
            _zoneMenuClosing = true;
            StateHasChanged();
            await Task.Delay(200);
            _zoneMenuOpen = false;
            _zoneMenuClosing = false;
        }
        else
        {
            _zoneMenuOpen = true;
            _floorMenuOpen = false; _paintMenuOpen = false; _plantMenuOpen = false; _designMenuOpen = false; _furnitureMenuOpen = false; _leisureMenuOpen = false;
        }
    }

    private async Task AddDecor(FloorDecorType type)
    {
        _plantMenuOpen = false;
        _designMenuOpen = false;
        _furnitureMenuOpen = false; _leisureMenuOpen = false;
        var dto = await DecorService.CreateAsync(type);
        _decor = [.. _decor, dto];
        StartEdit();
    }

    private async Task RemoveDecor(int id)
    {
        await DecorService.DeleteAsync(id);
        _decor = _decor.Where(d => d.Id != id).ToList();
    }

    // ---- Floor zones: named, clickable boundary boxes drawn directly on the map (e.g.
    // "Terrace", "Bar") — distinct from RestaurantTable.Zone (the free-text tag each table is
    // filed under, driving the zone-filter tabs). Clicking a zone box applies that same filter
    // spatially instead of only from the tabs below the map. Rendered first inside .floor-canvas
    // so they paint underneath tables/decor. No rotation/shape — just drag + resize. ----
    private List<FloorZoneDto> _zones = new();
    private int? _renamingZoneId;
    private string _zoneNameInput = "";
    private string? _zoneColorInput;

    private void OnZoneClick(FloorZoneDto z)
    {
        if (_editing) return;
        _zoneFilter = _zoneFilter == z.Name ? null : z.Name;
    }

    private async Task AddZone()
    {
        _zoneMenuOpen = false;
        var dto = await ZoneService.CreateAsync();
        _zones = [.. _zones, dto];
        StartEdit();
    }

    private async Task RemoveZone(int id)
    {
        await ZoneService.DeleteAsync(id);
        _zones = _zones.Where(z => z.Id != id).ToList();
    }

    private void StartRenameZone(FloorZoneDto z)
    {
        _renamingZoneId = z.Id;
        _zoneNameInput = z.Name;
        _zoneColorInput = z.Color;
    }

    // Rename/delete from inside layout-edit mode (see the zone markup above) — both leave edit
    // mode first since the rename Modal and the delete's list update only take effect once
    // Blazor is rendering again (see SaveLayout/CancelEdit clearing _suppressRender).
    private async Task EditZoneDuringLayoutEdit(FloorZoneDto z)
    {
        await SaveLayout();
        StartRenameZone(z);
    }

    // ---- Delete confirmation: shared by zones, decor and tables' own "x" button, shown while
    // layout-edit mode is on (see the markup above). All three save the in-progress layout first
    // (like EditZoneDuringLayoutEdit does for rename) rather than discarding it, since the item
    // about to be deleted having no layout worth keeping doesn't mean anything ELSE dragged
    // earlier in the same edit session should be thrown away too — then leave edit mode so the
    // confirm Modal below can actually render (Blazor is frozen mid-edit, see ShouldRender).
    private enum DeleteKind { Zone, Decor, Table }
    private (DeleteKind Kind, int Id, string Name)? _confirmDelete;

    private async Task RequestDeleteZone(FloorZoneDto z)
    {
        await SaveLayout();
        _confirmDelete = (DeleteKind.Zone, z.Id, z.Name);
    }

    private async Task RequestDeleteDecor(FloorDecorDto d)
    {
        await SaveLayout();
        _confirmDelete = (DeleteKind.Decor, d.Id, Loc.T(DecorLabel(d.Type)));
    }

    private async Task RequestDeleteTable(TableDto t)
    {
        await SaveLayout();
        _confirmDelete = (DeleteKind.Table, t.Id, t.Name);
    }

    private void CancelConfirmDelete() => _confirmDelete = null;

    private async Task ConfirmDelete()
    {
        if (_confirmDelete is null) return;
        var (kind, id, _) = _confirmDelete.Value;
        switch (kind)
        {
            case DeleteKind.Zone: await RemoveZone(id); break;
            case DeleteKind.Decor: await RemoveDecor(id); break;
            case DeleteKind.Table:
                try { await Service.DeleteAsync(id); await Load(); }
                catch (InvalidOperationException ex) { _notice = ex.Message; }
                break;
        }
        _confirmDelete = null;
    }

    private void CancelRenameZone() => _renamingZoneId = null;

    private async Task ConfirmRenameZone()
    {
        if (_renamingZoneId is null || string.IsNullOrWhiteSpace(_zoneNameInput)) return;
        await ZoneService.UpdateAsync(_renamingZoneId.Value, _zoneNameInput, _zoneColorInput);
        var renamedId = _renamingZoneId.Value;
        _zones = _zones.Select(z => z.Id == renamedId ? z with { Name = _zoneNameInput.Trim(), Color = _zoneColorInput } : z).ToList();
        _renamingZoneId = null;
    }

    // ---- Quick-edit for a table from its own "pencil" button in layout-edit mode (see the .tbl
    // markup above) — same save-then-modal pattern as EditZoneDuringLayoutEdit, since a Modal
    // needs Blazor rendering back (see ShouldRender/_suppressRender) to actually show up.
    // For a joined table (only the group's anchor member shows this button — see the markup)
    // this edits the shared group name instead of that one member's own name/seats, since a
    // joined block reads and renames as a single unit, not table-by-table.
    private int? _renamingTableId;
    private string _tableNameInput = "";
    private int _tableSeatsInput = 1;
    private TableShape _tableShapeInput = TableShape.Square;
    private string? _tableColorInput;
    private string _groupNameQuickInput = "";

    private TableDto? RenamingTable => _tables.FirstOrDefault(x => x.Id == _renamingTableId);

    private async Task EditTableDuringLayoutEdit(TableDto t)
    {
        await SaveLayout();
        _renamingTableId = t.Id;
        _tableNameInput = t.Name;
        _tableSeatsInput = t.Seats;
        _tableShapeInput = t.Shape;
        _tableColorInput = t.Color;
        _groupNameQuickInput = t.GroupName ?? "";
    }

    private void CancelRenameTable() => _renamingTableId = null;

    private async Task ConfirmRenameTable()
    {
        var t = RenamingTable;
        if (t is null) { _renamingTableId = null; return; }
        if (_tableSeatsInput < 1) return;

        if (t.GroupId is not null)
        {
            if (string.IsNullOrWhiteSpace(_groupNameQuickInput)) return;
            await Service.RenameGroupAsync(t.GroupId.Value, _groupNameQuickInput);
            await Service.UpdateInfoAsync(new TableFormDto
            {
                Id = t.Id, Name = t.Name, Seats = _tableSeatsInput, Shape = _tableShapeInput, Zone = t.Zone, Color = _tableColorInput
            });
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_tableNameInput)) return;
            await Service.UpdateInfoAsync(new TableFormDto
            {
                Id = t.Id, Name = _tableNameInput.Trim(), Seats = _tableSeatsInput, Shape = _tableShapeInput, Zone = t.Zone, Color = _tableColorInput
            });
        }
        _renamingTableId = null;
        await Load();
    }

    // ---- Zoom: scales just the .floor-canvas wrapper (tables/decor/badges), not the outer
    // .floor viewport/texture, so floorplan.js's drag math only needs a zoom-factor correction
    // instead of a full coordinate-space rewrite. Hidden during layout editing (like Expand map)
    // so the factor can't change mid-drag. ----
    private const double ZoomMin = 0.5, ZoomMax = 2, ZoomStep = 0.1;
    private double _zoom = 1;
    private void ZoomIn() => _zoom = Math.Min(ZoomMax, Math.Round(_zoom + ZoomStep, 2));
    private void ZoomOut() => _zoom = Math.Max(ZoomMin, Math.Round(_zoom - ZoomStep, 2));
    private void ZoomReset() => _zoom = 1;

    // ---- Reservations panel state ----
    // Floats over the map, anchored under the calendar toggle (see .resv-col in Tables.razor.css).
    private bool _resSidebarOpen = false;
    // Closing plays the unfold animation in reverse before the panel leaves the DOM (same
    // "closing" pattern as the floor pickers — Blazor would otherwise drop it instantly).
    private bool _resSidebarClosing;
    private async Task ToggleResSidebar()
    {
        if (_resSidebarClosing) return;
        if (!_resSidebarOpen) { _resSidebarOpen = true; return; }
        _resSidebarClosing = true;
        StateHasChanged();
        await Task.Delay(240);
        _resSidebarOpen = false;
        _resSidebarClosing = false;
    }
    private ElementReference _resvPanelEl;
    private ElementReference _resvResizeEl;
    private ElementReference _resvHeaderEl;
    private bool _resvDragBound;
    private DateTime _reserveDate = DateTime.Today;
    private bool _showDatePicker;
    private Task PickReserveDate(DateTime date)
    {
        _reserveDate = date;
        _showDatePicker = false;
        return LoadReservations();
    }
    private List<ReservationDto> _reservations = new();
    private ServicePeriod? _periodFilter;

    private List<ReservationDto> FilteredReservations => _periodFilter is null
        ? _reservations
        : _reservations.Where(r => Branding.Current.GetPeriod(r.Time) == _periodFilter).ToList();

    // Drives the floor plan's reservation badges too, so switching the Lunch/Dinner filter
    // hides the other service's reservations from the map, not just the sidebar list.
    private Dictionary<int, ReservationDto> ResByTable => FilteredReservations
        .Where(r => r.Status != ReservationStatus.Cancelled && r.Status != ReservationStatus.Finished)
        .SelectMany(r => r.TableIds.Select(tableId => (TableId: tableId, Res: r)))
        .GroupBy(x => x.TableId)
        .ToDictionary(g => g.Key, g => g.OrderBy(x => x.Res.Time).First().Res);
    private int? _assignReservationId;
    private string? _assignName;
    // Table clicked once while carrying a reservation, revealing its quick-remove X (see
    // OnTableClick and RemoveTableFromReservation) instead of jumping straight to its comanda.
    private int? _selectedAssignedTableId;
    private int? _statusMenuOpenId;
    private ReservationFormDto? _resForm;
    private string? _resError;

    // ---- Reservation-taking policy: staff-facing note on how bookings currently come in ----
    private bool _policyMenuOpen;
    private static readonly (string Value, string Label, bool ComingSoon)[] ReservationPolicies =
    {
        ("open", "Accepting reservations", false),
        ("phone_only", "Phone only", false),
        ("closed", "Not accepting reservations", false),
        ("web", "Online booking", true),
    };

    private static string PolicyLabel(string value) =>
        ReservationPolicies.FirstOrDefault(o => o.Value == value).Label ?? value;

    private static string PolicyDotColor(string value) => value switch
    {
        "open" => "var(--success)",
        "phone_only" => "var(--warning)",
        "closed" => "var(--danger)",
        _ => "var(--success)",
    };

    private void TogglePolicyMenu() => _policyMenuOpen = !_policyMenuOpen;
    private void ClosePolicyMenu() => _policyMenuOpen = false;

    private async Task SetReservationPolicy(string value)
    {
        _policyMenuOpen = false;
        var form = await Settings.GetForEditAsync();
        form.ReservationPolicy = value;
        await Settings.UpdateAsync(form);
    }

    // ---- Reservation wizard: 4 steps, each its own screen ----
    private int _resStep = 1;
    private int _resMaxStep = 1;   // furthest step reached, gates which step-chips are clickable
    private static readonly (int Step, string Label)[] ResSteps =
    {
        (1, "Guest"), (2, "Date"), (3, "Service"), (4, "Summary")
    };

    // Fills the stepper's connecting line up to the current step's dot — the dots are evenly
    // spaced (100 / ResSteps.Length apart), so step 1 = 0% filled, the last step = full width.
    private double StepProgressWidthPercent => (100.0 / ResSteps.Length) * (_resStep - 1);

    private bool _suppressRender;   // while true, JS owns the DOM; Blazor must not re-render the floor
    private ElementReference _floorEl;
    private IJSObjectReference? _module;

    private string? _zoneFilter;

    // True once any zone's chip has been clicked to enter layout-edit mode (see the zone-pick
    // menu) — while true, every zone box gets its own Edit/Delete buttons (not just the one whose
    // chip was clicked), so any zone can be renamed or removed once that session has started.
    // Kept separate from _zoneFilter because that field *toggles* (clicking the same chip twice
    // clears it back to null, for the plain view-only "show just this zone" filter), so relying
    // on it here meant a second click on the same chip silently dropped the buttons even though
    // editing had just (re)started.
    private bool _zoneEditActive;

    // Each zone tab leads with a dot in that zone's own colour (as drawn on the map); zones filled
    // with an image instead of a colour just get the neutral dot.
    private string? ZoneDotStyle(string zone)
    {
        var color = _zones.FirstOrDefault(z => z.Name == zone)?.Color;
        return color is not null && !IsImageColor(color) ? $"--zc:{color}" : null;
    }

    private List<string> Zones => _tables
        .Select(t => t.Zone)
        .Where(z => !string.IsNullOrWhiteSpace(z))
        .Distinct()
        .OrderBy(z => z)
        .ToList()!;

    private List<TableDto> VisibleTables =>
        (_editing || _selecting || _assignReservationId is not null || _zoneFilter is null)
            ? _tables
            : _tables.Where(t => t.Zone == _zoneFilter).ToList();

    // When a zone filter is active, the map should read as "just this zone" — so besides
    // VisibleTables (already scoped to t.Zone above), the zone box itself and any decor sitting
    // inside its footprint are the only other things left on screen; every other zone box and
    // any decor outside it disappears instead of just losing its highlight.
    private List<FloorZoneDto> VisibleZones =>
        (_editing || _selecting || _assignReservationId is not null || _zoneFilter is null)
            ? _zones
            : _zones.Where(z => z.Name == _zoneFilter).ToList();

    private static bool DecorInsideZone(FloorDecorDto d, FloorZoneDto z)
    {
        var cx = d.PositionX + d.Width / 2;
        var cy = d.PositionY + d.Height / 2;
        return cx >= z.PositionX && cx <= z.PositionX + z.Width
            && cy >= z.PositionY && cy <= z.PositionY + z.Height;
    }

    private List<FloorDecorDto> VisibleDecor
    {
        get
        {
            if (_editing || _selecting || _assignReservationId is not null || _zoneFilter is null) return _decor;
            var zone = _zones.FirstOrDefault(z => z.Name == _zoneFilter);
            return zone is null ? _decor : _decor.Where(d => DecorInsideZone(d, zone)).ToList();
        }
    }

    // Everything FloorMap draws from — see FloorRenderKey for why lists compare by reference.
    private FloorRenderKey FloorKey => new(
        _tables, _zones, _decor, _reservations, _periodFilter, _loaded,
        _editing, _selecting, FloorRenderKey.HashSelection(_selection), _assignReservationId, _zoneFilter,
        _zoneMenuOpen, _zoneEditActive, _selectedAssignedTableId, _layoutEpoch, Branding.Current);

    protected override bool ShouldRender() => !_suppressRender;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private int _userId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState!;
        _userId = int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;

        await Load();
        await LoadReservations();
        _loaded = true;
    }

    // False until the first load finishes, so the map shows nothing (rather than a flash of
    // "No tables yet") while the circuit's first data load is still in flight.
    private bool _loaded;

    private async Task Load()
    {
        _tables = await Service.GetAllAsync();
        _decor = await DecorService.GetAllAsync();
        _zones = await ZoneService.GetAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // <PageTitle> only reaches the static <head> during prerendering, which this page skips
        // (see @rendermode above), so set the tab title directly once the page is up.
        if (firstRender) await JS.InvokeVoidAsync("posSetTitle", $"Tables · {Branding.Current.Title}");

        if (_editing && _module is null && RendererInfo.IsInteractive)
        {
            // Cache-busted with a fixed build marker (bump the number whenever this file changes)
            // — a plain "./js/floorplan.js" URL lets browsers keep serving a stale cached copy
            // across dev-server restarts/deploys, silently running old drag/resize logic even
            // after the server-side fix is live.
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/floorplan.js?v=3");
            await _module.InvokeVoidAsync("init", _floorEl, _zoom);
            _suppressRender = true;
        }
        if (_resSidebarOpen && !_resvDragBound && RendererInfo.IsInteractive)
        {
            // Client-only drag by the panel's own header (its empty space, not its buttons) —
            // no separate grip icon needed. Position isn't persisted
            // anywhere, it just resets to the default corner-anchored spot next time the panel
            // is opened. Sizing uses its own explicit handle (.resv__resize-handle) driven by
            // pointer events rather than native CSS `resize`, which needs a fiddly 15px corner
            // grab-zone that's easy to miss/mis-hit and doesn't work on touch at all — the
            // camarero screens are touch-first, so this has to work with a finger too.
            await JS.InvokeVoidAsync("posPanelDrag", _resvHeaderEl, _resvPanelEl);
            // Width floor is read live from the header row's own natural (unwrapped) width
            // rather than a guessed constant, so the panel can never be shrunk narrower than
            // what the date-nav icons need — they'd otherwise start wrapping/overlapping.
            await JS.InvokeVoidAsync("posPanelResize", _resvResizeEl, _resvPanelEl, _resvHeaderEl, 220);
            _resvDragBound = true;
        }
        else if (!_resSidebarOpen)
        {
            _resvDragBound = false;
        }
    }

    // ---- Layout editing (drag / resize / rotate) ----
    private void StartEdit() { CancelAssign(); CancelReassign(); StopPaintMode(); _editing = true; }

    private async Task SaveLayout()
    {
        _suppressRender = false;
        if (_module is not null)
        {
            var layout = await _module.InvokeAsync<TableLayoutDto[]>("getLayout");
            await Service.SaveLayoutAsync(layout);
            var decorLayout = await _module.InvokeAsync<FloorDecorLayoutDto[]>("getDecorLayout");
            await DecorService.SaveLayoutAsync(decorLayout);
            var zoneLayout = await _module.InvokeAsync<FloorZoneLayoutDto[]>("getZoneLayout");
            await ZoneService.SaveLayoutAsync(zoneLayout);
            await _module.InvokeVoidAsync("dispose");
            await _module.DisposeAsync();
            _module = null;
        }
        _editing = false;
        // Entering edit from a zone chip (see the zone-pick menu) also sets this as a side effect
        // of OnZoneClick, but a FloorZone's Name rarely matches any table's free-text Zone tag —
        // so leaving it set here hid every table once editing ended, looking like tables had
        // vanished. Edit mode always shows the full map anyway (see VisibleTables/VisibleZones),
        // so there's nothing still "focused" to preserve once it's done.
        _zoneFilter = null;
        _zoneEditActive = false;
        await Load();
    }

    private async Task CancelEdit()
    {
        _suppressRender = false;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose");
            await _module.DisposeAsync();
            _module = null;
        }
        _editing = false;
        _zoneFilter = null;
        _zoneEditActive = false;
        _layoutEpoch++; // discard whatever floorplan.js moved (see FloorMap.LayoutEpoch)
        await Load();
    }

    private int _layoutEpoch;

    // ---- Join / separate ----
    private void StartSelect() { CancelAssign(); CancelReassign(); StopPaintMode(); _selecting = true; _selection.Clear(); _notice = null; }
    private void CancelSelect() { _selecting = false; _selection.Clear(); }

    // ---- Reassign an open order to another table ----
    private void StartReassign() { CancelAssign(); StopPaintMode(); _reassigning = true; _reassignSource = null; _reassignDestId = null; _notice = null; }
    private void CancelReassign() { _reassigning = false; _reassignSource = null; _reassignDestId = null; }

    private async Task ConfirmReassign()
    {
        if (_reassignSource?.ActiveOrderId is null || _reassignDestId is null) return;
        await OrderSvc.MoveOrderToTableAsync(_reassignSource.ActiveOrderId.Value, _reassignDestId.Value);
        CancelReassign();
        await Load();
    }

    // Joining asks for a name first (defaulting to "T1 + T2") so the group reads as one table
    // everywhere, instead of leaving each member's own name showing.
    private bool _showJoinNamePrompt;
    private string _joinNameInput = "";

    private void OpenJoinNamePrompt()
    {
        _joinNameInput = string.Join(" + ", _tables.Where(t => _selection.Contains(t.Id)).OrderBy(t => t.Name).Select(t => t.Name));
        _showJoinNamePrompt = true;
    }

    private void CancelJoinNamePrompt() => _showJoinNamePrompt = false;

    private async Task ConfirmJoin()
    {
        try
        {
            await Service.JoinTablesAsync(_selection, _joinNameInput);
            _notice = $"{_selection.Count} {Loc.T("tables joined.")}";
        }
        catch (InvalidOperationException ex) { _notice = ex.Message; }
        _showJoinNamePrompt = false;
        _selecting = false;
        _selection.Clear();
        await Load();
    }

    private async Task SeparateGroup(int tableId)
    {
        try { await Service.SeparateGroupAsync(tableId); }
        catch (InvalidOperationException ex) { _error = ex.Message; return; }
        _form = null;
        _groupMembers = new();
        await Load();
    }

    // Non-null only when every selected table already belongs to that same existing group —
    // selecting an already-joined group's tables (via the same "Join tables" button) means the
    // user wants to undo the join, not make a new one, so the toolbar offers Separate instead.
    private int? SelectedGroupId
    {
        get
        {
            var selected = _tables.Where(t => _selection.Contains(t.Id)).ToList();
            if (selected.Count == 0) return null;
            var first = selected[0].GroupId;
            return first is not null && selected.All(t => t.GroupId == first) ? first : null;
        }
    }

    private async Task SeparateSelectedGroup()
    {
        if (_selection.Count == 0) return;
        var tableId = _selection.First();
        try { await Service.SeparateGroupAsync(tableId); }
        catch (InvalidOperationException ex) { _notice = ex.Message; }
        _selecting = false;
        _selection.Clear();
        await Load();
    }

    // ---- Reservations panel ----
    private Task ShiftDay(int days)
    {
        _reserveDate = _reserveDate.AddDays(days);
        return LoadReservations();
    }

    private async Task LoadReservations() => _reservations = await ReservationService.GetByDateAsync(_reserveDate);

    private void StartAssign(ReservationDto r) { CancelReassign(); StopPaintMode(); _assignReservationId = r.Id; _assignName = r.CustomerName; }
    private void CancelAssign() { _assignReservationId = null; _assignName = null; }

    // Clicking "Assign" again while already assigning that same reservation cancels it,
    // instead of just restarting the same picking session.
    private void ToggleAssign(ReservationDto r)
    {
        if (_assignReservationId == r.Id) CancelAssign();
        else StartAssign(r);
    }

    // First click on a sidebar table chip only reveals its quick-remove X (see the chip markup
    // above and _selectedAssignedTableId, shared with the floor map's identical X) instead of
    // opening the "change table" picker straight away; a second click on that same chip falls
    // through to the normal ToggleAssign behaviour.
    private void OnAssignedChipClick(ReservationDto r, int tableId)
    {
        if (_selectedAssignedTableId != tableId) { _selectedAssignedTableId = tableId; return; }
        _selectedAssignedTableId = null;
        ToggleAssign(r);
    }

    // Clicking a table while assigning toggles its membership; assign mode stays open so
    // several tables can be picked in one go, and is exited explicitly via "Done".
    private async Task AssignToTable(int tableId)
    {
        if (_assignReservationId is null) return;
        await ReservationService.ToggleTableAsync(_assignReservationId.Value, tableId);
        await LoadReservations();
        await Load();
    }

    // Quick removal from the floor map's revealed X (see OnTableClick/_selectedAssignedTableId) —
    // drops just this one table from whichever reservation it's carrying, unlike Unassign above
    // which clears every table off a reservation from the sidebar card.
    private Task RemoveTableFromReservation(TableDto t)
    {
        if (!ResByTable.TryGetValue(t.Id, out var rv)) return Task.CompletedTask;
        return RemoveTableFromReservation(rv.Id, t.Id);
    }

    // Same drop-just-this-table action, reachable from the sidebar chip's own X (see
    // OnAssignedChipClick) without needing to look the reservation up via ResByTable.
    private async Task RemoveTableFromReservation(int reservationId, int tableId)
    {
        await ReservationService.ToggleTableAsync(reservationId, tableId);
        _selectedAssignedTableId = null;
        await LoadReservations();
        await Load();
    }

    private async Task SetResStatus(int reservationId, ReservationStatus status)
    {
        try { await ReservationService.SetStatusAsync(reservationId, status); }
        catch (InvalidOperationException ex) { _notice = ex.Message; return; }
        await LoadReservations();
        await Load();
    }

    private void ToggleStatusMenu(int id) => _statusMenuOpenId = _statusMenuOpenId == id ? null : id;

    private async Task ChooseStatus(int reservationId, ReservationStatus status)
    {
        _statusMenuOpenId = null;
        await SetResStatus(reservationId, status);
    }

    private async Task OpenResForm(int? id)
    {
        _resError = null;
        _resForm = id is null
            ? new ReservationFormDto { Date = _reserveDate }
            : await ReservationService.GetForEditAsync(id.Value) ?? new ReservationFormDto();
        // Editing an existing reservation already has every step filled in, so unlock the whole
        // wizard instead of forcing another walk through it; a new one starts at step 1 only.
        _resStep = 1;
        _resMaxStep = id is null ? 1 : ResSteps.Length;
        SplitPhone();
    }

    private void CloseResForm() => _resForm = null;

    // ---- Phone prefix picker: splits the single Phone string into a "+34"-style prefix
    // (its own searchable dropdown) and the local number, then recombines them on every
    // edit — the rest of the app still only ever sees one Phone string. ----
    private string _phonePrefix = "+34";
    private string _phoneLocal = "";
    private bool _prefixMenuOpen;
    private string _prefixSearch = "";

    private static readonly (string Name, string Code)[] PhonePrefixes =
    {
        ("Spain", "+34"), ("Andorra", "+376"), ("Portugal", "+351"), ("France", "+33"),
        ("Italy", "+39"), ("Germany", "+49"), ("United Kingdom", "+44"), ("Ireland", "+353"),
        ("Netherlands", "+31"), ("Belgium", "+32"), ("Luxembourg", "+352"), ("Switzerland", "+41"),
        ("Austria", "+43"), ("Denmark", "+45"), ("Norway", "+47"), ("Sweden", "+46"),
        ("Finland", "+358"), ("Iceland", "+354"), ("Poland", "+48"), ("Czechia", "+420"),
        ("Slovakia", "+421"), ("Hungary", "+36"), ("Romania", "+40"), ("Bulgaria", "+359"),
        ("Greece", "+30"), ("Turkey", "+90"), ("Croatia", "+385"), ("Serbia", "+381"),
        ("Ukraine", "+380"), ("Russia", "+7"), ("Morocco", "+212"), ("Algeria", "+213"),
        ("Tunisia", "+216"), ("Egypt", "+20"), ("Israel", "+972"),
        ("United Arab Emirates", "+971"), ("Saudi Arabia", "+966"),
        ("United States", "+1"), ("Canada", "+1"), ("Mexico", "+52"),
        ("Guatemala", "+502"), ("Costa Rica", "+506"), ("Panama", "+507"), ("Cuba", "+53"),
        ("Dominican Republic", "+1"), ("Colombia", "+57"), ("Venezuela", "+58"),
        ("Ecuador", "+593"), ("Peru", "+51"), ("Bolivia", "+591"), ("Chile", "+56"),
        ("Argentina", "+54"), ("Paraguay", "+595"), ("Uruguay", "+598"), ("Brazil", "+55"),
        ("China", "+86"), ("Japan", "+81"), ("South Korea", "+82"), ("India", "+91"),
        ("Australia", "+61"), ("New Zealand", "+64"), ("South Africa", "+27"),
    };

    private IReadOnlyList<(string Name, string Code)> FilteredPrefixes =>
        (string.IsNullOrWhiteSpace(_prefixSearch)
            ? PhonePrefixes.AsEnumerable()
            : PhonePrefixes.Where(p =>
                p.Name.Contains(_prefixSearch, StringComparison.OrdinalIgnoreCase) ||
                p.Code.Contains(_prefixSearch, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private void TogglePrefixMenu()
    {
        _prefixMenuOpen = !_prefixMenuOpen;
        _prefixSearch = "";
    }

    private void ClosePrefixMenu() => _prefixMenuOpen = false;

    private void PickPrefix(string code)
    {
        _phonePrefix = code;
        _prefixMenuOpen = false;
        SyncPhone();
    }

    private void SyncPhone()
    {
        if (_resForm is null) return;
        _resForm.Phone = string.IsNullOrWhiteSpace(_phoneLocal) ? null : $"{_phonePrefix} {_phoneLocal.Trim()}";
    }

    // Longest-prefix-first match so e.g. "+351" (Portugal) isn't mistaken for "+35" of nothing —
    // codes overlap in their leading digits (+1, +34, +352…), so length order matters.
    private void SplitPhone()
    {
        _phonePrefix = "+34";
        _phoneLocal = "";
        var raw = _resForm?.Phone?.Trim();
        if (string.IsNullOrWhiteSpace(raw)) return;

        var match = PhonePrefixes
            .OrderByDescending(p => p.Code.Length)
            .FirstOrDefault(p => raw.StartsWith(p.Code, StringComparison.Ordinal));
        if (match.Code is not null)
        {
            _phonePrefix = match.Code;
            _phoneLocal = raw[match.Code.Length..].TrimStart();
        }
        else
        {
            _phoneLocal = raw;
        }
    }

    private void GoToStep(int step)
    {
        if (step <= _resMaxStep) _resStep = step;
    }

    private void GoNext()
    {
        // Leaving the Guest step needs a name and a phone — checked here (one message at a
        // time) instead of just disabling Next, so pressing it always says exactly what's
        // still missing rather than silently doing nothing.
        if (_resStep == 1 && _resForm is not null)
        {
            if (string.IsNullOrWhiteSpace(_resForm.CustomerName)) { _resError = Loc.T("Enter the customer's name."); return; }
            if (string.IsNullOrWhiteSpace(_resForm.Phone)) { _resError = Loc.T("Enter a phone number."); return; }
        }

        _resError = null;
        _resStep = Math.Min(ResSteps.Length, _resStep + 1);
        _resMaxStep = Math.Max(_resMaxStep, _resStep);
    }

    private void GoBack() => _resStep = Math.Max(1, _resStep - 1);

    // Picking a date or a service period is a single, unambiguous action — so unlike the
    // free-text/number steps, these two advance the wizard on their own instead of waiting for
    // an explicit Next click.
    private void PickDate(DateTime date)
    {
        if (_resForm is null) return;
        _resForm.Date = date;
        GoNext();
    }

    // Picking a period no longer jumps straight to the next step — it just anchors the form to
    // that period's start so ServiceSlots below has something to show, and reveals the quarter-hour
    // slot grid for it. The wizard only advances once an actual slot is picked.
    private void PickPeriod(TimeOnly start)
    {
        if (_resForm is null) return;
        _resForm.Time = start;
    }

    private void PickSlot(TimeOnly slot)
    {
        if (_resForm is null) return;
        _resForm.Time = slot;
        GoNext();
    }

    // Quarter-hour slots spanning the currently selected service period, e.g. 13:00, 13:15 …
    // up to whatever end time is configured in Settings. Picking one sets the reservation's
    // exact time and advances straight to the summary — no separate "pick the hour" step.
    private List<TimeOnly> CurrentPeriodSlots => _resForm is null ? new() : Branding.Current.GetPeriod(_resForm.Time) switch
    {
        ServicePeriod.Lunch => ServiceSlots(Branding.Current.LunchStart, Branding.Current.LunchEnd),
        ServicePeriod.Dinner => ServiceSlots(Branding.Current.DinnerStart, Branding.Current.DinnerEnd),
        _ => new()
    };

    private static List<TimeOnly> ServiceSlots(TimeOnly start, TimeOnly end)
    {
        var slots = new List<TimeOnly>();
        var t = start;
        for (var i = 0; i < 96 && t <= end; i++)
        {
            slots.Add(t);
            t = t.AddMinutes(15);
        }
        return slots;
    }

    // Seats needed = adults (party size) + children, so the seat-count check accounts for everyone at the table.
    private int FormTotalGuests => _resForm is null ? 0 : _resForm.PartySize + _resForm.ChildrenCount;

    private bool _saveSuccess;
    private bool _savingRes;
    private bool _wasNewReservation;

    private async Task SaveRes()
    {
        // Guards the whole save + success-checkmark window: without it, a second click while the
        // 650ms confirmation is showing would re-submit the same (already cleared) form.
        if (_resForm is null || _savingRes) return;
        var result = await ResValidator.ValidateAsync(_resForm);
        if (!result.IsValid) { _resError = result.Errors[0].ErrorMessage; return; }

        _savingRes = true;
        try
        {
            _wasNewReservation = _resForm.Id == 0;
            if (_resForm.Id > 0) await ReservationService.UpdateAsync(_resForm);
            else await ReservationService.CreateAsync(_resForm);

            await LoadReservations();
            await Load();

            // A brief checkmark confirmation instead of the panel just vanishing — makes the
            // save read as a deliberate, acknowledged action rather than an abrupt reset.
            _saveSuccess = true;
            StateHasChanged();
            await Task.Delay(650);

            _saveSuccess = false;
            _resForm = null;
        }
        finally
        {
            _savingRes = false;
        }
    }

    private async Task DeleteRes(int id)
    {
        await ReservationService.DeleteAsync(id);
        _resForm = null;
        await LoadReservations();
        await Load();
    }

    private static string StatusClass(ReservationStatus s) => s switch
    {
        ReservationStatus.Confirmed => "badge--primary",
        ReservationStatus.Seated => "badge--warning",
        ReservationStatus.Finished => "badge--success",
        ReservationStatus.Cancelled => "badge--danger",
        ReservationStatus.Pending => "badge--pending",
        _ => ""
    };

    // Which service turn a reservation's time falls into, so it reads at a glance in the
    // day list and on the floor plan without having to parse the raw HH:mm.
    private string PeriodIcon(TimeOnly time) => FloorPlanHelpers.PeriodIcon(Branding.Current.GetPeriod(time));

    private string PeriodLabel(TimeOnly time) => Branding.Current.GetPeriod(time) switch
    {
        ServicePeriod.Lunch => "Lunch",
        ServicePeriod.Dinner => "Dinner",
        _ => "Outside service hours"
    };

    // ---- Table click routing ----
    private async Task OnTableClick(TableDto t)
    {
        if (_paintMode) { _selectedAssignedTableId = null; await PaintTable(t); return; }
        if (_editing) return;   // in edit mode a click is a drag (JS owns it)
        if (_selecting)
        {
            _selectedAssignedTableId = null;
            if (!_selection.Add(t.Id)) _selection.Remove(t.Id);
            return;
        }
        if (_assignReservationId is not null) { _selectedAssignedTableId = null; await AssignToTable(t.Id); return; }
        if (_reassigning)
        {
            _selectedAssignedTableId = null;
            // Only an occupied table (with an order to move) opens the inline confirm+destination
            // picker; clicking a free table while reassigning does nothing.
            if (t.ActiveOrderId is not null) { _reassignSource = t; _reassignDestId = null; }
            return;
        }

        // First click on a table carrying a reservation only reveals its quick-remove X (see
        // RemoveTableFromReservation) instead of opening the comanda; a second click on that same
        // table falls through below and opens it as usual. Clicking any other table — reserved or
        // not — clears the reveal instead of leaving it stuck open on a table no longer selected.
        if (ResByTable.TryGetValue(t.Id, out _) && _selectedAssignedTableId != t.Id)
        {
            _selectedAssignedTableId = t.Id;
            return;
        }
        _selectedAssignedTableId = null;

        // A single tap always jumps straight into the table's comanda (opening one if it doesn't
        // have one yet, same as tapping a table in /pos) instead of the properties form — same
        // behaviour whether the map is expanded or not. Tables stay reachable for editing
        // (shape/colour/etc.) only via "Edit layout"'s per-table pencil button instead.
        await OpenOrderEditorFor(t);
    }

    private async Task OpenOrderEditorFor(TableDto t)
    {
        if (t.ActiveOrderId is not null) { _editorOrderId = t.ActiveOrderId; return; }
        var order = await OrderSvc.OpenOrderAsync(t.Id, _userId);
        _editorOrderId = order.Id;
        await Load();
    }

    private int? _editorOrderId;
    private void CloseOrderEditor() => _editorOrderId = null;
    private async Task OnOrderEditorChanged() => await Load();

    private void OpenForm(int? id)
    {
        _error = null;
        if (id is null) { _form = new TableFormDto { Zone = _zoneFilter }; _groupMembers = new(); _groupId = null; _groupNameEdit = ""; return; }

        var t = _tables.First(x => x.Id == id);
        _form = new TableFormDto { Id = t.Id, Name = t.Name, Seats = t.Seats, Shape = t.Shape, Zone = t.Zone, Color = t.Color };
        _groupId = t.GroupId;
        _groupNameEdit = t.GroupName ?? "";
        _groupMembers = t.GroupId is null
            ? new()
            : _tables.Where(x => x.GroupId == t.GroupId && x.Id != t.Id).Select(x => x.Name).ToList();
    }

    private void Close() { _form = null; _groupMembers = new(); _groupId = null; _groupNameEdit = ""; }

    private async Task Save()
    {
        if (_form is null) return;
        var result = await Validator.ValidateAsync(_form);
        if (!result.IsValid) { _error = result.Errors[0].ErrorMessage; return; }

        if (_form.Id > 0) await Service.UpdateInfoAsync(_form);
        else await Service.CreateAsync(_form);

        if (_groupId is not null) await Service.RenameGroupAsync(_groupId.Value, _groupNameEdit);

        _form = null;
        _groupMembers = new();
        _groupId = null;
        _groupNameEdit = "";
        await Load();
    }

    private async Task Delete(int id)
    {
        try { await Service.DeleteAsync(id); }
        catch (InvalidOperationException ex) { _error = ex.Message; return; }
        _form = null;
        _groupMembers = new();
        _groupId = null;
        _groupNameEdit = "";
        await Load();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            // Navigating away mid-edit (without Save/Cancel) would otherwise skip the JS-side
            // dispose(), leaving its window-level pointermove/pointerup listeners registered
            // forever with closures over this page's now-detached DOM.
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch { /* circuit already gone */ }
        }
    }
}
