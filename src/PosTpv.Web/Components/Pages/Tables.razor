@page "/tables"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Waiter,Cashier")]
@using System.Globalization
@using System.Security.Claims
@using FluentValidation
@implements IAsyncDisposable
@inject ITableService Service
@inject IFloorDecorService DecorService
@inject IFloorZoneService ZoneService
@inject IReservationService ReservationService
@inject IOrderService OrderSvc
@inject IValidator<TableFormDto> Validator
@inject IValidator<ReservationFormDto> ResValidator
@inject IJSRuntime JS
@inject AppSettingsCache Branding
@inject ISettingsService Settings
@inject NavigationManager Nav

<PageTitle>Tables · @Branding.Current.Title</PageTitle>

<div class="floor-layout floor-layout--split @(_mapExpanded ? "floor-layout--map-expanded" : "")">
    <div class="floor-panel card">
        @if (_notice is not null)
        {
            <p class="floor-notice">@_notice</p>
        }
        @if (_selecting)
        {
            <p class="floor-hint muted">@Loc.T("Tap two or more free tables to join them into one group that shares a single bill.")</p>
        }

    <div class="floor-wrap">
    @* Floats over the map's top-right corner instead of taking its own row, so the map
       fills the whole panel height. *@
    <div class="toolbar toolbar--tables @(_showFilters ? "toolbar--tables-menu-open" : "")">
        <span class="spacer"></span>
        @* Rendered unconditionally (outside the Edit/Select/Reassign/default branches below) and
           absolutely positioned (.floor-settings) so it always sits in the map's top-right corner —
           it used to live inside the "default" toolbar-actions row only, so it vanished entirely
           whenever _editing/_selecting/_reassigning replaced that row with their own controls. *@
        <div class="floor-tex-widget floor-settings">
            <button class="btn btn--icon @(_showFilters ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Filters")" @onclick="() => _showFilters = !_showFilters"><LucideIcon Name="settings" Size="16" /></button>
            @if (_showFilters)
            {
                <div class="floor-tools-menu">
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_zoneMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Zones")" @onclick="ToggleZoneMenu"><LucideIcon Name="square-dashed" Size="16" /></button>
                        @if (_zoneMenuOpen || _zoneMenuClosing)
                        {
                            <div class="floor-tex-menu zone-pick @(_zoneMenuClosing ? "floor-tex-menu--closing" : "")">
                                @foreach (var z in _zones)
                                {
                                    <button type="button" class="zone-chip" style="@(z.Color is not null && !IsImageColor(z.Color) ? $"--zc:{z.Color}" : "")" @onclick="() => { OnZoneClick(z); _zoneMenuOpen = false; _zoneEditActive = true; StartEdit(); }">@z.Name</button>
                                }
                                <button type="button" class="floor-tex-opt" title="@Loc.T("Add zone")" @onclick="AddZone">
                                    <span class="zone-swatch"><LucideIcon Name="plus" Size="14" /></span>
                                    <span class="floor-tex-opt__label">@Loc.T("Add zone")</span>
                                </button>
                            </div>
                        }
                    </div>
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_floorMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Floor style")" @onclick="ToggleFloorMenu"><LucideIcon Name="image" Size="16" /></button>
                        @if (_floorMenuOpen || _floorMenuClosing)
                        {
                            <div class="floor-tex-menu tex-pick @(_floorMenuClosing ? "floor-tex-menu--closing" : "")">
                                @foreach (var tex in FloorTextures)
                                {
                                    <button type="button" class="floor-tex-opt @(Branding.Current.FloorTexture == tex ? "floor-tex-opt--on" : "")" title="@Loc.T(TextureLabel(tex))" @onclick="() => ChooseFloorTexture(tex)">
                                        <span class="floor-tex-swatch floor-tex-swatch--@tex"></span>
                                        <span class="floor-tex-opt__label">@Loc.T(TextureLabel(tex))</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_paintMode || _paintMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Paint table colours")" @onclick="TogglePaintMenu"><LucideIcon Name="palette" Size="16" /></button>
                    </div>
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_plantMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Plants")" @onclick="TogglePlantMenu"><LucideIcon Name="leaf" Size="16" /></button>
                        @if (_plantMenuOpen || _plantMenuClosing)
                        {
                            <div class="floor-tex-menu plant-pick @(_plantMenuClosing ? "floor-tex-menu--closing" : "")">
                                @foreach (var type in PlantTypes)
                                {
                                    <button type="button" class="floor-tex-opt" title="@Loc.T(DecorLabel(type))" @onclick="() => AddDecor(type)">
                                        <span class="decor-swatch decor-swatch--@DecorSlug(type)"></span>
                                        <span class="floor-tex-opt__label">@Loc.T(DecorLabel(type))</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="floor-tex-widget">
                        <button class="btn btn--icon @(_designMenuOpen ? "btn--primary" : "btn--ghost") btn--sm" title="@Loc.T("Design elements")" @onclick="ToggleDesignMenu"><LucideIcon Name="layout-template" Size="16" /></button>
                        @if (_designMenuOpen || _designMenuClosing)
                        {
                            <div class="floor-tex-menu design-pick @(_designMenuClosing ? "floor-tex-menu--closing" : "")">
                                @foreach (var type in InteriorTypes)
                                {
                                    <button type="button" class="floor-tex-opt" title="@Loc.T(DecorLabel(type))" @onclick="() => AddDecor(type)">
                                        <span class="decor-swatch decor-swatch--@DecorSlug(type)"></span>
                                        <span class="floor-tex-opt__label">@Loc.T(DecorLabel(type))</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        @if (_editing)
        {
            <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Cancel")" @onclick="CancelEdit"><LucideIcon Name="x" Size="16" /></button>
            <button class="btn btn--icon btn--primary btn--sm" title="@Loc.T("Save layout")" @onclick="SaveLayout"><LucideIcon Name="save" Size="14" /></button>
        }
        else if (_selecting)
        {
            <span class="badge badge--primary">@_selection.Count @Loc.T("selected")</span>
            <button class="btn btn--ghost btn--sm" @onclick="CancelSelect">@Loc.T("Cancel")</button>
            @if (SelectedGroupId is not null)
            {
                <button class="btn btn--danger btn--sm" @onclick="SeparateSelectedGroup"><LucideIcon Name="split" Size="14" />@Loc.T("Separate")</button>
            }
            else
            {
                <button class="btn btn--primary btn--sm" disabled="@(_selection.Count < 2)" @onclick="OpenJoinNamePrompt"><LucideIcon Name="link" Size="14" />@Loc.T("Join")</button>
            }
        }
        else if (_reassigning)
        {
            <button class="btn btn--ghost btn--sm" @onclick="CancelReassign">@Loc.T("Cancel")</button>
        }
        else if (_paintMode)
        {
            @* Each tap on a table already applies (and persists) the selected colour immediately —
               there's no staged change to discard — but the icon-only Cancel/Done pair still mirrors
               the Edit-layout toolbar (see _editing above) so every "mode" in this toolbar exits the
               same way instead of paint mode alone keeping the old floating text hint + button. *@
            <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Cancel")" @onclick="StopPaintMode"><LucideIcon Name="x" Size="16" /></button>
            <button class="btn btn--icon btn--primary btn--sm" title="@Loc.T("Done")" @onclick="StopPaintMode"><LucideIcon Name="save" Size="14" /></button>
        }
        else if (_showFilters)
        {
            <div class="toolbar-actions">
                <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("New table")" @onclick="() => OpenForm(null)"><LucideIcon Name="plus" Size="16" /></button>
                <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Join tables")" @onclick="StartSelect"><LucideIcon Name="link" Size="16" /></button>
                <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Assign tables")" @onclick="StartReassign"><LucideIcon Name="arrow-right-left" Size="16" /></button>
                <button class="btn btn--icon btn--primary btn--sm" title="@Loc.T("Edit layout")" @onclick="StartEdit"><LucideIcon Name="move" Size="16" /></button>
            </div>
        }
        @* Expand/collapse always renders, regardless of Edit/Select/Reassign/Filters mode, so the
           map stays navigable while any of those tools is active instead of only from the bare
           default toolbar. Zoom moved out of this bar (see .floor-zoom-dock below) to sit right
           above the zone-filter pill instead. *@
        <button class="btn btn--icon btn--ghost btn--sm" type="button"
                title="@(_mapExpanded ? Loc.T("Minimise map") : Loc.T("Expand map"))" @onclick="() => _mapExpanded = !_mapExpanded">
            <LucideIcon Name="@(_mapExpanded ? "minimize-2" : "maximize-2")" Size="16" />
        </button>
    </div>
    @* Stacked bottom-center of the map: zoom always renders here (even in Edit/Select mode, when
       the zone-filter pill below it is hidden), with the zone tabs docked directly under it. *@
    <div class="floor-zoom-dock">
        <span class="zoom-group zoom-group--sm">
            <button class="btn btn--icon btn--ghost btn--sm" type="button" disabled="@(_zoom <= ZoomMin)" title="@Loc.T("Zoom out")" @onclick="ZoomOut"><LucideIcon Name="zoom-out" Size="12" /></button>
            <button class="zoom-group__level" type="button" title="@Loc.T("Reset zoom")" @onclick="ZoomReset">@((_zoom * 100).ToString("0"))%</button>
            <button class="btn btn--icon btn--ghost btn--sm" type="button" disabled="@(_zoom >= ZoomMax)" title="@Loc.T("Zoom in")" @onclick="ZoomIn"><LucideIcon Name="zoom-in" Size="12" /></button>
        </span>
        @if (!_editing && !_selecting && _assignReservationId is null && Zones.Count > 0)
        {
            <div class="tabs zone-filter">
                <button class="tabs__opt @(_zoneFilter is null ? "tabs__opt--on" : "")" @onclick="() => _zoneFilter = null">@Loc.T("All zones")</button>
                @foreach (var z in Zones)
                {
                    <button class="tabs__opt @(_zoneFilter == z ? "tabs__opt--on" : "")" @onclick="() => _zoneFilter = z">@z</button>
                }
            </div>
        }
    </div>
    @if (_reassigning && _reassignSource is null)
    {
        <div class="floor-hint floor-hint--assign floor-hint--floating">
            <LucideIcon Name="arrow-right-left" Size="16" /> @Loc.T("Click the occupied table whose order you want to move.")
        </div>
    }
    @if (_reassignSource is not null)
    {
        <div class="reassign-popover">
            <div class="reassign-popover__title"><LucideIcon Name="arrow-right-left" Size="15" /> @Loc.T("Reassign") @(_reassignSource.GroupId is not null ? (_reassignSource.GroupName ?? _reassignSource.Name) : _reassignSource.Name)?</div>
            <select class="select" @bind="_reassignDestId">
                <option value="">@Loc.T("Choose a table")</option>
                @foreach (var dest in VisibleTables.Where(x => x.Id != _reassignSource.Id && x.ActiveOrderId is null && x.GroupId is null))
                {
                    <option value="@dest.Id">@dest.Name</option>
                }
            </select>
            <div class="reassign-popover__actions">
                <button class="btn btn--ghost btn--sm" @onclick="CancelReassign">@Loc.T("Cancel")</button>
                <button class="btn btn--primary btn--sm" disabled="@(_reassignDestId is null)" @onclick="ConfirmReassign">@Loc.T("Confirm")</button>
            </div>
        </div>
    }
    <div class="floor floor--tex-@Branding.Current.FloorTexture @(_editing ? "floor--edit" : "") @(_selecting ? "floor--select" : "") @(_assignReservationId is not null ? "floor--assign" : "") @(_reassigning ? "floor--assign" : "") @(_paintMode ? "floor--assign" : "")" @ref="_floorEl">
        @{
            // Computed once per render instead of once per table/foreach: VisibleTables filters the
            // whole floor and ResByTable groups every reservation, so re-evaluating either property
            // on each access below was doing that work again for every table and every group badge.
            var visible = VisibleTables;
            var resByTable = ResByTable;
        }
    <div class="floor-canvas" style="transform:scale(@N(_zoom)); transform-origin:0 0; --zoom:@N(_zoom);">
        @foreach (var z in VisibleZones)
        {
            <div class="floor-zone @(!_editing && _zoneFilter == z.Name ? "floor-zone--on" : "") @(_editing && _zoneEditActive ? "floor-zone--btns-visible" : "") @(z.Color is not null && IsImageColor(z.Color) ? "floor-zone--img" : "")"
                 data-id="@z.Id"
                 data-x="@N(z.PositionX)" data-y="@N(z.PositionY)"
                 data-w="@N(z.Width)" data-h="@N(z.Height)" data-rot="0"
                 data-locked="false"
                 style="@ZoneStyle(z)"
                 title="@z.Name">
                <span class="floor-zone__name">@z.Name</span>
                @if (_editing)
                {
                    @if (_zoneEditActive)
                    {
                        @* Rename/delete need a Blazor-rendered Modal (rename) or a live list
                           update (delete) to actually show up — impossible while _editing has
                           frozen rendering for JS to own the DOM (see ShouldRender/_suppressRender)
                           — so both handlers below step out of edit mode first (Save for rename,
                           so a drag already in progress isn't silently thrown away; Cancel for
                           delete, since the zone about to be removed has nothing worth keeping)
                           before doing anything Blazor needs to re-render for. floorplan.js's
                           onDown also has to ignore pointerdown on these two, or it arms a drag
                           on the zone underneath before the click ever reaches these handlers. *@
                        <button class="floor-zone__rename" type="button" title="@Loc.T("Rename")" @onclick="() => EditZoneDuringLayoutEdit(z)" @onclick:stopPropagation="true"><LucideIcon Name="pencil" Size="12" /></button>
                    }
                    <button class="floor-zone__delete" type="button" title="@Loc.T("Remove")" @onclick="() => RequestDeleteZone(z)" @onclick:stopPropagation="true"><LucideIcon Name="x" Size="12" /></button>
                    <span class="tbl__handle tbl__handle--resize" title="@Loc.T("Resize")"></span>
                }
                else if (_zoneMenuOpen || _zoneFilter == z.Name)
                {
                    @* Shown while the "Zones" toolbar button's own edit mode is on (see
                       ToggleZoneMenu) — otherwise these sat on every zone box all the time, so
                       modifying a zone only ever took clicking directly on it, never the button —
                       or, once a chip has narrowed the map down to that one zone (_zoneFilter),
                       on that single remaining zone box even after the dropdown itself has
                       closed, since it's now the only thing left to act on. *@
                    <button class="floor-zone__rename" type="button" title="@Loc.T("Rename")" @onclick="() => StartRenameZone(z)" @onclick:stopPropagation="true"><LucideIcon Name="pencil" Size="12" /></button>
                    <button class="floor-zone__delete" type="button" title="@Loc.T("Remove")" @onclick="() => RemoveZone(z.Id)" @onclick:stopPropagation="true"><LucideIcon Name="x" Size="12" /></button>
                }
            </div>
        }
        @foreach (var t in visible)
        {
            resByTable.TryGetValue(t.Id, out var rv);
            <div class="@TableClass(t, rv)"
                 data-id="@t.Id"
                 data-x="@N(t.PositionX)" data-y="@N(t.PositionY)"
                 data-w="@N(t.Width)" data-h="@N(t.Height)" data-rot="@N(t.Rotation)"
                 data-locked="@(t.IsLocked ? "true" : "false")"
                 data-shape="@((int)t.Shape)"
                 data-group="@(t.GroupId?.ToString() ?? "")"
                 data-seam="@GroupSeamAttr(t)"
                 style="@TableStyle(t)"
                 @onclick="() => OnTableClick(t)"
                 @oncontextmenu:preventDefault="true"
                 title="@(t.GroupId is not null ? (t.GroupName ?? t.Name) : t.Name)">
                @if (!_editing)
                {
                    @foreach (var chairStyle in ChairStyles(t, _tables))
                    {
                        <svg class="tbl__chair @(EffectiveTableStatus(t, rv) == TableStatus.Occupied ? "tbl__chair--seated" : "")"
                             style="@chairStyle" viewBox="0 0 14 19.6" width="14" height="19.6">
                            <rect class="chair-leg" x="-1" y="9.1" width="1.7" height="2" rx="0.4" />
                            <rect class="chair-leg" x="13.3" y="9.1" width="1.7" height="2" rx="0.4" />
                            <rect class="chair-leg" x="-1" y="13.65" width="1.7" height="2" rx="0.4" />
                            <rect class="chair-leg" x="13.3" y="13.65" width="1.7" height="2" rx="0.4" />
                            <rect class="chair-seat" x="0" y="5.25" width="14" height="14" rx="3.5" />
                            <rect class="chair-cushion" x="2.1" y="7.35" width="9.8" height="9.8" rx="2.45" />
                            <rect class="chair-backrest" x="1.4" y="0" width="11.2" height="5.95" rx="2.8" />
                        </svg>
                    }
                }
                <div class="tbl__content">
                    @if (t.GroupId is null)
                    {
                        <span class="tbl__name">@t.Name</span>
                        <span class="tbl__seats">@t.Seats<LucideIcon Name="user" Size="12" /></span>
                        @if (rv is not null)
                        {
                            <span class="tbl__total">@rv.CustomerName</span>
                        }
                    }
                </div>
                @* Grouped tables skip this entirely — see the .tbl__resv--group badge below,
                   rendered once per group and centred on the whole joined row instead of hanging
                   off whichever member happens to be the anchor. *@
                @if (!_editing && rv is not null && t.GroupId is null)
                {
                    <span class="tbl__resv" title="@rv.CustomerName"><LucideIcon Name="@(rv.Status == ReservationStatus.Seated ? "armchair" : PeriodIcon(rv.Time))" Size="14" /> @rv.Time.ToString("HH:mm")</span>
                }
                @* Revealed by a first click on this same assigned table (see OnTableClick) instead of
                   showing on every reserved table all the time — a second click on the table itself
                   still opens its comanda as usual; this X only removes the table from the reservation. *@
                @if (!_editing && rv is not null && _selectedAssignedTableId == t.Id)
                {
                    <button type="button" class="tbl__unassign" title="@Loc.T("Remove from reservation")" @onclick="() => RemoveTableFromReservation(t)" @onclick:stopPropagation="true"><LucideIcon Name="x" Size="12" /></button>
                }
                @if (_editing)
                {
                    @if (t.GroupId is null)
                    {
                        @* Grouped members skip shape: JoinTablesAsync already forces every member
                           to share one Rotation/IsLocked/Height, so editing it individually while
                           joined doesn't fit the "reads as one table" model — and, concretely,
                           .tbl__shape sits bottom-left on its own table while .tbl__handle--resize
                           sits bottom-right on the one before it, so for two tables snapped
                           edge-to-edge those two controls land almost exactly on top of each other
                           at the shared seam. Grabbing one member's resize handle there could land
                           on its neighbour's shape button instead, silently cycling that neighbour
                           from square to round. *@
                        <button class="tbl__shape" type="button" title="@Loc.T("Change shape")">@ShapeIcon(t.Shape)</button>
                    }
                    @* One edit button per group (on its anchor member), not one per table — a
                       joined block reads and is edited as a single unit, so its pencil opens the
                       shared group name below instead of each member's own name in turn. *@
                    @if (t.GroupId is null || IsGroupAnchor(t))
                    {
                        <button class="tbl__rename" type="button" title="@Loc.T("Edit table")" @onclick="() => EditTableDuringLayoutEdit(t)" @onclick:stopPropagation="true"><LucideIcon Name="pencil" Size="14" /></button>
                    }
                    <button class="tbl__delete" type="button" title="@Loc.T("Remove")" @onclick="() => RequestDeleteTable(t)" @onclick:stopPropagation="true"><LucideIcon Name="x" Size="14" /></button>
                    <span class="tbl__handle tbl__handle--rotate" title="@Loc.T("Rotate")"></span>
                    <span class="tbl__handle tbl__handle--resize" title="@Loc.T("Resize")"></span>
                }
            </div>
        }
        @* One badge per group, centered on the bounding box of its member tables — rather
           than pinned to a single anchor table — so it sits right where they join once
           dragged, and carries the group's own name now that no single member shows it. *@
        @foreach (var gid in visible.Where(t => t.GroupId.HasValue).Select(t => t.GroupId!.Value).Distinct())
        {
            var grv = GroupReservation(gid, resByTable);
            <span class="tbl__group" data-group="@gid" style="@GroupCenterStyle(gid, visible) --grp:@GroupColor(gid)">
                @if (grv is not null)
                {
                    <span class="tbl__total">@grv.CustomerName</span>
                }
                <span class="tbl__group-name">@GroupDisplayName(gid)</span>
                <span class="tbl__group-seats"><LucideIcon Name="link" Size="15" /> @GroupSeats(gid)<LucideIcon Name="user" Size="14" /></span>
            </span>
            @if (!_editing && grv is not null)
            {
                <span class="tbl__resv tbl__resv--group" data-group="@gid" style="@GroupBottomCenterStyle(gid, visible)" title="@grv.CustomerName"><LucideIcon Name="@(grv.Status == ReservationStatus.Seated ? "armchair" : PeriodIcon(grv.Time))" Size="14" /> @grv.Time.ToString("HH:mm")</span>
            }
        }
        @foreach (var d in VisibleDecor)
        {
            <div class="decor decor--@DecorSlug(d.Type)"
                 data-id="@d.Id"
                 data-x="@N(d.PositionX)" data-y="@N(d.PositionY)"
                 data-w="@N(d.Width)" data-h="@N(d.Height)" data-rot="@N(d.Rotation)"
                 data-locked="@(d.IsLocked ? "true" : "false")"
                 style="@DecorStyle(d)"
                 title="@Loc.T(DecorLabel(d.Type))">
                @if (_editing)
                {
                    <button class="tbl__lock" type="button" title="@Loc.T("Lock / unlock")"><LucideIcon Name="@(d.IsLocked ? "lock" : "lock-open")" Size="14" /></button>
                    <button class="decor__delete" type="button" title="@Loc.T("Remove")" @onclick="() => RequestDeleteDecor(d)" @onclick:stopPropagation="true"><LucideIcon Name="x" Size="12" /></button>
                    <span class="tbl__handle tbl__handle--rotate" title="@Loc.T("Rotate")"></span>
                    <span class="tbl__handle tbl__handle--resize" title="@Loc.T("Resize")"></span>
                }
            </div>
        }
        @if (_tables.Count == 0) { <p class="empty">@Loc.T("No tables yet. Create one to start.")</p> }
        else if (visible.Count == 0) { <p class="empty">@Loc.T("No tables in this zone.")</p> }
    </div>
    </div>
    </div>
    </div>

        <div class="resv-col">
        <div class="tables-datebar card">
            <div class="resv__day-nav">
                <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Previous day")" @onclick="() => ShiftDay(-1)"><LucideIcon Name="arrow-left" Size="11" /></button>
                <div class="resv__head-date-wrap">
                    <div class="tabs resv__head-periods">
                        <button class="tabs__opt @(_periodFilter == ServicePeriod.Lunch ? "tabs__opt--on" : "")" title="@Loc.T("Lunch")"
                                @onclick="() => _periodFilter = _periodFilter == ServicePeriod.Lunch ? null : ServicePeriod.Lunch">
                            <LucideIcon Name="sun" Size="10" />
                        </button>
                        <button class="tabs__opt @(_periodFilter == ServicePeriod.Dinner ? "tabs__opt--on" : "")" title="@Loc.T("Dinner")"
                                @onclick="() => _periodFilter = _periodFilter == ServicePeriod.Dinner ? null : ServicePeriod.Dinner">
                            <LucideIcon Name="moon" Size="10" />
                        </button>
                    </div>
                    <input @ref="_dateInputEl" type="date" class="input resv__head-date" @bind="_reserveDate" @bind:after="LoadReservations" />
                    <button type="button" class="resv__head-date-icon" title="@Loc.T("Pick a date")" @onclick="OpenDatePicker"><LucideIcon Name="calendar" Size="11" /></button>
                </div>
                <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Next day")" @onclick="() => ShiftDay(1)"><LucideIcon Name="arrow-right" Size="11" /></button>
            </div>
            <div class="tables-datebar__actions">
                <button class="resv__stats-btn resv__stats-btn--on" title="@Loc.T("Tables")" @onclick="GoToTables"><LucideIcon Name="calendar" Size="10" /></button>
                <button class="resv__stats-btn" title="@Loc.T("Reservations")" @onclick="OpenDashboard"><LucideIcon Name="bar-chart-3" Size="10" /></button>
            </div>
        </div>
        <aside class="resv card">
        @if (_resForm is not null)
        {
            <div class="resv__head">
                <h2>@(_resForm.Id > 0 ? Loc.T("Edit reservation") : Loc.T("New reservation"))</h2>
                <span class="spacer"></span>
                @if (_resForm.Id > 0)
                {
                    <button class="btn btn--icon btn--ghost" title="@Loc.T("Delete")" @onclick="() => DeleteRes(_resForm.Id)" type="button"><LucideIcon Name="trash-2" Size="16" /></button>
                }
                <button class="btn btn--icon btn--ghost" title="@Loc.T("Close")" @onclick="CloseResForm" type="button"><LucideIcon Name="x" Size="16" /></button>
                <button class="btn btn--icon btn--primary" title="@Loc.T("Save")" disabled="@_savingRes" @onclick="SaveRes" type="button"><LucideIcon Name="check" Size="16" /></button>
            </div>
            <div class="resv-wizard">
                @if (_saveSuccess)
                {
                    <div class="resv-success">
                        <div class="resv-success__circle"><LucideIcon Name="check" Size="26" /></div>
                        <p class="resv-success__text">@(_wasNewReservation ? Loc.T("Reservation created") : Loc.T("Changes saved"))</p>
                    </div>
                }
                else
                {
                <div class="resv-form">
                    <div class="resv-steps">
                        <div class="resv-steps__track"></div>
                        <div class="resv-steps__progress" style="width:@(N(StepProgressWidthPercent))%"></div>
                        @foreach (var s in ResSteps)
                        {
                            <button type="button"
                                    class="resv-step @(s.Step == _resStep ? "resv-step--on" : "") @(s.Step < _resMaxStep && s.Step != _resStep ? "resv-step--done" : "")"
                                    disabled="@(s.Step > _resMaxStep)" @onclick="() => GoToStep(s.Step)">
                                <span class="resv-step__num">@(s.Step < _resMaxStep ? "✓" : s.Step.ToString())</span>
                                <span class="resv-step__label">@Loc.T(s.Label)</span>
                            </button>
                        }
                    </div>

                    <div class="resv-step-panel">
                        @if (_resStep == 1)
                        {
                            <div class="resv-row">
                                <div class="field"><label>@Loc.T("Customer name")</label><input class="input" @bind="_resForm.CustomerName" /></div>
                                <div class="field">
                                    <label>@Loc.T("Phone")</label>
                                    <div class="phone-field">
                                        <button type="button" class="phone-prefix" @onclick="TogglePrefixMenu">
                                            @_phonePrefix<LucideIcon Name="chevron-down" Size="11" />
                                        </button>
                                        <input class="input" @bind="_phoneLocal" @bind:event="oninput" @bind:after="SyncPhone" />
                                        @if (_prefixMenuOpen)
                                        {
                                            <div class="phone-prefix__backdrop" @onclick="ClosePrefixMenu"></div>
                                            <div class="phone-prefix__menu" @onclick:stopPropagation="true">
                                                <input class="input phone-prefix__search" placeholder="@Loc.T("Search country or code…")"
                                                       @bind="_prefixSearch" @bind:event="oninput" autofocus />
                                                <div class="phone-prefix__list">
                                                    @foreach (var p in FilteredPrefixes)
                                                    {
                                                        <button type="button" class="phone-prefix__opt @(p.Code == _phonePrefix ? "phone-prefix__opt--on" : "")" @onclick="() => PickPrefix(p.Code)">
                                                            <span>@p.Name</span>
                                                            <span class="muted">@p.Code</span>
                                                        </button>
                                                    }
                                                    @if (!FilteredPrefixes.Any()) { <p class="empty">@Loc.T("No matches.")</p> }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="resv-row resv-row--guest">
                                <div class="field"><label>@Loc.T("Party size")</label><input type="number" min="0" class="input" @bind="_resForm.PartySize" /></div>
                                <div class="field"><label><LucideIcon Name="baby" Size="12" /> @Loc.T("Children")</label><input type="number" min="0" class="input" @bind="_resForm.ChildrenCount" /></div>
                                <div class="field"><label><LucideIcon Name="armchair" Size="12" /> @Loc.T("High chairs")</label><input type="number" min="0" class="input" @bind="_resForm.HighChairCount" /></div>
                            </div>
                            <div class="field"><label>@Loc.T("Total")</label><div class="field-static">@FormTotalGuests @Loc.T("people")</div></div>
                        }
                        else if (_resStep == 2)
                        {
                            <Calendar Value="_resForm.Date" ValueChanged="PickDate" />
                        }
                        else if (_resStep == 3)
                        {
                            <div class="period-picker">
                                <button type="button" class="period-opt @(Branding.Current.GetPeriod(_resForm.Time) == ServicePeriod.Lunch ? "period-opt--on" : "")"
                                        @onclick="() => PickPeriod(Branding.Current.LunchStart)">
                                    <LucideIcon Name="sun" Size="16" />
                                    <span class="period-opt__label">@Loc.T("Lunch")</span>
                                    <span class="period-opt__time">@Branding.Current.LunchStart.ToString("HH:mm")–@Branding.Current.LunchEnd.ToString("HH:mm")</span>
                                </button>
                                <button type="button" class="period-opt @(Branding.Current.GetPeriod(_resForm.Time) == ServicePeriod.Dinner ? "period-opt--on" : "")"
                                        @onclick="() => PickPeriod(Branding.Current.DinnerStart)">
                                    <LucideIcon Name="moon" Size="16" />
                                    <span class="period-opt__label">@Loc.T("Dinner")</span>
                                    <span class="period-opt__time">@Branding.Current.DinnerStart.ToString("HH:mm")–@Branding.Current.DinnerEnd.ToString("HH:mm")</span>
                                </button>
                            </div>
                            var slots = CurrentPeriodSlots;
                            @if (slots.Count > 0)
                            {
                                <div class="slot-grid">
                                    @foreach (var slot in slots)
                                    {
                                        <button type="button" class="slot-chip @(slot == _resForm.Time ? "slot-chip--on" : "")" @onclick="() => PickSlot(slot)">@slot.ToString("HH:mm")</button>
                                    }
                                </div>
                            }
                        }
                        else if (_resStep == 4)
                        {
                            <div class="resv-summary__title">@(_resForm.Id > 0 ? Loc.T("Edit reservation") : Loc.T("New reservation"))</div>
                            <div class="resv-summary">
                                <div class="resv-summary__row"><LucideIcon Name="user" Size="14" /> @(string.IsNullOrWhiteSpace(_resForm.CustomerName) ? Loc.T("Customer name") : _resForm.CustomerName) @if (!string.IsNullOrWhiteSpace(_resForm.Phone)) { <span class="muted"> · @_resForm.Phone</span> }</div>
                                <div class="resv-summary__row"><LucideIcon Name="users" Size="14" /> @FormTotalGuests @Loc.T("people")
                                    @if (_resForm.ChildrenCount > 0) { <span class="muted"> · <LucideIcon Name="baby" Size="13" /> @_resForm.ChildrenCount</span> }
                                    @if (_resForm.HighChairCount > 0) { <span class="muted"> · <LucideIcon Name="armchair" Size="13" /> @_resForm.HighChairCount</span> }
                                </div>
                                <div class="resv-summary__row"><LucideIcon Name="calendar" Size="14" /> @_resForm.Date.ToString("dd MMM yyyy")</div>
                                <div class="resv-summary__row"><LucideIcon Name="@(Branding.Current.GetPeriod(_resForm.Time) == ServicePeriod.Lunch ? "sun" : "moon")" Size="14" /> @Loc.T(Branding.Current.GetPeriod(_resForm.Time) == ServicePeriod.Lunch ? "Lunch" : "Dinner") · @_resForm.Time.ToString("HH:mm")</div>
                            </div>
                            <div class="field"><label>@Loc.T("Comments")</label><textarea class="input" rows="2" @bind="_resForm.Comments"></textarea></div>
                        }

                        @if (_resError is not null) { <div class="field-error">@_resError</div> }
                    </div>

                    <div class="resv-nav @(_resStep == ResSteps.Length ? "resv-nav--joined" : "")">
                        @if (_resStep > 1)
                        {
                            <button type="button" class="btn btn--ghost resv-nav__back--full" @onclick="GoBack"><LucideIcon Name="arrow-left" Size="16" />@Loc.T("Back")</button>
                        }
                        @if (_resStep == 1 && _resStep < ResSteps.Length)
                        {
                            <button type="button" class="btn btn--primary resv-nav__next"
                                    @onclick="GoNext">@Loc.T("Next")<LucideIcon Name="arrow-right" Size="16" /></button>
                        }
                        else if (_resStep == ResSteps.Length)
                        {
                            <button type="button" class="btn btn--primary resv-nav__next" disabled="@_savingRes" @onclick="SaveRes">
                                @(_resForm.Id > 0 ? Loc.T("Save changes") : Loc.T("Create reservation"))
                            </button>
                        }
                    </div>
                </div>
                }
            </div>
        }
        else
        {
            <div class="resv__head">
                <h2>@Loc.T("Reservations")</h2>
                <div class="resv-policy">
                    @* Replaces the old gear-icon trigger: the dot itself already shows the current
                       policy at a glance (colour-coded, see PolicyDotColor), still opens the same
                       picker menu on click. *@
                    <button type="button" class="resv-policy-dot" style="--dot:@PolicyDotColor(Branding.Current.ReservationPolicy)" title="@Loc.T(PolicyLabel(Branding.Current.ReservationPolicy))" @onclick="TogglePolicyMenu"></button>
                    @if (_policyMenuOpen)
                    {
                        <div class="resv-policy__backdrop" @onclick="ClosePolicyMenu"></div>
                        <div class="resv-policy__menu" @onclick:stopPropagation="true">
                            <div class="resv-policy__title">@Loc.T("Taking reservations")</div>
                            @foreach (var opt in ReservationPolicies)
                            {
                                <button type="button" class="resv-policy__opt @(Branding.Current.ReservationPolicy == opt.Value ? "resv-policy__opt--on" : "")"
                                        disabled="@opt.ComingSoon" @onclick="() => SetReservationPolicy(opt.Value)">
                                    <span>@Loc.T(opt.Label)</span>
                                    @if (opt.ComingSoon)
                                    {
                                        <span class="badge">@Loc.T("Coming soon")</span>
                                    }
                                    else if (Branding.Current.ReservationPolicy == opt.Value)
                                    {
                                        <LucideIcon Name="check" Size="14" />
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>
                <span class="spacer"></span>
                <button class="btn btn--primary btn--icon resv__new-btn" title="@Loc.T("New reservation")" @onclick="() => OpenResForm(null)"><LucideIcon Name="plus" Size="15" /></button>
            </div>

            <div class="resv__list">
                @foreach (var r in FilteredReservations)
                {
                    <div class="resv-card @(_assignReservationId == r.Id ? "resv-card--active" : "")" style="border-left:4px solid @r.Color">
                        <div class="resv-card__top">
                            <span class="resv-card__period" title="@Loc.T(PeriodLabel(r.Time))"><LucideIcon Name="@PeriodIcon(r.Time)" Size="14" /></span>
                            <strong>@r.Time.ToString("HH:mm")</strong>
                            <span class="resv-card__name">@r.CustomerName</span>
                            <span class="spacer"></span>
                            <div class="resv-status">
                                <button type="button" class="badge resv-card__status @StatusClass(r.Status)" title="@Loc.T("Status")" @onclick="() => ToggleStatusMenu(r.Id)">
                                    @Loc.T(r.Status.ToString())
                                </button>
                                @if (_statusMenuOpenId == r.Id)
                                {
                                    <div class="resv-status__menu">
                                        @foreach (var s in Enum.GetValues<ReservationStatus>())
                                        {
                                            <button type="button" class="resv-status__opt @(s == r.Status ? "resv-status__opt--on" : "")" @onclick="() => ChooseStatus(r.Id, s)">
                                                <span class="badge @StatusClass(s)">@Loc.T(s.ToString())</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <button class="btn btn--icon btn--ghost btn--sm" title="@Loc.T("Edit")" @onclick="() => OpenResForm(r.Id)"><LucideIcon Name="pencil" Size="14" /></button>
                        </div>
                        <div class="resv-card__meta muted">
                            <LucideIcon Name="users" Size="14" /> @(r.PartySize + r.ChildrenCount)
                            @if (r.ChildrenCount > 0)
                            {
                                <span class="resv-card__stat"><LucideIcon Name="baby" Size="14" /> @r.ChildrenCount</span>
                            }
                            @if (r.HighChairCount > 0)
                            {
                                <span class="resv-card__stat"><LucideIcon Name="armchair" Size="14" /> @r.HighChairCount</span>
                            }
                            @if (r.TableNames.Count > 0)
                            {
                                <span class="resv-card__tables">
                                    @* First click on an assigned chip only reveals its own quick-remove X
                                       (shares _selectedAssignedTableId with the floor map's identical X) instead
                                       of jumping straight into the "change table" picker — a second click on that
                                       same chip falls through to ToggleAssign as before. *@
                                    @foreach (var (tableId, name) in r.TableIds.Zip(r.TableNames))
                                    {
                                        <span class="tbl-chip-wrap">
                                            <button type="button" class="tbl-chip tbl-chip--sm" title="@Loc.T("Click to change table")" @onclick="() => OnAssignedChipClick(r, tableId)"><LucideIcon Name="armchair" Size="12" /> @name</button>
                                            @if (_selectedAssignedTableId == tableId)
                                            {
                                                <button type="button" class="tbl-chip__unassign" title="@Loc.T("Remove from reservation")" @onclick="() => RemoveTableFromReservation(r.Id, tableId)" @onclick:stopPropagation="true"><LucideIcon Name="x" Size="7" /></button>
                                            }
                                        </span>
                                    }
                                    @if (_assignReservationId == r.Id)
                                    {
                                        <button type="button" class="btn btn--icon btn--primary btn--sm resv-card__confirm-assign" title="@Loc.T("Done")" @onclick="CancelAssign"><LucideIcon Name="check" Size="13" /></button>
                                        <button type="button" class="btn btn--icon btn--ghost btn--sm resv-card__confirm-assign" title="@Loc.T("Cancel")" @onclick="CancelAssign"><LucideIcon Name="x" Size="13" /></button>
                                    }
                                    else if (_selectedAssignedTableId is not null && r.TableIds.Contains(_selectedAssignedTableId.Value))
                                    {
                                        @* Shown alongside a chip's revealed X (see above) so the row-level check/cross
                                           are reachable right away too — check opens the same "change table" picker as
                                           tapping the chip a second time, cross just closes the reveal. *@
                                        <button type="button" class="btn btn--icon btn--primary btn--sm resv-card__confirm-assign" title="@Loc.T("Change table")" @onclick="() => ToggleAssign(r)"><LucideIcon Name="check" Size="13" /></button>
                                        <button type="button" class="btn btn--icon btn--ghost btn--sm resv-card__confirm-assign" title="@Loc.T("Close")" @onclick="() => _selectedAssignedTableId = null"><LucideIcon Name="x" Size="13" /></button>
                                    }
                                </span>
                            }
                            else
                            {
                                @* Direct shortcut into assign mode — same as the "Assign" button tucked behind
                                   the gear icon below, but reachable in one tap instead of two. Tick + cross both
                                   sit right next to it as soon as assign mode opens (not only once a table's
                                   been picked), so there's always a visible way to finish/cancel right here
                                   instead of the floating "Done" hints this replaces. *@
                                <button type="button" class="tbl-chip tbl-chip--sm tbl-chip--unassigned" @onclick="() => ToggleAssign(r)">@Loc.T("Unassigned")</button>
                                @if (_assignReservationId == r.Id)
                                {
                                    <button type="button" class="btn btn--icon btn--primary btn--sm resv-card__confirm-assign" title="@Loc.T("Done")" @onclick="CancelAssign"><LucideIcon Name="check" Size="13" /></button>
                                    <button type="button" class="btn btn--icon btn--ghost btn--sm resv-card__confirm-assign" title="@Loc.T("Cancel")" @onclick="CancelAssign"><LucideIcon Name="x" Size="13" /></button>
                                }
                            }
                            <span class="spacer"></span>
                            @if (r.Status is ReservationStatus.Pending or ReservationStatus.Confirmed)
                            {
                                <button class="btn btn--primary btn--sm" disabled="@(r.TableIds.Count == 0)"
                                        title="@(r.TableIds.Count == 0 ? Loc.T("Assign a table before seating this reservation.") : null)"
                                        @onclick="() => SetResStatus(r.Id, ReservationStatus.Seated)"><LucideIcon Name="check" Size="15" />@Loc.T("Seat")</button>
                            }
                            else if (r.Status == ReservationStatus.Seated)
                            {
                                <button class="btn btn--primary btn--sm" @onclick="() => SetResStatus(r.Id, ReservationStatus.Finished)"><LucideIcon Name="log-out" Size="15" />@Loc.T("Mark as left")</button>
                            }
                        </div>
                    </div>
                }
                @if (_reservations.Count == 0) { <p class="empty">@Loc.T("No reservations for this day.")</p> }
                else if (FilteredReservations.Count == 0) { <p class="empty">@Loc.T("No reservations for this service.")</p> }
            </div>
        }
        </aside>
        </div>
</div>

<Modal Visible="_form is not null" Title="@(_form?.Id > 0 ? Loc.T("Edit table") : Loc.T("New table"))" OnClose="Close" FullScreen="true">
    <ChildContent>
        @if (_form is not null)
        {
            <div class="field"><label>@Loc.T("Name")</label><input class="input" @bind="_form.Name" /></div>
            <div class="row-2">
                <div class="field"><label>@Loc.T("Seats")</label><input type="number" class="input" @bind="_form.Seats" /></div>
                <div class="field"><label>@Loc.T("Shape")</label>
                    <select class="select" @bind="_form.Shape">
                        @foreach (var s in Enum.GetValues<TableShape>())
                        {
                            <option value="@s">@Loc.T(s.ToString())</option>
                        }
                    </select>
                </div>
            </div>
            <div class="field">
                <label>@Loc.T("Zone")</label>
                <input class="input" list="zone-options" placeholder="@Loc.T("e.g. Main hall, Bar")" @bind="_form.Zone" />
                <datalist id="zone-options">
                    @foreach (var z in Zones)
                    {
                        <option value="@z"></option>
                    }
                </datalist>
            </div>
            <div class="field">
                <label>@Loc.T("Accent colour")</label>
                <ColorPickerPanel Current="@_form.Color" OnPick="c => _form.Color = c" ImageFolder="tables" />
            </div>
            @if (_groupMembers.Count > 0)
            {
                <div class="field"><label>@Loc.T("Group name")</label><input class="input" @bind="_groupNameEdit" /></div>
                <div class="join-info">
                    <span class="badge badge--primary"><LucideIcon Name="link" Size="14" /> @Loc.T("Joined")</span>
                    @Loc.T("Shares a bill with:") <strong>@string.Join(", ", _groupMembers)</strong>
                </div>
            }
            @if (_error is not null) { <div class="field-error">@_error</div> }
        }
    </ChildContent>
    <Footer>
        @if (_form?.Id > 0)
        {
            <button class="btn btn--danger" @onclick="() => Delete(_form!.Id)">@Loc.T("Delete")</button>
        }
        @if (_groupMembers.Count > 0)
        {
            <button class="btn btn--ghost" @onclick="() => SeparateGroup(_form!.Id)"><LucideIcon Name="link" Size="16" />@Loc.T("Separate")</button>
        }
        <span class="spacer"></span>
        <button class="btn btn--ghost" @onclick="Close">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" @onclick="Save">@Loc.T("Save")</button>
    </Footer>
</Modal>

<Modal Visible="_paintMenuOpen" Title="@Loc.T("Paint table colours")" OnClose="TogglePaintMenu" Narrow="true">
    <ChildContent>
        <ColorPickerPanel Current="@_paintColor" OnPick="ChoosePaintColor" ImageFolder="tables" />
    </ChildContent>
</Modal>

<Modal Visible="_showJoinNamePrompt" Title="@Loc.T("Name this table")" OnClose="CancelJoinNamePrompt">
    <ChildContent>
        <div class="field"><label>@Loc.T("Group name")</label><input class="input" @bind="_joinNameInput" /></div>
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CancelJoinNamePrompt">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" @onclick="ConfirmJoin"><LucideIcon Name="link" Size="16" />@Loc.T("Join")</button>
    </Footer>
</Modal>

<Modal Visible="_renamingTableId is not null" Title="@(RenamingTable?.GroupId is not null ? Loc.T("Group name") : Loc.T("Edit table"))" OnClose="CancelRenameTable" Narrow="true">
    <ChildContent>
        @if (RenamingTable?.GroupId is not null)
        {
            <div class="field"><label>@Loc.T("Group name")</label><input class="input" placeholder="@GroupDisplayName(RenamingTable.GroupId.Value)" @bind="_groupNameQuickInput" /></div>
        }
        else
        {
            <div class="field"><label>@Loc.T("Name")</label><input class="input" @bind="_tableNameInput" /></div>
        }
        @* Seats/shape/colour belong to this specific table, not the group as a whole — still
           editable here even when joined (same as the full "Edit table" modal already allows),
           on top of the shared group name above. *@
        <div class="row-2">
            <div class="field"><label>@Loc.T("Seats")</label><input type="number" min="1" class="input" @bind="_tableSeatsInput" /></div>
            <div class="field"><label>@Loc.T("Shape")</label>
                <select class="select" @bind="_tableShapeInput">
                    @foreach (var s in Enum.GetValues<TableShape>())
                    {
                        <option value="@s">@Loc.T(s.ToString())</option>
                    }
                </select>
            </div>
        </div>
        <div class="field">
            <label>@Loc.T("Accent colour")</label>
            <ColorPickerPanel Current="@_tableColorInput" OnPick="c => _tableColorInput = c" ImageFolder="tables" />
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CancelRenameTable">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" @onclick="ConfirmRenameTable">@Loc.T("Save")</button>
    </Footer>
</Modal>

<Modal Visible="_renamingZoneId is not null" Title="@Loc.T("Name this zone")" OnClose="CancelRenameZone" Narrow="true">
    <ChildContent>
        <div class="field"><label>@Loc.T("Zone name")</label><input class="input" @bind="_zoneNameInput" /></div>
        <div class="field">
            <label>@Loc.T("Accent colour")</label>
            <ColorPickerPanel Current="@_zoneColorInput" OnPick="c => _zoneColorInput = c" ImageFolder="zones" />
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CancelRenameZone">@Loc.T("Cancel")</button>
        <button class="btn btn--primary" @onclick="ConfirmRenameZone">@Loc.T("Save")</button>
    </Footer>
</Modal>

<Modal Visible="_confirmDelete is not null" Title="@Loc.T("Confirm deletion")" OnClose="CancelConfirmDelete" Narrow="true">
    <ChildContent>
        <p>@Loc.T("Delete") "@_confirmDelete?.Name"? @Loc.T("This can't be undone.")</p>
    </ChildContent>
    <Footer>
        <button class="btn btn--ghost" @onclick="CancelConfirmDelete">@Loc.T("Cancel")</button>
        <button class="btn btn--danger" @onclick="ConfirmDelete">@Loc.T("Delete")</button>
    </Footer>
</Modal>

@* Big-map mode and small screens (see OnTableClick): a single tap on a table opens its comanda
   straight away instead of the table-properties form, so the expanded map (and mobile) works as
   a fast waiter screen — there's no press-and-hold fallback to the properties form here, tapping
   a table only ever opens its comanda; use "Edit layout" for table properties instead. *@
<OrderEditor OrderId="_editorOrderId" OnClose="CloseOrderEditor" OnChanged="OnOrderEditorChanged" FullScreen="true" />

@code {
    // Cooler, darker "corporate upholstery" palette (navy, teal, slate, taupe, aubergine, sage)
    // instead of the warmer/brighter first pass — used both for joined-group badges and the table
    // paint-mode swatches, so the whole floor plan reads as enterprise software, not a colour wheel.
    private static readonly string[] GroupColors = { "#2f4a68", "#2f6b66", "#52657a", "#6b5f4a", "#5c4a5c", "#3f5c4a" };

    private List<TableDto> _tables = new();
    private TableFormDto? _form;
    private List<string> _groupMembers = new();
    private int? _groupId;
    private string _groupNameEdit = "";
    private string? _error;
    private string? _notice;

    private bool _editing;
    private bool _selecting;
    private bool _showFilters;
    private readonly HashSet<int> _selection = new();

    // ---- Reassign order to another table ----
    private bool _reassigning;
    private TableDto? _reassignSource;   // set once the occupied table to move is clicked
    private int? _reassignDestId;

    // ---- Floor style (background texture) ----
    private static readonly string[] FloorTextures = { "grid", "wood", "tile", "concrete", "marble", "terracotta" };
    private bool _floorMenuOpen;
    private bool _floorMenuClosing;
    private async Task ToggleFloorMenu()
    {
        if (_floorMenuOpen)
        {
            _floorMenuClosing = true;
            StateHasChanged();
            await Task.Delay(200);
            _floorMenuOpen = false;
            _floorMenuClosing = false;
        }
        else
        {
            _floorMenuOpen = true;
