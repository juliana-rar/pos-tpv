    // ---- Reservation wizard: 4 steps, each its own screen ----
    private int _resStep = 1;
    private int _resMaxStep = 1;   // furthest step reached, gates which step-chips are clickable
    private static readonly (int Step, string Label)[] ResSteps =
    {
        (1, "Guest"), (2, "Date"), (3, "Service"), (4, "Summary")
    };

    // Fills the stepper's connecting line up to the current step's dot — the dots are evenly
    // spaced (100 / ResSteps.Length apart), so step 1 = 0% filled, the last step = full width.
    private double StepProgressWidthPercent => (100.0 / ResSteps.Length) * (_resStep - 1);

    private bool _suppressRender;   // while true, JS owns the DOM; Blazor must not re-render the floor
    private ElementReference _floorEl;
    private IJSObjectReference? _module;

    // Numbers must be invariant so CSS/px values never use a comma decimal separator.
    private static string N(double d) => d.ToString(CultureInfo.InvariantCulture);
    private static string GroupColor(int gid) => GroupColors[Math.Abs(gid) % GroupColors.Length];

    // The anchor is the left-most (then top-most) member — it carries the group's badge and total.
    private bool IsGroupAnchor(TableDto t) =>
        t.GroupId is not null &&
        !_tables.Any(o => o.GroupId == t.GroupId &&
                          (o.PositionX < t.PositionX ||
                           (o.PositionX == t.PositionX && o.PositionY < t.PositionY)));

    // Which of a joined member's shared edges (left/right) butt up against a neighbour, so the
    // CSS can drop the border/bevel there and the row reads as one continuous table surface
    // instead of a seam down the middle. Mirrors ChairStyles' own hideLeft/hideRight logic,
    // since both rely on the same "always snapped left-to-right" layout (see JoinTablesAsync).
    private string GroupSeamAttr(TableDto t)
    {
        if (t.GroupId is null) return "";
        var members = _tables.Where(m => m.GroupId == t.GroupId).OrderBy(m => m.PositionX).ToList();
        var idx = members.FindIndex(m => m.Id == t.Id);
        var left = idx > 0;
        var right = idx >= 0 && idx < members.Count - 1;
        return left && right ? "both" : left ? "left" : right ? "right" : "";
    }

    // The reservation shown on a joined group's own overlay badge — any member carries the same
    // reservation object (see ResByTable), so the first one found is enough.
    private ReservationDto? GroupReservation(int gid, Dictionary<int, ReservationDto> resByTable)
    {
        var member = _tables.FirstOrDefault(t => t.GroupId == gid);
        return member is not null && resByTable.TryGetValue(member.Id, out var rv) ? rv : null;
    }

    // Joining tables loses a seat on each side of every seam where two tables meet (nobody can
    // sit facing into the next table) — a chain of N tables has N-1 seams, so 2 seats go for
    // each one. Two 4-seat tables joined into one therefore seat 6, not 8.
    private int GroupSeats(int gid)
    {
        var members = _tables.Where(t => t.GroupId == gid).ToList();
        if (members.Count <= 1) return members.Sum(t => t.Seats);
        return Math.Max(0, members.Sum(t => t.Seats) - 2 * (members.Count - 1));
    }

    private string GroupDisplayName(int gid)
    {
        var members = _tables.Where(t => t.GroupId == gid).OrderBy(t => t.Name).ToList();
        var namedGroup = members.Select(t => t.GroupName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n));
        return namedGroup ?? string.Join(" + ", members.Select(t => t.Name));
    }

    // True centre of the group's bounding box, both axes — kept centred on the table itself
    // (like any ungrouped table's own name) rather than floating above it, so it reads the same
    // whether the group is freshly rendered or mid-drag. floorplan.js's own live badge position
    // during a drag (see onMove) uses this exact same formula, so the label doesn't visibly jump
    // the instant the drag ends and Blazor's render takes back over.
    private string GroupCenterStyle(int gid, List<TableDto> visible)
    {
        var members = visible.Where(t => t.GroupId == gid).ToList();
        if (members.Count == 0) return "";
        var left = members.Min(t => t.PositionX);
        var right = members.Max(t => t.PositionX + t.Width);
        var top = members.Min(t => t.PositionY);
        var bottom = members.Max(t => t.PositionY + t.Height);
        return $"left:{N((left + right) / 2)}px; top:{N((top + bottom) / 2)}px;";
    }

    // Bottom-centre of the group's bounding box — where the joined row's one shared
    // reservation-time badge hangs (see .tbl__resv--group), centred under the whole merged span
    // instead of just the anchor member's own narrower box. floorplan.js's onMove uses this same
    // formula live during a drag, for the same reason GroupCenterStyle documents above.
    private string GroupBottomCenterStyle(int gid, List<TableDto> visible)
    {
        var members = visible.Where(t => t.GroupId == gid).ToList();
        if (members.Count == 0) return "";
        var left = members.Min(t => t.PositionX);
        var right = members.Max(t => t.PositionX + t.Width);
        var bottom = members.Max(t => t.PositionY + t.Height);
        return $"left:{N((left + right) / 2)}px; top:{N(bottom)}px;";
    }

    private string? _zoneFilter;

    // True once any zone's chip has been clicked to enter layout-edit mode (see the zone-pick
    // menu) — while true, every zone box gets its own Edit/Delete buttons (not just the one whose
    // chip was clicked), so any zone can be renamed or removed once that session has started.
    // Kept separate from _zoneFilter because that field *toggles* (clicking the same chip twice
    // clears it back to null, for the plain view-only "show just this zone" filter), so relying
    // on it here meant a second click on the same chip silently dropped the buttons even though
    // editing had just (re)started.
    private bool _zoneEditActive;

    private List<string> Zones => _tables
        .Select(t => t.Zone)
        .Where(z => !string.IsNullOrWhiteSpace(z))
        .Distinct()
        .OrderBy(z => z)
        .ToList()!;

    private List<TableDto> VisibleTables =>
        (_editing || _selecting || _assignReservationId is not null || _zoneFilter is null)
            ? _tables
            : _tables.Where(t => t.Zone == _zoneFilter).ToList();

    // When a zone filter is active, the map should read as "just this zone" — so besides
    // VisibleTables (already scoped to t.Zone above), the zone box itself and any decor sitting
    // inside its footprint are the only other things left on screen; every other zone box and
    // any decor outside it disappears instead of just losing its highlight.
    private List<FloorZoneDto> VisibleZones =>
        (_editing || _selecting || _assignReservationId is not null || _zoneFilter is null)
            ? _zones
            : _zones.Where(z => z.Name == _zoneFilter).ToList();

    private static bool DecorInsideZone(FloorDecorDto d, FloorZoneDto z)
    {
        var cx = d.PositionX + d.Width / 2;
        var cy = d.PositionY + d.Height / 2;
        return cx >= z.PositionX && cx <= z.PositionX + z.Width
            && cy >= z.PositionY && cy <= z.PositionY + z.Height;
    }

    private List<FloorDecorDto> VisibleDecor
    {
        get
        {
            if (_editing || _selecting || _assignReservationId is not null || _zoneFilter is null) return _decor;
            var zone = _zones.FirstOrDefault(z => z.Name == _zoneFilter);
            return zone is null ? _decor : _decor.Where(d => DecorInsideZone(d, zone)).ToList();
        }
    }

    private string TableClass(TableDto t, ReservationDto? rv)
    {
        var status = EffectiveTableStatus(t, rv);
        var c = $"tbl tbl--{t.Shape.ToString().ToLower()} tbl--{status.ToString().ToLower()}";
        if (t.Color is not null) c += IsImageColor(t.Color) ? " tbl--colored-img" : " tbl--colored";
        if (t.IsLocked) c += " tbl--locked";
        if (t.GroupId is not null) c += " tbl--grouped";
        if (_selecting && _selection.Contains(t.Id)) c += " tbl--selected";
        return c;
    }

    // A seated party reads as "occupied" on the floor plan (yellow, same as a walk-in order) even
    // though the table's own record is still "Reserved" — the guest is physically there now.
    private static TableStatus EffectiveTableStatus(TableDto t, ReservationDto? rv) =>
        rv?.Status == ReservationStatus.Seated ? TableStatus.Occupied : t.Status;

    // Icons mirror SHAPE_ICONS in floorplan.js so the button looks identical before and after a JS cycle.
    private static string ShapeIcon(TableShape shape) => shape switch
    {
        TableShape.Round => "○",
        TableShape.Rectangular => "▭",
        TableShape.Oval => "⬭",
        _ => "◻"
    };

    private string TableStyle(TableDto t)
    {
        var s = $"left:{N(t.PositionX)}px; top:{N(t.PositionY)}px; width:{N(t.Width)}px; height:{N(t.Height)}px; transform:rotate({N(t.Rotation)}deg); --rot:{N(t.Rotation)}deg";
        if (t.GroupId is not null) s += $"; --grp:{GroupColor(t.GroupId.Value)}";
        if (t.Color is not null)
        {
            if (IsImageColor(t.Color)) { s += $"; --timg:url('{t.Color}'); --tfg:#fff"; }
            else
            {
                s += $"; --tcolor:{t.Color}";
                if (IsDarkColor(t.Color)) s += "; --tfg:#fff";
            }
        }
        return s;
    }

    // Colour values picked via ColorPickerPanel are either a "#rrggbb" hex or an "/uploads/..."
    // image path (see ColorPickerPanel's own Value/IsImage) — this is the same '#'-prefix check
    // used there, kept in sync so a value round-trips as the same kind on both ends.
    private static bool IsImageColor(string color) => !color.StartsWith('#');

    // Quick perceived-luminance check so a custom/dark accent colour (picked freely via the
    // native colour input, unlike the fixed GroupColors palette) automatically gets white
    // labels instead of the default dark text becoming unreadable on it.
    private static bool IsDarkColor(string hex)
    {
        if (hex.Length < 7) return false;
        if (!byte.TryParse(hex.AsSpan(1, 2), System.Globalization.NumberStyles.HexNumber, null, out var r)) return false;
        if (!byte.TryParse(hex.AsSpan(3, 2), System.Globalization.NumberStyles.HexNumber, null, out var g)) return false;
        if (!byte.TryParse(hex.AsSpan(5, 2), System.Globalization.NumberStyles.HexNumber, null, out var b)) return false;
        return (0.299 * r + 0.587 * g + 0.114 * b) / 255 < 0.5;
    }

    // One small chair mark per seat, ringed around the table so it reads as a real table
    // instead of a bare labelled box. Round/oval tables get an even circular ring. Square/
    // rectangular tables follow the same convention as a real dining table: exactly one chair
    // on each short side (left/right) once there are at least 2 seats, and the rest split as
    // evenly as possible between the head and foot (top/bottom) — so 4 seats is 1-1-1-1, 6 is
    // 1-1-2-2, 8 is 1-1-3-3, etc., rather than a count proportional to each edge's length.
    // Percentages can fall outside 0–100 on purpose — that's what pushes the chair beyond the
    // table's own edge instead of sitting on top of it.
    // Joined tables are always snapped into a single left-to-right row (see JoinTablesAsync), so
    // a member's left and/or right edge can be a seam shared with its neighbour rather than a
    // real table edge — those sides skip their chair so nobody is drawn "sitting" inside the
    // next table. Top/bottom are never shared, since the row never stacks vertically.
    private static IEnumerable<string> ChairStyles(TableDto t, IReadOnlyList<TableDto> allTables)
    {
        var hideLeft = false;
        var hideRight = false;
        if (t.GroupId is not null)
        {
            var members = allTables.Where(m => m.GroupId == t.GroupId).OrderBy(m => m.PositionX).ToList();
            var idx = members.FindIndex(m => m.Id == t.Id);
            hideLeft = idx > 0;
            hideRight = idx >= 0 && idx < members.Count - 1;
        }

        const double outset = 18; // clearance off the table's own edge, scaled to the smaller chair size (see .tbl__chair)
        // Left/right offsets are a % of the table's own Width, so a wide 6+ seat table (see
        // RestaurantTable.DefaultWidthForSeats) pushed its side chairs much farther out in
        // absolute px than the top/bottom ones get from the same %. Pin the side offset to the
        // pixel clearance a default 70px-tall table would get instead, so it stays close
        // regardless of how wide the table is.
        var sideOutset = t.Width > 0 ? outset / 100 * 70 / t.Width * 100 : outset;
        var n = t.Seats;
        if (n <= 0 || n > 16) yield break;

        // A joined member always has its corners squared regardless of its own Shape (see
        // .tbl--grouped's border-radius:0 — the row has to read as one continuous rectangular
        // surface, not a chain of circles), so a round/oval seat ring — chairs at 30°/60° angles
        // meant to trace a circle's curve — would float at odd diagonal positions that don't line
        // up with that rectangle's straight edges or corners at all. Grouped members fall through
        // to the same rectangular one-per-side layout every square/rect table already uses.
        if (t.GroupId is null && t.Shape is TableShape.Round or TableShape.Oval)
        {
            for (var i = 0; i < n; i++)
            {
                var angle = 2 * Math.PI * i / n - Math.PI / 2;
                var left = 50 + 50 * (1 + outset / 50) * Math.Cos(angle);
                var top = 50 + 50 * (1 + outset / 50) * Math.Sin(angle);
                // Faces outward, away from the table centre — the same vector the chair was placed
                // along, just expressed as a rotation for the backrest pseudo-element (see .tbl__chair
                // in Tables.razor.css). +90 converts "angle from +X axis" to "rotation from facing up".
                var ang = angle * 180 / Math.PI + 90;
                yield return $"left:{left:0.#}%; top:{top:0.#}%; --ang:{ang:0.#}deg;";
            }
            yield break;
        }

        var sideCount = n >= 2 ? 1 : 0;
        var remaining = n - 2 * sideCount;
        var topCount = (remaining + 1) / 2;      // the odd remainder's extra chair goes to the head (top)
        var bottomCount = remaining / 2;

        if (!hideLeft)
            for (var i = 0; i < sideCount; i++)
                yield return $"left:{-sideOutset:0.#}%; top:50%; --ang:270deg;";          // left
        if (!hideRight)
            for (var i = 0; i < sideCount; i++)
                yield return $"left:{100 + sideOutset:0.#}%; top:50%; --ang:90deg;";      // right
        for (var i = 0; i < topCount; i++)
            yield return $"left:{(i + 0.5) / topCount * 100:0.#}%; top:{-outset:0.#}%; --ang:0deg;";
        for (var i = 0; i < bottomCount; i++)
            yield return $"left:{(i + 0.5) / bottomCount * 100:0.#}%; top:{100 + outset:0.#}%; --ang:180deg;";
    }

    protected override bool ShouldRender() => !_suppressRender;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private int _userId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState!;
        _userId = int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;

        await Load();
        await LoadReservations();
    }

    private async Task Load()
    {
        _tables = await Service.GetAllAsync();
        _decor = await DecorService.GetAllAsync();
        _zones = await ZoneService.GetAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_editing && _module is null && RendererInfo.IsInteractive)
        {
            // Cache-busted with a fixed build marker (bump the number whenever this file changes)
            // — a plain "./js/floorplan.js" URL lets browsers keep serving a stale cached copy
            // across dev-server restarts/deploys, silently running old drag/resize logic even
            // after the server-side fix is live.
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/floorplan.js?v=2");
            await _module.InvokeVoidAsync("init", _floorEl, _zoom);
            _suppressRender = true;
        }
    }

    // ---- Layout editing (drag / resize / rotate) ----
    private void StartEdit() { CancelAssign(); CancelReassign(); StopPaintMode(); _editing = true; }

    private async Task SaveLayout()
    {
        _suppressRender = false;
        if (_module is not null)
        {
            var layout = await _module.InvokeAsync<TableLayoutDto[]>("getLayout");
            await Service.SaveLayoutAsync(layout);
            var decorLayout = await _module.InvokeAsync<FloorDecorLayoutDto[]>("getDecorLayout");
            await DecorService.SaveLayoutAsync(decorLayout);
            var zoneLayout = await _module.InvokeAsync<FloorZoneLayoutDto[]>("getZoneLayout");
            await ZoneService.SaveLayoutAsync(zoneLayout);
            await _module.InvokeVoidAsync("dispose");
            await _module.DisposeAsync();
            _module = null;
        }
        _editing = false;
        // Entering edit from a zone chip (see the zone-pick menu) also sets this as a side effect
        // of OnZoneClick, but a FloorZone's Name rarely matches any table's free-text Zone tag —
        // so leaving it set here hid every table once editing ended, looking like tables had
        // vanished. Edit mode always shows the full map anyway (see VisibleTables/VisibleZones),
        // so there's nothing still "focused" to preserve once it's done.
        _zoneFilter = null;
        _zoneEditActive = false;
        await Load();
    }

    private async Task CancelEdit()
    {
        _suppressRender = false;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose");
            await _module.DisposeAsync();
            _module = null;
        }
        _editing = false;
        _zoneFilter = null;
        _zoneEditActive = false;
        await Load();
    }

    // ---- Join / separate ----
    private void StartSelect() { CancelAssign(); CancelReassign(); StopPaintMode(); _selecting = true; _selection.Clear(); _notice = null; }
    private void CancelSelect() { _selecting = false; _selection.Clear(); }

    // ---- Reassign an open order to another table ----
    private void StartReassign() { CancelAssign(); StopPaintMode(); _reassigning = true; _reassignSource = null; _reassignDestId = null; _notice = null; }
    private void CancelReassign() { _reassigning = false; _reassignSource = null; _reassignDestId = null; }

    private async Task ConfirmReassign()
    {
        if (_reassignSource?.ActiveOrderId is null || _reassignDestId is null) return;
        await OrderSvc.MoveOrderToTableAsync(_reassignSource.ActiveOrderId.Value, _reassignDestId.Value);
        CancelReassign();
        await Load();
    }

    // Joining asks for a name first (defaulting to "T1 + T2") so the group reads as one table
    // everywhere, instead of leaving each member's own name showing.
    private bool _showJoinNamePrompt;
    private string _joinNameInput = "";

    private void OpenJoinNamePrompt()
    {
        _joinNameInput = string.Join(" + ", _tables.Where(t => _selection.Contains(t.Id)).OrderBy(t => t.Name).Select(t => t.Name));
        _showJoinNamePrompt = true;
    }

    private void CancelJoinNamePrompt() => _showJoinNamePrompt = false;

    private async Task ConfirmJoin()
    {
        try
        {
            await Service.JoinTablesAsync(_selection, _joinNameInput);
            _notice = $"{_selection.Count} {Loc.T("tables joined.")}";
        }
        catch (InvalidOperationException ex) { _notice = ex.Message; }
        _showJoinNamePrompt = false;
        _selecting = false;
        _selection.Clear();
        await Load();
    }

    private async Task SeparateGroup(int tableId)
    {
        try { await Service.SeparateGroupAsync(tableId); }
        catch (InvalidOperationException ex) { _error = ex.Message; return; }
        _form = null;
        _groupMembers = new();
        await Load();
    }

    // Non-null only when every selected table already belongs to that same existing group —
    // selecting an already-joined group's tables (via the same "Join tables" button) means the
    // user wants to undo the join, not make a new one, so the toolbar offers Separate instead.
    private int? SelectedGroupId
    {
        get
        {
            var selected = _tables.Where(t => _selection.Contains(t.Id)).ToList();
            if (selected.Count == 0) return null;
            var first = selected[0].GroupId;
            return first is not null && selected.All(t => t.GroupId == first) ? first : null;
        }
    }

    private async Task SeparateSelectedGroup()
    {
        if (_selection.Count == 0) return;
        var tableId = _selection.First();
        try { await Service.SeparateGroupAsync(tableId); }
        catch (InvalidOperationException ex) { _notice = ex.Message; }
        _selecting = false;
        _selection.Clear();
        await Load();
    }

