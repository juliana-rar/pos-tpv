    private async Task OpenResForm(int? id)
    {
        _resError = null;
        _resForm = id is null
            ? new ReservationFormDto { Date = _reserveDate }
            : await ReservationService.GetForEditAsync(id.Value) ?? new ReservationFormDto();
        // Editing an existing reservation already has every step filled in, so unlock the whole
        // wizard instead of forcing another walk through it; a new one starts at step 1 only.
