@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject AppSettingsCache Branding

<PageTitle>@Loc.T("Menu") · @Branding.Current.Title</PageTitle>

<AuthorizeView>
    <Authorized Context="auth">
        <div class="hub">
            <div class="hub__grid">
                <HubCard Href="/dashboard" Icon="layout-dashboard" Accent="#6366f1"
                         Title="@Loc.T("Dashboard")" Description="@Loc.T("Live sales overview and top products")" />

                <AuthorizeView Roles="Admin,Waiter,Cashier" Context="a">
                    <HubCard Href="/pos" Icon="shopping-cart" Accent="#0ea5e9"
                             Title="@Loc.T("Point of Sale")" Description="@Loc.T("Take orders and charge tables")" />
                </AuthorizeView>

                <AuthorizeView Roles="Admin,Waiter,Cashier" Context="a">
                    <HubCard Href="/orders" Icon="clipboard-list" Accent="#8b5cf6"
                             Title="@Loc.T("Orders")" Description="@Loc.T("Track and charge open orders")" />
                </AuthorizeView>

                <AuthorizeView Roles="Admin,Waiter,Cashier" Context="a">
                    <HubCard Href="/tables" Icon="armchair" Accent="#10b981"
                             Title="@Loc.T("Tables")" Description="@Loc.T("Floor plan, joins and reservations")" />
                </AuthorizeView>

                <AuthorizeView Roles="Admin,Kitchen" Context="a">
                    <HubCard Href="/kitchen" Icon="chef-hat" Accent="#ef4444"
                             Title="@Loc.T("Kitchen")" Description="@Loc.T("Kitchen display for live tickets")" />
                </AuthorizeView>

                <AuthorizeView Roles="Admin,Cashier" Context="a">
                    <HubCard Href="/billing" Icon="banknote" Accent="#14b8a6"
                             Title="@Loc.T("Billing")" Description="@Loc.T("Revenue reports and invoices")" />
                </AuthorizeView>

                <AuthorizeView Roles="Admin" Context="a">
                    <HubCard Href="/products" Icon="utensils-crossed" Accent="#ec4899"
                             Title="@Loc.T("Products")" Description="@Loc.T("Manage the product catalogue")" />
                </AuthorizeView>

                <AuthorizeView Roles="Admin" Context="a">
                    <HubCard Href="/settings" Icon="settings" Accent="#64748b"
                             Title="@Loc.T("Settings")" Description="@Loc.T("Manage the app title, staff accounts and service hours")" />
                </AuthorizeView>
            </div>
        </div>
    </Authorized>
</AuthorizeView>
