@page "/kitchen"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Kitchen")]
@using Microsoft.AspNetCore.SignalR.Client
@using PosTpv.Web.Hubs
@implements IAsyncDisposable
@inject IOrderService Orders
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AppSettingsCache Branding

<PageTitle>Kitchen · @Branding.Current.Title</PageTitle>

@* Same quick-jump chip strip as /orders (.orders-quicknav in Orders.razor.css) — one chip per
   ticket on screen, click to scroll straight to it instead of hunting across the board. *@
<div class="orders-quicknav @(_showFilters ? "orders-quicknav--filters-open" : "")">
    <div class="orders-quicknav__chips @(_chipsExpanded ? "orders-quicknav__chips--expanded" : "")">
        @foreach (var o in Filtered)
        {
            <button class="orders-quicknav__chip" data-status="@o.Status.ToString().ToLower()"
                    title="@o.TableName · @Loc.T(o.Status.ToString())" @onclick="() => JumpToTicket(o.Id)" type="button">
                <span class="orders-quicknav__chip-name">@o.TableName</span>
            </button>
        }
    </div>
    <div class="kds__head toolbar">
        @if (_showFilters)
        {
            <div class="dd">
                <button type="button" class="select dd__trigger" style="max-width:130px" @onclick="ToggleStatusMenu">@StatusFilterLabel()</button>
                @if (_statusMenuOpen)
                {
                    <div class="dd__menu">
                        <button type="button" class="dd__opt @(_statusFilterValue is null ? "dd__opt--on" : "")" @onclick='() => ChooseStatusFilter(null)'>@Loc.T("All statuses")</button>
                        @foreach (var s in new[] { OrderStatus.Open, OrderStatus.Sent, OrderStatus.InPreparation, OrderStatus.Ready, OrderStatus.Delivered })
                        {
                            <button type="button" class="dd__opt @(_statusFilterValue == s ? "dd__opt--on" : "")" @onclick="() => ChooseStatusFilter(s)">@Loc.T(s.ToString())</button>
                        }
                    </div>
                }
            </div>
            <div class="dd">
                <button type="button" class="select dd__trigger" style="max-width:130px" @onclick="ToggleSortMenu">@SortLabel(_sortOrder)</button>
                @if (_sortMenuOpen)
                {
                    <div class="dd__menu">
                        <button type="button" class="dd__opt @(_sortOrder == "oldest" ? "dd__opt--on" : "")" @onclick='() => ChooseSort("oldest")'>@Loc.T("Oldest first")</button>
                        <button type="button" class="dd__opt @(_sortOrder == "newest" ? "dd__opt--on" : "")" @onclick='() => ChooseSort("newest")'>@Loc.T("Newest first")</button>
                        <button type="button" class="dd__opt @(_sortOrder == "number" ? "dd__opt--on" : "")" @onclick='() => ChooseSort("number")'>@Loc.T("Order number")</button>
                    </div>
                }
            </div>
            @if (Zones.Count > 0)
            {
                <div class="dd">
                    <button type="button" class="select dd__trigger" style="max-width:130px" @onclick="ToggleZoneMenu">@(string.IsNullOrEmpty(_zoneFilter) ? Loc.T("All zones") : _zoneFilter)</button>
                    @if (_zoneMenuOpen)
                    {
                        <div class="dd__menu">
                            <button type="button" class="dd__opt @(string.IsNullOrEmpty(_zoneFilter) ? "dd__opt--on" : "")" @onclick='() => ChooseZone("")'>@Loc.T("All zones")</button>
                            @foreach (var z in Zones)
                            {
                                <button type="button" class="dd__opt @(_zoneFilter == z ? "dd__opt--on" : "")" @onclick="() => ChooseZone(z)">@z</button>
                            }
                        </div>
                    }
                </div>
            }
            <input class="input" style="max-width:130px" placeholder="@Loc.T("Search table…")" @bind="_tableSearch" @bind:event="oninput" />
        }
        <button class="btn btn--icon btn--ghost" title="@Loc.T("Refresh")" @onclick="Reload"><LucideIcon Name="rotate-cw" Size="16" /></button>
        <button class="btn btn--icon @(_showFilters ? "btn--primary" : "btn--ghost")" title="@Loc.T("Filters")" @onclick="() => _showFilters = !_showFilters">
            <LucideIcon Name="settings" Size="16" />
        </button>
        <button class="btn btn--icon @(_chipsExpanded ? "btn--primary" : "btn--ghost")"
                title="@(_chipsExpanded ? Loc.T("Show fewer tables") : Loc.T("Show all tables"))"
                @onclick="() => _chipsExpanded = !_chipsExpanded">
            <LucideIcon Name="@(_chipsExpanded ? "chevron-up" : "chevron-down")" Size="16" />
        </button>
    </div>
</div>

@if (Filtered.Count == 0)
{
    <p class="empty">@Loc.T("No orders in the kitchen. Enjoy the calm. ☕")</p>
}
else
{
    <div class="kds">
        @foreach (var o in Filtered)
        {
            <div id="ticket-@o.Id" class="ticket @(o.SecondsFiredAt is null ? "" : "ticket--seconds")">
                <div class="ticket__head">
                    <span class="ticket__table"><LucideIcon Name="armchair" Size="16" /> @o.TableName</span>
                    <span class="badge ticket__status">@TicketStatusLabel(o.Status)</span>
                    <span class="spacer"></span>
                    <span class="ticket__time">@o.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                </div>

                <div class="ticket__fired-row">
                    <button type="button" class="btn btn--sm btn--ghost ticket__fired @(o.SecondsSentAt is null ? "ticket__fired--empty" : "")"
                            title="@(o.SecondsSentAt is null ? Loc.T("Click to mark as fired") : Loc.T("Click to mark as not fired"))" @onclick="() => ToggleSeconds(o)">
                        <LucideIcon Name="bell" Size="14" />
                        @Loc.T("Seconds prepared")@(o.SecondsSentAt is { } secondsAt ? $" · {secondsAt.ToLocalTime():HH:mm}" : "")
                    </button>
                </div>

                @if (o.SecondsFiredAt is not null)
                {
                    <div class="ticket__fire">
                        <span class="ticket__fire-label"><LucideIcon Name="bell" Size="15" /> @Loc.T("Fire second courses")</span>
                        <button class="btn btn--icon" title="@Loc.T("Got it")"
                                @onclick="() => AcknowledgeSeconds(o)"><LucideIcon Name="check" Size="18" /></button>
                    </div>
                }

                @{
                    var food = o.Items.Where(i => !i.IsDrink && i.Status != OrderItemStatus.Delivered).ToList();
                    // Same course grouping/labels as the waiter's OrderCard (First course /
                    // Second course / Desserts), so the kitchen sees the same vocabulary.
                    var groups = new List<(string Icon, string Label, List<OrderItemDto> Items)>
                    {
                        ("salad", "First course", food.Where(i => i.Course == CourseType.Starter).ToList()),
                        ("utensils", "Second course", food.Where(i => i.Course == CourseType.Main).ToList()),
                        ("cake-slice", "Desserts", food.Where(i => i.Course == CourseType.Dessert).ToList()),
                    }.Where(g => g.Items.Count > 0).ToList();
                    var allFoodReady = food.Count > 0 && food.All(i => i.Status == OrderItemStatus.Ready);
                }

                <div class="ticket__items">
                    @foreach (var group in groups)
                    {
                        <div class="ticket__group"><LucideIcon Name="@group.Icon" Size="14" /> @Loc.T(group.Label)</div>
                        @* Same ordered-together bracket as /orders (OrderCard.razor's GroupByOrderTime): items tapped
                           in the same minute share one timestamp behind a connecting bar instead of repeating it. *@
                        @foreach (var timeGroup in GroupByOrderTime(group.Items))
                        {
                            <div class="ticket__time-group">
                                <span class="ticket__time-group-time">@timeGroup.Time.ToLocalTime().ToString("HH:mm")</span>
                                <div class="ticket__time-group-items">
                                    @foreach (var it in timeGroup.Items)
                                    {
                                        <div class="kitem kitem--@it.Status.ToString().ToLower()">
                                            <div class="kitem__row">
                                                <span class="kitem__qty">@it.Quantity×</span>
                                                <span class="kitem__name">@it.ProductName</span>
                                                <span class="spacer"></span>
                                                @if (it.Status == OrderItemStatus.Preparing)
                                                {
                                                    <button class="btn btn--icon btn--success" title="@Loc.T("Ready")"
                                                            @onclick="() => SetItem(it.Id, OrderItemStatus.Ready)"><LucideIcon Name="arrow-right" Size="18" /></button>
                                                }
                                                else
                                                {
                                                    <LucideIcon Name="check" Size="16" />
                                                }
                                            </div>
                                            @if (it.Extras.Count > 0)
                                            {
                                                <div class="kitem__extras">＋ @string.Join(", ", it.Extras.Select(e => e.Name))</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(it.Comment))
                                            {
                                                <div class="kitem__comment"><LucideIcon Name="triangle-alert" Size="14" /> @it.Comment</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (food.Count > 0)
                {
                    <div class="ticket__foot">
                        <button class="btn btn--ghost btn--block" title="@(allFoodReady ? Loc.T("Click to undo") : null)" @onclick="() => ToggleAllReady(o)">
                            @if (allFoodReady)
                            {
                                <LucideIcon Name="check" Size="16" />
                            }
                            @(allFoodReady ? Loc.T("All ready") : Loc.T("Mark all ready"))
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<OrderDto> _orders = new();
    private HubConnection? _hub;

    private bool _showFilters;
    private bool _chipsExpanded;
    private OrderStatus? _statusFilterValue;
    private bool _statusMenuOpen;
    private void ToggleStatusMenu() => _statusMenuOpen = !_statusMenuOpen;
    private void ChooseStatusFilter(OrderStatus? value) { _statusFilterValue = value; _statusMenuOpen = false; }
    private string StatusFilterLabel() => _statusFilterValue is null ? Loc.T("All statuses") : Loc.T(_statusFilterValue.ToString()!);

    private string _sortOrder = "oldest"; // "newest" | "oldest" | "number" — oldest first matches the kitchen's natural cook-order priority
    private bool _sortMenuOpen;
    private void ToggleSortMenu() => _sortMenuOpen = !_sortMenuOpen;
    private void ChooseSort(string value) { _sortOrder = value; _sortMenuOpen = false; }
    private string SortLabel(string value) => value switch
    {
        "newest" => Loc.T("Newest first"),
        "number" => Loc.T("Order number"),
        _ => Loc.T("Oldest first"),
    };

    private bool _zoneMenuOpen;
    private void ToggleZoneMenu() => _zoneMenuOpen = !_zoneMenuOpen;
    private void ChooseZone(string value) { _zoneFilter = value; _zoneMenuOpen = false; }
    private string _zoneFilter = "";
    private string _tableSearch = "";
    private List<string> Zones => _orders
        .Select(o => o.Zone)
        .Where(z => !string.IsNullOrWhiteSpace(z))
        .Distinct()
        .OrderBy(z => z)
        .ToList()!;
    private List<OrderDto> Filtered
    {
        get
        {
            var list = _statusFilterValue is null ? _orders : _orders.Where(o => o.Status == _statusFilterValue);
            if (!string.IsNullOrEmpty(_zoneFilter)) list = list.Where(o => o.Zone == _zoneFilter);
            if (!string.IsNullOrWhiteSpace(_tableSearch)) list = list.Where(o => o.TableName.Contains(_tableSearch, StringComparison.OrdinalIgnoreCase));
            return (_sortOrder switch
            {
                "newest" => list.OrderByDescending(o => o.CreatedAt),
                "number" => list.OrderBy(o => o.Number),
                _ => list.OrderBy(o => o.CreatedAt)
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();

        if (!RendererInfo.IsInteractive) return;

        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri(KitchenHub.Path))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<int>(KitchenHub.OrderSent, async _ => await Reload());
        _hub.On<int, int>(KitchenHub.ItemStatusChanged, async (_, _) => await Reload());
        _hub.On<int>(KitchenHub.OrderReady, async _ => await Reload());
        _hub.On<int>(KitchenHub.SecondsFired, async _ =>
        {
            await Reload();
            await JS.InvokeVoidAsync("posBeep");
        });
        _hub.Reconnected += async _ => await Reload();

        await _hub.StartAsync();
        StateHasChanged();
    }

    private void JumpToTicket(int orderId) => Nav.NavigateTo($"/kitchen#ticket-{orderId}");

    // Same bracket grouping as OrderCard.razor's GroupByOrderTime: items ordered in the same
    // minute share one timestamp instead of each line carrying its own repeated time.
    private static List<TimeGroup> GroupByOrderTime(List<OrderItemDto> items)
    {
        var groups = new List<TimeGroup>();
        foreach (var it in items)
        {
            var minute = new DateTime(it.CreatedAt.Year, it.CreatedAt.Month, it.CreatedAt.Day, it.CreatedAt.Hour, it.CreatedAt.Minute, 0, it.CreatedAt.Kind);
            if (groups.Count > 0 && groups[^1].Time == minute)
                groups[^1].Items.Add(it);
            else
                groups.Add(new TimeGroup(minute, new List<OrderItemDto> { it }));
        }
        return groups;
    }

    private sealed record TimeGroup(DateTime Time, List<OrderItemDto> Items);

    private async Task Load() => _orders = await Orders.GetKitchenOrdersAsync();

    private async Task Reload()
    {
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetItem(int itemId, OrderItemStatus status)
    {
        await Orders.SetItemStatusAsync(itemId, status);
        await Load();
    }

    // Marks every non-delivered food item Ready; once they're all Ready, the same button
    // flips to undo and puts them all back to Preparing (same toggle pattern as /orders).
    // Both directions are single-round-trip service calls (not a per-item loop), so they can't
    // race the page's own SignalR reload on the same DbContext.
    private async Task ToggleAllReady(OrderDto o)
    {
        var food = o.Items.Where(i => !i.IsDrink && i.Status != OrderItemStatus.Delivered).ToList();
        if (food.Count == 0) return;
        if (food.All(i => i.Status == OrderItemStatus.Ready))
            await Orders.UnmarkFoodReadyAsync(o.Id);
        else
            await Orders.MarkFoodReadyAsync(o.Id);
        await Load();
    }

    private async Task AcknowledgeSeconds(OrderDto o)
    {
        await Orders.AcknowledgeSecondCoursesAsync(o.Id);
        await Load();
    }

    private async Task ToggleSeconds(OrderDto o)
    {
        if (o.SecondsSentAt is null) await Orders.FireSecondCoursesAsync(o.Id);
        else await Orders.UndoSecondCoursesFiredAsync(o.Id);
        await Load();
    }

    private static string TicketStatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.Ready => Loc.T("Ready"),
        OrderStatus.InPreparation => Loc.T("In preparation"),
        _ => Loc.T("Sent")
    };


    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}
