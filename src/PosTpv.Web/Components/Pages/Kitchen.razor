@page "/kitchen"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Kitchen")]
@using Microsoft.AspNetCore.SignalR.Client
@using PosTpv.Web.Hubs
@implements IAsyncDisposable
@inject IOrderService Orders
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AppSettingsCache Branding

<PageTitle>Kitchen · @Branding.Current.Title</PageTitle>

@* Same quick-jump chip strip as /orders (.orders-quicknav in Orders.razor.css) — one chip per
   ticket on screen, click to scroll straight to it instead of hunting across the board. *@
<div class="orders-quicknav @(_showFilters ? "orders-quicknav--filters-open" : "")">
    <div class="orders-quicknav__chips @(_chipsExpanded ? "orders-quicknav__chips--expanded" : "")">
        @foreach (var o in Filtered)
        {
            <button @key="o.Id" class="orders-quicknav__chip" data-status="@o.Status.ToString().ToLower()"
                    title="@o.TableName · @Loc.T(o.Status.ToString())" @onclick="() => JumpToTicket(o.Id)" type="button">
                <span class="orders-quicknav__chip-name">@o.TableName</span>
            </button>
        }
    </div>
    <div class="kds__head toolbar">
        @if (_showFilters)
        {
            <div class="dd">
                <button type="button" class="select dd__trigger" style="max-width:130px" @onclick="ToggleStatusMenu">@StatusFilterLabel()</button>
                @if (_statusMenuOpen)
                {
                    <div class="dd__menu">
                        <button type="button" class="dd__opt @(_statusFilterValue is null ? "dd__opt--on" : "")" @onclick='() => ChooseStatusFilter(null)'>@Loc.T("All statuses")</button>
                        @foreach (var s in new[] { OrderStatus.Open, OrderStatus.Sent, OrderStatus.InPreparation, OrderStatus.Ready, OrderStatus.Delivered })
                        {
                            <button type="button" class="dd__opt @(_statusFilterValue == s ? "dd__opt--on" : "")" @onclick="() => ChooseStatusFilter(s)">@Loc.T(s.ToString())</button>
                        }
                    </div>
                }
            </div>
            <div class="dd">
                <button type="button" class="select dd__trigger" style="max-width:130px" @onclick="ToggleSortMenu">@SortLabel(_sortOrder)</button>
                @if (_sortMenuOpen)
                {
                    <div class="dd__menu">
                        <button type="button" class="dd__opt @(_sortOrder == "oldest" ? "dd__opt--on" : "")" @onclick='() => ChooseSort("oldest")'>@Loc.T("Oldest first")</button>
                        <button type="button" class="dd__opt @(_sortOrder == "newest" ? "dd__opt--on" : "")" @onclick='() => ChooseSort("newest")'>@Loc.T("Newest first")</button>
                        <button type="button" class="dd__opt @(_sortOrder == "number" ? "dd__opt--on" : "")" @onclick='() => ChooseSort("number")'>@Loc.T("Order number")</button>
                    </div>
                }
            </div>
            @if (Zones.Count > 0)
            {
                <div class="dd">
                    <button type="button" class="select dd__trigger" style="max-width:130px" @onclick="ToggleZoneMenu">@(string.IsNullOrEmpty(_zoneFilter) ? Loc.T("All zones") : _zoneFilter)</button>
                    @if (_zoneMenuOpen)
                    {
                        <div class="dd__menu">
                            <button type="button" class="dd__opt @(string.IsNullOrEmpty(_zoneFilter) ? "dd__opt--on" : "")" @onclick='() => ChooseZone("")'>@Loc.T("All zones")</button>
                            @foreach (var z in Zones)
                            {
                                <button type="button" class="dd__opt @(_zoneFilter == z ? "dd__opt--on" : "")" @onclick="() => ChooseZone(z)">@z</button>
                            }
                        </div>
                    }
                </div>
            }
            <input class="input" style="max-width:130px" placeholder="@Loc.T("Search table…")" @bind="_tableSearch" @bind:event="oninput" @bind:after="RefreshCaches" />
        }
        <button class="btn btn--icon btn--ghost" title="@Loc.T("Refresh")" @onclick="Reload"><LucideIcon Name="rotate-cw" Size="16" /></button>
        <button class="btn btn--icon @(_showFilters ? "btn--primary" : "btn--ghost")" title="@Loc.T("Filters")" @onclick="() => _showFilters = !_showFilters">
            <LucideIcon Name="settings" Size="16" />
        </button>
        <button class="btn btn--icon @(_chipsExpanded ? "btn--primary" : "btn--ghost")"
                title="@(_chipsExpanded ? Loc.T("Show fewer tables") : Loc.T("Show all tables"))"
                @onclick="() => _chipsExpanded = !_chipsExpanded">
            <LucideIcon Name="@(_chipsExpanded ? "chevron-up" : "chevron-down")" Size="16" />
        </button>
    </div>
</div>

@if (Filtered.Count == 0)
{
    <p class="empty">@Loc.T("No orders in the kitchen. Enjoy the calm. ☕")</p>
}
else
{
    <div class="kds">
        @foreach (var o in Filtered)
        {
            <KitchenTicket @key="o.Id" Order="o"
                           OnSetItem="args => SetItem(args.OrderId, args.ItemId, args.Status)"
                           OnToggleAllReady="ToggleAllReady"
                           OnAcknowledgeSeconds="AcknowledgeSeconds"
                           OnToggleSeconds="ToggleSeconds" />
        }
    </div>
}

@code {
    private List<OrderDto> _orders = new();
    private HubConnection? _hub;

    private bool _showFilters;
    private bool _chipsExpanded;
    private OrderStatus? _statusFilterValue;
    private bool _statusMenuOpen;
    private void ToggleStatusMenu() => _statusMenuOpen = !_statusMenuOpen;
    private void ChooseStatusFilter(OrderStatus? value) { _statusFilterValue = value; _statusMenuOpen = false; RefreshCaches(); }
    private string StatusFilterLabel() => _statusFilterValue is null ? Loc.T("All statuses") : Loc.T(_statusFilterValue.ToString()!);

    private string _sortOrder = "oldest"; // "newest" | "oldest" | "number" — oldest first matches the kitchen's natural cook-order priority
    private bool _sortMenuOpen;
    private void ToggleSortMenu() => _sortMenuOpen = !_sortMenuOpen;
    private void ChooseSort(string value) { _sortOrder = value; _sortMenuOpen = false; RefreshCaches(); }
    private string SortLabel(string value) => value switch
    {
        "newest" => Loc.T("Newest first"),
        "number" => Loc.T("Order number"),
        _ => Loc.T("Oldest first"),
    };

    private bool _zoneMenuOpen;
    private void ToggleZoneMenu() => _zoneMenuOpen = !_zoneMenuOpen;
    private void ChooseZone(string value) { _zoneFilter = value; _zoneMenuOpen = false; RefreshCaches(); }
    private string _zoneFilter = "";
    private string _tableSearch = "";

    // Both were plain get-only properties re-running their LINQ pipeline on every access — up to
    // 3x per render for Filtered (quicknav strip, the empty-state check, and the ticket loop) even
    // though nothing changed between them. Cached fields instead, refreshed only when the data or
    // a filter actually changes (RefreshCaches, called from Load/Reload and every filter setter).
    private List<string> _zones = new();
    private List<OrderDto> _filtered = new();
    private List<string> Zones => _zones;
    private List<OrderDto> Filtered => _filtered;

    private void RefreshCaches()
    {
        _zones = _orders
            .Select(o => o.Zone)
            .Where(z => !string.IsNullOrWhiteSpace(z))
            .Distinct()
            .OrderBy(z => z)
            .ToList()!;

        var list = _statusFilterValue is null ? _orders : _orders.Where(o => o.Status == _statusFilterValue);
        if (!string.IsNullOrEmpty(_zoneFilter)) list = list.Where(o => o.Zone == _zoneFilter);
        if (!string.IsNullOrWhiteSpace(_tableSearch)) list = list.Where(o => o.TableName.Contains(_tableSearch, StringComparison.OrdinalIgnoreCase));
        _filtered = (_sortOrder switch
        {
            "newest" => list.OrderByDescending(o => o.CreatedAt),
            "number" => list.OrderBy(o => o.Number),
            _ => list.OrderBy(o => o.CreatedAt)
        }).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();

        if (!RendererInfo.IsInteractive) return;

        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri(KitchenHub.Path))
            .WithAutomaticReconnect()
            .Build();

        // Every event carries the affected order id, so — same as /orders — we refresh just that
        // one ticket instead of re-fetching and re-rendering the whole board on every event from
        // every waiter station.
        _hub.On<int>(KitchenHub.OrderSent, RefreshOrder);
        _hub.On<int, int>(KitchenHub.ItemStatusChanged, (orderId, _) => RefreshOrder(orderId));
        _hub.On<int>(KitchenHub.OrderReady, RefreshOrder);
        _hub.On<int>(KitchenHub.SecondsFired, async orderId =>
        {
            await RefreshOrder(orderId);
            await JS.InvokeVoidAsync("posBeep");
        });
        _hub.Reconnected += OnReconnected;

        await _hub.StartAsync();
        StateHasChanged();
    }

    // A reconnect may have missed several targeted events while disconnected, so this one still
    // does a full reload to resync. Kept as a named handler (not a lambda) so it can be
    // unsubscribed in DisposeAsync instead of only relying on the whole connection being torn down.
    private Task OnReconnected(string? _) => Reload();

    private void JumpToTicket(int orderId) => Nav.NavigateTo($"/kitchen#ticket-{orderId}");

    // Refresh a single ticket in place: one DB read for that order, and only its subtree
    // re-renders — mirrors Orders.razor's RefreshOrder for the kitchen board.
    private async Task RefreshOrder(int orderId)
    {
        var fresh = await Orders.GetByIdAsync(orderId);
        var idx = _orders.FindIndex(o => o.Id == orderId);
        var belongsOnBoard = fresh is not null
            && fresh.Status is OrderStatus.Sent or OrderStatus.InPreparation or OrderStatus.Ready
            && fresh.Items.Any(i => !i.IsDrink);

        if (!belongsOnBoard)
        {
            if (idx >= 0) _orders.RemoveAt(idx);             // paid/cancelled, or no food left to cook
        }
        else if (idx >= 0)
        {
            _orders[idx] = fresh!;                           // replace just this ticket's snapshot
        }
        else
        {
            _orders.Add(fresh!);                              // newly sent order appeared
            _orders.Sort((a, b) => a.CreatedAt.CompareTo(b.CreatedAt));
        }

        // Rebuilds Filtered/Zones from the now-updated _orders. The untouched tickets keep the
        // exact same OrderDto references (LINQ filters/reorders, it doesn't clone), so
        // KitchenTicket's ShouldRender still skips re-rendering everything except the one that
        // actually changed.
        RefreshCaches();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Load()
    {
        _orders = await Orders.GetKitchenOrdersAsync();
        RefreshCaches();
    }

    private async Task Reload()
    {
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    // No local reload after any of these: each backend call broadcasts its own SignalR event,
    // and this page is subscribed to all of them (see OnInitializedAsync), so the echo refreshes
    // just the affected ticket via RefreshOrder — same zero-local-fetch pattern as /orders.
    private async Task SetItem(int orderId, int itemId, OrderItemStatus status) =>
        await Orders.SetItemStatusAsync(itemId, status);

    // Marks every non-delivered food item Ready; once they're all Ready, the same button
    // flips to undo and puts them all back to Preparing (same toggle pattern as /orders).
    private async Task ToggleAllReady(OrderDto o)
    {
        var food = o.Items.Where(i => !i.IsDrink && i.Status != OrderItemStatus.Delivered).ToList();
        if (food.Count == 0) return;
        if (food.All(i => i.Status == OrderItemStatus.Ready))
            await Orders.UnmarkFoodReadyAsync(o.Id);
        else
            await Orders.MarkFoodReadyAsync(o.Id);
    }

    private Task AcknowledgeSeconds(OrderDto o) => Orders.AcknowledgeSecondCoursesAsync(o.Id);

    private Task ToggleSeconds(OrderDto o) =>
        o.SecondsSentAt is null ? Orders.FireSecondCoursesAsync(o.Id) : Orders.UndoSecondCoursesFiredAsync(o.Id);

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            _hub.Reconnected -= OnReconnected;
            await _hub.DisposeAsync();
        }
    }
}
