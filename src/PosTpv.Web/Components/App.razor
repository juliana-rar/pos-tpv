@* Root document. Interactivity is declared per-page so the login page can run as static SSR
   (required to set the authentication cookie). *@
@inject AppSettingsCache Branding
<!DOCTYPE html>
<html lang="@(Loc.IsSpanish ? "es" : "en")" data-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["PosTpv.Web.styles.css"]" />
    @* Overrides app.css's default --primary for both themes with the Settings-configured accent
       colour. Same specificity as app.css's ":root"/"[data-theme=dark]" rules, so it wins purely
       by coming later in the cascade — no !important needed. --primary-strong is derived from it
       so a custom colour still gets a matching hover shade instead of clashing with the default. *@
    <style>
        :root {
            --primary: @Branding.Current.PrimaryColor;
            --primary-strong: color-mix(in srgb, black 12%, @Branding.Current.PrimaryColor);
        }
    </style>
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    <script>
        // Apply the persisted theme before first paint to avoid a flash.
        (function () {
            const t = localStorage.getItem('pos-theme') || 'light';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/pos.js"></script>
</body>

</html>
