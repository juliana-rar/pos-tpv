<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PosTpv.Application\PosTpv.Application.csproj" />
    <ProjectReference Include="..\PosTpv.Infrastructure\PosTpv.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The /tables floor is rendered by a child component (FloorMap) but styled by Tables.razor.css:
       giving both the same CSS isolation scope keeps every floor rule matching its markup. -->
  <ItemGroup>
    <None Update="Components\Pages\Tables.razor.css" CssScope="b-tables-floor" />
    <None Update="Components\Shared\FloorMap.razor.css" CssScope="b-tables-floor" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>postpv-web-dev</UserSecretsId>
  </PropertyGroup>

</Project>
